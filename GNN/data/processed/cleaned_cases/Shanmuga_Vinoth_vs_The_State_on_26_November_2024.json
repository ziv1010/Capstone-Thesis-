        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "This provision provides for an appeal against the report of the Food Analyst before the Designated Officer, who can refer the matter to the Referral Food Laboratory for opinion."
