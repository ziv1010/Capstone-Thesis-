        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "Therefore, to avoid any untoward incident, the respondents are insisting the businessmen in surrounding areas to close their shops before 11.30 p.m.\n9."
