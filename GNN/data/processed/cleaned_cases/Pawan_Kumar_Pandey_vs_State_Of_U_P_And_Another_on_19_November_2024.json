        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "There needs to be a strict compliance of the mandate laid down in the judgment of this Court in Siddharth [Siddharth v. State of U.P., (2022) 1 SCC 676 :\n(2022) 1 SCC (Cri) 423].\n100.7."
