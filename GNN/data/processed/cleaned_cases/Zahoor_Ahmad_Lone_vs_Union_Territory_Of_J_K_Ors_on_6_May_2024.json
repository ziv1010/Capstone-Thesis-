        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "\n\"This is an area where the court has been most strict and scrupulous in ensuring observance with the requirements of the law, and even where a requirement of the law is breached in the slightest measure, the court has not hesitated to stri"
      },
      {
