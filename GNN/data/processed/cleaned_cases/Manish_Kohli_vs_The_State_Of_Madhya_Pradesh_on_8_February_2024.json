        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "Learned counsel in the light of the aforesaid judgments of the Supreme Court and the High Courts, has submitted that in the present case, food item was not unsafe."
      },
      {
        "annotation_id": "cf27b4cc9f3e4751ae9c03719c4d17c2_39",
