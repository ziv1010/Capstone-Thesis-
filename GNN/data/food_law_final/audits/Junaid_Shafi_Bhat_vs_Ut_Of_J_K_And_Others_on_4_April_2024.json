      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "This court is left wondering as to whether the preventive detention of the petitioner is based upon application of mind or avoidance of mind on the part of the authorities above referred when just by using the cloak that the petitioner's br"
