      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "He deposes about the injuries and treatment of claimant as follows:\n(i) Injuries to left upper limb and he was diagnosed to have open type IIIE comminuted fracture of both bones of left forearm with elbow disclocation with gross contaminati"
    },
