      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nThus PW2's evidence shows that claimant was treated as inpatient in the said hospital between 07.08.2012 to 05.10.2012 and again between 29.11.2012 to 30.11.2012."
