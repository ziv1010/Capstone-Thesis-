        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "Thus, again raising the similar ground is of no consequence."
    },
    {
      "annotation_id": "b013a8ce4b544671ba8291851d381cb2_107",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
