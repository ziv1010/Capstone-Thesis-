      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The burden is upon the petitioner to prove that, the accident occurred due to negligent driving of the driver of the offending Tractor & Trailer bearing Reg. No. KA- 07-T-0604 & KA-07-T-0605.\n12."
