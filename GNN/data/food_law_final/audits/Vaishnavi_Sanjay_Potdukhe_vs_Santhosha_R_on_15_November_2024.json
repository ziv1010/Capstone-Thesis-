      "annotation_id": "d9034b1d18414f43acd3b9cb2d086eb9_129",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
