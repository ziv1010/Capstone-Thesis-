      "annotation_id": "b44b15eb3f1d4035b58703f9abdc727c_144",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "By relying on the aforesaid decision,\n6% interest awarded to the petitioners in the present case on hand."
    },
    {
      "annotation_id": "9148f827e3b2463eb568e4688ddfbd5e_145",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
