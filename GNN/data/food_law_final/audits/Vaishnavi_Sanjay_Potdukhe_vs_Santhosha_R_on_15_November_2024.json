      "labels": [
        "RPC"
      ],
      "reasons": [
        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "In case of deposit of awarded amount, the petitioner is entitled to receive amount as mentioned above after expiry of period provided for filing an appeal."
