      "matched_phrases": [],
      "text_preview": "The petitioner has produced the discharge summary marked at Ex.P.11 wherein it is mentioned that the petitioner was admitted in the Manipal Hospital, Bangalore for 10 days."
    },
    {
      "annotation_id": "334ad43f73704b90be8a92dc9474c327_86",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "She has produced the wound certificate marked at Ex.P.7 wound certificate the doctor has opined that the injuries are grievous in nature."
    },
    {
      "annotation_id": "77fb9adfae75462ab4ce6ca3e81f34bd_87",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Hence, it is clear that during the above said period the petitioner suffered lot of pain and inconvenience."
    },
