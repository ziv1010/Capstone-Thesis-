      "annotation_id": "42cf54c278704ff09104073989c19620_128",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Total Rs. 6,70,696/-"
    },
