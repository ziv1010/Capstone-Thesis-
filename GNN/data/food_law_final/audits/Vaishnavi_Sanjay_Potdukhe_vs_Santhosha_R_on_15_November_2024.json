      "annotation_id": "ab31e61197e84a05b4698ce6f73d0ef2_127",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Future medical expenses Rs. 3,00,000/-\n "
    },
