      "annotation_id": "4335e3077db1452ebf8e0e38d0c1658f_125",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Nutritious food and Rs. 58,732/-\nattendant charges 5 Loss of future amenities and Rs. 1,00,000/-"
    },
