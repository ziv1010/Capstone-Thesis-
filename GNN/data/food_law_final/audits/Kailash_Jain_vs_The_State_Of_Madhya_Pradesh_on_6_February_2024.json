        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "However, looking to the submissions of the learned counsel for the appellant, this Court is of the view that the fine amount imposed against the appellant be reduced from Rs.1,00,000/- to Rs.50,000/-."
    },
    {
      "annotation_id": "58cd4e0e582f4589a9ecb59bfb0f64e4_39",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
