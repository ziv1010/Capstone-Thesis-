      "summary_section": "facts",
      "labels": [
        "RLC"
      ],
      "reasons": [
        "forbidden_labels:RLC"
      ],
      "matched_phrases": [],
      "text_preview": "\nd. That the Ld. Trial Court failed to appreciate that no independent witness was joined by the respondent while purchasing samples.\ne. That the Ld. Trial Court did not appreciate the material contradiction in the testimony of witnesses exa"
    },
