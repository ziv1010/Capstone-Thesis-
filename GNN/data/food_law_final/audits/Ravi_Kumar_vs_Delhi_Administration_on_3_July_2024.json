        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "However,\nw.e.f. 15.10.2007, new Food Safety and Standards Act, 2006 came into force in which, for similar offence, the punishment of only fine has been prescribed."
