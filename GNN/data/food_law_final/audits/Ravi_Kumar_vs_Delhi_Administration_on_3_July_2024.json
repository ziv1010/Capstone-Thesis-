      ],
      "reasons": [
        "forbidden_labels:RLC"
      ],
      "matched_phrases": [],
      "text_preview": "Vide order dated 20.10.2022, the Ld. ACMM has sentenced the appellant to undergo SI for six months alongwith fine of Rs. 1,000/- for the offence punishable under Section 16(1)(a) of the Act."
    },
    {
