      ],
      "matched_phrases": [],
      "text_preview": "It is argued that the PFA act has been recently amended which Digitally signed by Kiran Kiran Gupta Date:\n Gupta 2024.07.03  15:16:49  +0530"
    },
    {
      "annotation_id": "17f1daf5213646be8e79265ba865dac3_72",
