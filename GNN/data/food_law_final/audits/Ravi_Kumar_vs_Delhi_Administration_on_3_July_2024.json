      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Further, as per the report Ex.PW1/G, BR reading exceeded the prescribed maximum limit and the RM value was less than the prescribed minimum limit."
