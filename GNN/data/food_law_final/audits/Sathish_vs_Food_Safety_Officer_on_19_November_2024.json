    {
      "annotation_id": "3caf858f1ad6488e94d3397fdcca8875_19",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "It has been simply stated that on the first day of questioning, the accused admitted the guilt."
    },
    {
      "annotation_id": "ba126905acbc4e918f7db752e101aa69_20",
      "summary_section": "ANALYSIS",
      "labels": [
        "RATIO"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "It is also stated that when the matter was posted for pronouncing judgment, A1 and A2 remained absent."
    },
    {
      "annotation_id": "417a16d7d53e4e7f9a1c9cd95037e824_22",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
