      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "After completion of the investigation, the Investigating Officer has filed charge sheet against the driver of offending vehicle for the offences punishable U/s 279 and 338 of IPC.\n11."
