        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "As we know evidence in any Summary Proceedings, \"\nThe act of Negligence\" will have to be assessed on the basis of broad preponderance of probabilities and degree of proof required is not one of beyond reasonable doubt,\nas it is insisted in "
    },
