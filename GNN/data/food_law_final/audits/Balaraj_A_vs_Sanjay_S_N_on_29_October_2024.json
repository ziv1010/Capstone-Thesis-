      "annotation_id": "2b4b9808d8724be79ba7dcc79ed33885_114",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Hence,\npolicy was in force at the time of accident."
    },
    {
      "annotation_id": "7ed01fb8a9104980b4857574f1155a9f_115",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Hence, in view of above discussion, the respondent No.1 and 2 are jointly severally liable to pay the compensation to the petitioner."
