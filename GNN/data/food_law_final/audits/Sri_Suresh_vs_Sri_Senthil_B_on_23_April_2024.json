        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "I am in agreement with learned counsel for the appellant that the disability assessed by the Tribunal is on the lower side."
