      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "He opined disability to an extent of 64.14% to right lower limb and 32% to whole body."
    },
    {
      "annotation_id": "a7980853ca9d4f188e0e5148f716b7a1_45",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The Tribunal taken the whole body disability to be 18%."
