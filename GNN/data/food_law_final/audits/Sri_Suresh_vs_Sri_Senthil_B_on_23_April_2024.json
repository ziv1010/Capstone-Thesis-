      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nConsidering the disability suffered by the claimant, this Court deems it appropriate to add 40% of income towards future prospects while computing compensation under the head of loss of future earnings."
    },
    {
