      "annotation_id": "e8332a3a9b794bcfbec63d459ef1dcda_47",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "There is no contra material placed on record and cogent evidence adduced by the Insurance Company by producing second opinion or any other medical opinion to contradict the statement of the doctor/PW.2."
    },
    {
      "annotation_id": "b70b2f494d1b4081ab3501c0cd17138e_48",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Even one-third portion of particular limb disability is taken as a whole body disability, it would come to 21%."
