      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "10. I am in agreement with learned counsel for the claimant that considering the fact that there is a disability of 64% to the right lower limb and 32% to whole body, future prospects requires to be awarded in this case."
    },
    {
      "annotation_id": "01c8ceb9a049404791e61f4de952e2f0_53",
