      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The petitioner is prosecuted by the respondent/Food Safety Officer for committing the offence punishable under https://www.mhc.tn.gov.in/judis Crl.O.P.(MD)No.14628 of 2022 Sections 51, 59(1) and 58 of Food Safety and Standard Act, 2006."
