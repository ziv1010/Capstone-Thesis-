      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nFurther, the sample, which had been taken by the Food Safety Officer on 25.08.2020,\nwas sent to the lab for analysis, on 26.08.2020, which was received by the food analyst on 01.09.2020 and analysis was done from 02.09.2020 to 20.09.2020."
