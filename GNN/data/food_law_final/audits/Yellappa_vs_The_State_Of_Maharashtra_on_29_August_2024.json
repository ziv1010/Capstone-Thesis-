      "summary_section": "ANALYSIS",
      "labels": [
        "STA"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "An order is promulgated by a public servant lawfully empowered to promulgate such order, directing that a religious procession shall not pass down a certain street."
    },
    {
      "annotation_id": "302ab05706954702a975a99f5da2447e_12",
      "summary_section": "ANALYSIS",
      "labels": [
        "STA"
      ],
      "reasons": [
