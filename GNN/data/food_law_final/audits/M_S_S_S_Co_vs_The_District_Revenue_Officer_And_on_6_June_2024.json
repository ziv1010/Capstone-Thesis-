      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nhttps://www.mhc.tn.gov.in/judis 4.The learned Government Advocate however submitted that the authority resorted to the act of sealing only for the purpose of storing the seized goods."
    },
    {
