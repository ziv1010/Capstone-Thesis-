      "annotation_id": "5b4bb41025724890bf1cbac7ccc25bd9_54",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The feasible discharge point has already been identified earlier before executing the work."
    },
