      "text_preview": "Immediate steps shall be taken for repairing of the same and its renovation."
    },
    {
      "annotation_id": "3fc4c7b5a74e4b2fb1fc099f407a2738_82",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
