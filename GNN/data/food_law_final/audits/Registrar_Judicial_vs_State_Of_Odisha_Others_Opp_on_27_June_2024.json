      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "This I.A. has been filed by Mr. Anadi Charan Sarangi for certain direction to CMC Authorities."
