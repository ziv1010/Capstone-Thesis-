      "annotation_id": "5a46da4fc09d49a89c62de37ce54fc7b_85",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "As per the decision of the State Govt., the renovation and beautification of Taladanda Canal and widening of the roads are being carried out upto Biribati Tarini Temple from Jobra to facilitate communication to the proposed expanded campus "
    },
    {
      "annotation_id": "f5251f01b5604ee08f0b8b21d780a45d_87",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "\nThe authorities concerned shall take immediate steps for clearing the garbage, construction waste materials from that road by next date and produce the video footage and photographs."
    },
    {
      "annotation_id": "9c95f1b28d8944fe97fdf22655a6dd8c_88",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
