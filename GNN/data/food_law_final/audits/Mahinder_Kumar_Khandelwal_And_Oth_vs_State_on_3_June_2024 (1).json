        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "20. The fine amount shall be deposited by the appellants before the concerned court within a period of 15 days from today."
    },
    {
      "annotation_id": "cfb2495cc40148fc88a6c1738c10839c_123",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
