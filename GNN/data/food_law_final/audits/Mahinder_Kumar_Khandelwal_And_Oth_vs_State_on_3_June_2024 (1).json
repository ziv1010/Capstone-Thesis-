        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "In case of default of payment of fine, the appellant Digitally signed by Kiran Kiran Gupta Date:\n Gupta 2024.06.03  15:24:07  +0530 no. 1 shall undergo simple imprisonment for a period of 60 days."
    },
    {
      "annotation_id": "012a7162353d418fbc80bbe6901fbef8_124",
      "summary_section": "decision",
      "labels": [
