      "summary_section": "ANALYSIS",
      "labels": [
        "RATIO"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The appellants have failed to tender any explanation as to how the BR reading went so high in case of ghee sold by them."
    },
