        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "The Tribunal has awarded Rs.1,43,000/- towards medical expenses, treatment and transportation on the basis of the bills produced, which does not call for interference."
    },
