      ],
      "matched_phrases": [],
      "text_preview": "Before dwelling into the facts of the present case, it would be apt to discuss the legal standards required to be met by both sides."
    },
    {
      "annotation_id": "02af66ebf0a54f628694125165bdeca2_56",
