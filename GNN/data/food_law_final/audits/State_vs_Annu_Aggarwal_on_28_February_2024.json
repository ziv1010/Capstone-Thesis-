      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "In criminal law, the burden of proving the guilt of the accused exclusively lies on the prosecution which must prove the offences charged beyond reasonable doubt."
    },
    {
      "annotation_id": "a9d1ca2513b44686bee19de369f00000_57",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The benefit of doubt, if any, must go in favour of the accused."
    },
    {
      "annotation_id": "c2a3fc9d0c55462984c9c2e18e3a7cf8_58",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Digitally signed by NIDHI NIDHI SINGH SINGH"
    },
    {
      "annotation_id": "908218634daa4bc6abe491c1b53dc91a_60",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
