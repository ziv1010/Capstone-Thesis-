    {
      "annotation_id": "7a09f96ef94c491e88112af8989f6aef_62",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "There is nothing on record to show that the appellants have subsequently sent the representation to PFA department in this regard."
