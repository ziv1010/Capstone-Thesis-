      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "10. Now, coming to the other ground of the appellants that the Ld. Trial Court has failed to appreciate that the witnesses deposed before the court were against the facts and contradictory to each other."
