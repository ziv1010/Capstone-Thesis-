    {
      "annotation_id": "6b7450b7346f43c19040548aa015321a_63",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Neither any representation nor any complaint was filed by the appellants before PFA department or any other forum."
    },
    {
