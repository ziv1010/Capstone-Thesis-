      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "That the Ld. Trial Court failed to appreciate that there were public persons and police personnel available at the spot on 13.09.2005 but none of them were joined druing Digitally signed by Kiran Kiran Gupta Date:"
    },
    {
