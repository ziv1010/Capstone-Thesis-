      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "During cross-examination of PW-2, in fact it is suggested that accused did not prepare \"nakli ghee\" but \"asli ghee\".\""
    },
    {
      "annotation_id": "d2dba7e7f22c4390a72f27d14bffa331_66",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
