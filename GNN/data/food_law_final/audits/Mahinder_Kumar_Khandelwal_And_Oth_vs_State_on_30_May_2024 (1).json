    },
    {
      "annotation_id": "28ab80ccf0bf401181681400a3c9496b_60",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "As per record, it is evident that at the time of sampling, FI had prepared several documents at the spot including vendor's receipt Ex.PW1/A, Notice in Form-VI Ex.PW1/B and panchnama Ex.PW1/C."
    },
    {
      "annotation_id": "1d0c350d93764b55be9bea05a3b790f2_61",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "All these documents bear the signature of appellant No. 1 / vendor and there is no endorsement of protest mentioned on these documents claiming that the food article was not ghee."
