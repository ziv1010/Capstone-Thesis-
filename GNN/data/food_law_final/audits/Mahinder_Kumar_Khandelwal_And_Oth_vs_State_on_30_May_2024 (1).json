      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Further, the submission of Ld. Counsel for appellant is contrary to the questions put during cross-examination of PW-1 and PW-2."
