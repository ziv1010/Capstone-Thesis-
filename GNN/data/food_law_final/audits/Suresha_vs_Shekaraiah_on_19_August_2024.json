      "annotation_id": "c32ebdec4ce1497482b246129dd8b1bc_117",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
