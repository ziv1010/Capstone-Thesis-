      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "He has sustained grievous and simple injuries and as per consideration of this Tribunal, he is suffering from 17% functional disability."
    },
