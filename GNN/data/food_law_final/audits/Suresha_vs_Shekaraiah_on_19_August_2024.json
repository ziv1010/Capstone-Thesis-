      "annotation_id": "6fe0f4b075b04fe399e67e610ab348f1_112",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Therefore, as on the date of the accident the Petitioner's age is 49 years."
