      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nTherefore, considering the age and nature of injuries that the Petitioner has suffered,\nSuresha vs Shekaraiah on 19 August, 2024 Indian Kanoon - http://indiankanoon.org/doc/37445310/\n6"
