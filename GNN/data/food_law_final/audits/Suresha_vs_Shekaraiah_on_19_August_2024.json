      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\n (v) LOSS OF FUTURE AMENITIES AND  HAPPINESS:-\nThe Petitioner was aged about 49 years at the time of accident."
