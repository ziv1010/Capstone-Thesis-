      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nOn perusal of Ex.P.7/Notarized copy of the petitioner, the petitioner's birth year is mentioned as 1973 and the accident SCCH - 25 14 MVC No. 7019/2022 occurred on 23.09.2022."
    },
    {
      "annotation_id": "89c4c762201844ff887f2bb07a0376cb_111",
