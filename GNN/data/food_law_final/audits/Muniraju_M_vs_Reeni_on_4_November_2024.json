      "annotation_id": "1a44d7d20a93453fa5ffd1227739ae9c_174",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "However, there is no document to substantiate the contention of the plaintiff that during 1981-82 on wards his father Muniyappa was rendering service as Watchman and after his death the plaintiff has continued to render service in the schoo"
    },
    {
      "annotation_id": "f3100c96259942f8a36661fb9b142cd5_175",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "PW.1 explicitly admitted there are no documents to show that he and his father was appointed by the Government or School authorities to render service as Watchman in the School."
