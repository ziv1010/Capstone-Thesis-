      "annotation_id": "5833e6df095d415a8f6505d75bb50a27_183",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Earlier to that Villagers have no voice in respect of school premises."
    },
    {
      "annotation_id": "7f3889c3f6984fe58bba481c4faa3a45_184",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The plaintiff has not produced any document to show that from 1981-82 on wards his father was rendering service in the school and stayed in the suit schedule premises."
    },
