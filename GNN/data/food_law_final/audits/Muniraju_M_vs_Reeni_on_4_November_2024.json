      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "He admits from 18-12-2003 his wife Jayalakshmamma was transferred to OS.No.\n2431/2024 Saneguruvanahalli Primary School."
