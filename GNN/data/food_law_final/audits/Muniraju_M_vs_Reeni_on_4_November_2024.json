      "annotation_id": "b883facf7eec4dcf806f190f555f4ce3_166",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "In para 18, PW.1 deposed that his son is working as Car Washer and daughter is staying with her husband house."
