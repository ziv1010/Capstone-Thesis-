      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "16. On the other hand, DW.1 - Head Master of the Primary Model School, Saneguruvanahalli has been cross-examined by the plaintiff counsel."
