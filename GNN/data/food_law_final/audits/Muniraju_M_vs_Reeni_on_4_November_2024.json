      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "That as on the date of joining school by her she came to know that plaintiff and his wife occupied one of the school premises room."
    },
