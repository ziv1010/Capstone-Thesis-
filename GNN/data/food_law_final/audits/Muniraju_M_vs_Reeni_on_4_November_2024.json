      "annotation_id": "12491a152b3d45c2b0faaec88680ee0d_185",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "There is no material on record that the plaintiff and his wife are staying in the suit schedule premises from 1983 on wards."
    },
    {
      "annotation_id": "844838ac42954917bd8fabd225efa6c0_186",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Admittedly, the plaintiff's wife Jayalakshmamma is working as Aya in the Government Primary School, Saneguruvanahalli."
    },
    {
      "annotation_id": "43380f1842e54280803df46404dcc336_187",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "OS.No. 2431/2024 17(b)."
    },
    {
      "annotation_id": "9c9c27987757469689cddf4612946a9a_188",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "PW.1 deposed that his wife has transferred to said school and working from 18-12-2003."
    },
    {
      "annotation_id": "a7e6ef88108f4bcaa6696d47044bc4c1_189",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The plaintiff has not placed any material that he is staying in the suit schedule premises from 1982-83."
    },
    {
      "annotation_id": "dbba133b40b04bf5992a3531b898078a_190",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The gas bills and bank pass book are recent documents."
    },
