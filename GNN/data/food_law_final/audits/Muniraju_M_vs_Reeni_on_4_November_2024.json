      "labels": [
        "RPC"
      ],
      "reasons": [
        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "The defendant school has issued notice to vacate the premises."
    },
    {
      "annotation_id": "37a7ccf6a1d546a09ca3f4ff0a8088c5_218",
      "summary_section": "ANALYSIS",
      "labels": [
        "RATIO"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "If the suit is not decreed, the defendants would be put to irreparable loss and injury, there is every chance of lapse of huge amount sanctioned for construction of 8 class rooms."
    },
    {
