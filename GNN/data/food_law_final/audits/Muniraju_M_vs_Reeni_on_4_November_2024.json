      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "After appreciating the evidence on record, it is not in dispute the plaintiff and his wife Jayalakshmamma are staying in the suit schedule premises."
    },
