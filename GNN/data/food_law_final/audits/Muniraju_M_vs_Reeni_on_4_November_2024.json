      "annotation_id": "84494fc571124b6795067bc4fdf22410_177",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "However, to show that there were illegal activities were going on in the school premises, there is no piece of paper."
    },
