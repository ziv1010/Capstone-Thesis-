      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "He admits the notice issued by the school to his wife to vacate the premises for construction of class rooms under Viveka Shala scheme."
