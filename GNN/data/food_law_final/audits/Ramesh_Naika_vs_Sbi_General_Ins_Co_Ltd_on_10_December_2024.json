      "annotation_id": "b9b1871cce2b46c4a4cad56a2376a0c2_127",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nAfter the accident, the Petitioner was treated in the above said hospitals, admitted as an inpatient and discharged with advise."
