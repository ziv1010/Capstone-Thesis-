      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "\n16. The Petitioner is entitled to compensation under the following heads:\n1. Pain and suffering Rs.60,000/-\n2. Medical Expenses Rs.2,928/-\n3. Loss of income during laid up Rs.15,500/-\nperiod 4. Loss of Future Income Rs.2,51,546/-\n"
