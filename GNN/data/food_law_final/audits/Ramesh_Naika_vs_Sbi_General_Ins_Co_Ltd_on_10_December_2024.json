      "annotation_id": "9afebc3726424e40bf7a3879d4cc5074_126",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\n(vi) ATTENDANT, CONVEYANCE, FOOD AND NOURISHMENT CHARGES:"
    },
