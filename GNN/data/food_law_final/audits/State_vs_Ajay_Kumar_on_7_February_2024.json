        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "Accordingly, accused Ajay Kumar S/o Chand Ram is acquitted for offence under section 279/304 A IPC."
    }
