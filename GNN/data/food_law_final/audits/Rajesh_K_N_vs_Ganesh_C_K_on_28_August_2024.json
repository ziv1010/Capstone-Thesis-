      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\niii) LOSS OF INCOME DURING LAID UP PERIOD:-\nAs mentioned above the petitioner has sustained grievous and simple injuries."
    },
    {
      "annotation_id": "442605586e084352b0ef09d4b0b1369a_96",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The petitioner has taken treatment for almost 1 month at Smt. Jayadevi Memorial Hospital which can be made out from Exs.P.9 & 14 Discharge summaries."
    },
