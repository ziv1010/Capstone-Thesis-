      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\niv) LOSS OF FUTURE INCOME:-\nOn perusal of Exs.P.13, 17 & 18/Aadhar Card and DL, the date of birth of the petitioner is 20.06.1971 and the date of accident is 07.02.2022."
    },
