      "annotation_id": "8c7a198f558f4819a2ec6dbd2f1e1158_103",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "As such the petitioner is entitled to Rs.4,09,200/-."
