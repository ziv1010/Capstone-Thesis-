      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "As per the dictum laid down in Sarala Verma's case, the appropriate multiplier applicable to his age is 11."
