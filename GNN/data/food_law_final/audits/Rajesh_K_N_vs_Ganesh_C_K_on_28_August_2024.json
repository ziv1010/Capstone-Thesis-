      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "(Rs.15,500/- x 12 x 20% x 11 = Rs.4,09,200/-\n)."
