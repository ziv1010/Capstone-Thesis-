      },
      {
        "annotation_id": "cfec9a1200634933ab988502808d4c1d_44",
        "summary_section": "decision",
        "labels": [
          "RPC"
        ],
        "reasons": [
          "forbidden_section:decision",
          "forbidden_labels:RPC",
          "suspicious_label:rpc"
        ],
        "matched_phrases": [],
        "text_preview": "The delay is condoned."
      },
      {
        "annotation_id": "071ea4ab4a0c48f7a4d351e7da3b8782_45",
        "summary_section": "decision",
        "labels": [
          "RPC"
        ],
