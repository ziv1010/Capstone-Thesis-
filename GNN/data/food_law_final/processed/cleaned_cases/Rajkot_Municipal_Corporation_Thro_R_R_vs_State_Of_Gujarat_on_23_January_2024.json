        "matched_phrases": [],
        "text_preview": "\n(3) When a person is charged with an offence, he may be convicted of an attempt to commit such offence although the attempt is not separately charged."
      },
      {
        "annotation_id": "ae9f60d9c20d4883ac69c2eba2f5f268_14",
        "summary_section": "ANALYSIS",
