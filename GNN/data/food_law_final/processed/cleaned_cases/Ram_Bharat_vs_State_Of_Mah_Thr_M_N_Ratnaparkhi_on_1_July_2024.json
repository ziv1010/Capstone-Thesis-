          "forbidden_labels:RPC",
          "suspicious_label:rpc"
        ],
        "matched_phrases": [],
        "text_preview": "It will cause prejudice to the complainant, who ultimately is prosecuting the case of the two workers, who have succumbed to the injuries."
      },
      {
        "annotation_id": "09c6b41ec94d45b4bb241b9f53c3dd72_67",
        "summary_section": "decision",
        "labels": [
          "RPC"
        ],
        "reasons": [
