        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "The owner of a cinema hall is entitled to determine whether she will set up or engage an entity for setting up counters for the sale of food and beverages and to regulate the terms on which such sale should take place."
      },
      {
