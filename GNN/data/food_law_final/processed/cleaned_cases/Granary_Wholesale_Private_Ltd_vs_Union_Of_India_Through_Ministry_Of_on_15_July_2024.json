        ],
        "reasons": [
          "forbidden_section:decision",
          "forbidden_labels:RPC",
          "suspicious_label:rpc"
        ],
        "matched_phrases": [],
        "text_preview": "\n4. Today when the matter is called out, Mr. Misra, appears on behalf of Respondent No.1 and waives notice."
      },
      {
        "annotation_id": "b0e8906566024cf49aa2d8f5221bf8b1_22",
        "summary_section": "decision",
