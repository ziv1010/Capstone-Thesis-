        "matched_phrases": [],
        "text_preview": "As far as Respondent Nos. 2 and 3 are concerned, it appears that they have been served through e-mail on 12th July, 2024 and 13th July, 2024."
      },
      {
        "annotation_id": "2f302d0858474594aa09383f9f09510f_23",
