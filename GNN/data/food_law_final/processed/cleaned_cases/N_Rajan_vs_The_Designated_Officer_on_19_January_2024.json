        ],
        "matched_phrases": [],
        "text_preview": "\n(3) The Designated Officer shall not apply for an emergency prohibition order unless,\nat least one day before the date of the application, he has served notice on the food business operator of the business of his intention to apply for the"
      },
      {
        "annotation_id": "c4c37ecc24f8403591ce3c645f14f3f8_15",
