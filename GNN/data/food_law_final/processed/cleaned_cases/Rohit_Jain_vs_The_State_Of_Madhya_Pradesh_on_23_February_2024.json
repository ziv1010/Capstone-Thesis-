        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "Further, the offence has also been registered under Sections 420 and 272 of IPC."
      },
      {
        "annotation_id": "b2b23bf49ca14b13ab7ad6b1c7319e6d_16",
        "summary_section": "ANALYSIS",
        "labels": [
