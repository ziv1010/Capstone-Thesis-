        "matched_phrases": [],
        "text_preview": "Medical expenses Rs. 2,67,626/-\n Food and nourishment Rs. 50,000/-\n "
      },
      {
        "annotation_id": "025554695ebf4e7fa53cc1df87ae2454_61",
        "summary_section": "decision",
        "labels": [
          "RPC"
        ],
        "reasons": [
