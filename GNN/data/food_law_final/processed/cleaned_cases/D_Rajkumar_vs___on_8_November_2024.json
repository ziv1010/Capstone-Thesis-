          "forbidden_section:decision",
          "forbidden_labels:RPC",
          "suspicious_label:rpc"
        ],
        "matched_phrases": [],
        "text_preview": "vii. The application for transit permit should reach this office before 15 days before the date of function/festivals."
      },
      {
