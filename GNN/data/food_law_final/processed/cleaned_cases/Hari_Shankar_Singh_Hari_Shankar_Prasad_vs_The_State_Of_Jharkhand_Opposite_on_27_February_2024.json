        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "\n(3) The Designated Officer after scrutiny of the report of Food Analyst shall decide as to whether the contravention is punishable with imprisonment or fine only and in the case of contravention punishable with imprisonment, he shall send "
      },
      {
        "annotation_id": "fd8674269f4e4f82814c4464b95d3f78_23",
