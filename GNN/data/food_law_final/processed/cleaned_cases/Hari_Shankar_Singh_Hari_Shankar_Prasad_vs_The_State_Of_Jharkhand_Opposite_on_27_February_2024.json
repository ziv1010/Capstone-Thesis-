        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "The provision of Section 42 of the Act, 2006 which lays down the procedure for launching prosecution for any offence under said Act is quoted herein below:\n\"42. Procedure for launching prosecution.-"
      },
      {
        "annotation_id": "78ad730536904b08b6caf0dd9e77c509_20",
