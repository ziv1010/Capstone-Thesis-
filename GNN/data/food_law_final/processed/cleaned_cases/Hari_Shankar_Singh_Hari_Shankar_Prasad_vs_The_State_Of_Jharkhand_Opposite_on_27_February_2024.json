        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "\n(2) The Food Analyst after receiving the sample from the Food Safety Officer shall analyse the sample and send the analysis report mentioning method of sampling and analysis within fourteen days to Designated Officer with a copy to Commiss"
      },
      {
        "annotation_id": "da59763aec124ffb8888a95548f5529e_22",
        "summary_section": "ANALYSIS",
        "labels": [
