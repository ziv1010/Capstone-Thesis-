        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "(1) The Food Safety Officer shall be responsible for inspection of food business, drawing samples and sending them to Food Analyst for analysis."
      },
      {
        "annotation_id": "e4f0a5b9e7754476a225bb5f592693a4_21",
        "summary_section": "ANALYSIS",
        "labels": [
