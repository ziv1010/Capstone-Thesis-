        "summary_section": "ANALYSIS",
        "labels": [
          "PRE_RELIED"
        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "The Allahabad High Court in Harishchandra v. State of U.P (2020 AHC 8080) had held that before passing such an order,\n"
