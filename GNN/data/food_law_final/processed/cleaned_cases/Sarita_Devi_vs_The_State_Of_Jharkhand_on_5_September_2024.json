      {
        "annotation_id": "22c295c333f241608ad7225f977ebca3_20",
        "summary_section": "ANALYSIS",
        "labels": [
          "ANALYSIS"
        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "submits that by virtue of Section 89 of the Food Safety and Standards Act, 2006, Section 59 of the said Act will override the provisions of Sections 272 and 273 of the IPC, therefore,\nthere will not be any question of simultaneous prosecuti"
      },
      {
        "annotation_id": "7262ad044a0d490db2e007d92422b5e5_21",
        "summary_section": "ANALYSIS",
        "labels": [
