        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "\n7. Having heard the submissions made at the Bar and after going through the materials available in the record, it is pertinent to mention here that the essential ingredients for the offence punishable under Section 414 of the Indian Penal "
      },
      {
        "annotation_id": "dd9fb3c1281942a0a60a467cad900670_23",
        "summary_section": "ANALYSIS",
        "labels": [
