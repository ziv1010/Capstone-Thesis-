        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "The Government Food Analysis Laboratory, Chennai sent its report on 27.09.2018 declaring that the product is unsafe and substandard."
