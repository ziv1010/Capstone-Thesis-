        "summary_section": "ANALYSIS",
        "labels": [
          "ANALYSIS"
        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "The said application was also rejected by the Commissioner of Food Safety and Drug Administration in his proceedings dated 11.06.2019 on the ground that the criminal proceedings already initiated cannot be withdrawn and therefore, the petit"
