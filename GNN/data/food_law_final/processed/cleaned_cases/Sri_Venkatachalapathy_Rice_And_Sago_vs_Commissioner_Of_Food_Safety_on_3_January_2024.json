        "summary_section": "ANALYSIS",
        "labels": [
          "ANALYSIS"
        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "The product was Tapioca Starch Milk and thereafter, they have sent it for analysis."
