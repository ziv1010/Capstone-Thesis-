        "annotation_id": "deac7ec79a4545fb8e59026475cbfb76_19",
        "summary_section": "ANALYSIS",
        "labels": [
          "ANALYSIS"
        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "A similar approach can very well be adopted in this case also."
