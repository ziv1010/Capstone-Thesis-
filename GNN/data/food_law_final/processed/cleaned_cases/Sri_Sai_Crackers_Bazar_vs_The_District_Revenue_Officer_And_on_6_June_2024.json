      {
        "annotation_id": "2d50288e823f44de853f76a6166f0b23_17",
        "summary_section": "ANALYSIS",
        "labels": [
          "ANALYSIS"
        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "But that will not validate an action that is otherwise illegal and without jurisdiction."
