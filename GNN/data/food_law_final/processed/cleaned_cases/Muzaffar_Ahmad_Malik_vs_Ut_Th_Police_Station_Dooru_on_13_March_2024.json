        "summary_section": "ANALYSIS",
        "labels": [
          "RATIO"
        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "We asked learned counsel for the Union Territory to refer to 161 statement of those witnesses and inform the Court whether the said witnesses have stated anything against the appellant that could raise a prima facie opinion against him."
      },
      {
        "annotation_id": "98c9a22ef36a4172814ea300d4ed7ac0_58",
        "summary_section": "ANALYSIS",
        "labels": [
          "RATIO"
        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "After having gone through the records, no such submissions have been forthcoming from the learned counsel for the respondent-UT.\n14."
      },
      {
