        ],
        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "This is evident from the penultimate paragraph of the order, wherein, it is specifically mentioned that the Commissioner of Food Safety is empowered under Section 30(2)(a) of the FSS Act to prohibit in the interests of public."
      },
      {
        "annotation_id": "dec4be9830f54c89aabbef5d3a2d51ec_19",
