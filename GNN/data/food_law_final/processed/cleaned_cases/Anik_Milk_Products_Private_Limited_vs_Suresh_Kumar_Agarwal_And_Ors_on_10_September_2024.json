        "reasons": [
          "forbidden_section:ANALYSIS"
        ],
        "matched_phrases": [],
        "text_preview": "It is the specific case of the plaintiff that on the last week of August, 2024 the plaintiff came to know that the defendants are selling the deceptively similar product i.e. Anik Ghee of the plaintiff."
      },
      {
        "annotation_id": "d1cc128de50b4d84bb31534d96b78aa8_62",
