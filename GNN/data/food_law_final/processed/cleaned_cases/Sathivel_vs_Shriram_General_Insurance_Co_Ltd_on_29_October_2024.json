        ],
        "matched_phrases": [],
        "text_preview": "\nNC: 2024:KHC:43753 Sathivel vs Shriram General Insurance Co Ltd on 29 October, 2024 Indian Kanoon - http://indiankanoon.org/doc/65579309/"
      },
      {
        "annotation_id": "281926fdf35c4abaa07869ca6c4b2115_31",
