        ],
        "reasons": [
          "forbidden_labels:RLC"
        ],
        "matched_phrases": [],
        "text_preview": "The Tribunal has awarded a sum of Rs.20,000/- towards 'pain and suffering' and Rs.20,000/-\ntowards 'loss of amenities'."
      },
      {
        "annotation_id": "5f99e5afa99e4579b5e4d7f34572baef_33",
        "summary_section": "facts",
        "labels": [
          "RLC"
        ],
        "reasons": [
          "forbidden_labels:RLC"
        ],
        "matched_phrases": [],
        "text_preview": "Having regard to the fracture to a major bone, it would be appropriate to enhance the said amounts to Rs.50,000/- under each heads."
      },
