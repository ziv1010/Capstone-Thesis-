        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "All connected applications, if any, stand dismissed."
    },
    {
      "annotation_id": "baeab35ff012416c8a4df8d538295543_34",
      "summary_section": "decision",
      "labels": [
        "RPC"
