      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "7. Future Medical Expenses Rs.30,000/-\nTOTAL Rs.6,19,937/-\n"
