      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The respondent No.2 has contended that the driver of the offending vehicle did not have a valid DL at the time of accident and the insured has committed breach of contract of insurance."
    },
