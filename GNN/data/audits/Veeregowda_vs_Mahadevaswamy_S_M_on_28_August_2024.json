      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "(Rs.15,000/- x 12 x 13% x 14 = Rs.3,27,600/- ).\n (v) LOSS OF FUTURE AMENITIES AND  HAPPINESS:-"
    },
    {
