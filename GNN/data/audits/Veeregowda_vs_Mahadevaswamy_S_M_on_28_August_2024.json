        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "If it is rounded off it comes around Rs.6,20,000/- and same is awarded under different heads to the Petitioner."
