      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The Respondents being the Owner and the insurer of the offending vehicle are jointly and severally liable to pay compensation to the Petitioner."
    },
    {
      "annotation_id": "dddc000cfa1b40efab4afd363576663f_131",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "However, as the policy existed as on the date of accident, the respondent No.2/insurer has to indemnify the respondent No.1/insured and to pay compensation awarded to the petitioner."
    },
