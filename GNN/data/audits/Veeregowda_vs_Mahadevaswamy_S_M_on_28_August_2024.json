      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Therefore, the respondents have failed to prove their defence."
