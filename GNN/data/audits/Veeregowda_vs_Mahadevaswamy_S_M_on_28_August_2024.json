      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "During the cross examination of PW.2 he has stated that in the police intimation and MLC register extract there is no mention of which vehicle caused the accident."
    },
    {
