      "annotation_id": "66b5228bf8634b5eb7783481b078b340_132",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The Petitioner has claimed for a sum of Rs.15,00,000/- but he is entitled only for a sum of Rs.6,20,000/- with interest @ 6% per annum Veeregowda vs Mahadevaswamy S.M on 28 August, 2024 Indian Kanoon - http://indiankanoon.org/doc/154966968/"
    },
