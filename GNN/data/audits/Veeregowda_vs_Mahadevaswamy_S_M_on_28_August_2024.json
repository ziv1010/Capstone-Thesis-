      "annotation_id": "9b48760c1fa74379a60bbe16716f20bf_116",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "18. The Petitioner is entitled to compensation under the following heads:\n1. Pain & suffering Rs.70,000/-\n2. Medical expenses Rs.1,37,337/-\n3. Loss of income during laid up Rs.15,000/- period 4. Loss of future income Rs.3,27,600/-\n"
