      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "12. The FIR was registered on 15.06.2021 at about 9.00am on the complaint of petitioner given by his wife after Four days at Exs.P.1 & 2."
