      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "On the day of complaint, the police have seized the offending vehicle, gave notice u/Sec.133 of MV Act and also received reply."
    },
    {
