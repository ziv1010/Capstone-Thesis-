      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "As a further consequence, the respondents are directed not to interfere with the lawful day-to-day business activities of the writ petitioners with regard to Tobacco products."
    },
