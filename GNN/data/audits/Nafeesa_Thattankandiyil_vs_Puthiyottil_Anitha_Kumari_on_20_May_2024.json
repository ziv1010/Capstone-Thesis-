      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "It could sees a name board of \"\nK.M.Traders, Market Road, Vatakara, on the top of the shutter of the said room."
    },
    {
      "annotation_id": "bda92e427af54771bfd026c2c3cb4982_78",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Since the sticker of the municipality showing building number is covered with paint,\nNafeesa Thattankandiyil vs Puthiyottil Anitha Kumari on 20 May, 2024 Indian Kanoon - http://indiankanoon.org/doc/127166204/\n5"
    },
    {
      "annotation_id": "ff49841620e54db79b8265bc50d34cb3_79",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
