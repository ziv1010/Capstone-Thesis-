    },
    {
      "annotation_id": "d367639f0cd14b29a2e1ba24df9ea37b_80",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The 2 nd respondent informed that, the number of the said room is 20/377."
    },
    {
      "annotation_id": "3cde888fed434628b189ccc1177dc26d_81",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The 2nd respondent was present at the cash counter,\nsituates in the said varanda of the said room."
    },
    {
      "annotation_id": "4d0f3b3f1b9b4a7f81adc482ece6259a_82",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "When it was asked, the 2nd respondent had shown the license."
    },
    {
      "annotation_id": "0774ee8296e7414c865a37205b96e81e_83",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "That stands in the name of 2 nd respondent."
    },
    {
      "annotation_id": "323b3ae8ec624cb9b14b0b4cf7a3cb8e_84",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "In the license,\nthe name of the concern, is shown as 'Shan Traders."
    },
    {
      "annotation_id": "16a7091ace8a47fbac6c59a8b70c9d62_85",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "The tax receipt for building number also is shown."
    },
    {
      "annotation_id": "47c348b354d24d628249a32f830dac56_86",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "In the tax receipt, building number is shown as 20/377 and further the new Number also is shown as 9/2625."
    },
    {
      "annotation_id": "faaedcb0710943fd98a648e2af19825e_87",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "That is a document RCREV. NO. 25 OF 2022 in the name of a 2nd respondent."
    },
    {
      "annotation_id": "6636f34686f04c9e8a9e8745d7f2337e_88",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "5. The license for the room number 20/377 stands in the name R2."
    },
