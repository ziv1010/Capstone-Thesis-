      "labels": [
        "RATIO"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nFor the reason aforementioned, we find that the judgment of the appellate authority do not suffer from any illegality and perversity."
    },
    {
