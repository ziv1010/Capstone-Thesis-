      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "All the documents were shown to me, at the cash counter, situates at veranda of room number 20/377 belongs to R2.\n7."
    },
