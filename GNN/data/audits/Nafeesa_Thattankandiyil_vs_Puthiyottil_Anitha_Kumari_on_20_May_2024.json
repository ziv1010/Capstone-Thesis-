      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nThe registration certificate is by Commissioner of Food and Safety shown tome,with registration number 213182340001110 is allowed to grocery retailer."
