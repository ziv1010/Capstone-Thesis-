        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "In all, the claimant would be entitled to Rs.30,000/- (Rs.20,000/- + Rs.10,000/-) under this head."
