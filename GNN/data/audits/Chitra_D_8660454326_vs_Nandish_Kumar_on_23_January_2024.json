        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "\nFurther, respondent is hereby directed to pay an amount of Rs.10,000/-per month (Rupees ten thousand only) to the petitioner's minor child by name Poorvi towards maintenance from the date of petition till her marriage.\nCrl.Misc.129/2019"
    },
    {
      "annotation_id": "e90e56854171445a853016b4b56192ca_159",
      "summary_section": "decision",
      "labels": [
        "RPC"
      ],
      "reasons": [
