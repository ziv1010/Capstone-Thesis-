      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "It may not be conclusive, for the judgment of acquittal may be ex facie wrong, the likelihood of desperate reprisal, if enlarged,\nmay be a deterrent and his own safety may be more in prison than in the vengeful village where feuds have prov"
    },
