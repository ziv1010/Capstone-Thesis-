    },
    {
      "annotation_id": "dcd057c38a7b41e0b0b928e0708d1d3b_27",
      "summary_section": "facts",
      "labels": [
        "RLC"
      ],
      "reasons": [
        "forbidden_labels:RLC"
      ],
      "matched_phrases": [],
      "text_preview": " for the offence under Section 364(A)/34 of the IPC."
    },
