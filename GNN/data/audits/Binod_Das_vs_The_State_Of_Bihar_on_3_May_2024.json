    },
    {
      "annotation_id": "9ebc629179af464187d27548727d3744_24",
      "summary_section": "facts",
      "labels": [
        "RLC"
      ],
      "reasons": [
        "forbidden_labels:RLC"
      ],
      "matched_phrases": [],
