      "annotation_id": "7b6275e425e94b23bbae4dc79905b819_25",
      "summary_section": "facts",
      "labels": [
        "RLC"
      ],
      "reasons": [
        "forbidden_labels:RLC"
      ],
      "matched_phrases": [],
