    {
      "annotation_id": "4708cc986c354c028928f77555b0a7aa_9",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "My attention has not been drawn to any such statutory power."
    },
    {
      "annotation_id": "b681e051fe684a0c88586c2f10d62333_10",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nhttps://www.mhc.tn.gov.in/judis 4.The learned Government Advocate however submitted that the authority resorted to the act of sealing only for the purpose of storing the seized goods."
    },
    {
      "annotation_id": "305e258aec494d97925aeb4dc4525e9b_11",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
