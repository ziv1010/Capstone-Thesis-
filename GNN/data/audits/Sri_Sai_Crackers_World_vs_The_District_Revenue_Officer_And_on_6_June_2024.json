        "forbidden_section:decision",
        "forbidden_labels:RPC",
        "suspicious_label:rpc"
      ],
      "matched_phrases": [],
      "text_preview": "An inventory can be taken and the petitioner can be made responsible for the safe and proper custody of the seized crackers."
    },
    {
