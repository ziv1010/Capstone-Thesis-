      "annotation_id": "e5e8093102cd4882812c8add51322a1a_116",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Keeping in mind the totality of the facts and the circumstances, this Court is inclined to invoke the discretionary power vested in the court by virtue of section 156(3) Cr.P.C. as allegations regarding certain cognizable offences have been"
    },
    {
      "annotation_id": "e63d890129cf46a98d60eab3825494e2_117",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "\nAccordingly the SHO, PS Amar Colony is directed to register an FIR in this case under appropriate sections and submit a compliance report in this regard."
    },
    {
      "annotation_id": "5f428f2771eb42c298e24747cfae62b8_118",
      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
