      "summary_section": "ANALYSIS",
      "labels": [
        "ANALYSIS"
      ],
      "reasons": [
        "forbidden_section:ANALYSIS"
      ],
      "matched_phrases": [],
      "text_preview": "Therefore,\nconsidering the age and nature of injuries that the Petitioner has suffered, a sum of Rs.20,000/- is awarded under this head."
