    {
      "sentence_id": 7,
      "text": "Heard learned counsels for the parties.",
      "rhetorical_role": "NONE",
      "start": 343,
      "end": 382,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 8,
      "text": "It appears from the report in the form of affidavit  submitted on behalf of the State respondents that the notice under Section 12(2) of the Land Acquisition Act, 1894 was issued upon the awardees including the petitioner, but there is no document to suggest that the notice was served upon the petitioner though the State states that the petitioner refused to accept the notice.",
      "rhetorical_role": "PREAMBLE",
      "start": 383,
      "end": 764,
      "entities": [
        {
          "text": "Section 12(2)",
          "label": "PROVISION",
          "start": 505,
          "end": 518
        },
        {
          "text": "Land Acquisition Act, 1894",
          "label": "STATUTE",
          "start": 526,
          "end": 552
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "It appears that the other awardees have been paid compensation but not the petitioner.",
      "rhetorical_role": "PREAMBLE",
      "start": 765,
      "end": 851,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "It cannot be ascertained whether the unpaid compensation has been deposited by the State in accordance with law.",
      "rhetorical_role": "PREAMBLE",
      "start": 852,
      "end": 965,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 11,
      "text": "Learned counsel for the State seeks to take instructions in this regard.",
      "rhetorical_role": "NONE",
      "start": 966,
      "end": 1039,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 12,
      "text": "Let the matter appear under the same heading on 9th October, 2023.",
