    {
      "sentence_id": 10,
      "text": "The learned counsel appearing for the respondents submits that issuance of notice under Section 12(2) of the Land Acquisition Act, 1894 implies that compensation has been tendered to the land owner whose land is acquired.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 707,
      "end": 928,
      "entities": [
        {
          "text": "Section 12(2)",
