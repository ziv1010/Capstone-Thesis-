      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.36508113145828247
    },
    {
      "sentence_id": 11,
      "text": "There is no averment in the counter affidavit to the effect that any compensation was tendered to the recorded land owner or the petitioner.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 929,
      "end": 1069,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.28974539041519165
    },
    {
      "sentence_id": 12,
      "text": "2. The counter affidavits do not specifically state that the amounts deposited by the beneficiary also include the compensation for the subject land.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1070,
      "end": 1220,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2435036152601242
    },
