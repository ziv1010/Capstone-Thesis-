      ],
      "in_summary": false
    },
    {
      "sentence_id": 8,
      "text": "Learned counsel for the petitioners submits that Notification under Section 4 Sub section (1) of the J&K Land Acquisition Act, for the subject land had been issued by the Collector Land Acquisition (SDM), Gool on 04.06.2016, however, the acquisition proceedings have not been concluded so far,\nas such, the petitioners are aggrieved that their land having been used, without paying any compensation.",
      "rhetorical_role": "NONE",
      "start": 915,
      "end": 1315,
