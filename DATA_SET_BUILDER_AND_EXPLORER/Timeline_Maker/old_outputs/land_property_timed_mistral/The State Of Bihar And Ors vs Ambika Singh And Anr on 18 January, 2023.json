        },
        {
          "text": "State of Bihar",
          "label": "PETITIONER",
          "start": 833,
          "end": 847
        },
        {
          "text": "B.I.A.D.A.",
          "label": "ORG",
          "start": 856,
          "end": 866
        },
        {
          "text": "F.A.\nNo. 26 of 2017",
          "label": "CASE_NUMBER",
          "start": 1037,
          "end": 1056
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 20,
      "text": "The common question in all the First Appeals is as to whether delay beyond a period of 120 days as prescribed under Section 74 of the Right to Fair Compensation and Transparency in Land Acquisition, Rehabilitation & Resettlement Act, 2013 for filing appeal is condonable or not.",
      "rhetorical_role": "PREAMBLE",
      "start": 1058,
      "end": 1336,
      "entities": [
        {
          "text": "Section 74",
          "label": "PROVISION",
          "start": 1174,
          "end": 1184
        },
        {
          "text": "Right to Fair Compensation and Transparency in Land Acquisition, Rehabilitation & Resettlement Act, 2013",
          "label": "STATUTE",
          "start": 1192,
          "end": 1296
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 21,
      "text": "On this issue, hearing has already concluded in F.A. No. 26 / 2017 and order has been reserved by a Co-ordinate Bench of this Court.",
      "rhetorical_role": "NONE",
      "start": 1337,
      "end": 1469,
      "entities": [
        {
          "text": "F.A. No. 26 / 2017",
          "label": "CASE_NUMBER",
          "start": 1385,
          "end": 1403
        }
      ],
      "in_summary": false
    },
