    {
      "sentence_id": 19,
      "text": "19 18-01-2023 Mr. Gyan Prakash Ojha as well as Mr. Parth Gaurav, learned counsel appearing for the State of Bihar and the B.I.A.D.A. respectively submit that against the common Award passed by the District Land Acquisition Officer various First Appeals have been filed before this Court, one of them is F.A.\nNo. 26 of 2017.",
      "rhetorical_role": "PREAMBLE",
      "start": 734,
      "end": 1057,
      "entities": [
        {
          "text": "19 18-01-2023",
          "label": "DATE",
          "start": 734,
          "end": 747
        },
        {
          "text": "Gyan Prakash Ojha",
          "label": "LAWYER",
          "start": 752,
          "end": 769
