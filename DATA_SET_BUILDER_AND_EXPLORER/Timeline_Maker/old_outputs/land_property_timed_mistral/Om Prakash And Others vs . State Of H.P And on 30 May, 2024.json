      "sentence_id": 6,
      "text": "Learned Additional Advocate General placed on record instructions dated 29th May, 2024 which r has go to indicate that Notification under Section 11 of the Right to Fair Compensation and Transparency in Land Acquisition, Rehabilitation and Resettlment Act 2013 has been issued.",
      "rhetorical_role": "PREAMBLE",
      "start": 353,
      "end": 631,
      "entities": [
        {
          "text": "29th May, 2024",
          "label": "DATE",
