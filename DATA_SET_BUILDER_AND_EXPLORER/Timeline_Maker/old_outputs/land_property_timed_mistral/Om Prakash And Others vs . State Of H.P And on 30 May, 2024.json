          "label": "STATUTE",
          "start": 510,
          "end": 614
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 7,
      "text": "However, due to Model Code of Conduct, this Notification under Section 11 of the Act has not yet been published in the daily newspaper and in the locality.",
      "rhetorical_role": "PREAMBLE",
      "start": 632,
      "end": 788,
      "entities": [
        {
          "text": "Section 11",
          "label": "PROVISION",
          "start": 696,
          "end": 706
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 8,
      "text": "We really wonder how the Model Code of Conduct comes in the way of publishing the said Notification.",
      "rhetorical_role": "PREAMBLE",
      "start": 789,
      "end": 890,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "Therefore, the Land Acquisition Collector, HP PWD South Zone, Winter Field, Shimla is directed to appear in person and apprise this Court with regard to applicability of the Model Code of Conduct, if any, in publishing the aforesaid Notification.",
      "rhetorical_role": "PREAMBLE",
      "start": 891,
