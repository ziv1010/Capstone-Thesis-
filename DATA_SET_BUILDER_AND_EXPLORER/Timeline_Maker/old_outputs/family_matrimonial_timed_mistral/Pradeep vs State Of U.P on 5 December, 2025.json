          "end": 1525
        },
        {
          "text": "5 December, 2025",
          "label": "DATE",
          "start": 1529,
          "end": 1545
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 17,
      "text": "Hence, we are of the view at this stage, the appellant cannot be denied the benefit of bail.",
      "rhetorical_role": "RATIO",
      "start": 1759,
      "end": 1851,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.27180927991867065
    },
    {
      "sentence_id": 18,
      "text": "The appellant is in 2 Crl.No.___ of 2025 @ SLP (Crl.) No.16006/2025 custody since 01 year 05 months.",
      "rhetorical_role": "NONE",
      "start": 1852,
      "end": 1952,
      "entities": [
        {
          "text": "Crl.No.___ of 2025",
          "label": "CASE_NUMBER",
          "start": 1874,
          "end": 1892
        },
        {
          "text": "Crl.) No.16006/2025",
          "label": "CASE_NUMBER",
          "start": 1900,
          "end": 1919
        },
        {
          "text": "01 year 05",
          "label": "DATE",
          "start": 1934,
          "end": 1944
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 19,
      "text": "Hence, we are of the considered view that appellant is entitled for the discretionary relief of bail since his detention is not warranted.",
      "rhetorical_role": "RATIO",
      "start": 1953,
      "end": 2091,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3981064558029175
    },
    {
      "sentence_id": 20,
      "text": "Hence, the appeal is allowed.",
      "rhetorical_role": "RPC",
      "start": 2092,
      "end": 2121,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.2774764895439148
    },
    {
      "sentence_id": 21,
      "text": "The appellant is ordered to be released on bail on such terms and conditions as the jurisdictional trial court deems fit.",
      "rhetorical_role": "RPC",
