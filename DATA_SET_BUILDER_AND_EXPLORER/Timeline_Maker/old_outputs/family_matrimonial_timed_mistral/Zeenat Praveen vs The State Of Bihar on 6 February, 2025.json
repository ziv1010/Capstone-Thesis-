    {
      "sentence_id": 17,
      "text": "It is submitted by learned counsel that the matter  between opposite party no. 2 and her husband Syed Imran  Ahmad stands compromised in view of annexures 3 and 4  series of supplementary affidavit as filed on behalf of  petitioners on 12.12.2024.",
      "rhetorical_role": "PREAMBLE",
      "start": 1829,
      "end": 2076,
      "entities": [
        {
          "text": "Syed Imran  Ahmad",
          "label": "OTHER_PERSON",
          "start": 1926,
