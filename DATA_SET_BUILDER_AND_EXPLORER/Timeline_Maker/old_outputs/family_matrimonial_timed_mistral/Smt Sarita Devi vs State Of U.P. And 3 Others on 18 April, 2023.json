    },
    {
      "sentence_id": 8,
      "text": "Learned counsel for the applicant states that certified copy of the ordersheet is filed; cognizance was taken in the case on 29.2.2021 and accused were summoned; accused appeared and enlarged on bail in course of time but trial is not proceeding, hence, a direction may be issued to the court below to the decide the same expeditiously.",
      "rhetorical_role": "PREAMBLE",
      "start": 836,
      "end": 1173,
      "entities": [
        {
          "text": "29.2.2021",
          "label": "DATE",
          "start": 962,
          "end": 971
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "It is directed that court below shall make all endeavour to decide this case expeditiously preferably within a period of one year from the date of production of certified copy of the order, without permitting undue adjournments to either side, if there is no legal impediment.\nSmt Sarita Devi vs State Of U.P. And 3 Others on 18 April, 2023 Indian Kanoon - http://indiankanoon.org/doc/199836808/\n1",
      "rhetorical_role": "PREAMBLE",
      "start": 1174,
      "end": 1572,
