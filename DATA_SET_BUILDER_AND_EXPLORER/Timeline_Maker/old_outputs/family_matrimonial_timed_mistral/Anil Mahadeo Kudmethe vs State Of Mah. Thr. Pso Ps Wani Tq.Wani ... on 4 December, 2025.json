    },
    {
      "sentence_id": 7,
      "text": "ARGUMENTS WERE HEARD ON : 2/12/2025  JUDGMENT IS PRONOUNCED ON : 4/12/2025",
      "rhetorical_role": "PREAMBLE",
      "start": 705,
      "end": 783,
