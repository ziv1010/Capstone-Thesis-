    },
    {
      "sentence_id": 9,
      "text": "ORDER This is the first application under Section 439 of Cr.P.C / Section 483 of BNSS filed by the applicant for grant of bail.",
      "rhetorical_role": "FAC",
      "start": 501,
      "end": 628,
      "entities": [
        {
