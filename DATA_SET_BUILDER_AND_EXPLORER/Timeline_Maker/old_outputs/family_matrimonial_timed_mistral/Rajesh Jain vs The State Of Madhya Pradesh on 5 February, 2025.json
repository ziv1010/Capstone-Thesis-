    },
    {
      "sentence_id": 10,
      "text": "2. The applicant has been arrested on 27.02.2024 by Police Station Lakhnadon, District Seoni (M.P.) in connection with Crime No.110/2024 for the offences punishable under Sections 302, 201 and 34 of the Indian Penal Code.",
      "rhetorical_role": "FAC",
