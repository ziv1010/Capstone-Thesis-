    {
      "sentence_id": 6,
      "text": "By the impugned order the learned court below on an application under section 319 Cr.P.C. filed by the prosecution has summoned the revisionist to face trial.",
      "rhetorical_role": "ANALYSIS",
      "start": 798,
      "end": 956,
      "entities": [
        {
