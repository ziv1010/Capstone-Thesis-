      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4207908511161804
    },
    {
      "sentence_id": 8,
      "text": "She has given dowry according to her status.",
      "rhetorical_role": "ANALYSIS",
      "start": 1182,
      "end": 1226,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.37147459387779236
    },
    {
      "sentence_id": 9,
      "text": "After marriage on 15.5.2009 when the complainant went her Sasural for Vidai Manoj Kumar Sindhi, Smt. Maya Devi mother-in-law, Geeta Devi and Kamla Devi Nanads demanded Rs. 2,50,000/- cash and also one house.",
      "rhetorical_role": "FAC",
      "start": 1227,
      "end": 1434,
      "entities": [
        {
          "text": "15.5.2009",
          "label": "DATE",
          "start": 1245,
          "end": 1254
        },
        {
          "text": "Vidai Manoj Kumar Sindhi",
          "label": "OTHER_PERSON",
          "start": 1297,
