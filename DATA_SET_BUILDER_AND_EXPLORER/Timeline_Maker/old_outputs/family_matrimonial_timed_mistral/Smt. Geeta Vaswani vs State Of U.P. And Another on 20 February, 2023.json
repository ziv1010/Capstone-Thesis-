          "start": 1670,
          "end": 1687
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.33245471119880676
    },
    {
      "sentence_id": 13,
      "text": "After investigation charge-sheet was submitted exonerating Smt. Geeta Wasvani-revisionist.",
      "rhetorical_role": "FAC",
      "start": 1800,
      "end": 1890,
      "entities": [
        {
          "text": "Geeta Wasvani",
          "label": "OTHER_PERSON",
          "start": 1864,
          "end": 1877
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2683509290218353
    },
    {
      "sentence_id": 14,
      "text": "During investigation after examination of two witnesses an application under section 319 Cr.P.C. was filed to summon Smt. Geeta Wasvani to face trial with other co-accused.",
      "rhetorical_role": "FAC",
      "start": 1891,
      "end": 2063,
      "entities": [
        {
          "text": "section 319",
          "label": "PROVISION",
          "start": 1968,
          "end": 1979
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 1980,
          "end": 1987
        },
        {
          "text": "Geeta Wasvani",
          "label": "OTHER_PERSON",
          "start": 2013,
          "end": 2026
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.340542733669281
    },
    {
      "sentence_id": 15,
      "text": "From the perusal of the record it is clear that revisionist is married Nanad of the victim.",
      "rhetorical_role": "FAC",
      "start": 2064,
      "end": 2156,
      "entities": [
        {
          "text": "Nanad",
          "label": "OTHER_PERSON",
          "start": 2136,
          "end": 2141
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.33027756214141846
    },
    {
      "sentence_id": 16,
      "text": "She is living separately with her husband.",
      "rhetorical_role": "FAC",
      "start": 2157,
      "end": 2199,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.31018105149269104
    },
    {
      "sentence_id": 17,
      "text": "So she has no concern with the family affairs of the victim and her husband.",
      "rhetorical_role": "ANALYSIS",
      "start": 2200,
      "end": 2276,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3325945734977722
    },
    {
      "sentence_id": 18,
      "text": "It also appears that husband and entire family has been implicated.",
      "rhetorical_role": "FAC",
      "start": 2277,
      "end": 2344,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24584263563156128
    },
    {
      "sentence_id": 19,
      "text": "There are general allegations against the revisionist.",
      "rhetorical_role": "ANALYSIS",
      "start": 2345,
      "end": 2399,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5006616115570068
    },
    {
      "sentence_id": 20,
      "text": "In Geeta Mehtrotra Vs. State of U.P. 2012 (10) ADJ 464 the Apex Court has observed that there is tendency of implicating the entire family.",
      "rhetorical_role": "PRE_RELIED",
      "start": 2400,
      "end": 2539,
      "entities": [
        {
          "text": "Geeta Mehtrotra Vs. State of U.P. 2012 (10) ADJ 464",
          "label": "PRECEDENT",
          "start": 2403,
          "end": 2454
        },
        {
          "text": "Apex Court",
          "label": "COURT",
          "start": 2459,
          "end": 2469
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5119722485542297
    },
    {
      "sentence_id": 21,
      "text": "There should be specific allegations.",
      "rhetorical_role": "PRE_RELIED",
      "start": 2540,
      "end": 2577,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.49120602011680603
    },
    {
      "sentence_id": 22,
      "text": "The apex court in a catena of decisions has held that power under section 319 Cr.P.C. is an extra ordinary power which should be exercised sparingly and very cautiously on the basis of cogent evidence.",
      "rhetorical_role": "PRE_RELIED",
      "start": 2578,
      "end": 2779,
      "entities": [
        {
          "text": "apex court",
          "label": "COURT",
          "start": 2582,
          "end": 2592
        },
        {
          "text": "section 319",
          "label": "PROVISION",
          "start": 2644,
          "end": 2655
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 2656,
          "end": 2663
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3590528070926666
    },
    {
      "sentence_id": 23,
      "text": "The standard of evidence is more that of a prima facie case.",
      "rhetorical_role": "RATIO",
      "start": 2780,
      "end": 2840,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5700816512107849
    },
    {
      "sentence_id": 24,
      "text": "Learned court below has passed the impugned order in a cavalier and cursory manner which does not satisfy the test laid down for exercising powers under section 319 Cr.P.C.",
      "rhetorical_role": "RATIO",
      "start": 2841,
      "end": 3013,
      "entities": [
        {
          "text": "section 319",
          "label": "PROVISION",
          "start": 2994,
          "end": 3005
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 3006,
          "end": 3013
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.38630199432373047
    },
    {
      "sentence_id": 25,
      "text": "The impugned order is not sustainable.",
      "rhetorical_role": "RATIO",
      "start": 3014,
      "end": 3052,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.480264812707901
    },
    {
      "sentence_id": 26,
      "text": "The criminal revision is hereby allowed.",
      "rhetorical_role": "RPC",
      "start": 3053,
      "end": 3094,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.2581465244293213
    },
    {
      "sentence_id": 27,
      "text": "The impugned order dated 11.11.2014 is hereby set-aside.",
      "rhetorical_role": "RPC",
