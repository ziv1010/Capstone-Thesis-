        },
        {
          "text": "Maya Devi",
          "label": "OTHER_PERSON",
          "start": 1328,
          "end": 1337
        },
        {
          "text": "Geeta Devi",
          "label": "OTHER_PERSON",
          "start": 1353,
          "end": 1363
        },
        {
          "text": "Kamla Devi Nanads",
          "label": "OTHER_PERSON",
          "start": 1368,
          "end": 1385
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24175673723220825
    },
    {
      "sentence_id": 10,
      "text": "The complainant showed inability to fulfill this demand.",
      "rhetorical_role": "FAC",
      "start": 1435,
      "end": 1491,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2662280797958374
    },
    {
      "sentence_id": 11,
      "text": "On 24.6.2009 her sister was again sent to her in-laws house.",
      "rhetorical_role": "FAC",
      "start": 1492,
      "end": 1552,
      "entities": [
        {
          "text": "24.6.2009",
          "label": "DATE",
          "start": 1495,
          "end": 1504
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3092873990535736
    },
    {
      "sentence_id": 12,
      "text": "The husband, parents-in-law and Nanads of her sister use to abuse Smt. Geeta Vaswani vs State Of U.P. And Another on 20 February, 2023 Indian Kanoon - http://indiankanoon.org/doc/89591706/\n1 and torture her for non fulfillment of demand of dowry.",
      "rhetorical_role": "FAC",
      "start": 1553,
      "end": 1799,
      "entities": [
        {
          "text": "Smt. Geeta Vaswani vs State Of U.P. And Another",
          "label": "PRECEDENT",
          "start": 1619,
          "end": 1666
        },
        {
