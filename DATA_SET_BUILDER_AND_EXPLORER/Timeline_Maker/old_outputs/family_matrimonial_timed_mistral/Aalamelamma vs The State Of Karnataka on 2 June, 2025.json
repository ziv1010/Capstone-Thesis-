      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 15,
      "text": "Hence the same may kindly be dismissed as Aalamelamma vs The State Of Karnataka on 2 June, 2025 Indian Kanoon - http://indiankanoon.org/doc/99123599/\n2 withdrawn.",
      "rhetorical_role": "PREAMBLE",
      "start": 2231,
