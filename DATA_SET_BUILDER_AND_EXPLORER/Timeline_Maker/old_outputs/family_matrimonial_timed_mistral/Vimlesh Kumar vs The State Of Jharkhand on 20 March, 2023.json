    },
    {
      "sentence_id": 6,
      "text": "For the O.P. No.2 : Mr. B. N. Jha, Advocate ----\n10/20.03.2023 Heard the parties.",
      "rhetorical_role": "PREAMBLE",
      "start": 430,
      "end": 511,
