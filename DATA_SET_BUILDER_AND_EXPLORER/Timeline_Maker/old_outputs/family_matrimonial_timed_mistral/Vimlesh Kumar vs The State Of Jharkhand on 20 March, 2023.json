          "text": "10/20.03.2023",
          "label": "DATE",
          "start": 479,
          "end": 492
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 7,
      "text": "Petitioner is apprehending his arrest in connection with Namkum P.S. Case No.125/2020, for the offences registered under Sections 498A read with section 34 of the Indian Penal Code and Sections 3 / 4 of the D.P. Act, pending in the court of Smt. Anamika Kisku, learned Judicial Magistrate, 1st Class, Ranchi.\nPetitioner is the husband of the informant.",
      "rhetorical_role": "PREAMBLE",
      "start": 513,
      "end": 865,
      "entities": [
        {
          "text": "Namkum P.S. Case No.125/2020",
