        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 20,
      "text": "Accordingly, I pass the following:",
      "rhetorical_role": "PREAMBLE",
      "start": 2696,
      "end": 2730,
