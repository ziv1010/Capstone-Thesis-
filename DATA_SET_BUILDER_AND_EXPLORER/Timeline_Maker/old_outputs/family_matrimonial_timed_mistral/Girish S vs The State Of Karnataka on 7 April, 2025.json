        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 15,
      "text": "The petitioner - accused No.4, has been charge- sheeted for the offences punishable under Sections 498A, 504, and 506 read with Section 34 of the IPC and Sections 3 and 4 of the Dowry Prohibition Act, 1961.",
      "rhetorical_role": "PREAMBLE",
      "start": 1846,
      "end": 2052,
