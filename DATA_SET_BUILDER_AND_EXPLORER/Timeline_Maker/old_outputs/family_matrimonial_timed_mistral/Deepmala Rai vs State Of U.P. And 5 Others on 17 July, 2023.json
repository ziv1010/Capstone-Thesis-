    },
    {
      "sentence_id": 6,
      "text": "Learned counsel for the applicant submits that the applicant is wife of opposite party no.2 and is residing in her parental house situated in district Prayagraj.",
      "rhetorical_role": "PREAMBLE",
      "start": 935,
      "end": 1097,
      "entities": [
        {
          "text": "Prayagraj",
          "label": "GPE",
