    {
      "sentence_id": 10,
      "text": "Case diary earlier called for has been received perused the same.",
      "rhetorical_role": "PREAMBLE",
      "start": 781,
      "end": 847,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 11,
      "text": "It appears that at paragraph-98 of the case diary, it has been mentioned that the petitioner was arrested, it further appears that after his arrest he was released by the investigating officer in the light of the provisions of section 41A of the Cr.P.C.\nConsidering this fact, there is no reasonable apprehension of the arrest of this petitioner.\nThe petitioner, if so, advised may surrender before the court below within two weeks from the date of receipt of the copy of this order and pray for regular bail.",
      "rhetorical_role": "PREAMBLE",
      "start": 848,
      "end": 1358,
      "entities": [
        {
          "text": "section 41A",
          "label": "PROVISION",
