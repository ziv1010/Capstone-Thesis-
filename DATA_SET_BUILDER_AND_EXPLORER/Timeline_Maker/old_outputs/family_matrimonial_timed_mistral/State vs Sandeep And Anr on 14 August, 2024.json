          "end": 886
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.12822943925857544
    },
    {
      "sentence_id": 7,
      "text": "SI Shajid Hussain attended the call and reached on the spot along with HC Meghram.",
      "rhetorical_role": "FAC",
      "start": 888,
      "end": 970,
      "entities": [
        {
