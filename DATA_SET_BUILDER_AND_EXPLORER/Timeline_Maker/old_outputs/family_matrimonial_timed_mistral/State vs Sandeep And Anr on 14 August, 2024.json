      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22724321484565735
    },
    {
      "sentence_id": 8,
      "text": "On preliminary inquiry, it was found that the deceased namely Neha got married to accused Sandeep on 10.02.2022, so her death being unnatural within seven years of marriage was informed to the Executive Magistrate.",
      "rhetorical_role": "FAC",
      "start": 971,
      "end": 1185,
      "entities": [
        {
          "text": "Neha",
          "label": "OTHER_PERSON",
          "start": 1033,
          "end": 1037
        },
        {
          "text": "Sandeep",
          "label": "RESPONDENT",
          "start": 1061,
          "end": 1068
        },
        {
          "text": "10.02.2022",
          "label": "DATE",
          "start": 1072,
          "end": 1082
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3896307647228241
    },
    {
      "sentence_id": 9,
      "text": "The Executive Magistrate concerned conducted proceedings U/s 176 Cr.P.C. and recorded the statement of father of the deceased.",
      "rhetorical_role": "FAC",
      "start": 1186,
      "end": 1312,
      "entities": [
        {
          "text": "s 176",
          "label": "PROVISION",
