          "end": 1258
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.322858601808548
    },
    {
      "sentence_id": 10,
      "text": "On the basis of the complaint of the father Sh. Gyan Chand, present FIR was registered.",
      "rhetorical_role": "FAC",
      "start": 1313,
      "end": 1400,
      "entities": [
        {
          "text": "Gyan Chand",
          "label": "WITNESS",
