      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20533137023448944
    },
    {
      "sentence_id": 26,
      "text": "Thereafter, the present matter was received by way of committal to the Court of Sessions on 12.07.2024.\n6.",
      "rhetorical_role": "FAC",
      "start": 3468,
      "end": 3574,
      "entities": [
