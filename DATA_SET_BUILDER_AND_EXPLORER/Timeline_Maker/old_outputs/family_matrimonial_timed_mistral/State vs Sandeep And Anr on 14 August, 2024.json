          "label": "OTHER_PERSON",
          "start": 1849,
          "end": 1860
        },
        {
          "text": "State vs Sandeep And Anr",
          "label": "PRECEDENT",
          "start": 1880,
          "end": 1904
        },
        {
          "text": "14 August, 2024",
          "label": "DATE",
          "start": 1908,
          "end": 1923
        },
