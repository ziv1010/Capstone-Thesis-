      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2250249981880188
    },
    {
      "sentence_id": 17,
      "text": "It is further stated that the accused has killed Neha for not meeting the demands of dowry.",
      "rhetorical_role": "FAC",
