          "end": 1371
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.29934024810791016
    },
    {
      "sentence_id": 11,
      "text": "3. As per the complaint of Gyan Chand, his daughter was married with accused Sandeep on 10.02.2022.",
      "rhetorical_role": "FAC",
      "start": 1402,
      "end": 1501,
      "entities": [
        {
          "text": "Gyan Chand",
          "label": "WITNESS",
          "start": 1429,
          "end": 1439
        },
        {
          "text": "Sandeep",
          "label": "RESPONDENT",
          "start": 1479,
          "end": 1486
        },
        {
          "text": "10.02.2022",
          "label": "DATE",
          "start": 1490,
          "end": 1500
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.27655118703842163
    },
    {
      "sentence_id": 12,
      "text": "It is stated that at the time of marriage they had given enough dowry.",
      "rhetorical_role": "FAC",
      "start": 1502,
      "end": 1572,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24820978939533234
    },
    {
      "sentence_id": 13,
      "text": "It is alleged that accused Sandeep after two months of marriage demanded chain and ring and used to give beatings to deceased Neha.",
      "rhetorical_role": "FAC",
      "start": 1573,
      "end": 1704,
      "entities": [
        {
          "text": "Sandeep",
          "label": "RESPONDENT",
          "start": 1600,
          "end": 1607
        },
        {
          "text": "Neha",
          "label": "OTHER_PERSON",
          "start": 1699,
          "end": 1703
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.27102574706077576
    },
    {
      "sentence_id": 14,
      "text": "It is further stated by the complainant that after the marriage accused Sandeep,\nhis sister Sangeeta and his two brothers namely Sonu Kumar and Meenu Kumar used to harass her State vs Sandeep And Anr on 14 August, 2024 Indian Kanoon - http://indiankanoon.org/doc/173180640/\n1 daughter/deceased Neha and taunt her for bringing insufficient dowry.",
      "rhetorical_role": "FAC",
      "start": 1705,
      "end": 2050,
      "entities": [
        {
          "text": "Sandeep",
          "label": "RESPONDENT",
          "start": 1777,
          "end": 1784
        },
        {
          "text": "Sangeeta",
