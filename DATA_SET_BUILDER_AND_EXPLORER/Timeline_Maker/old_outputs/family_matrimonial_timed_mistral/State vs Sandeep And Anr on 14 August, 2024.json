          "text": "Neha",
          "label": "OTHER_PERSON",
          "start": 1999,
          "end": 2003
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.172771617770195
    },
    {
      "sentence_id": 15,
      "text": "It is further stated that whenever Neha used to come to his parental house she used to tell that accused Sandeep in the influence of liquor used to harass her and also break the household items.",
      "rhetorical_role": "FAC",
      "start": 2051,
      "end": 2245,
      "entities": [
        {
