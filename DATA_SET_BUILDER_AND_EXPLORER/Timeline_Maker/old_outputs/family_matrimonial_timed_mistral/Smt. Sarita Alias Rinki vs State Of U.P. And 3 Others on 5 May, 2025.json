    },
    {
      "sentence_id": 5,
      "text": "Concededly, the applicant herself lodged the F.I.R. at Mainpuri and is seeking transfer to Auraiya on the ground that after registration of the case, she shifted to her parental home at Auraiya.",
      "rhetorical_role": "PREAMBLE",
      "start": 792,
