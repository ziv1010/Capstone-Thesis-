    },
    {
      "sentence_id": 9,
      "text": "The petitioners apprehend their arrest in a case registered for the offences punishable under Sections 304B, 498A and 34 of the Indian Penal Code.",
      "rhetorical_role": "PREAMBLE",
      "start": 1021,
      "end": 1168,
      "entities": [
        {
          "text": "Sections 304B",
          "label": "PROVISION",
          "start": 1116,
          "end": 1129
        },
        {
          "text": "498A",
          "label": "PROVISION",
          "start": 1131,
