          "label": "STATUTE",
          "start": 1150,
          "end": 1167
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "It is a case of dowry death.",
      "rhetorical_role": "PREAMBLE",
      "start": 1169,
      "end": 1198,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 11,
      "text": "Petitioner no. 1 is father- in-law and petitioner no. 2 is mother-in-law of the deceased.",
      "rhetorical_role": "PREAMBLE",
      "start": 1199,
      "end": 1288,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 12,
      "text": "It is submitted on behalf of the petitioner that thrust of accusation is against husband of the deceased who is already in custody.",
      "rhetorical_role": "PREAMBLE",
      "start": 1289,
      "end": 1421,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 13,
      "text": "So far as petitioners are concerned, petitioner no. 1 is father-in-law and petitioner no. 2 is mother-in-law of the deceased and they are living separately and have got no concern with the family affairs of the deceased and her husband.",
      "rhetorical_role": "PREAMBLE",
      "start": 1422,
      "end": 1658,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 14,
      "text": "There is Patna High Court CR. MISC. No.66508 of 2022(2) dt.18-03-2023 general and omnibus allegation.",
      "rhetorical_role": "PREAMBLE",
      "start": 1659,
      "end": 1760,
      "entities": [
        {
          "text": "Patna High Court",
          "label": "COURT",
          "start": 1668,
          "end": 1684
        },
        {
          "text": "CR. MISC. No.66508 of 2022(2)",
          "label": "CASE_NUMBER",
          "start": 1685,
          "end": 1714
        },
        {
          "text": "dt.18-03-2023",
          "label": "DATE",
          "start": 1715,
          "end": 1728
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
