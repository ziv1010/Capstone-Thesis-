      "end": 2858,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24451783299446106
    },
    {
      "sentence_id": 35,
      "text": "4. Learned Counsel for the Petitioner submitted that the F.I.R.\n has been registered out of vendetta.",
