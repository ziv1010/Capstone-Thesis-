    {
      "sentence_id": 11,
      "text": "Heard the parties.",
      "rhetorical_role": "NONE",
      "start": 931,
      "end": 949,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 12,
      "text": "As per the case of prosecution, it is a gang rape and murder of a minor-girl.",
      "rhetorical_role": "FAC",
      "start": 950,
      "end": 1028,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3215746581554413
    },
    {
      "sentence_id": 13,
      "text": "It is submitted by learned counsel for the petitioner that petitioner is not named in the FIR and the only material is confessional statement of co- accused.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1029,
      "end": 1187,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.18945039808750153
    },
    {
      "sentence_id": 14,
      "text": "It is submitted that there is no eye-witness of the alleged occurrence and the petitioner does not have criminal antecedent.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1188,
      "end": 1312,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.17063148319721222
    },
    {
      "sentence_id": 15,
      "text": "Learned APP for the State has vehemently opposed the prayer.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1313,
      "end": 1374,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.11501503735780716
    },
    {
      "sentence_id": 16,
      "text": "It is submitted that name of the petitioner has appeared during investigation.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1375,
      "end": 1453,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.13658712804317474
    },
    {
      "sentence_id": 17,
      "text": "It is submitted that the petitioner /accused has also made confessional statement regarding the occurrence.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1454,
      "end": 1561,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14565643668174744
    },
    {
      "sentence_id": 18,
      "text": "Considering the nature of allegation and gravity of offence, I am not inclined to enlarge the petitioner on regular bail and accordingly, the prayer for the same is rejected.",
      "rhetorical_role": "NONE",
      "start": 1562,
      "end": 1737,
      "entities": [],
      "in_summary": false
    },
    {
