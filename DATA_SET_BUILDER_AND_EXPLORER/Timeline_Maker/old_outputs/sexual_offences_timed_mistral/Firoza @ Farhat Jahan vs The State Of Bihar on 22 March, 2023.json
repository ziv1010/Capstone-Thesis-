      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 18,
      "text": "Later Section 376 and 493 of the Indian Penal Code has been added vide order dated 07.12.2022.",
      "rhetorical_role": "PREAMBLE",
      "start": 1383,
      "end": 1477,
      "entities": [
        {
          "text": "Section 376",
          "label": "PROVISION",
