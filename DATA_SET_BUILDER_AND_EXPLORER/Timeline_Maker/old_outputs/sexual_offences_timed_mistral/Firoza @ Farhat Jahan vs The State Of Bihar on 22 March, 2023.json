          "start": 1405,
          "end": 1408
        },
        {
          "text": "Indian Penal Code",
          "label": "STATUTE",
          "start": 1416,
          "end": 1433
        },
        {
          "text": "07.12.2022",
          "label": "DATE",
          "start": 1466,
          "end": 1476
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 19,
      "text": "The accused (Danish) and the girl were friends.",
      "rhetorical_role": "PREAMBLE",
      "start": 1478,
      "end": 1526,
      "entities": [
        {
          "text": "Danish",
          "label": "OTHER_PERSON",
          "start": 1492,
          "end": 1498
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 20,
      "text": "After sometime, the accused established physical relation with her on the pretext of marriage.",
      "rhetorical_role": "PREAMBLE",
      "start": 1527,
      "end": 1621,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 21,
      "text": "But when she asked to solemnize the Patna High Court CR. MISC. No.18301 of 2023(2) dt.22-03-2023 marriage, the accused denied.",
      "rhetorical_role": "PREAMBLE",
      "start": 1622,
      "end": 1748,
      "entities": [
        {
          "text": "Patna High Court",
          "label": "COURT",
          "start": 1658,
          "end": 1674
        },
        {
          "text": "CR. MISC. No.18301 of 2023(2)",
          "label": "CASE_NUMBER",
          "start": 1675,
          "end": 1704
        },
        {
          "text": "dt.22-03-2023",
          "label": "DATE",
          "start": 1705,
          "end": 1718
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 22,
      "text": "After sometime, the accused along with his three friends kidnapped her and along with petitioner No. 1 and 2 i.e. mother and sister of accused assaulted, abused her, torn her clothes and also made nude video of her.",
      "rhetorical_role": "PREAMBLE",
      "start": 1749,
      "end": 1964,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 23,
      "text": "Firoza @ Farhat Jahan vs The State Of Bihar on 22 March, 2023 Indian Kanoon - http://indiankanoon.org/doc/182730135/\n1",
      "rhetorical_role": "PREAMBLE",
      "start": 1965,
      "end": 2084,
      "entities": [
        {
          "text": "Firoza @ Farhat Jahan vs The State Of Bihar",
          "label": "PRECEDENT",
