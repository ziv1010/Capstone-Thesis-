      "start": 1508,
      "end": 1579,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26916608214378357
    },
    {
      "sentence_id": 15,
      "text": "Raju is said to have burnt the rope by which throttling is alleged.",
      "rhetorical_role": "FAC",
      "start": 1580,
      "end": 1647,
      "entities": [
        {
          "text": "Raju",
