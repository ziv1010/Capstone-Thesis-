      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24376828968524933
    },
    {
      "sentence_id": 20,
      "text": "Recovery of blood stained shirt was made on basis of memorandum given by applicant on 27.03.2024.",
