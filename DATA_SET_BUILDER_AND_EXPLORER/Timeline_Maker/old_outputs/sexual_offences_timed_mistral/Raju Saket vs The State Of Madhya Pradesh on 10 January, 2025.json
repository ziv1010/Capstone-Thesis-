          "label": "OTHER_PERSON",
          "start": 1317,
          "end": 1324
        },
        {
          "text": "Raju",
          "label": "PETITIONER",
          "start": 1353,
          "end": 1357
        },
        {
          "text": "Jitendra",
          "label": "OTHER_PERSON",
