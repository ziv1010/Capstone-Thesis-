      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.30945754051208496
    },
    {
      "sentence_id": 12,
      "text": "Roshni in village-Padri was involved intimately with deceased-Santosh and all of a sudden accused Raju and Jitendra came there and Santosh was throttled.",
      "rhetorical_role": "FAC",
