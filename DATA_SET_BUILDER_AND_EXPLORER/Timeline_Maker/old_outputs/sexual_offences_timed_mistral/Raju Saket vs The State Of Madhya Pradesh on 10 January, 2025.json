      "text": "Case of other co-accused persons is different.",
      "rhetorical_role": "FAC",
      "start": 2677,
      "end": 2723,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23743346333503723
    },
    {
      "sentence_id": 28,
      "text": "Shirt of Jitendra and mobile phone of deceased were seized from him.",
