      "end": 916,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3258500099182129
    },
    {
      "sentence_id": 6,
      "text": "He is in jail since 27.03.2024.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 917,
      "end": 948,
      "entities": [
        {
          "text": "27.03.2024",
          "label": "DATE",
          "start": 937,
          "end": 947
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.287903368473053
    },
    {
      "sentence_id": 7,
      "text": "As per prosecution story, deceased Santosh committed rape on one Roshni in year 2023.",
      "rhetorical_role": "FAC",
      "start": 949,
      "end": 1034,
      "entities": [
        {
          "text": "Santosh",
          "label": "OTHER_PERSON",
