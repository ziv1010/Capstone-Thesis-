      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3114428222179413
    },
    {
      "sentence_id": 11,
      "text": "On 20.03.2024, he was called in village-Padri.",
      "rhetorical_role": "FAC",
      "start": 1208,
      "end": 1254,
      "entities": [
        {
          "text": "20.03.2024",
