          "end": 1020
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3309653103351593
    },
    {
      "sentence_id": 8,
      "text": "Offence under Section 376 of the IPC was registered against him.",
      "rhetorical_role": "FAC",
      "start": 1035,
      "end": 1099,
      "entities": [
        {
          "text": "Section 376",
          "label": "PROVISION",
          "start": 1049,
          "end": 1060
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 1068,
          "end": 1071
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.31002917885780334
    },
    {
      "sentence_id": 9,
      "text": "He was released on bail.",
      "rhetorical_role": "FAC",
      "start": 1100,
      "end": 1124,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.35565444827079773
    },
    {
      "sentence_id": 10,
      "text": "In criminal conspiracy, Roshni called deceased Santosh and started talking to him.",
      "rhetorical_role": "FAC",
      "start": 1125,
      "end": 1207,
      "entities": [
