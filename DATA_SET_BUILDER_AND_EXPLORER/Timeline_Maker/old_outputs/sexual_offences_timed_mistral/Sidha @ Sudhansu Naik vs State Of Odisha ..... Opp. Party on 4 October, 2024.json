      "summary_section": "arguments",
      "summary_sent_score": 0.07857406139373779
    },
    {
      "sentence_id": 16,
      "text": "He further submits that the false allegation has been made against him at the instance of the co- accused Sibani Nayak.",
      "rhetorical_role": "ARG_PETITIONER",
