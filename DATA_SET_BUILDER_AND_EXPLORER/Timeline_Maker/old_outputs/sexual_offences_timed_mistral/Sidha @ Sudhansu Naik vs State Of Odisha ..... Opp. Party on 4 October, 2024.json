      "sentence_id": 17,
      "text": "6. Mr. G.N. Rout, learned Addl.",
      "rhetorical_role": "NONE",
      "start": 2433,
      "end": 2464,
      "entities": [
        {
          "text": "G.N. Rout",
          "label": "LAWYER",
