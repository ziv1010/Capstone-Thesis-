        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 18,
      "text": "Standing Counsel for the State opposes the prayer for bail stating that the petitioner evaded arrest and could only be arrested after NBW of arrest was issued against him.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2465,
      "end": 2636,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1628493368625641
    },
    {
      "sentence_id": 19,
      "text": "He was arrested in another case and brought on remand in this case on 10.04.2024 allegations on record make out a case under Section 376-D of IPC apart from other offenses for which he is not entitled to be released on bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2637,
      "end": 2861,
      "entities": [
