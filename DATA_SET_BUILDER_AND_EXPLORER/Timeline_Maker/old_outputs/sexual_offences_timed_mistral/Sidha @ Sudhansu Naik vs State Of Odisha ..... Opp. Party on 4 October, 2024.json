      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2286628633737564
    },
    {
      "sentence_id": 11,
      "text": "Out of the said persons, the informant knew two persons, namely, Kalia and Tuku.",
      "rhetorical_role": "FAC",
      "start": 1382,
