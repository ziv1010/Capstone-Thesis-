    },
    {
      "sentence_id": 6,
      "text": "Subsequently,\nthe victim was recovered from the custody of the appellant and in her evidence as P.W. 1, she has stated about the appellant committing rape upon her.",
      "rhetorical_role": "PREAMBLE",
      "start": 1158,
      "end": 1322,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 7,
      "text": "In the medical report the age of the victim has been assessed to be 14-16 years.",
      "rhetorical_role": "PREAMBLE",
      "start": 1323,
      "end": 1403,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 8,
      "text": "Regard being had to the evidence of the victim as well as the medical report of the victim, we are not inclined to admit the appellant on bail, and the present application stands rejected at this stage.\nAccordingly, I. A. No. 10195 of 2024 stands rejected.",
      "rhetorical_role": "PREAMBLE",
