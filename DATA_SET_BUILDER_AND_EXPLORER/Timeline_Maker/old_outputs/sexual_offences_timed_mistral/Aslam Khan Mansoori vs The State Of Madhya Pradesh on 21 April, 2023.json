    {
      "sentence_id": 6,
      "text": "This application coming on for admission this day, the C  the following:\n ORDER",
      "rhetorical_role": "PREAMBLE",
      "start": 638,
      "end": 717,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 7,
      "text": "This is the first application by the present applicant under Section 439 of Cr.P.C. for grant of bail,\nwho is under custody since 26.05.2022 in connection with FIR No.364/2022 dated (not mentioned)\nregistered at Police Station Bairasiya, District Bhopal for the offence punishable under Sections 376,\n323, 506 of IPC.",
      "rhetorical_role": "PREAMBLE",
      "start": 718,
      "end": 1036,
      "entities": [
        {
          "text": "Section 439",
          "label": "PROVISION",
          "start": 779,
          "end": 790
        },
        {
