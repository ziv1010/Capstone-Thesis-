          "end": 1034
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 8,
      "text": "As per the prosecution, a complaint was lodged by the complainant that on pretext of meeting her parents for seeking permission to marry, took her in an auto.",
      "rhetorical_role": "PREAMBLE",
      "start": 1036,
      "end": 1194,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "However, in the mid way he stopped the auto and sent it back under the pretext that someone is coming to pick them.",
      "rhetorical_role": "PREAMBLE",
      "start": 1195,
      "end": 1310,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "Thereafter he took her towards the side and committed rape on her and ran away.",
      "rhetorical_role": "PREAMBLE",
      "start": 1311,
      "end": 1390,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 11,
      "text": "The FIR was lodged on the very next day i.e. on 17.05.2022.",
      "rhetorical_role": "PREAMBLE",
      "start": 1391,
      "end": 1450,
      "entities": [
        {
          "text": "17.05.2022",
          "label": "DATE",
          "start": 1439,
          "end": 1449
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 12,
      "text": "MLC was also conducted.",
      "rhetorical_role": "PREAMBLE",
      "start": 1451,
      "end": 1474,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 13,
      "text": "Though no definite opinion was given by the doctor regarding the rape, however the FSL report has come positive against the present applicant.",
      "rhetorical_role": "PREAMBLE",
      "start": 1475,
      "end": 1617,
      "entities": [
