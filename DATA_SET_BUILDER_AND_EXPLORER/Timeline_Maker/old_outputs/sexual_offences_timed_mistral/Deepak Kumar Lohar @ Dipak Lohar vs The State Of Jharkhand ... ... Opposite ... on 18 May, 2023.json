    {
      "sentence_id": 5,
      "text": "----- \nFor Petitioner : Mr. Indrajit Sinha, Advocate : Mr. Akhouri Awinash Kumar, Adv.",
      "rhetorical_role": "PREAMBLE",
      "start": 361,
      "end": 448,
      "entities": [
