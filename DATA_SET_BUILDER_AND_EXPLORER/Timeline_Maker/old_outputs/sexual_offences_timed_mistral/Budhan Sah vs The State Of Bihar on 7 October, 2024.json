    {
      "sentence_id": 12,
      "text": "4 07-10-2024 Heard learned counsel for the petitioner as well as learned APP for the State.",
      "rhetorical_role": "NONE",
      "start": 775,
      "end": 867,
      "entities": [
        {
          "text": "07-10-2024",
          "label": "DATE",
