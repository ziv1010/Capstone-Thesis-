      "end": 1192,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "Considering the nature of allegation, I am not inclined to enlarge the petitioner on bail.",
