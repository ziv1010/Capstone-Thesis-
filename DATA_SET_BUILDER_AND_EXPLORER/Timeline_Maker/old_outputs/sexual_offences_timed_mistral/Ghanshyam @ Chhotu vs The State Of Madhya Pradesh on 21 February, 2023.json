        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2876929044723511
    },
    {
      "sentence_id": 11,
      "text": "As per prosecution story on 29.09.2022, 20 years old prosecutrix filed an application in writing before S.H.O. Kotwali District Panna alleging that three years ago, she was student of B.Sc in Chhatrasal Science College, Panna.",
      "rhetorical_role": "FAC",
      "start": 1846,
      "end": 2072,
      "entities": [
        {
          "text": "29.09.2022",
          "label": "DATE",
          "start": 1874,
          "end": 1884
        },
        {
          "text": "S.H.O. Kotwali District Panna",
          "label": "ORG",
          "start": 1950,
          "end": 1979
        },
        {
          "text": "Chhatrasal Science College, Panna",
          "label": "ORG",
          "start": 2038,
          "end": 2071
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1761079579591751
    },
    {
      "sentence_id": 12,
      "text": "Due to lock-down and Covid Pandemic classes were not being regularly conducted.",
      "rhetorical_role": "FAC",
      "start": 2073,
      "end": 2152,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23344270884990692
    },
    {
      "sentence_id": 13,
      "text": "She use to come Panna for taking examination.",
      "rhetorical_role": "FAC",
      "start": 2153,
      "end": 2198,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20365670323371887
    },
    {
      "sentence_id": 14,
      "text": "Since July, 2022, she was living in a rented house at Indrapuri Colony, Panna.",
      "rhetorical_role": "FAC",
      "start": 2199,
      "end": 2277,
      "entities": [
        {
          "text": "July, 2022",
          "label": "DATE",
          "start": 2205,
          "end": 2215
        },
        {
          "text": "Panna",
          "label": "GPE",
          "start": 2271,
          "end": 2276
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1985522210597992
    },
    {
      "sentence_id": 15,
      "text": "She use to come to her college by auto.",
      "rhetorical_role": "FAC",
      "start": 2278,
      "end": 2317,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21512573957443237
    },
    {
      "sentence_id": 16,
      "text": "Name of auto driver was Ghanshyam Rajak.",
      "rhetorical_role": "FAC",
      "start": 2318,
      "end": 2358,
      "entities": [
        {
          "text": "Ghanshyam Rajak",
          "label": "PETITIONER",
          "start": 2342,
          "end": 2357
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2310331165790558
    },
    {
      "sentence_id": 17,
      "text": "Ghanshyam Rajak had taken her mobile number.",
      "rhetorical_role": "FAC",
      "start": 2359,
      "end": 2403,
      "entities": [
        {
          "text": "Ghanshyam Rajak",
          "label": "PETITIONER",
          "start": 2359,
          "end": 2374
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24390338361263275
    },
    {
      "sentence_id": 18,
      "text": "He use to make calls to her telling that he loves her.",
      "rhetorical_role": "FAC",
      "start": 2404,
      "end": 2458,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19748090207576752
    },
    {
      "sentence_id": 19,
      "text": "After sometime, she stopped attending Ghanshyam Rajak's calls.",
      "rhetorical_role": "FAC",
      "start": 2459,
      "end": 2521,
      "entities": [
        {
          "text": "Ghanshyam Rajak",
          "label": "PETITIONER",
          "start": 2497,
          "end": 2512
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23271483182907104
    },
    {
      "sentence_id": 20,
      "text": "Ghanshyam Rajak shared her mobile number with his friends Naveen Balmik and Maan Ali.",
      "rhetorical_role": "FAC",
      "start": 2522,
      "end": 2607,
      "entities": [
        {
          "text": "Ghanshyam Rajak",
          "label": "PETITIONER",
          "start": 2522,
          "end": 2537
        },
        {
          "text": "Naveen Balmik",
          "label": "OTHER_PERSON",
          "start": 2580,
          "end": 2593
        },
        {
          "text": "Maan Ali",
          "label": "OTHER_PERSON",
          "start": 2598,
          "end": 2606
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2138727605342865
    },
    {
      "sentence_id": 21,
      "text": "Thereafter they both regularly made calls to her and also pressurized to make physical relations with them.",
      "rhetorical_role": "FAC",
      "start": 2609,
      "end": 2716,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22113730013370514
    },
    {
      "sentence_id": 22,
      "text": "On 28.09.2022 at around 11 A.M. Maan Ali and Naveen Balmik made a call stating that they are reaching near Sahu Aata Chakki in the auto of Maan Ali and from there they would go to visit some places.",
      "rhetorical_role": "FAC",
      "start": 2717,
      "end": 2915,
      "entities": [
        {
          "text": "28.09.2022",
          "label": "DATE",
          "start": 2720,
          "end": 2730
        },
        {
          "text": "Maan Ali",
          "label": "OTHER_PERSON",
          "start": 2749,
          "end": 2757
        },
        {
          "text": "Naveen Balmik",
          "label": "OTHER_PERSON",
          "start": 2762,
          "end": 2775
        },
        {
          "text": "Sahu Aata Chakki",
          "label": "OTHER_PERSON",
          "start": 2824,
          "end": 2840
        },
        {
          "text": "Maan Ali",
          "label": "OTHER_PERSON",
          "start": 2856,
          "end": 2864
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2510613799095154
    },
    {
      "sentence_id": 23,
      "text": "She seated in the auto alongwith them.",
      "rhetorical_role": "FAC",
      "start": 2916,
      "end": 2954,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23771777749061584
    },
    {
      "sentence_id": 24,
      "text": "Auto was being driven by Naveen Balmik.",
      "rhetorical_role": "FAC",
      "start": 2955,
      "end": 2994,
      "entities": [
        {
          "text": "Naveen Balmik",
          "label": "OTHER_PERSON",
          "start": 2980,
          "end": 2993
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.28754982352256775
    },
    {
      "sentence_id": 25,
      "text": "They took her in the forest of Dehlan Chowki.",
      "rhetorical_role": "FAC",
      "start": 2995,
      "end": 3040,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24482807517051697
    },
    {
      "sentence_id": 26,
      "text": "In the forest, Maan Ali and Naveen Balmik committed rape upon her.",
      "rhetorical_role": "FAC",
      "start": 3041,
      "end": 3107,
      "entities": [
        {
          "text": "Maan Ali",
          "label": "OTHER_PERSON",
          "start": 3056,
          "end": 3064
        },
        {
          "text": "Naveen Balmik",
          "label": "OTHER_PERSON",
          "start": 3069,
          "end": 3082
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3130181133747101
    },
    {
      "sentence_id": 27,
      "text": "Thereafter, they brought her back and at around 1.30 P.M. dropped her near her rented room.",
      "rhetorical_role": "FAC",
      "start": 3108,
      "end": 3199,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.25119051337242126
    },
    {
      "sentence_id": 28,
      "text": "Same day at around 5.00 P.M., Maan Ali again made a call and pressurized her to go with him, when she refused his demand, after sometime Ghanshyam Rajak made a call and asked her to go alongwith him at Kishoriji Temple.",
      "rhetorical_role": "FAC",
      "start": 3200,
      "end": 3419,
      "entities": [
        {
          "text": "Maan Ali",
          "label": "OTHER_PERSON",
          "start": 3230,
          "end": 3238
        },
        {
          "text": "Ghanshyam Rajak",
          "label": "PETITIONER",
          "start": 3337,
          "end": 3352
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1778443455696106
    },
    {
      "sentence_id": 29,
      "text": "In the meantime, she heard the voice of Maan Ali stating that they have prepared her rape video and they will make the same viral.",
      "rhetorical_role": "FAC",
      "start": 3420,
      "end": 3550,
      "entities": [
        {
          "text": "Maan Ali",
          "label": "OTHER_PERSON",
          "start": 3460,
          "end": 3468
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.236587792634964
    },
    {
      "sentence_id": 30,
      "text": "Having no option, she went near Satna barrier where Maan Ali and Ghanshyam Rajak were standing on a motorcycle.",
      "rhetorical_role": "FAC",
      "start": 3551,
      "end": 3662,
      "entities": [
        {
          "text": "Maan Ali",
          "label": "OTHER_PERSON",
          "start": 3603,
          "end": 3611
        },
        {
          "text": "Ghanshyam Rajak",
          "label": "PETITIONER",
          "start": 3616,
          "end": 3631
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.25819170475006104
    },
    {
      "sentence_id": 31,
      "text": "They again took her in the forest where Maan Ali again attempted to commit rape upon her but she did not allow him thereafter Ghanshyam Rajak forcibly committed rape upon her and dropped her near Sahu Aata Chakki.",
      "rhetorical_role": "FAC",
      "start": 3663,
      "end": 3876,
      "entities": [
        {
          "text": "Maan Ali",
          "label": "OTHER_PERSON",
          "start": 3703,
          "end": 3711
        },
        {
          "text": "Ghanshyam Rajak",
          "label": "PETITIONER",
          "start": 3789,
          "end": 3804
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.26172953844070435
    },
    {
      "sentence_id": 32,
      "text": "In the night too, they repeatedly made calls but she did not attend their calls.",
      "rhetorical_role": "FAC",
      "start": 3877,
      "end": 3957,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.25049206614494324
    },
    {
      "sentence_id": 33,
      "text": "Thereafter, she narrated the story to her sister Shilpi and 1-2 other persons.",
      "rhetorical_role": "FAC",
      "start": 3958,
      "end": 4037,
      "entities": [
        {
          "text": "Shilpi",
          "label": "OTHER_PERSON",
          "start": 4008,
          "end": 4014
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22893430292606354
    },
    {
      "sentence_id": 34,
      "text": "F.I.R. was registered.",
      "rhetorical_role": "FAC",
      "start": 4038,
      "end": 4060,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.17450319230556488
    },
    {
      "sentence_id": 35,
      "text": "After investigation charge sheet has been filed.",
      "rhetorical_role": "FAC",
      "start": 4061,
      "end": 4110,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22720187902450562
    },
    {
      "sentence_id": 36,
      "text": "Learned counsel for the applicants have submitted that applicants have not committed any offence.",
      "rhetorical_role": "FAC",
      "start": 4111,
      "end": 4209,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21797655522823334
    },
    {
      "sentence_id": 37,
      "text": "They are innocent.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4210,
      "end": 4229,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3046552836894989
    },
    {
      "sentence_id": 38,
      "text": "They have been falsely implicated.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4230,
      "end": 4264,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2687656581401825
    },
    {
      "sentence_id": 39,
      "text": "No video of rape has been seized from them.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4265,
      "end": 4308,
      "entities": [],
      "in_summary": true,
