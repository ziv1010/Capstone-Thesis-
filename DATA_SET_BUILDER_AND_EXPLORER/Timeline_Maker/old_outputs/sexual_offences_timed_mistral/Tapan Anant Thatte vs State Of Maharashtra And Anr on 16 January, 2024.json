          "start": 803,
          "end": 831
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 11,
      "text": "The aforesaid crime was registered pursuant to the FIR lodged by Respondent No.2.",
      "rhetorical_role": "FAC",
      "start": 910,
      "end": 991,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4678087532520294
    },
    {
      "sentence_id": 12,
      "text": "The facts narrated in the FIR prima facie indicate that Respondent No.2 had indulged in sexual 37_wpst_17769_2023.doc relationship with the Petitioner during the subsistence of her marriage.",
      "rhetorical_role": "FAC",
      "start": 992,
      "end": 1182,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4415811598300934
    },
    {
      "sentence_id": 13,
      "text": "The records prima facie indicate that the relationship of the Petitioner and Respondent No.2, both adults was consensual.",
      "rhetorical_role": "PREAMBLE",
      "start": 1183,
      "end": 1304,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 14,
      "text": "Hence, further proceedings in Sessions Case No.836 of 2023 are stayed till the next date of hearing.",
