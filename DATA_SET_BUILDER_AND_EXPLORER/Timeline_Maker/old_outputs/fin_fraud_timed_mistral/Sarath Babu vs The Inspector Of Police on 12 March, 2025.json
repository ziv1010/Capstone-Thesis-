          "label": "COURT",
          "start": 1436,
          "end": 1467
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "4. In light of the submission made by the learned Government https://www.mhc.tn.gov.in/judis (\nUploaded on: 22/05/2025 01:24:10 pm ) Advocate (crl.side), this Court is of the view that the prayer sought in this petition cannot be granted.",
      "rhetorical_role": "NONE",
      "start": 1470,
      "end": 1708,
      "entities": [
        {
          "text": "22/05/2025",
          "label": "DATE",
          "start": 1578,
          "end": 1588
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 11,
      "text": "Accordingly, this Criminal Original Petition stands dismissed as infructuous.",
