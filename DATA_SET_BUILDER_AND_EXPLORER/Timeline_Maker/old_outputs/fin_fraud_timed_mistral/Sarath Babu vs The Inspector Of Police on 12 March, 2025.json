    },
    {
      "sentence_id": 8,
      "text": "2. Heard the learned counsel appearing on either side and perused the materials placed on record.\n3.",
      "rhetorical_role": "NONE",
      "start": 1141,
      "end": 1241,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "The learned Government Advocate (crl.side), on instructions, would submit that the investigation in Crime No.21 of 2023 has already been completed and the final report has been filed before the Judicial Magistrate, Thiruvarur.",
      "rhetorical_role": "NONE",
      "start": 1242,
      "end": 1468,
      "entities": [
        {
