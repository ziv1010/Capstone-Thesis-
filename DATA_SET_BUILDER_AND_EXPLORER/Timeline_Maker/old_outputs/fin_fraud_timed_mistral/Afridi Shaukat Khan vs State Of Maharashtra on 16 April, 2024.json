        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.10948208719491959
    },
    {
      "sentence_id": 10,
      "text": "One Louis Godad through his representative Kenny Godad had made a complaint that, he had received a call on 03.01.2021.",
      "rhetorical_role": "FAC",
      "start": 1135,
      "end": 1254,
      "entities": [
        {
          "text": "Louis Godad",
          "label": "OTHER_PERSON",
