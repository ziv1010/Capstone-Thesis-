      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15426744520664215
    },
    {
      "sentence_id": 8,
      "text": "He was working in the investigation and legal department to prevent Digitally signed by VINOD VINOD BHASKAR BHASKAR GOKHALE GOKHALE",
      "rhetorical_role": "FAC",
      "start": 940,
      "end": 1071,
