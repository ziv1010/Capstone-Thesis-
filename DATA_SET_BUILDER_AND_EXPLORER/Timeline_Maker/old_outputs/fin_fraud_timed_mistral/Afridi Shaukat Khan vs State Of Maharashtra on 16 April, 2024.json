          "end": 3760
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.03461018577218056
    },
    {
      "sentence_id": 35,
      "text": "Their statements show that, Shailesh Bhardwaj had started a company by the name P. J. Policy Junction Pvt. Ltd. at Phoenix Mall, Kurla (W).",
      "rhetorical_role": "FAC",
      "start": 3762,
      "end": 3902,
      "entities": [
        {
