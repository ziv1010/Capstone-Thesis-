          "end": 1150
        },
        {
          "text": "Kenny Godad",
          "label": "OTHER_PERSON",
          "start": 1178,
          "end": 1189
        },
        {
          "text": "03.01.2021",
          "label": "DATE",
          "start": 1243,
          "end": 1253
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1618577092885971
    },
    {
      "sentence_id": 11,
      "text": "The caller gave his name as Akubuddin.",
      "rhetorical_role": "FAC",
      "start": 1255,
      "end": 1293,
      "entities": [
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 1283,
          "end": 1292
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19642531871795654
    },
    {
      "sentence_id": 12,
      "text": "He told the informant's company's customer Louis that he was the Insurance Agent.",
      "rhetorical_role": "FAC",
      "start": 1294,
      "end": 1375,
      "entities": [
        {
          "text": "Louis",
          "label": "OTHER_PERSON",
          "start": 1337,
          "end": 1342
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20826351642608643
    },
    {
      "sentence_id": 13,
      "text": "The said customer Louis had two insurance policies and they were due for renewal.",
      "rhetorical_role": "FAC",
      "start": 1376,
      "end": 1457,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.23128493130207062
    },
    {
      "sentence_id": 14,
      "text": "Their premium was Afridi Shaukat Khan vs State Of Maharashtra on 16 April, 2024 Indian Kanoon - http://indiankanoon.org/doc/31392935/\n1 Rs.71348/- and Rs.50233/-.",
      "rhetorical_role": "FAC",
      "start": 1458,
      "end": 1620,
      "entities": [
        {
          "text": "Afridi Shaukat Khan vs State Of Maharashtra on 16 April, 2024 Indian Kanoon",
          "label": "PRECEDENT",
          "start": 1476,
          "end": 1551
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.09647180885076523
    },
    {
      "sentence_id": 15,
      "text": "Since the policy numbers and the names mentioned by Akubuddin were correct, the said customer believed him and deposited an amount of Rs.1,21,581/- in Akubuddin's account.",
      "rhetorical_role": "FAC",
      "start": 1621,
      "end": 1792,
      "entities": [
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 1673,
          "end": 1682
        },
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 1772,
          "end": 1781
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18435655534267426
    },
    {
      "sentence_id": 16,
      "text": "On 07.01.2021, Kenny Godad asked the Customer Care center of the informant's company regarding this.",
      "rhetorical_role": "FAC",
      "start": 1793,
      "end": 1893,
      "entities": [
        {
          "text": "07.01.2021",
          "label": "DATE",
          "start": 1796,
          "end": 1806
        },
        {
          "text": "Kenny Godad",
          "label": "OTHER_PERSON",
          "start": 1808,
          "end": 1819
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19266310334205627
    },
    {
      "sentence_id": 17,
      "text": "At that time, he was told that the informant's company had not given those policies.",
      "rhetorical_role": "FAC",
      "start": 1894,
      "end": 1978,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20547576248645782
    },
    {
      "sentence_id": 18,
      "text": "The said customer then called Akubuddin, who told him that he should withdraw the complaints regarding the policies and his money would be returned within 8 to 10 days in his account.",
      "rhetorical_role": "FAC",
      "start": 1979,
      "end": 2162,
      "entities": [
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 2009,
          "end": 2018
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.16663555800914764
    },
    {
      "sentence_id": 19,
      "text": "Based on this complaint, the informant's company's Fraud Control Unit investigated.",
      "rhetorical_role": "FAC",
      "start": 2163,
      "end": 2246,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19417184591293335
    },
    {
      "sentence_id": 20,
      "text": "It was found that the accused Akubuddin was working with the informant's company from May 2018 to September 2018 with the customer experience department.",
      "rhetorical_role": "FAC",
      "start": 2247,
      "end": 2400,
      "entities": [
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 2277,
          "end": 2286
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20989327132701874
    },
    {
      "sentence_id": 21,
      "text": "He 3 of 5 17-aba-290-24 had left the company and had joined Landmark Insurance Brokers Pvt. Ltd. from November 2018 to April 2019.",
      "rhetorical_role": "FAC",
      "start": 2401,
      "end": 2531,
      "entities": [
        {
          "text": "5 17-aba-290-24",
          "label": "DATE",
          "start": 2409,
          "end": 2424
        },
        {
          "text": "Landmark Insurance Brokers Pvt. Ltd.",
          "label": "ORG",
          "start": 2461,
          "end": 2497
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.14322516322135925
    },
    {
      "sentence_id": 22,
      "text": "The enquiry revealed that, some more customers were cheated in the same manner.",
      "rhetorical_role": "FAC",
      "start": 2532,
      "end": 2611,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18742269277572632
    },
    {
      "sentence_id": 23,
      "text": "Thus, total amount of this fraud was Rs.3,13,783/-.",
      "rhetorical_role": "FAC",
      "start": 2612,
      "end": 2664,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18850533664226532
    },
    {
      "sentence_id": 24,
      "text": "Further enquiry was made in the informant's company.",
      "rhetorical_role": "FAC",
      "start": 2665,
      "end": 2717,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.23290954530239105
    },
    {
      "sentence_id": 25,
      "text": "It was found that the Assistant Manager i.e. accused Fakruddin used to download that data and was giving it to Ijma Solutions Pvt. Ltd. owned by the accused Afridi i.e. the present applicant.",
      "rhetorical_role": "FAC",
      "start": 2718,
      "end": 2909,
      "entities": [
        {
          "text": "Fakruddin",
          "label": "OTHER_PERSON",
          "start": 2771,
          "end": 2780
        },
        {
          "text": "Ijma Solutions Pvt. Ltd.",
          "label": "ORG",
          "start": 2829,
          "end": 2853
        },
        {
          "text": "Afridi",
          "label": "PETITIONER",
          "start": 2875,
          "end": 2881
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21324647963047028
    },
    {
      "sentence_id": 26,
      "text": "Another employee Debhajit Rabha was also involved in such activities and used to make the data available to the applicant; who in turn used to supply it to Akubuddin and others which was misused to cheat the customers of the informant's company.",
      "rhetorical_role": "FAC",
      "start": 2910,
      "end": 3155,
      "entities": [
        {
          "text": "Debhajit Rabha",
          "label": "OTHER_PERSON",
          "start": 2927,
          "end": 2941
        },
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 3066,
          "end": 3075
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19112764298915863
    },
    {
      "sentence_id": 27,
      "text": "On this basis the F.I.R. was lodged.",
      "rhetorical_role": "FAC",
      "start": 3156,
      "end": 3192,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21075482666492462
    },
    {
      "sentence_id": 28,
      "text": "4. Learned counsel for the applicant submitted that the main accused Akubuddin was working in the said company up to September 2018 and, therefore, there was no reason why Akubuddin would take help of the present applicant Afridi to get the data from the company.",
      "rhetorical_role": "FAC",
      "start": 3194,
      "end": 3457,
      "entities": [
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 3263,
          "end": 3272
        },
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 3366,
          "end": 3375
        },
        {
          "text": "Afridi",
          "label": "PETITIONER",
          "start": 3417,
          "end": 3423
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.17937450110912323
    },
    {
      "sentence_id": 29,
      "text": "The allegations against him are baseless.",
      "rhetorical_role": "FAC",
      "start": 3458,
      "end": 3499,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.10760016739368439
    },
    {
      "sentence_id": 30,
      "text": "His custodial interrogation is not necessary.",
      "rhetorical_role": "ANALYSIS",
      "start": 3500,
      "end": 3545,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.10253649204969406
    },
    {
      "sentence_id": 31,
      "text": "4 of 5 17-aba-290-24 5.",
      "rhetorical_role": "FAC",
      "start": 3546,
      "end": 3570,
      "entities": [
        {
          "text": "17-aba-290-24",
          "label": "DATE",
          "start": 3554,
          "end": 3567
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.06096557900309563
    },
    {
      "sentence_id": 32,
      "text": "Learned APP opposed these submissions.",
      "rhetorical_role": "FAC",
      "start": 3571,
      "end": 3609,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.0377262681722641
    },
    {
      "sentence_id": 33,
      "text": "She produced the investigation papers before the Court.",
      "rhetorical_role": "FAC",
      "start": 3610,
      "end": 3665,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.10313163697719574
    },
    {
      "sentence_id": 34,
      "text": "She relied on the statements of Abid Ahmed Hussain Shaikh, Almora Khan and Shailesh Bharadwaj.",
      "rhetorical_role": "FAC",
      "start": 3666,
      "end": 3761,
      "entities": [
        {
          "text": "Abid Ahmed Hussain Shaikh",
          "label": "OTHER_PERSON",
          "start": 3699,
          "end": 3724
        },
        {
          "text": "Almora Khan",
          "label": "OTHER_PERSON",
          "start": 3726,
          "end": 3737
        },
        {
          "text": "Shailesh Bharadwaj",
          "label": "OTHER_PERSON",
