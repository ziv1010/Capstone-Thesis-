      "summary_sent_score": 0.2366771250963211
    },
    {
      "sentence_id": 9,
      "text": "Date:\n2024.04.18 16:10:04 +0530 2 of 5 17-aba-290-24 cheating.",
      "rhetorical_role": "FAC",
      "start": 1072,
      "end": 1134,
      "entities": [
        {
          "text": "2024.04.18",
          "label": "DATE",
