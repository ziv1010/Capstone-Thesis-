          "end": 3808
        },
        {
          "text": "P. J. Policy Junction Pvt. Ltd.",
          "label": "ORG",
          "start": 3843,
          "end": 3874
        },
        {
          "text": "Kurla",
          "label": "GPE",
          "start": 3892,
          "end": 3897
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.11799061298370361
    },
    {
      "sentence_id": 36,
      "text": "The applicant Afridi was a Manager and accused Akubuddin was the team leader.",
      "rhetorical_role": "FAC",
      "start": 3903,
      "end": 3980,
      "entities": [
        {
          "text": "Afridi",
          "label": "PETITIONER",
          "start": 3917,
          "end": 3923
        },
        {
          "text": "Akubuddin",
          "label": "OTHER_PERSON",
          "start": 3950,
          "end": 3959
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21127949655056
    },
    {
      "sentence_id": 37,
      "text": "Both of them had taken two SIM cards; out of which, one SIM card was used for committing this offence.",
      "rhetorical_role": "FAC",
      "start": 3981,
      "end": 4083,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1956852525472641
    },
    {
      "sentence_id": 38,
      "text": "While they were working in the said P. J. Policy Junction Pvt.\nLtd. they had opened an account and had linked it with PAY U link.",
      "rhetorical_role": "FAC",
      "start": 4084,
      "end": 4213,
      "entities": [
        {
          "text": "P. J. Policy Junction Pvt.\nLtd.",
          "label": "ORG",
          "start": 4120,
          "end": 4151
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21296487748622894
    },
