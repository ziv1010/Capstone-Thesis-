      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22552922368049622
    },
    {
      "sentence_id": 35,
      "text": "On completion of investigation, final report was submitted pending the investigation against the absconding accused applicant- Dharmendra Sahu.",
      "rhetorical_role": "FAC",
      "start": 3970,
      "end": 4113,
      "entities": [
