        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2602114975452423
    },
    {
      "sentence_id": 36,
      "text": "Learned Counsel for the applicant, in addition to the grounds mentioned in the application, submits that the applicant has been falsely implicated in this matter merely on the basis of statement of co-accused in police custody.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4114,
      "end": 4342,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2267768532037735
    },
    {
      "sentence_id": 37,
      "text": "Co-accused Laxmi Narayan and Sundar Bi have been extended benefit of bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4343,
      "end": 4417,
      "entities": [
        {
          "text": "Laxmi Narayan",
          "label": "OTHER_PERSON",
          "start": 4354,
          "end": 4367
        },
        {
          "text": "Sundar Bi",
          "label": "OTHER_PERSON",
          "start": 4372,
          "end": 4381
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.27955836057662964
    },
    {
      "sentence_id": 38,
      "text": "The prosecution against the applicant is based on information given by other co-accused in police custody.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4418,
      "end": 4524,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.5771978497505188
    },
    {
      "sentence_id": 39,
      "text": "There is no likelihood of tampering with the evidence by the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4525,
      "end": 4596,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.5404026508331299
    },
    {
      "sentence_id": 40,
      "text": "He is ready to cooperative in the investigation.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4597,
      "end": 4645,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4619988203048706
    },
    {
      "sentence_id": 41,
      "text": "Therefore, applicant may be extended the NEUTRAL CITATION NO. 2025:MPHC-IND:12281 4 MCRC-17134-2025 benefit of anticipatory bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4646,
      "end": 4775,
      "entities": [
        {
          "text": "NEUTRAL CITATION NO. 2025",
          "label": "CASE_NUMBER",
          "start": 4687,
          "end": 4712
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.500525176525116
    },
    {
      "sentence_id": 42,
      "text": "Per contra, learned Counsel for the State opposes the application on the ground of gravity of alleged offence.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4776,
      "end": 4887,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14943060278892517
    },
    {
      "sentence_id": 43,
      "text": "However, after going through the case diary, he fairly states that no criminal antecedent is reported against the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4888,
      "end": 5012,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.26570138335227966
    },
    {
      "sentence_id": 44,
      "text": "The applicant has been absconding since registration of FIR.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5013,
      "end": 5074,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4145335257053375
    },
    {
      "sentence_id": 45,
      "text": "He was not available for investigation despite his proposal to surrender at the time of rejection of earlier anticipatory bail application.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5075,
      "end": 5214,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3609103858470917
    },
    {
      "sentence_id": 46,
      "text": "The custodial interrogation of the applicant would be required for further investigation into forgery of the alleged documents.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5215,
      "end": 5342,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.5107786059379578
    },
    {
      "sentence_id": 47,
      "text": "His complicity in the alleged offence is prima facie revealed by the material on record.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5343,
      "end": 5431,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.5964636206626892
    },
    {
      "sentence_id": 48,
      "text": "Therefore, in view of above stated facts and the judgement of the Apex Court in the case of State of M.P. Vs. Pradeep Sharma reported in (2014) 2 SCC 171, the rare relief of anticipatory bail cannot be extended to the applicant.",
      "rhetorical_role": "PRE_RELIED",
