    },
    {
      "sentence_id": 34,
      "text": "Laxminarayan was arrested on 08.07.2024.",
      "rhetorical_role": "FAC",
      "start": 3929,
      "end": 3969,
      "entities": [
        {
          "text": "Laxminarayan",
