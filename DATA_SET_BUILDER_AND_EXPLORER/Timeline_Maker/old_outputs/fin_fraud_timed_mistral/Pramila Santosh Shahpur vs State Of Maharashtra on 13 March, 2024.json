        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "2. Heard Mr. Niranjan Kondyala, learned counsel for the Applicant and Ms. Rajeshree Newton,\nlearned APP for the Respondent-State.",
      "rhetorical_role": "NONE",
