          "end": 4522
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.04575738683342934
    },
    {
      "sentence_id": 51,
      "text": "They told him that they could give MGCM's room admeasuring 270 sq. ft. for Rs.25 Lakhs.",
