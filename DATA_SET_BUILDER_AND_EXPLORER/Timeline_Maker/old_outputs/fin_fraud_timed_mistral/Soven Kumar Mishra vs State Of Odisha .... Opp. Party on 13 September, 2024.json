    {
      "sentence_id": 5,
      "text": "It is submitted by the learned counsel for the State that the IIC concerned had sent the explanation, but the same is dated 08.09.2023.",
      "rhetorical_role": "PREAMBLE",
      "start": 905,
      "end": 1040,
