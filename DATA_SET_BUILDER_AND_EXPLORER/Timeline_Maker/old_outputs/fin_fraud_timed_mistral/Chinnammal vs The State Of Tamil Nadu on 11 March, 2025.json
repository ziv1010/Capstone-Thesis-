      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 12,
      "text": "3.The learned Government Advocate (Crl.Side) appearing for the respondent police would submit that the case is now posted for examination of witnesses L.W.1 to L.W.5 and the respondent police will co-operate for speedy disposal by producing the witnesses as directed by the trial Court.",
      "rhetorical_role": "NONE",
      "start": 1423,
      "end": 1710,
      "entities": [],
      "in_summary": false
    },
