    {
      "sentence_id": 5,
      "text": "This second petition under Section 438 Cr.P.C. for pre- arrest bail has been filed by the petitioner Kulpreet Singh, an accused in FIR No.380 dated 28.12.2018 under Sections 420, 120-B IPC,\nregistered with Police Station Shimlapuri, District Ludhiana.",
      "rhetorical_role": "PREAMBLE",
      "start": 529,
      "end": 780,
      "entities": [
        {
