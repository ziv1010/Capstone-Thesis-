    {
      "sentence_id": 5,
      "text": "Heard learned counsels for the parties.",
      "rhetorical_role": "NONE",
      "start": 283,
      "end": 322,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 6,
      "text": "The petitioners have alleged that their land was not  acquired at all despite which the National Highways  Authority of India is trying to encroach upon the same.",
      "rhetorical_role": "FAC",
      "start": 323,
      "end": 487,
      "entities": [
        {
          "text": "National Highways  Authority of India",
