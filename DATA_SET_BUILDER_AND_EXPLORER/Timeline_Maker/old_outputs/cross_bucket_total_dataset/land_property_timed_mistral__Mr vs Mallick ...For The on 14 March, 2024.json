          "start": 413,
          "end": 450
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3106875419616699
    },
    {
      "sentence_id": 7,
      "text": "The name of the predecessor-in-interest of the  petitioners is still recorded in the R.S. Record of Rights.",
      "rhetorical_role": "FAC",
      "start": 488,
      "end": 597,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.4077601432800293
    },
    {
      "sentence_id": 8,
      "text": "It transpires from the report in the form of affidavit  submitted on behalf of the State respondents that requisition under Section 3(1) of the West Bengal Land (Requisition & Acquisition) Act, 1948 was issued in respect of the plot in question on August 13, 1958 and declaration under Section 4(a) of the Act was published.",
      "rhetorical_role": "FAC",
      "start": 598,
      "end": 924,
      "entities": [
        {
          "text": "Section 3(1)",
          "label": "PROVISION",
