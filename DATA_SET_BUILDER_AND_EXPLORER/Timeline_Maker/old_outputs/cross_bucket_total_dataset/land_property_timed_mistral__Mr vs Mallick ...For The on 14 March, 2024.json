          "text": "Section 4(a)",
          "label": "PROVISION",
          "start": 886,
          "end": 898
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4814625084400177
    },
    {
      "sentence_id": 9,
      "text": "But there is no document to show that award was declared or compensation paid to the petitioners/their predecessor within the statutory period of time.",
      "rhetorical_role": "FAC",
