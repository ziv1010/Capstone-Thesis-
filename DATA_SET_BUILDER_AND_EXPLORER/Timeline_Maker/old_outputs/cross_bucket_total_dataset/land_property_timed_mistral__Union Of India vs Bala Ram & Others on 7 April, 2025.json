    },
    {
      "sentence_id": 75,
      "text": "Satyen Vaidya, Judge (oral):\nHeard.\n2.",
      "rhetorical_role": "PREAMBLE",
      "start": 4286,
      "end": 4325,
      "entities": [
        {
