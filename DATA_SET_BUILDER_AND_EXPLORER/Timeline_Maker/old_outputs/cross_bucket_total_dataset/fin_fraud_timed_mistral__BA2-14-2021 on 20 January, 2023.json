      "summary_sent_score": 0.15243899822235107
    },
    {
      "sentence_id": 6,
      "text": "He has been granted short term bail for one month, on 30.09.2021, on health ground.",
      "rhetorical_role": "FAC",
      "start": 518,
      "end": 601,
      "entities": [
        {
          "text": "30.09.2021",
          "label": "DATE",
          "start": 572,
          "end": 582
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3168870806694031
    },
    {
      "sentence_id": 7,
      "text": "Now, an application for extension of short term bail has been filed.",
      "rhetorical_role": "FAC",
      "start": 602,
      "end": 670,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2336837500333786
    },
    {
      "sentence_id": 8,
      "text": "Heard learned counsel for the parties.",
      "rhetorical_role": "NONE",
      "start": 672,
      "end": 710,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "Learned counsel for the applicant appeared through video conferencing.",
      "rhetorical_role": "NONE",
      "start": 711,
      "end": 781,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "It is argued that, in fact, the applicant is seriously unwell.",
      "rhetorical_role": "FAC",
      "start": 782,
      "end": 845,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1836436539888382
    },
    {
      "sentence_id": 11,
      "text": "He is suffering with Thrombocytopenia and has been referred to some Cancer Institute at Delhi or Mumbai.",
      "rhetorical_role": "FAC",
      "start": 846,
      "end": 950,
      "entities": [
        {
          "text": "Delhi",
          "label": "GPE",
          "start": 934,
          "end": 939
        },
        {
          "text": "Mumbai",
          "label": "GPE",
          "start": 943,
          "end": 949
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23225781321525574
    },
    {
      "sentence_id": 12,
      "text": "Reference has been made to annexure-4 to the short term bail extension application.",
      "rhetorical_role": "FAC",
      "start": 951,
      "end": 1034,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2527936100959778
    },
    {
      "sentence_id": 13,
      "text": "Having considered, this Court is of the view that short term bail granted to the applicant should be extended.",
      "rhetorical_role": "RPC",
      "start": 1036,
      "end": 1146,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.3773854970932007
    },
    {
      "sentence_id": 14,
      "text": "Keeping in view the heath condition of the applicant, short term bail is extended for another two months.",
      "rhetorical_role": "RPC",
      "start": 1147,
      "end": 1252,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.2816983759403229
    },
    {
      "sentence_id": 15,
      "text": "Time Extension Application (MCRC No.10/2023) is allowed accordingly.",
