      "summary_sent_score": 0.31006255745887756
    },
    {
      "sentence_id": 10,
      "text": "After investigation charge sheet was submitted.",
      "rhetorical_role": "FAC",
      "start": 1133,
      "end": 1180,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.25351157784461975
    },
    {
      "sentence_id": 11,
      "text": "The revisionist moved an application for discharge which has been rejected by the impugned order.",
