      "summary_sent_score": 0.43201714754104614
    },
    {
      "sentence_id": 12,
      "text": "Smt. Nunanisha @ Noornisha vs State Of U.P. And Another on 14 December, 2023 Indian Kanoon - http://indiankanoon.org/doc/46352434/\n1 4.",
      "rhetorical_role": "NONE",
      "start": 1279,
      "end": 1415,
      "entities": [
        {
