          "start": 1339,
          "end": 1356
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 13,
      "text": "Learned counsel for revisionist mainly contended that the revisionist is mother-in-law of the deceased and her living is separate.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1416,
      "end": 1546,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.3116827607154846
    },
    {
      "sentence_id": 14,
      "text": "It is further contended that Misc. Case No.13 of 2015 was filed by her under Section 7 G Guardians and Wards Act which also establishes that the revisionist is living separately.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1547,
      "end": 1725,
      "entities": [
        {
          "text": "Misc. Case No.13 of 2015",
          "label": "CASE_NUMBER",
          "start": 1576,
          "end": 1600
        },
        {
          "text": "Section 7",
          "label": "PROVISION",
          "start": 1624,
          "end": 1633
        },
        {
          "text": "G Guardians and Wards Act",
          "label": "STATUTE",
          "start": 1634,
          "end": 1659
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.3044344186782837
    },
    {
      "sentence_id": 15,
      "text": "Learned trial court has failed to consider it and has committed error in rejecting the discharge application.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1726,
      "end": 1835,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.30508700013160706
    },
    {
      "sentence_id": 16,
      "text": "5. Learned AGA and learned counsel for informant submitted that the defence of revisionist accused cannot be considered at this stage.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1836,
      "end": 1971,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.29271796345710754
    },
    {
      "sentence_id": 17,
      "text": "There is no illegality in the impugned order.",
      "rhetorical_role": "RATIO",
      "start": 1972,
      "end": 2017,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5469311475753784
    },
    {
      "sentence_id": 18,
      "text": "6. Perusal of FIR reveals that there are allegation which discloses cognizable offence and on the basis of the evidence collected during course of investigation charge sheet has been submitted.",
      "rhetorical_role": "RATIO",
      "start": 2018,
      "end": 2212,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4862113296985626
    },
    {
      "sentence_id": 19,
      "text": "It is well settled law that at the stage of framing of charge only prima facie case is to be seen.",
      "rhetorical_role": "RATIO",
      "start": 2213,
      "end": 2311,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5515297651290894
    },
    {
      "sentence_id": 20,
      "text": "Any defence version cannot be taken into consideration at this stage.",
      "rhetorical_role": "RATIO",
      "start": 2312,
      "end": 2381,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.49188297986984253
    },
    {
      "sentence_id": 21,
      "text": "So the ground on which discharge is sought cannot be considered at this stage.",
      "rhetorical_role": "RPC",
      "start": 2382,
      "end": 2460,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.5880740880966187
    },
    {
      "sentence_id": 22,
      "text": "However, it will be open for the revisionist to take his defence plea at an appropriate stage.",
      "rhetorical_role": "RPC",
      "start": 2461,
      "end": 2555,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.5333526134490967
    },
    {
      "sentence_id": 23,
      "text": "So there is no illegality in the impugned order.",
      "rhetorical_role": "RATIO",
      "start": 2556,
      "end": 2604,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6073595285415649
    },
    {
      "sentence_id": 24,
      "text": "7. Revision is devoid on merits and is hereby dismissed.",
      "rhetorical_role": "RPC",
      "start": 2605,
      "end": 2662,
