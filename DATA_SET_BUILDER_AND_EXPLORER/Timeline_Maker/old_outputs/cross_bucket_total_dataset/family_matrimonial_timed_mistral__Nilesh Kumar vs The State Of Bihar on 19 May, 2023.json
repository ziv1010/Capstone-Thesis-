    {
      "sentence_id": 17,
      "text": "Learned counsel for the petitioner submits that the petitioner is innocent and has falsely been implicated in the instant case.",
      "rhetorical_role": "PREAMBLE",
      "start": 1284,
      "end": 1412,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 18,
      "text": "Further submission is that the dispute has been resolved through the process of mediation and both the parties have mutually agreed upon the terms of settlement as contained in the mediation report at Flag-'B'.",
      "rhetorical_role": "PREAMBLE",
      "start": 1413,
      "end": 1623,
