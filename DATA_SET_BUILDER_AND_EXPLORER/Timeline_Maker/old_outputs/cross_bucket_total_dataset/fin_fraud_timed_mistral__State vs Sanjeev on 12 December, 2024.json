          "end": 4690
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 108,
      "text": "It is settled preposition that the prosecution has to prove the guilt of accused beyond all reasonable doubt and that too by leading independent, reliable and unimpeachable evidence.",
      "rhetorical_role": "NONE",
      "start": 4709,
      "end": 4891,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 109,
      "text": "There is no controversy to the proposition that the accused is entitled to the benefit of every doubt occurring in the prosecution case.",
      "rhetorical_role": "RATIO",
      "start": 4892,
      "end": 5028,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5452821254730225
    },
    {
      "sentence_id": 110,
      "text": "The general principles of criminal jurisprudence, namely, that the prosecution has to prove its case beyond reasonable doubt and that the accused is entitled to the benefit of a reasonable doubt, are to be borne in mind.",
      "rhetorical_role": "RATIO",
      "start": 5029,
      "end": 5249,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6387189626693726
    },
    {
      "sentence_id": 111,
      "text": "State vs Sanjeev on 12 December, 2024 Indian Kanoon - http://indiankanoon.org/doc/162982762/\n2 9)",
      "rhetorical_role": "NONE",
      "start": 5250,
      "end": 5348,
      "entities": [
        {
          "text": "State vs Sanjeev on 12 December, 2024 Indian Kanoon",
          "label": "PRECEDENT",
          "start": 5251,
          "end": 5302
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 112,
      "text": "In view of the above said discussion, the prosecution has failed to prove the charges u/s.420/471/511 IPC against the accused.",
      "rhetorical_role": "RATIO",
      "start": 5349,
      "end": 5475,
      "entities": [
        {
          "text": "s.420/471/511",
          "label": "PROVISION",
          "start": 5437,
          "end": 5450
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 5451,
          "end": 5454
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.39649689197540283
    },
    {
      "sentence_id": 113,
      "text": "Accordingly, benefit of doubt is given to accused and he is acquitted for the offences punishable U/s.420/471/511 IPC.",
      "rhetorical_role": "RPC",
      "start": 5476,
      "end": 5594,
      "entities": [
        {
          "text": "s.420/471/511",
          "label": "PROVISION",
          "start": 5576,
          "end": 5589
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 5590,
          "end": 5593
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.5235847234725952
    },
    {
      "sentence_id": 114,
      "text": "Bail bonds of the accused, if any,\nalready on record are hereby extended u/s.437A Cr.PC.",
      "rhetorical_role": "NONE",
      "start": 5595,
      "end": 5683,
      "entities": [
        {
          "text": "s.437A",
          "label": "PROVISION",
