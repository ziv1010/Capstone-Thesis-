      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 107,
      "text": "2024.12.12 16:50:34 +0530 8)",
      "rhetorical_role": "PREAMBLE",
      "start": 4679,
      "end": 4708,
      "entities": [
        {
          "text": "2024.12.12",
