    },
    {
      "sentence_id": 3,
      "text": "Opposite Party :- State of U.P.\nCounsel for Applicant :- Anil Kumar Dubey\nCounsel for Opposite Party :- G.A.\nHon'ble Samit Gopal,J.\n1.",
      "rhetorical_role": "PREAMBLE",
