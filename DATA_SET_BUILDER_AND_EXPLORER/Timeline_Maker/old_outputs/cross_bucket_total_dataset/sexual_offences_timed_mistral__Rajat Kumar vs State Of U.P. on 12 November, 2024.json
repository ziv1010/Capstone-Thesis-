          "end": 396
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 4,
      "text": "Heard Sri Anil Kumar Dubey, learned counsel for the applicant, Sri Birendra Pratap Singh,\nlearned counsel for the State and perused the material on record.",
      "rhetorical_role": "NONE",
      "start": 403,
      "end": 559,
