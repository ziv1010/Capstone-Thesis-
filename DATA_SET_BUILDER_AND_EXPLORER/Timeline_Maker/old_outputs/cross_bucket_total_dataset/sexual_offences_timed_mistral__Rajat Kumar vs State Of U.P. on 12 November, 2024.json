      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.12723441421985626
    },
    {
      "sentence_id": 43,
      "text": "It is further argued while placing paragraph 26 of the affidavit that the applicant is involved in 10 other cases and in the said cases he is on bail. Annexure-9 to the affidavit being the bail orders passed by the concerned court has been placed before the Court.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 6252,
      "end": 6516,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.08384649455547333
    },
    {
      "sentence_id": 44,
      "text": "The applicant is in jail since 18.04.2023.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 6517,
      "end": 6559,
      "entities": [
        {
          "text": "18.04.2023",
          "label": "DATE",
          "start": 6548,
          "end": 6558
        }
