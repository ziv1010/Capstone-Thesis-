      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1204117089509964
    },
    {
      "sentence_id": 42,
      "text": "It is further argued that co-accused Shahjad has been granted bail by this Court vide order dated 05.07.2023 passed in Criminal Misc. Bail Application No. 29224 of 2023, the copy of the said order is annexed as Annexure-10 to the affidavit.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 6011,
      "end": 6251,
      "entities": [
