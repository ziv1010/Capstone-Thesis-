      "summary_sent_score": 0.23582637310028076
    },
    {
      "sentence_id": 26,
      "text": "He is student of B.Sc. third year.",
      "rhetorical_role": "FAC",
      "start": 4672,
      "end": 4706,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19221797585487366
    },
    {
      "sentence_id": 27,
      "text": "Accused persons are the persons of criminal nature.",
      "rhetorical_role": "FAC",
      "start": 4707,
      "end": 4758,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.271808922290802
    },
    {
      "sentence_id": 28,
      "text": "They had enmity with his son due to his good carrier.",
      "rhetorical_role": "FAC",
      "start": 4759,
      "end": 4812,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.26926419138908386
    },
    {
      "sentence_id": 29,
      "text": "The deceased is of a backward caste carpenter.",
      "rhetorical_role": "FAC",
      "start": 4813,
      "end": 4859,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.27526113390922546
    },
    {
      "sentence_id": 30,
      "text": "The accused persons used to implicate his son due to which he was disturbed.",
      "rhetorical_role": "FAC",
      "start": 4860,
      "end": 4936,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.29524534940719604
    },
    {
      "sentence_id": 31,
      "text": "They used to instigate him for committing suicide.",
      "rhetorical_role": "FAC",
      "start": 4937,
      "end": 4987,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.28966858983039856
    },
    {
      "sentence_id": 32,
      "text": "His son recorded a video on his mobile and disclosed it.",
      "rhetorical_role": "FAC",
      "start": 4988,
      "end": 5044,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2838265299797058
    },
    {
      "sentence_id": 33,
      "text": "On 9.4.2023 at about 6:00 P.M. his son committed suicide on railway line between Kalakhedi gate and lalwala gate.",
      "rhetorical_role": "FAC",
      "start": 5045,
      "end": 5158,
      "entities": [
        {
          "text": "9.4.2023",
          "label": "DATE",
          "start": 5048,
          "end": 5056
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2501606047153473
    },
    {
      "sentence_id": 34,
      "text": "The first information report has been lodged.",
      "rhetorical_role": "FAC",
      "start": 5159,
      "end": 5204,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20114824175834656
    },
    {
      "sentence_id": 35,
      "text": "4. Learned counsel for the applicant argued that the applicant has been falsely implicated in the present case.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5206,
      "end": 5317,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.16368605196475983
    },
    {
      "sentence_id": 36,
      "text": "Learned counsel for the applicant argued that there is no abetment and instigation of any kind by the applicant which has any nexus with the death of the deceased.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5318,
      "end": 5481,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1369161307811737
    },
    {
      "sentence_id": 37,
      "text": "The applicant has no mens-rea at all.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5482,
      "end": 5519,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.25074440240859985
    },
    {
      "sentence_id": 38,
      "text": "There is no overt act whatsoever of the applicant which resulted in the death of the deceased, the applicant has no motive at all to commit the aforesaid offence.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5520,
      "end": 5682,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.22633740305900574
    },
    {
      "sentence_id": 39,
      "text": "The deceased committed suicide and died before a moving train.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5683,
      "end": 5745,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2814929187297821
    },
    {
      "sentence_id": 40,
      "text": "It is argued that applicant is not involved in the present case.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5746,
      "end": 5810,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.150831937789917
    },
    {
      "sentence_id": 41,
      "text": "It is argued that co-accused Jitendra @ Tata has been granted bail by the Additional Sessions Court, POCSO Act, Bijnor, vide order dated 19.06.2023 passed in Second Bail Application No. 1795 of 2023.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5811,
      "end": 6010,
      "entities": [
        {
          "text": "Jitendra @ Tata",
          "label": "PETITIONER",
          "start": 5840,
          "end": 5855
        },
        {
          "text": "Additional Sessions Court, POCSO Act, Bijnor",
          "label": "COURT",
          "start": 5885,
          "end": 5929
        },
        {
          "text": "19.06.2023",
          "label": "DATE",
          "start": 5948,
          "end": 5958
        },
        {
          "text": "Second Bail Application No. 1795 of 2023",
          "label": "CASE_NUMBER",
