          "label": "OTHER_PERSON",
          "start": 471,
          "end": 492
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 5,
      "text": "2. Learned counsel for the applicant submits that he had taken time for filing supplementary affidavit but he does not intend to file any supplementary affidavit.",
      "rhetorical_role": "NONE",
      "start": 561,
      "end": 723,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 6,
      "text": "3. This second bail application under Section 439 of Code of Criminal Procedure has been filed by the applicant Rajat Kumar, seeking enlargement on bail during trial in connection with Case Crime No. 113 of 2023, under Section 306 I.P.C., registered at Police Station Nagina, District Bijnor.",
      "rhetorical_role": "FAC",
      "start": 724,
      "end": 1017,
      "entities": [
        {
