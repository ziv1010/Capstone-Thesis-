          "end": 1212
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 33,
      "text": "3. There is allegation of torture and harassment due to non-fulfillment of demand of dowry .",
      "rhetorical_role": "PREAMBLE",
      "start": 1215,
      "end": 1308,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 34,
      "text": "4. Petitioner is mother-in-law of the victim.",
      "rhetorical_role": "PREAMBLE",
      "start": 1309,
      "end": 1355,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 35,
      "text": "She is separate in mess and property.",
      "rhetorical_role": "PREAMBLE",
      "start": 1356,
      "end": 1393,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 36,
      "text": "Allegation of harassment is general and omnibus.",
      "rhetorical_role": "PREAMBLE",
      "start": 1394,
      "end": 1442,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 37,
      "text": "Thrust of accusation is against the husband of the victim.",
      "rhetorical_role": "PREAMBLE",
      "start": 1443,
      "end": 1501,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 38,
      "text": "Petitioner claims clean antecedent.",
