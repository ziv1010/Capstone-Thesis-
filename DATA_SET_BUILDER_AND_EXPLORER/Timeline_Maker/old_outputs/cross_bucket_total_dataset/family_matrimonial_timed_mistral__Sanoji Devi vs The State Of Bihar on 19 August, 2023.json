      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 32,
      "text": "2. Petitioner apprehends arrest in a case registered for the offence punishable under sections 498A and 504 of the Indian Penal Code .",
      "rhetorical_role": "PREAMBLE",
      "start": 1079,
      "end": 1214,
      "entities": [
