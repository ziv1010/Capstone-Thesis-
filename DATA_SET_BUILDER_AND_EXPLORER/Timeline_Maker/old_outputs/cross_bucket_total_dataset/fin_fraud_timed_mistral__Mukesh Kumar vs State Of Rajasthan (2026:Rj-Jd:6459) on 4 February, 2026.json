    {
      "sentence_id": 24,
      "text": "1 For Petitioner(s) : Mr. Piyush Chouhan For Respondent(s) : Mr. Vikram Singh Rajpurohit, PP  HON'BLE MR. JUSTICE BALJINDER SINGH SANDHU Order 04/02/2026",
      "rhetorical_role": "PREAMBLE",
      "start": 1854,
      "end": 2007,
      "entities": [
        {
          "text": "Piyush Chouhan",
          "label": "LAWYER",
          "start": 1880,
          "end": 1894
        },
        {
          "text": "Vikram Singh Rajpurohit",
          "label": "LAWYER",
