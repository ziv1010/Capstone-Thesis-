    {
      "sentence_id": 23,
      "text": "Mantu Mandal And Ors. vs State Of Bihar And Anr on 16 February, 2023 Indian Kanoon - http://indiankanoon.org/doc/75511744/\n1",
      "rhetorical_role": "PREAMBLE",
      "start": 1898,
      "end": 2023,
      "entities": [
        {
          "text": "Mantu Mandal And Ors. vs State Of Bihar And Anr",
          "label": "PRECEDENT",
          "start": 1899,
          "end": 1946
        },
        {
          "text": "16 February, 2023",
          "label": "DATE",
          "start": 1950,
          "end": 1967
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 24,
      "text": "The notice was validly served upon the opposite party no. 2 but no one has appeared for the opposite party no.2 .",
      "rhetorical_role": "PREAMBLE",
      "start": 2024,
      "end": 2137,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 25,
      "text": "It seems that because of the compromise, the OP No. 2 is not appearing and the O.P. No. 2 has lost interest in the case.\nIn that view of the matter, the case is being heard on merits.\nConsidering the compromise between the parties in the divorce case, there is no point in keeping the criminal prosecution pending between the parties.\nIn these circumstances, this application is allowed.",
      "rhetorical_role": "PREAMBLE",
      "start": 2138,
      "end": 2526,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 26,
      "text": "The order dated 24.05.2012 passed in Complaint Case No. 748C of 2011 by Sub-Divisional Magistrate, Khagaria is hereby quashed.",
      "rhetorical_role": "PREAMBLE",
      "start": 2527,
