      "end": 692,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 13,
      "text": "We have considered the materials on record.",
      "rhetorical_role": "NONE",
      "start": 693,
      "end": 737,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 14,
      "text": "Statements of witnesses show housewife was tortured over demands of dowry and committed suicide within five months of marriage.",
      "rhetorical_role": "NONE",
      "start": 738,
      "end": 865,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 15,
      "text": "Petitioner is the husband of the housewife.",
