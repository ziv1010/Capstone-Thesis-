      "start": 866,
      "end": 910,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 16,
      "text": "Under such circumstances, we are of the opinion this is not a fit case to grant bail to the petitioner at this stage.",
      "rhetorical_role": "RPC",
      "start": 911,
      "end": 1029,
