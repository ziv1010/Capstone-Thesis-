      "end": 1065,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.44105470180511475
    },
    {
      "sentence_id": 9,
      "text": "Taking note of the long incarceration, we are of the view that the appellant can be released on bail subject to the terms and conditions to be imposed by the Trial Court.",
