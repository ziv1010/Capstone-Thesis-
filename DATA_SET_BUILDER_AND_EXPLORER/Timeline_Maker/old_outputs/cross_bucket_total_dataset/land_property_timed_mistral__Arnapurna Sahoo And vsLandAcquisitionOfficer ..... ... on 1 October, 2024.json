        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "It appears from the Annexure-1 that the Arbitrator and Collector, Cuttack vide order dated 20.04.2022 passed in Arbitration Case No.95 of 2016 directed the Special Land Acquisition Officer and Competent Authority (opposite party no.1) to recalculate the amount of compensation due to the petitioner as per the New Act and to pay the differential amount within a period of six weeks.",
      "rhetorical_role": "PREAMBLE",
      "start": 1002,
      "end": 1385,
      "entities": [
        {
          "text": "Cuttack",
          "label": "GPE",
