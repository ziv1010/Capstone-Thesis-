        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "On the asking of the Court, Mr. B.S. Virk, Sr. D.A.G., Haryana accepts notice on behalf of respondents no.1 to 4.",
      "rhetorical_role": "NONE",
      "start": 825,
      "end": 939,
      "entities": [
        {
          "text": "B.S. Virk",
          "label": "OTHER_PERSON",
          "start": 858,
          "end": 867
        },
        {
          "text": "Haryana",
          "label": "GPE",
