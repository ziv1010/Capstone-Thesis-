          "end": 888
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 8,
      "text": "At the outset, learned counsel for the petitioner submits that he would be satisfied, if, the present petition is disposed of with a direction to the competent authority to take a decision on the representation dated 10.5.2023 (Annexure P-2) already submitted by the petitioner expeditiously and in a time bound manner.",
      "rhetorical_role": "NONE",
      "start": 940,
      "end": 1260,
      "entities": [
        {
          "text": "10.5.2023",
          "label": "DATE",
          "start": 1158,
          "end": 1167
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "I find the prayer to be just and reasonable.",
      "rhetorical_role": "NONE",
      "start": 1261,
      "end": 1306,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "In view of the above position, present petition is disposed of with a direction to respondent no.3 i.e.\nS.P., Narnaul at Mahendergarh to decide the representation date 10.5.2023 (Annexure P-2) already submitted by the petitioner within a period of one month from today in accordance with law.",
