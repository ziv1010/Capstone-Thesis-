    {
      "sentence_id": 5,
      "text": "2. Heard Mr. Aditya Singh, learned counsel for the applicants and Mr. Akshay Latwal, learned Assistant Government Advocate for the respondent no.1.",
      "rhetorical_role": "NONE",
      "start": 637,
      "end": 784,
