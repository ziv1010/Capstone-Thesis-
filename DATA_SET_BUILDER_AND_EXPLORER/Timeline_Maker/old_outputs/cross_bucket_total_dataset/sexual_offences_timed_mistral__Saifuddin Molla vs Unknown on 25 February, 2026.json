      "summary_sent_score": 0.1667589247226715
    },
    {
      "sentence_id": 30,
      "text": "In re : CRA (DB) 327 of 2025 10.",
      "rhetorical_role": "NONE",
      "start": 2457,
      "end": 2489,
      "entities": [
