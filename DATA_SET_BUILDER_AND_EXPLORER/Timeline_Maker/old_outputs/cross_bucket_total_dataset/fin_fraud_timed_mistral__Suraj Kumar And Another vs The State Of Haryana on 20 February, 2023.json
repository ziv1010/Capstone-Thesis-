      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.40220677852630615
    },
    {
      "sentence_id": 37,
      "text": "In view of what has been discussed in the preceding paragraphs, custodial interrogation of the petitioners is required to unearth the truth.",
      "rhetorical_role": "ANALYSIS",
      "start": 4239,
      "end": 4380,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2448698729276657
    },
    {
      "sentence_id": 38,
      "text": "Suraj Kumar And Another vs The State Of Haryana on 20 February, 2023 Indian Kanoon - http://indiankanoon.org/doc/110194752/\n2",
      "rhetorical_role": "NONE",
      "start": 4381,
      "end": 4507,
      "entities": [
        {
          "text": "Suraj Kumar And Another vs The State Of Haryana",
          "label": "PRECEDENT",
