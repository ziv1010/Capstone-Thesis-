      "summary_section": "arguments",
      "summary_sent_score": 0.24123002588748932
    },
    {
      "sentence_id": 11,
      "text": "He also contends that the criminal cases registered against the applicant are since 2009.",
      "rhetorical_role": "ARG_RESPONDENT",
