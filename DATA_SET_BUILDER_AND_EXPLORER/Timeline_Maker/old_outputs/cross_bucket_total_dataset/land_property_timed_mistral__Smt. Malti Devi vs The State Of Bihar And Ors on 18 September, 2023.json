    {
      "sentence_id": 39,
      "text": "From the counter affidavit it transpires to this Court that counter affidavit has been filed by the Sate in the year 2016, seven year is lapsed.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3217,
      "end": 3361,
