          "end": 2392
        },
        {
          "text": "26.07.2010",
          "label": "DATE",
          "start": 2397,
          "end": 2407
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1890925168991089
    },
    {
      "sentence_id": 36,
      "text": "Counsel further submits that the transfer of the land was handed over to the BIADA who has submitted the requisition for acquisition by the District Land Acquisition Officer, Patna on 17.10.2008 which has been annexed as Annexure-R-2/6 (page-27, running page- 84).",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2409,
      "end": 2673,
      "entities": [
        {
          "text": "BIADA",
          "label": "ORG",
          "start": 2486,
          "end": 2491
        },
        {
          "text": "Patna",
          "label": "GPE",
          "start": 2584,
          "end": 2589
        },
        {
          "text": "17.10.2008",
          "label": "DATE",
          "start": 2593,
          "end": 2603
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.16975721716880798
    },
    {
      "sentence_id": 37,
      "text": "Counsel further submits that one piece of land which is subject to sale deed dated 18.09.1997 was transferred in favour of the petitioner prior to transfer of possession, whereas the land which was purchased by the petitioner on 26.07.2010 was registered after the date of transfer of land.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2674,
      "end": 2964,
      "entities": [
        {
          "text": "18.09.1997",
          "label": "DATE",
          "start": 2757,
          "end": 2767
        },
        {
          "text": "26.07.2010",
          "label": "DATE",
          "start": 2903,
          "end": 2913
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.23057129979133606
    },
    {
      "sentence_id": 38,
      "text": "Counsel further submits that under Section 16 and 17 of the Land Acquisition Act the title was transferred in favour of the BIADA, therefore, Patna High Court CWJC No.15119 of 2015(4)\ndt.18-09-2023 any transfer of the said date is void- ab-initio.\n4.",
