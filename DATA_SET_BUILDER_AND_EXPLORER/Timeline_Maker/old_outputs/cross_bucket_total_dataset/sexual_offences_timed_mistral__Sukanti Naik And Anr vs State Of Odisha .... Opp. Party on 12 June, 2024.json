      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 8,
      "text": "1. .  2. Heard learned counsel for the petitioner and learned Addl.\nStanding Counsel for the State.\n3.",
      "rhetorical_role": "PREAMBLE",
      "start": 440,
      "end": 542,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "The petitioners are apprehending arrest in connection with Dhenkanal Motonga P.S. Case No.134 of 2024 corresponding to C.T.(Spl.) (P) No. 8/2024 pending in the Court of learned Addl. Sessions Judge-cum-Special Judge, POCSO, Dhenkanal for the alleged commission of offence under Sections 376(2)(n)/294/ 323/506/34 of IPC read with Section 6 of POCSO Act.",
      "rhetorical_role": "PREAMBLE",
