      "summary_section": "facts",
      "summary_sent_score": 0.12826687097549438
    },
    {
      "sentence_id": 24,
      "text": "Counsel for the private respondent submits that the petitioner went to the residence of the private respondent on 3rd January, 2023 along with four CISF personnel, who were carrying loaded weapons to threaten and intimidate him.",
      "rhetorical_role": "FAC",
      "start": 2098,
      "end": 2327,
      "entities": [
