      "in_summary": false
    },
    {
      "sentence_id": 13,
      "text": "The petitioner is aggrieved by investigation into Fir No.13/23 dated 24th January, 2023 under\nSections 376, 354C, 323, 506 of the Ipc along with provisions of the Sc & St (Prevention of\nAtrocities) Act registered by the Techno City Police Station under the Bidhannagar Police\nCommissionerate.",
      "rhetorical_role": "FAC",
      "start": 479,
      "end": 773,
      "entities": [
        {
          "text": "Sc & St (Prevention of\nAtrocities) Act",
          "label": "STATUTE",
          "start": 643,
          "end": 681
        },
        {
          "text": "Bidhannagar Police\nCommissionerate",
          "label": "ORG",
          "start": 737,
          "end": 771
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.30163028836250305
    },
    {
      "sentence_id": 14,
      "text": "The petitioner had lodged a complaint on 6th January, 2023 against the accused person and sent the same by post to the Taltala Police Station.",
      "rhetorical_role": "FAC",
      "start": 773,
      "end": 915,
      "entities": [
        {
          "text": "6th January, 2023",
          "label": "DATE",
          "start": 814,
          "end": 831
        },
        {
          "text": "Taltala Police Station",
          "label": "ORG",
          "start": 892,
          "end": 914
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4573647379875183
    },
    {
      "sentence_id": 15,
      "text": "Zero FIR was registered on 11th January, 2023.",
      "rhetorical_role": "FAC",
      "start": 916,
      "end": 962,
      "entities": [
        {
          "text": "11th January, 2023",
          "label": "DATE",
          "start": 943,
          "end": 961
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.28087377548217773
    },
    {
      "sentence_id": 16,
      "text": "FIR was forwarded to the Commissioner of Police, Bidhannagar Police Commissionerate and subsequently was taken up by the Techno City Police Station on 24th January, 2023.",
      "rhetorical_role": "FAC",
      "start": 963,
      "end": 1133,
      "entities": [
        {
          "text": "Bidhannagar Police Commissionerate",
          "label": "ORG",
          "start": 1012,
          "end": 1046
        },
        {
