      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1704038381576538
    },
    {
      "sentence_id": 25,
      "text": "Curiously, this Court notes that the accused persons had filed complaint of theft against the petitioner on 14th January, 2023.",
      "rhetorical_role": "FAC",
