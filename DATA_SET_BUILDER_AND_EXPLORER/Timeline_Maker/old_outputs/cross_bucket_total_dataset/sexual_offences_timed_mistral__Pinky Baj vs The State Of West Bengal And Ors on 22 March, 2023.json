      "summary_section": "facts",
      "summary_sent_score": 0.09926069527864456
    },
    {
      "sentence_id": 23,
      "text": "The Commissioner of Police, Bidhannagar Police Commissionerate shall also ensure that the objectionable videos and photographs of the petitioner are seized and not made public by the accused or any other person.",
      "rhetorical_role": "FAC",
      "start": 1885,
      "end": 2097,
