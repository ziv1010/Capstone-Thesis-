      "start": 1208,
      "end": 1347,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3741700351238251
    },
    {
      "sentence_id": 20,
      "text": "He paid money in advance till 2.12.2016, however, he has not received the gold bars.",
      "rhetorical_role": "FAC",
      "start": 1348,
      "end": 1432,
      "entities": [
        {
