      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 6,
      "text": "Being aggrieved by the rejection of his application for bail U/s.439 Cr.P.C. by the learned Additional Sessions Judge, Sonepur by order dated 13.09.2023 in the aforementioned case, the present BLAPL has been filed.",
      "rhetorical_role": "PREAMBLE",
      "start": 683,
      "end": 897,
      "entities": [
        {
          "text": "s.439",
          "label": "PROVISION",
