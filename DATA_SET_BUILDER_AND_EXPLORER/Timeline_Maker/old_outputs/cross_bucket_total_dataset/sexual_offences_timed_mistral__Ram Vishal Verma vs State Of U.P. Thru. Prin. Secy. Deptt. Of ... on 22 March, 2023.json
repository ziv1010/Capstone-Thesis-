          "end": 988
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 8,
      "text": "The aforesaid case has been registered on the basis of F.I.R. lodged on 06.09.2022 stating that the applicant had enticed away the informant's daughter on 03.09.2022 and that his daughter had taken away jewellery worth about Rs.1,32,000/- and Rs. 84,500/- cash with her.",
      "rhetorical_role": "PREAMBLE",
      "start": 990,
      "end": 1261,
      "entities": [
        {
          "text": "06.09.2022",
          "label": "DATE",
          "start": 1063,
          "end": 1073
        },
        {
          "text": "03.09.2022",
          "label": "DATE",
          "start": 1146,
          "end": 1156
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "In the statement of the alleged victim recorded under Section 161 Cr.P.C., she stated that on 03.09.2022, she had gone by train to Lucknow and from their she went to Delhi and ultimately she went to Ahmadabad.",
      "rhetorical_role": "PREAMBLE",
      "start": 1262,
      "end": 1471,
      "entities": [
        {
          "text": "Section 161",
          "label": "PROVISION",
          "start": 1316,
          "end": 1327
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 1328,
          "end": 1335
        },
        {
          "text": "03.09.2022",
          "label": "DATE",
          "start": 1356,
          "end": 1366
        },
        {
          "text": "Lucknow",
          "label": "GPE",
          "start": 1393,
          "end": 1400
        },
        {
          "text": "Delhi",
          "label": "GPE",
          "start": 1428,
          "end": 1433
        },
        {
          "text": "Ahmadabad",
          "label": "GPE",
          "start": 1461,
          "end": 1470
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "She also stated that the applicant reached Ahmadabad station and took the victim with him.",
      "rhetorical_role": "PREAMBLE",
      "start": 1472,
      "end": 1562,
      "entities": [
        {
          "text": "Ahmadabad",
          "label": "GPE",
          "start": 1515,
          "end": 1524
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 11,
      "text": "He further stated that she lived with the applicant as his wife.",
      "rhetorical_role": "PREAMBLE",
      "start": 1563,
      "end": 1627,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 12,
      "text": "Ram Vishal Verma vs State Of U.P. Thru. Prin. Secy. Deptt. Of ... on 22 March, 2023 Indian Kanoon - http://indiankanoon.org/doc/141047909/\n1",
      "rhetorical_role": "PREAMBLE",
