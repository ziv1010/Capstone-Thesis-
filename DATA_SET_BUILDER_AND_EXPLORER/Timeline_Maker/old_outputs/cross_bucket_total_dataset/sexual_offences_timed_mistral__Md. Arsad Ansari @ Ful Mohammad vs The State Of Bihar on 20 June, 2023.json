    {
      "sentence_id": 38,
      "text": "It is a case of committing rape by the petitioner upon the informant, aged about 18 years resulting into her pregnancy and birth of a child.",
      "rhetorical_role": "PREAMBLE",
      "start": 1276,
      "end": 1417,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 39,
      "text": "Learned counsel appearing on behalf of the petitioner has submitted that petitioner is innocent and has committed no offence.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1418,
      "end": 1544,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.15277868509292603
    },
    {
      "sentence_id": 40,
      "text": "Due to non-payment of tution fee, as demanded by the petitioner, the present malacious prosecution has been lodged Patna High Court CR. MISC. No.72864 of 2022(4)\ndt.20-06-2023 against the petitioner.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1545,
      "end": 1744,
      "entities": [
        {
          "text": "Patna High Court",
          "label": "COURT",
          "start": 1660,
          "end": 1676
        },
        {
          "text": "CR. MISC. No.72864 of 2022(4)",
          "label": "CASE_NUMBER",
          "start": 1677,
          "end": 1706
        },
        {
          "text": "dt.20-06-2023",
          "label": "DATE",
          "start": 1707,
          "end": 1720
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.20664182305335999
    },
    {
      "sentence_id": 41,
      "text": "Petitioner has got no criminal antecedent and he is languishing in judicial custody since 6.8.2022.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1745,
      "end": 1844,
      "entities": [
        {
          "text": "6.8.2022",
          "label": "DATE",
          "start": 1835,
          "end": 1843
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.26715201139450073
    },
    {
      "sentence_id": 42,
      "text": "Learned APP appearing for the State has opposed the prayer of bail and submitted that there is Md. Arsad Ansari @ Ful Mohammad vs The State Of Bihar on 20 June, 2023 Indian Kanoon - http://indiankanoon.org/doc/26147515/\n1 specific allegation of commission of rape against the petitioner.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1846,
      "end": 2133,
      "entities": [
        {
          "text": "Md. Arsad Ansari @ Ful Mohammad vs The State Of Bihar",
          "label": "PRECEDENT",
          "start": 1941,
          "end": 1994
        },
        {
          "text": "20 June, 2023",
          "label": "DATE",
          "start": 1998,
          "end": 2011
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2755533456802368
    },
    {
      "sentence_id": 43,
      "text": "He has ruined the life of the victim girl.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2134,
      "end": 2176,
      "entities": [],
