      "end": 1340,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "It is alleged that on false promise of marriage, this petitioner established physical relation with the informant and subsequently, refused to marry her.",
