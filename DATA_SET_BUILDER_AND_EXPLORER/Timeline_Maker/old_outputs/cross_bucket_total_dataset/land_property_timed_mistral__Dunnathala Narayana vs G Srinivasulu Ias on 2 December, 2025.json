          "label": "DATE",
          "start": 4430,
          "end": 4440
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 43,
      "text": "For non-compliance of the said order, present contempt case has been filed.",
