    {
      "sentence_id": 13,
      "text": "Heard learned counsel for the petitioners, learned counsel for the State of Bihar and learned counsel for the Patna High Court.\n2.",
      "rhetorical_role": "NONE",
      "start": 728,
      "end": 859,
      "entities": [
