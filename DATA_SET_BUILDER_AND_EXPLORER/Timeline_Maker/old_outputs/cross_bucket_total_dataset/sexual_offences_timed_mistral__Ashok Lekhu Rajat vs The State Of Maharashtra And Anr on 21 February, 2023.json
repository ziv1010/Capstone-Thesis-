      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "This is an application as second attempt by the Applicant to seek bail during pendency of this Criminal Appeal No.1394 of 2019.",
      "rhetorical_role": "FAC",
      "start": 619,
      "end": 747,
      "entities": [
        {
          "text": "Criminal Appeal No.1394 of 2019",
          "label": "CASE_NUMBER",
          "start": 715,
          "end": 746
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.17722934484481812
    },
    {
      "sentence_id": 11,
      "text": "Earlier he had filed Criminal Interim Application No.778 of 2020.",
      "rhetorical_role": "FAC",
      "start": 748,
      "end": 813,
      "entities": [
        {
          "text": "Criminal Interim Application No.778 of 2020",
          "label": "CASE_NUMBER",
          "start": 769,
          "end": 812
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.23151615262031555
    },
    {
      "sentence_id": 12,
      "text": "That application was dismissed as withdrawn as is recorded in the order dated 03/05/2021.\n2.",
      "rhetorical_role": "FAC",
      "start": 814,
      "end": 907,
      "entities": [
        {
          "text": "03/05/2021",
          "label": "DATE",
          "start": 893,
          "end": 903
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1958751082420349
    },
    {
      "sentence_id": 13,
      "text": "Today, learned counsel for Applicant could not point out a single change in circumstance except passage of time.",
      "rhetorical_role": "NONE",
      "start": 908,
      "end": 1020,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 14,
      "text": "The Digitally signed by Applicant was convicted for commission of offence punishable MANUSHREE MANUSHREE V NESARIKAR V NESARIKAR Date:\n2023.02.23 14:56:32 +0530 Nesarikar 2/3 03-IA-1969-22-IN-APEAL-1394-19.odt u/s 4 and 6 of the Protection of Children from Sexual Offences Act, 2012 and u/s 376 of the Indian Penal Code.",
      "rhetorical_role": "NONE",
      "start": 1021,
      "end": 1341,
      "entities": [
        {
          "text": "MANUSHREE MANUSHREE V NESARIKAR V NESARIKAR",
          "label": "PRECEDENT",
          "start": 1106,
          "end": 1149
        },
        {
