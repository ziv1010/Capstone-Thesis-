      "sentence_id": 8,
      "text": "3. The petitioner is said to have enticed away 14 years old victim to leave her lawful guardianship.",
      "rhetorical_role": "PREAMBLE",
      "start": 902,
      "end": 1002,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "She was taken to various places in Uttar Pradesh.",
      "rhetorical_role": "PREAMBLE",
      "start": 1003,
      "end": 1053,
      "entities": [
        {
          "text": "Uttar Pradesh",
