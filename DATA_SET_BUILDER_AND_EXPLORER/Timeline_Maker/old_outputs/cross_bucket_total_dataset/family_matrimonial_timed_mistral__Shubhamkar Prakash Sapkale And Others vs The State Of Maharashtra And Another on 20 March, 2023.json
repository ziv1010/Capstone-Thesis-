      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 20,
      "text": "Applicants are seeking quashment of the crime registered at the instance of respondent No.2, who happens to be the wife of applicant No.1, being FIR No.433 of 2021, for the ofence punishable under Section 498A of the Indian Penal Code.",
      "rhetorical_role": "PREAMBLE",
      "start": 1956,
      "end": 2191,
      "entities": [
