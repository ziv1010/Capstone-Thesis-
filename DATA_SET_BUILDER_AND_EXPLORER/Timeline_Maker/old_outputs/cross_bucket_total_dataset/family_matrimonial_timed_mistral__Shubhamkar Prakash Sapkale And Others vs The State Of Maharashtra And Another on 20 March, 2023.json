          "end": 2190
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 21,
      "text": "Rest of the applicants are relatives of applicant No.1 husband.",
      "rhetorical_role": "PREAMBLE",
      "start": 2192,
      "end": 2255,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 22,
      "text": "3. Respondent No.2 has fled afdavit inter alia mentioning that she alongwith applicant No.1 husband have resolved to amicably settle the dispute.",
      "rhetorical_role": "PREAMBLE",
      "start": 2256,
      "end": 2402,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 23,
      "text": "Even a decree of divorce has been obtained with consent under Section 13B of the Hindu Marriage Act and she consents for quashment of the FIR.",
