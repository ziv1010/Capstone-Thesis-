      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2177174985408783
    },
    {
      "sentence_id": 44,
      "text": "She,\n therefore, submitted that, it is wrongly assumed that the applicant  is in-charge of the affairs of the said firm.",
