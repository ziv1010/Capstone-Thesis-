      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.11047986149787903
    },
    {
      "sentence_id": 20,
      "text": "He met the accused Milind  Sawant and Rupesh Shah.",
      "rhetorical_role": "FAC",
      "start": 1884,
      "end": 1934,
      "entities": [
        {
          "text": "Milind",
          "label": "OTHER_PERSON",
