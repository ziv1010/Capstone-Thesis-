      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.09697539359331131
    },
    {
      "sentence_id": 21,
      "text": "Both of them told the informant that  they were the Proprietors and Partners of that entity and supported  what Pranay had told the informant.",
      "rhetorical_role": "FAC",
      "start": 1935,
      "end": 2077,
      "entities": [
