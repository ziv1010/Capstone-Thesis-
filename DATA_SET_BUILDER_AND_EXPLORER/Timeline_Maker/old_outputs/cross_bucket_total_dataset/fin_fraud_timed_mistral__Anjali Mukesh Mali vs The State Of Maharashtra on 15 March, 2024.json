      "summary_sent_score": 0.11611907184123993
    },
    {
      "sentence_id": 16,
      "text": "Pranay told the informant  that if the investment was made in that company, they were giving  5% to 7% returns per month.",
      "rhetorical_role": "FAC",
      "start": 1503,
      "end": 1624,
      "entities": [
        {
          "text": "Pranay",
