      "summary_sent_score": 0.09111694246530533
    },
    {
      "sentence_id": 31,
      "text": "The  informant invested some further amount in that account.",
      "rhetorical_role": "FAC",
      "start": 3036,
      "end": 3096,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1481466144323349
    },
    {
      "sentence_id": 32,
      "text": "Accused  Rupesh executed an agreement in August 2020 mentioning that  they were to give Rs.1 lakh per month on the investment of Rs.20  lakhs.",
