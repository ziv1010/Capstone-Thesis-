      "summary_section": "facts",
      "summary_sent_score": 0.16539999842643738
    },
    {
      "sentence_id": 34,
      "text": ",\n however, that cheque was dishonoured.",
      "rhetorical_role": "FAC",
      "start": 3355,
      "end": 3395,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.136932834982872
    },
    {
      "sentence_id": 35,
      "text": "Nothing was returned to  the informant.",
