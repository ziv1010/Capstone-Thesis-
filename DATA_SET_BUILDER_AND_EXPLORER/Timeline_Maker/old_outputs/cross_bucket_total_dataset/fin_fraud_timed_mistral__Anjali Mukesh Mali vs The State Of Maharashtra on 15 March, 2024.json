          "end": 1631
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.11921713501214981
    },
    {
      "sentence_id": 18,
      "text": "He further told the informant that the present  applicant was his maternal cousin and she was working with that  company since past eight years.",
      "rhetorical_role": "FAC",
      "start": 1674,
      "end": 1818,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.06933587789535522
    },
    {
      "sentence_id": 19,
      "text": "The informant went to the  company's office at Roha in May 2019.",
