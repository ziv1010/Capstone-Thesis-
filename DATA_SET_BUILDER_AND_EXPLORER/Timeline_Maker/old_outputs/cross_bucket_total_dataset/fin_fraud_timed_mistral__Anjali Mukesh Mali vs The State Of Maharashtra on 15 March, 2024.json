      "text": "The informant transferred  various amounts in that account.",
      "rhetorical_role": "FAC",
      "start": 2323,
      "end": 2382,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.17444966733455658
