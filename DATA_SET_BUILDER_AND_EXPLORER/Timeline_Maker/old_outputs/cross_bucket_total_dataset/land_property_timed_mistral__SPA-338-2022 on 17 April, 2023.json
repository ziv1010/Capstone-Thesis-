        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 6,
      "text": "Counsel for the THDC : Mr. Shobhit Saharia, learned counsel.",
      "rhetorical_role": "NONE",
      "start": 488,
      "end": 548,
      "entities": [
        {
          "text": "THDC",
