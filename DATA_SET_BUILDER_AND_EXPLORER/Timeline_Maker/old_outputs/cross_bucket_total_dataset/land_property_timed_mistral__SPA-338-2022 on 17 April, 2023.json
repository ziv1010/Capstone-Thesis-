          "start": 515,
          "end": 530
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "Upon hearing the learned Counsel, the Court made the following ORDER:\n(per Sri Vipin Sanghi, C.J.)",
      "rhetorical_role": "NONE",
      "start": 550,
      "end": 648,
      "entities": [
        {
          "text": "Vipin Sanghi",
          "label": "JUDGE",
          "start": 629,
          "end": 641
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 8,
      "text": "The report has been filed by the Tehsildar, as per which the land in Khata No. 26 comprising of Khasra Nos. 897, 901, 903, 904, 911, 912, 913, 917, 920, 922 and 930 is recorded in the name of respondent-THDC India Private Limited.",
      "rhetorical_role": "FAC",
      "start": 649,
      "end": 879,
      "entities": [
        {
          "text": "Khata",
          "label": "GPE",
          "start": 718,
          "end": 723
        },
        {
          "text": "Khasra Nos. 897, 901, 903, 904, 911, 912, 913, 917, 920, 922 and 930",
          "label": "CASE_NUMBER",
          "start": 745,
          "end": 813
        },
        {
          "text": "THDC India Private Limited",
          "label": "RESPONDENT",
          "start": 852,
          "end": 878
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.07187400758266449
    },
    {
      "sentence_id": 9,
      "text": "At the same time, the THDC India Private Limited is not in possession and even the appellants were not found in possession at the site.",
      "rhetorical_role": "FAC",
      "start": 880,
      "end": 1015,
      "entities": [
        {
          "text": "THDC India Private Limited",
          "label": "RESPONDENT",
          "start": 902,
          "end": 928
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.24222823977470398
    },
    {
      "sentence_id": 10,
      "text": "Upon inspection, it was found that the THDC India Private Limited has not undertaken any activities on the land, and the THDC India Private Limited has also not dealt with the land.",
      "rhetorical_role": "FAC",
      "start": 1016,
      "end": 1198,
      "entities": [
        {
          "text": "THDC India Private Limited",
          "label": "RESPONDENT",
          "start": 1056,
          "end": 1082
        },
        {
          "text": "THDC India Private Limited",
          "label": "RESPONDENT",
          "start": 1138,
          "end": 1164
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23866693675518036
    },
    {
      "sentence_id": 11,
      "text": "2. The appellants are claiming compensation on the ground that the land was acquired for the purpose of THDC India Private Limited.",
      "rhetorical_role": "FAC",
      "start": 1199,
      "end": 1331,
      "entities": [
        {
          "text": "THDC India Private Limited",
          "label": "RESPONDENT",
          "start": 1304,
          "end": 1330
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.37822484970092773
    },
    {
      "sentence_id": 12,
      "text": "Though the appellants have placed on record the Notification issued under Section 4, read with Section 17, of the Land Acquisition Act, 1894, the appellants have not placed on record any documents as regards the acquisition proceedings.",
      "rhetorical_role": "FAC",
      "start": 1332,
      "end": 1568,
      "entities": [
        {
          "text": "Section 4",
          "label": "PROVISION",
          "start": 1406,
          "end": 1415
        },
        {
          "text": "read with Section 17",
          "label": "PROVISION",
          "start": 1417,
          "end": 1437
        },
        {
          "text": "Land Acquisition Act, 1894",
          "label": "STATUTE",
          "start": 1446,
          "end": 1472
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.152330219745636
    },
    {
      "sentence_id": 13,
      "text": "3. Learned counsel for the appellants seeks time to produce certain documents in that regard.",
      "rhetorical_role": "NONE",
      "start": 1570,
      "end": 1663,
      "entities": [],
      "in_summary": false
