          "start": 2985,
          "end": 3006
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2184002548456192
    },
    {
      "sentence_id": 23,
      "text": "Therefore,\napplicant be extended the benefit of anticipatory bail.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3008,
      "end": 3074,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.32241693139076233
    },
    {
      "sentence_id": 24,
      "text": "5. Per contra, learned Counsel for the State, ably assisted by learned counsel for the objector,\nopposes the bail application on the ground of gravity of alleged offence.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3076,
      "end": 3246,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.12890860438346863
    },
    {
      "sentence_id": 25,
      "text": "Learned counsel further contends that despite proposed resignation dated 07.07.2021, applicant Nitin Chandilya continued as Director of M/s. Shubh Riddhi Agri Foods Product Pvt. Ltd..",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3247,
      "end": 3430,
      "entities": [
        {
          "text": "07.07.2021",
          "label": "DATE",
          "start": 3320,
          "end": 3330
        },
        {
          "text": "Nitin Chandilya",
          "label": "PETITIONER",
          "start": 3342,
          "end": 3357
        },
        {
          "text": "Shubh Riddhi Agri Foods Product Pvt. Ltd",
          "label": "ORG",
          "start": 3388,
          "end": 3428
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.16422556340694427
    },
    {
      "sentence_id": 26,
      "text": "He had signed the MOU in question dated 18.07.2022 in capacity of Director and Share-holder.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3431,
      "end": 3523,
      "entities": [
        {
          "text": "18.07.2022",
          "label": "DATE",
          "start": 3471,
          "end": 3481
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.32635948061943054
    },
    {
      "sentence_id": 27,
      "text": "Further, the NEUTRAL CITATION NO.\n2026:MPHC-IND:3423 3 MCRC-944-2026 Balance-sheet of year 2022-23 of M/s. Shubh Riddhi Agri Foods Product Pvt. Ltd. also bears signature of Nitin Chandilya as Director of the firm.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3524,
      "end": 3737,
      "entities": [
        {
          "text": "NEUTRAL CITATION NO.\n2026:MPHC-IND:3423 3 MCRC-944-2026",
          "label": "CASE_NUMBER",
          "start": 3537,
          "end": 3592
        },
        {
          "text": "Shubh Riddhi Agri Foods Product Pvt. Ltd.",
          "label": "ORG",
          "start": 3631,
          "end": 3672
        },
        {
          "text": "Nitin Chandilya",
          "label": "PETITIONER",
          "start": 3697,
          "end": 3712
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.06126507371664047
    },
    {
      "sentence_id": 28,
      "text": "The firm M/s. Shubh Riddhi Agri Foods Product Pvt. Ltd. has received the subsidy of Rs.6,27,52,000/- for the claim year 2022-23 on application filed by Nitin Chandilya and Mukesh Kumar Jain as authorized signatory of the firm.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3738,
      "end": 3964,
      "entities": [
        {
          "text": "Shubh Riddhi Agri Foods Product Pvt. Ltd.",
          "label": "ORG",
          "start": 3752,
          "end": 3793
        },
        {
          "text": "Nitin Chandilya",
          "label": "PETITIONER",
          "start": 3890,
          "end": 3905
        },
        {
          "text": "Mukesh Kumar Jain",
          "label": "OTHER_PERSON",
          "start": 3910,
          "end": 3927
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.21811290085315704
    },
    {
      "sentence_id": 29,
      "text": "It goes to show that applicant Nitin Chandilya continued as Director of the firm.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3965,
      "end": 4046,
      "entities": [
        {
          "text": "Nitin Chandilya",
          "label": "PETITIONER",
          "start": 3996,
          "end": 4011
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.22943703830242157
    },
    {
      "sentence_id": 30,
      "text": "The investigation is underway.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4047,
      "end": 4077,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1988462209701538
    },
    {
      "sentence_id": 31,
      "text": "The applicant did not cooperate in the investigation.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4078,
      "end": 4131,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.313760906457901
    },
    {
      "sentence_id": 32,
      "text": "Therefore, the applicant may not be extended benefit of anticipatory bail.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4132,
      "end": 4206,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.24455419182777405
    },
    {
      "sentence_id": 33,
      "text": "However,\nafter going through the case diary, he fairly states that no criminal antecedent is reported against the applicant.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4207,
      "end": 4331,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1410633623600006
    },
    {
      "sentence_id": 34,
      "text": "He further states that the applicant is aged around 35 years and is a businessman by profession.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4332,
      "end": 4428,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.17441976070404053
    },
    {
      "sentence_id": 35,
      "text": "6. Heard both the parties and perused the case diary.\n7.",
      "rhetorical_role": "ANALYSIS",
      "start": 4430,
      "end": 4486,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1810482293367386
    },
    {
      "sentence_id": 36,
      "text": "As per accusation on c ase diary, Bhupendra Kumar Dangi filed a written complaint before the Court of Judicial Magistrate First Class, Jaora in District Ratlam inter-alia alleging cheating and fraud against 11 named accused.",
      "rhetorical_role": "ANALYSIS",
      "start": 4487,
      "end": 4711,
      "entities": [
        {
          "text": "Bhupendra Kumar Dangi",
          "label": "OTHER_PERSON",
          "start": 4521,
          "end": 4542
        },
        {
          "text": "Court of Judicial Magistrate First Class, Jaora",
          "label": "COURT",
          "start": 4580,
          "end": 4627
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.19729696214199066
    },
    {
      "sentence_id": 37,
      "text": "It is alleged that Mukesh Chandilya and Nitin Chandilya (\napplicant) induced him to invest in business on promise of handsome profit.",
