          "end": 2575
        },
        {
          "text": "471",
          "label": "PROVISION",
          "start": 2580,
          "end": 2583
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 2587,
          "end": 2590
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2751290798187256
    },
    {
      "sentence_id": 18,
      "text": "Learned counsel further submits that applicant enjoys good character and social standing.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2613,
      "end": 2702,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.12199357151985168
    },
    {
      "sentence_id": 19,
      "text": "Jail incarceration on false accusation would cause hardship to the applicant and his family.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 2703,
      "end": 2795,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.24905730783939362
    },
    {
      "sentence_id": 20,
      "text": "The investigation is almost complete.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 2796,
      "end": 2833,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.252096951007843
    },
    {
      "sentence_id": 21,
      "text": "He is ready to cooperate in investigation.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 2834,
      "end": 2876,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.21152420341968536
    },
    {
      "sentence_id": 22,
      "text": "Co-accused Malka Devi has been extended benefit of anticipatory bail vide order dated 11.12.2025, passed in M.Cr.C. No.50595/2025.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 2877,
      "end": 3007,
      "entities": [
        {
          "text": "Malka Devi",
          "label": "OTHER_PERSON",
          "start": 2888,
          "end": 2898
        },
        {
