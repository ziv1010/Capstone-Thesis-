          "label": "DATE",
          "start": 1912,
          "end": 1922
        },
        {
          "text": "07.07.2021",
          "label": "DATE",
          "start": 1926,
          "end": 1936
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2119213044643402
    },
    {
      "sentence_id": 13,
      "text": "Therefore, he cannot be held responsible for the conduct of business of M/s. Shubh Riddhi Agri Foods Product Pvt. Ltd. after 07.07.2021.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1938,
      "end": 2074,
      "entities": [
        {
          "text": "Shubh Riddhi Agri Foods Product Pvt. Ltd.",
          "label": "ORG",
          "start": 2015,
          "end": 2056
        },
        {
          "text": "07.07.2021",
          "label": "DATE",
          "start": 2063,
          "end": 2073
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.31254497170448303
    },
    {
      "sentence_id": 14,
      "text": "Learned counsel further referring to the MOU in dispute dated 18.07.2022 submits that the interest of complainant Bhupendra Dangi have been protected in the MOU.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2075,
      "end": 2236,
      "entities": [
        {
          "text": "18.07.2022",
          "label": "DATE",
          "start": 2137,
          "end": 2147
        },
        {
          "text": "Bhupendra Dangi",
          "label": "OTHER_PERSON",
          "start": 2189,
          "end": 2204
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.17553597688674927
    },
    {
      "sentence_id": 15,
      "text": "No wrongful loss was suffered by Bhupendra Dangi and no wrongful gain was received by applicant Nitin Chandilya.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2237,
      "end": 2349,
      "entities": [
        {
          "text": "Bhupendra Dangi",
          "label": "OTHER_PERSON",
          "start": 2270,
          "end": 2285
        },
        {
          "text": "Nitin Chandilya",
          "label": "PETITIONER",
          "start": 2333,
          "end": 2348
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3351598381996155
    },
    {
      "sentence_id": 16,
      "text": "Therefore, the offence of cheating is not made out.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2350,
      "end": 2402,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3461955785751343
    },
    {
      "sentence_id": 17,
      "text": "Learned counsel further submits that there is no documents to suggest fraudulent transaction by applicant Nitin Chandilya, therefore, the offence alleged under Sections 468 and 471 of IPC is also not made out.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2403,
      "end": 2612,
      "entities": [
        {
          "text": "Nitin Chandilya",
          "label": "PETITIONER",
          "start": 2509,
          "end": 2524
        },
        {
          "text": "Sections 468",
          "label": "PROVISION",
