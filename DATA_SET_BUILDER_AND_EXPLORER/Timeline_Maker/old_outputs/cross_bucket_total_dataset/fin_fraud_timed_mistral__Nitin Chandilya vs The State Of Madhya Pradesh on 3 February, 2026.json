          "end": 1535
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.13303394615650177
    },
    {
      "sentence_id": 11,
      "text": "Therefore,\nhis capacity remains as share-holder in the firm.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1537,
      "end": 1597,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.30631399154663086
    },
    {
      "sentence_id": 12,
      "text": "Learned counsel referring to the print out from the Nitin Chandilya vs The State Of Madhya Pradesh on 3 February, 2026 Indian Kanoon - http://indiankanoon.org/doc/170899353/\n1 website of the Ministry of Corporate Affairs dated 27.01.2016 contends that applicant Nitin Chandilya is shown as Director for the period 30.06.2014 to 07.07.2021.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1598,
      "end": 1937,
      "entities": [
        {
          "text": "Nitin Chandilya vs The State Of Madhya Pradesh",
          "label": "PRECEDENT",
          "start": 1650,
          "end": 1696
        },
