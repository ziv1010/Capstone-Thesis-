      "rhetorical_role": "NONE",
      "start": 1025,
      "end": 1137,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "4. Learned Counsel for the applicant, in addition to the grounds mentioned in the application,\nsubmits that applicant has been falsely implicated in this matter merely.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1138,
      "end": 1307,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.182886004447937
    },
    {
      "sentence_id": 8,
      "text": "It is a business dispute inter se between the relatives.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1308,
      "end": 1364,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.39649832248687744
    },
    {
      "sentence_id": 9,
      "text": "The applicant - Nitin Chandilya had resigned from M/s. Shubh Riddhi Agri Foods Product Pvt. Ltd.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1365,
      "end": 1462,
      "entities": [
        {
          "text": "Nitin Chandilya",
          "label": "PETITIONER",
          "start": 1381,
          "end": 1396
        },
        {
          "text": "Shubh Riddhi Agri Foods Product Pvt. Ltd.",
          "label": "ORG",
          "start": 1420,
          "end": 1461
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.34664472937583923
    },
    {
      "sentence_id": 10,
      "text": "NEUTRAL CITATION NO. 2026:MPHC-IND:3423 2 MCRC-944-2026 w.e.f. 07.07.2021.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1462,
      "end": 1536,
      "entities": [
        {
          "text": "NEUTRAL CITATION NO. 2026",
