      "end": 1254,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.13823038339614868
    },
    {
      "sentence_id": 12,
      "text": "The deceased is the legally wedded wife of the accused and their marriage was solemnized on 08.07.2012.",
      "rhetorical_role": "FAC",
      "start": 1254,
      "end": 1357,
      "entities": [
        {
          "text": "08.07.2012",
          "label": "DATE",
          "start": 1346,
          "end": 1356
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.401177316904068
    },
    {
      "sentence_id": 13,
      "text": "The accused demanded and received cash of Rs.2,50,000/- and gold worth Rs.1,50,000/- as  3 S.C.No.714/2019 dowry.",
      "rhetorical_role": "FAC",
      "start": 1358,
      "end": 1471,
      "entities": [
        {
          "text": "S.C.No.714/2019",
          "label": "CASE_NUMBER",
          "start": 1449,
          "end": 1464
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4149632453918457
    },
    {
      "sentence_id": 14,
      "text": "After marriage, the husband and wife were residing at Benson Town.",
      "rhetorical_role": "FAC",
      "start": 1472,
      "end": 1538,
      "entities": [
        {
          "text": "Benson Town",
          "label": "GPE",
          "start": 1526,
          "end": 1537
