      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4316902160644531
    },
    {
      "sentence_id": 15,
      "text": "She gave birth to male child.",
      "rhetorical_role": "FAC",
      "start": 1539,
      "end": 1568,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.48718076944351196
    },
    {
      "sentence_id": 16,
      "text": "Later, the accused had developed illicit relationship,\nneglected the deceased and treated her with physical and mental cruelty.",
      "rhetorical_role": "FAC",
      "start": 1569,
      "end": 1697,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5529283881187439
    },
    {
      "sentence_id": 17,
      "text": "He used to consume alcohol and demanded divorce.",
      "rhetorical_role": "FAC",
      "start": 1698,
      "end": 1746,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4499872326850891
    },
    {
      "sentence_id": 18,
      "text": "So, the deceased was residing with her parents.",
      "rhetorical_role": "FAC",
      "start": 1747,
      "end": 1794,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.48528212308883667
    },
    {
