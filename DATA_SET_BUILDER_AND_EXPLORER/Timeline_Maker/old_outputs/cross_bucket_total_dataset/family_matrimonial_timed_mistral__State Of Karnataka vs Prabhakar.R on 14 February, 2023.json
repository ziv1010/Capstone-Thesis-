      "text": "The accused had sent divorce notice to the deceased.",
      "rhetorical_role": "FAC",
      "start": 1795,
      "end": 1847,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.48698529601097107
    },
    {
      "sentence_id": 20,
      "text": "Without bearing the torture and cruelty,\non 12.12.2017, she hanged herself and committed suicide.",
      "rhetorical_role": "FAC",
      "start": 1848,
      "end": 1945,
      "entities": [
        {
