    },
    {
      "sentence_id": 8,
      "text": "3. A lady, aged about 35 years, has lodged the report against one Arjun alleging the offence of rape.",
      "rhetorical_role": "FAC",
      "start": 886,
      "end": 987,
      "entities": [
        {
          "text": "Arjun",
          "label": "OTHER_PERSON",
