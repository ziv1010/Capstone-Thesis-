          "end": 957
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.24379317462444305
    },
    {
      "sentence_id": 9,
      "text": "Both applicants are sons of main accused Arjun.",
      "rhetorical_role": "FAC",
      "start": 989,
      "end": 1036,
      "entities": [
        {
          "text": "Arjun",
          "label": "OTHER_PERSON",
          "start": 1030,
          "end": 1035
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22384563088417053
    },
    {
      "sentence_id": 10,
      "text": "As regards the applicants, the informant stated that both applicants also threatened her on telephone.",
      "rhetorical_role": "FAC",
      "start": 1037,
      "end": 1139,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.07237464189529419
    },
    {
      "sentence_id": 11,
      "text": "4. It is argued that the entire allegations are against Arjun with which applicants have nothing to do.",
      "rhetorical_role": "FAC",
      "start": 1141,
      "end": 1244,
      "entities": [
        {
          "text": "Arjun",
          "label": "OTHER_PERSON",
          "start": 1197,
          "end": 1202
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.14806011319160461
    },
    {
      "sentence_id": 12,
      "text": "Only because the applicants are sons of Arjun, they have been falsely implicated to pressurize their father Arjun.",
      "rhetorical_role": "PREAMBLE",
      "start": 1245,
      "end": 1360,
      "entities": [
        {
          "text": "Arjun",
          "label": "OTHER_PERSON",
