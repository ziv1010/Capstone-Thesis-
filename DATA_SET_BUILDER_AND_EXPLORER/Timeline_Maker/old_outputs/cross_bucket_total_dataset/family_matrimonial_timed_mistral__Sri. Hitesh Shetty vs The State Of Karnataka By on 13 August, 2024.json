    {
      "sentence_id": 10,
      "text": "This Court, on 18.06.2024 had passed a peremptory order, which reads as follows:\n\"Two weeks time is granted to comply with the office objections, failing which,\npetition would be dismissed without reference to the Bench.",
      "rhetorical_role": "PREAMBLE",
      "start": 2176,
      "end": 2396,
      "entities": [
        {
          "text": "18.06.2024",
          "label": "DATE",
