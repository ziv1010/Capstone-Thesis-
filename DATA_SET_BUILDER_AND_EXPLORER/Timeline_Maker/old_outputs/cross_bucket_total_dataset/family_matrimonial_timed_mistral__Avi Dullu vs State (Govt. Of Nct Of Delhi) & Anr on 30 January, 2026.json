      ],
      "in_summary": false
    },
    {
      "sentence_id": 15,
      "text": "Mr. Ashwani Kumar Sharma, learned counsel, accepts notice on behalf of respondent No.\n2.\n3.",
      "rhetorical_role": "NONE",
