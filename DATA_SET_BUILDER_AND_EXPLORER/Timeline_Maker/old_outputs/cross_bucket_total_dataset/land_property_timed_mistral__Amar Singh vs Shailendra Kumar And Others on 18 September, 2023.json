    {
      "sentence_id": 7,
      "text": "Learned counsel appearing for the Revenue-respondent submits that the requisite rules under 'The Jammu and Kashmir Right to Fair Compensation and Transparency in Land Acquisition,\nRehabilitation and Resettlement Act, 2013' have been framed and notified and that the process for the acquisition of the land of the petitioner shall be initiated.",
      "rhetorical_role": "NONE",
      "start": 596,
      "end": 939,
      "entities": [
        {
          "text": "Jammu and Kashmir Right to Fair Compensation and Transparency in Land Acquisition,\nRehabilitation and Resettlement Act, 2013",
          "label": "STATUTE",
