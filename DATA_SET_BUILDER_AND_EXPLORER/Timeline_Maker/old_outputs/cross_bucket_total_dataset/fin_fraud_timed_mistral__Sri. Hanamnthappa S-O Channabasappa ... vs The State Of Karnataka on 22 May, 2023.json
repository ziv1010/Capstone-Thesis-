      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 11,
      "text": "Heard Sri Shivakumar S.Badawadagi, learned counsel for petitioner and Sri Anil Kale, learned counsel for respondent No.1.\n2. Petition under Section 482 Cr.P.C. as against the respondent/Anti Corruption Bureau.",
      "rhetorical_role": "PREAMBLE",
      "start": 1702,
      "end": 1911,
      "entities": [
        {
