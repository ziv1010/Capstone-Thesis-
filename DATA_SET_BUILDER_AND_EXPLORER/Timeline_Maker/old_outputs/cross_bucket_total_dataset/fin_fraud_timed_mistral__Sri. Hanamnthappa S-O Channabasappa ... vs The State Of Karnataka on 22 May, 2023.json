          "start": 1842,
          "end": 1853
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 1854,
          "end": 1861
        },
        {
          "text": "Anti Corruption Bureau",
          "label": "ORG",
          "start": 1888,
          "end": 1910
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 12,
      "text": "By virtue of the order passed by the Division Bench of Karnataka High Court, very constitution of the ACB has ceased to be in existence.",
      "rhetorical_role": "PREAMBLE",
      "start": 1912,
      "end": 2048,
      "entities": [
        {
          "text": "Karnataka High Court",
          "label": "COURT",
          "start": 1967,
          "end": 1987
        },
        {
          "text": "ACB",
          "label": "COURT",
          "start": 2014,
          "end": 2017
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 13,
      "text": "Accordingly, the petition has become infructuous and no orders can be passed as against respondent No.1.\n3.",
      "rhetorical_role": "PREAMBLE",
      "start": 2049,
      "end": 2156,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 14,
      "text": "However at this juncture, Sri Shivakumar S.Badawadagi expresses his apprehension that the Lokayukta may proceed against the petitioner.",
      "rhetorical_role": "PREAMBLE",
      "start": 2157,
      "end": 2292,
      "entities": [
        {
          "text": "Shivakumar S.Badawadagi",
          "label": "OTHER_PERSON",
          "start": 2187,
          "end": 2210
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 15,
      "text": "If there is any such proceeding as against the petitioner by the Lokayukta in view of the fact that ACB is not in existence, petitioner is at liberty to file necessary petition and obtain necessary orders in accordance with law.",
      "rhetorical_role": "PREAMBLE",
      "start": 2293,
      "end": 2521,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
