      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 5,
      "text": "Learned counsel for the parties contend that the criminal proceedings arise out of matrimonial dispute.",
      "rhetorical_role": "PREAMBLE",
      "start": 612,
      "end": 715,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 6,
      "text": "The parties have arrived at a compromise which has been reduced to writing and the opposite party no. 2 does not want to press the prosecution.",
      "rhetorical_role": "NONE",
      "start": 716,
      "end": 859,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "The compromise has been verified by the learned trial court.",
      "rhetorical_role": "PREAMBLE",
      "start": 860,
      "end": 920,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 8,
      "text": "Learned AGA does not dispute the aforesaid fact on the basis of instructions.",
      "rhetorical_role": "PREAMBLE",
      "start": 921,
      "end": 999,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
