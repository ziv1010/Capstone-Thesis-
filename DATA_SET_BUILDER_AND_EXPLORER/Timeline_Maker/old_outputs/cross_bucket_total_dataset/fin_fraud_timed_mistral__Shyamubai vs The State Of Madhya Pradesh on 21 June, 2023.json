      "start": 1705,
      "end": 1781,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.34131479263305664
    },
    {
      "sentence_id": 12,
      "text": "The applicant is 39 years old lady having minor children.",
