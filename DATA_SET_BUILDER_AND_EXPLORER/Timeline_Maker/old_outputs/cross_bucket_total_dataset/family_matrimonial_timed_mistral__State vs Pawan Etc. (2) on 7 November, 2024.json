      "start": 510,
      "end": 559,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "Matter is listed today for PE.",
      "rhetorical_role": "NONE",
      "start": 560,
      "end": 591,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "PW-4 Sh. Naubat has been recalled today for cross- examination by accused persons, however, Ld.",
      "rhetorical_role": "NONE",
      "start": 592,
      "end": 689,
      "entities": [
        {
          "text": "Naubat",
          "label": "WITNESS",
          "start": 602,
          "end": 608
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 11,
      "text": "Proxy Counsel for accused persons submit that main counsel is not available today as he has gone to attend Hon'ble High Court of Delhi.",
      "rhetorical_role": "NONE",
      "start": 689,
      "end": 824,
      "entities": [
        {
          "text": "High Court of Delhi",
          "label": "COURT",
