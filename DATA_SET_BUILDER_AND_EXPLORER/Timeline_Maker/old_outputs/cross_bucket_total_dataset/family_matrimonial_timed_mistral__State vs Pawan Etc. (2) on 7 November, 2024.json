          "end": 823
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 12,
      "text": "Requests for giving an opportunity for the purpose of cross-examination of PW-4 has been made.",
      "rhetorical_role": "NONE",
      "start": 825,
      "end": 919,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 13,
      "text": "Submissions Heard.",
      "rhetorical_role": "NONE",
      "start": 920,
      "end": 939,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 14,
      "text": "Request is considered and allowed. PW-4 Sh. Naubat is bound down for NDOH.",
      "rhetorical_role": "NONE",
      "start": 940,
      "end": 1014,
      "entities": [
        {
