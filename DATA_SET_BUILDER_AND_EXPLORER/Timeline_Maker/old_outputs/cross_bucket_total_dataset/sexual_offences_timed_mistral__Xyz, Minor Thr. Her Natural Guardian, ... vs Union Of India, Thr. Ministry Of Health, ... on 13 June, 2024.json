    {
      "sentence_id": 8,
      "text": "2. The petitioner, a minor, has approached this Court through her natural guardian i.e. Mother based on the medical history as narrated in the discharge card issued by the Sub-District Hospital.",
      "rhetorical_role": "PREAMBLE",
      "start": 776,
      "end": 971,
      "entities": [
        {
          "text": "Sub-District Hospital",
          "label": "ORG",
          "start": 949,
          "end": 970
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "3. The medical documents reflect that the victim is carrying pregnancy of about 25 weeks on the date of the examination, i.e. May 28, 2024.\n4.",
      "rhetorical_role": "PREAMBLE",
      "start": 972,
      "end": 1115,
      "entities": [
        {
          "text": "May 28, 2024",
          "label": "DATE",
          "start": 1099,
          "end": 1111
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "She is victim in Crime No. 711 of 2024 punishable under Section 4 of the Prevention of Children from Sexual Offences Act, 2012 and sections 376, 376(2)(j) of the Indian Penal Code, 1860.",
      "rhetorical_role": "PREAMBLE",
      "start": 1116,
      "end": 1302,
      "entities": [
        {
          "text": "Crime No. 711 of 2024",
          "label": "CASE_NUMBER",
          "start": 1133,
          "end": 1154
        },
