      "summary_sent_score": 0.1858643740415573
    },
    {
      "sentence_id": 14,
      "text": "There is no progress in the trial.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2332,
      "end": 2366,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2926945090293884
