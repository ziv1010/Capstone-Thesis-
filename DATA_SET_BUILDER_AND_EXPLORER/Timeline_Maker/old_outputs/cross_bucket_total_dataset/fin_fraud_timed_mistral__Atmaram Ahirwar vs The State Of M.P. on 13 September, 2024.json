      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.30822694301605225
    },
    {
      "sentence_id": 16,
      "text": "There is no seizure from the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2404,
      "end": 2443,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.33322790265083313
    },
    {
      "sentence_id": 17,
      "text": "He placed reliance on the judgment passed by Apex Court in the case of Moh.Muslim Vs. NCT Delhi passed in SLP (criminal) No.915/2023.\n5.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2444,
      "end": 2581,
      "entities": [
        {
          "text": "Apex Court",
          "label": "COURT",
