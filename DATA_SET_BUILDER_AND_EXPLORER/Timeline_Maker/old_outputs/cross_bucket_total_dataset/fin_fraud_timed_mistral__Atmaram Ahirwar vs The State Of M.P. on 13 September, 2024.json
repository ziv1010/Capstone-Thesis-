      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.42002683877944946
    },
    {
      "sentence_id": 25,
      "text": "The same would not apply to the facts of the present case.",
      "rhetorical_role": "RPC",
      "start": 3795,
      "end": 3853,
