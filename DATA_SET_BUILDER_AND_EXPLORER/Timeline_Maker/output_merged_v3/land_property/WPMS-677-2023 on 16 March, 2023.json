      "in_summary": false
    },
    {
      "sentence_id": 6,
      "text": "Petitioners' land was acquired under the provisions of National Highways Act, 1956, Competent Authority has determined compensation payable to petitioner.",
      "rhetorical_role": "FAC",
      "start": 496,
      "end": 651,
      "entities": [
        {
          "text": "National Highways Act, 1956",
          "label": "STATUTE",
          "start": 552,
          "end": 579
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.47894585132598877
    },
    {
      "sentence_id": 7,
      "text": "Petitioner is dissatisfied with amount determined by Competent Authority, Land Acquisition, therefore, he approached this Court.",
      "rhetorical_role": "FAC",
      "start": 652,
      "end": 780,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22487185895442963
    },
    {
      "sentence_id": 8,
      "text": "Since, he has a remedy under Section 3G(5) of National Highways Act of approaching the Arbitrator,\ntherefore, this Court declines to entertain the writ petition.",
      "rhetorical_role": "FAC",
      "start": 781,
      "end": 943,
      "entities": [
        {
          "text": "Section 3G(5)",
          "label": "PROVISION",
          "start": 811,
          "end": 824
        },
        {
          "text": "National Highways Act",
          "label": "STATUTE",
          "start": 828,
          "end": 849
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3978762626647949
    },
    {
      "sentence_id": 9,
      "text": "The writ petition is accordingly dismissed with liberty to the petitioner to approach the appropriate forum in the aforesaid provision.",
      "rhetorical_role": "RPC",
      "start": 944,
      "end": 1079,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.24762921035289764
    },
    {
      "sentence_id": 10,
      "text": "Petitioner moves the Arbitrator within two weeks from today, the Arbitrator shall decide petitioner's claim on merits, if possible, within one year.",
