          "start": 976,
          "end": 981
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3421775698661804
    },
    {
      "sentence_id": 12,
      "text": "Being dissatisfied with the quantum of compensation",
      "rhetorical_role": "FAC",
      "start": 1036,
      "end": 1087,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.38592493534088135
    },
    {
      "sentence_id": 13,
      "text": ",\nhe filed protest petition before the opposite party and accordingly the matter was referred to the learned Senior Civil Judge, Juapada under Section 18 of the Land Acquisition Act.",
      "rhetorical_role": "FAC",
      "start": 1088,
      "end": 1270,
      "entities": [
        {
          "text": "Senior Civil Judge, Juapada",
          "label": "COURT",
