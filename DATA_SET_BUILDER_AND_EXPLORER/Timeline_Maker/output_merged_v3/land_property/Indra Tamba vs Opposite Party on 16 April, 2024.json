        },
        {
          "text": "Basa Tamba",
          "label": "OTHER_PERSON",
          "start": 1491,
          "end": 1501
        },
        {
          "text": "LAR Case No. 42 of 2008",
          "label": "CASE_NUMBER",
          "start": 1532,
          "end": 1555
        },
        {
          "text": "Senior Civil Judge, Nuapada",
          "label": "COURT",
          "start": 1594,
          "end": 1621
        },
        {
          "text": "07.02.2013",
