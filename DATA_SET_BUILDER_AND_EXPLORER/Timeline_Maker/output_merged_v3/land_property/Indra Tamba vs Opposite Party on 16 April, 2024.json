          "end": 1338
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.30995577573776245
    },
    {
      "sentence_id": 15,
      "text": "Since Basa Tamba expired, the petitioner filed CMA No.45 of 2021 under Order 22 Rule 3 read with Section 151 CPC to substitute legal heirs of claimant Basa Tamba as well as for restoration of LAR Case No. 42 of 2008, which was disposed of by the learned Senior Civil Judge, Nuapada vide order dated 07.02.2013.",
      "rhetorical_role": "FAC",
      "start": 1340,
      "end": 1650,
      "entities": [
        {
          "text": "Basa Tamba",
          "label": "OTHER_PERSON",
