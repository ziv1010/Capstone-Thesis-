          "end": 2267
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 21,
      "text": "In view of such position, the claim made by the petitioner to be impleaded as party after long lapse of 9 years and to reconsider the case once again cannot be sustained in the eye of law.",
      "rhetorical_role": "RATIO",
      "start": 2312,
      "end": 2500,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5272688269615173
    },
    {
      "sentence_id": 22,
      "text": "Thereby,\nthe learned Senior Civil Judge, Nuapada has not committed any error in the order dated 24.08.2023 passed in CMA No.45 of 2021 so as to interference of this Court at this stage.",
      "rhetorical_role": "FAC",
      "start": 2501,
      "end": 2686,
      "entities": [
        {
          "text": "Senior Civil Judge, Nuapada",
          "label": "COURT",
          "start": 2522,
          "end": 2549
        },
        {
          "text": "24.08.2023",
          "label": "DATE",
          "start": 2597,
          "end": 2607
        },
        {
          "text": "CMA No.45 of 2021",
          "label": "CASE_NUMBER",
          "start": 2618,
          "end": 2635
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.4056378901004791
    },
