        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5065873265266418
    },
    {
      "sentence_id": 16,
      "text": "Therefore,\nafter a long lapse of time, the petitioner filed CMA No.45 of 2021 in 2021.",
      "rhetorical_role": "FAC",
      "start": 1651,
      "end": 1737,
      "entities": [
        {
          "text": "CMA No.45 of 2021 in 2021",
          "label": "CASE_NUMBER",
          "start": 1711,
          "end": 1736
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.42631053924560547
    },
    {
      "sentence_id": 17,
      "text": "The learned Senior Civil Judge, Nuapada considered the said application and held that since the award has been confirmed,\nCMA No.45 of 2021 is not maintainable as the original case is not in existence.",
      "rhetorical_role": "RLC",
      "start": 1738,
      "end": 1939,
      "entities": [
        {
          "text": "Senior Civil Judge, Nuapada",
          "label": "COURT",
          "start": 1750,
          "end": 1777
        },
        {
          "text": "CMA No.45 of 2021",
          "label": "CASE_NUMBER",
          "start": 1860,
          "end": 1877
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.4306182563304901
    },
    {
      "sentence_id": 18,
      "text": "As such, the petitioner cannot got beyond the pleadings available on record.",
      "rhetorical_role": "FAC",
      "start": 1940,
      "end": 2016,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.48008689284324646
    },
    {
      "sentence_id": 19,
      "text": "As the claimant did not adduce evidence in original L.A.R. case to prove his claim, learned Senior Civil Judge, Nuapada confirmed the award made by the opposite party and closed the case.",
      "rhetorical_role": "FAC",
      "start": 2017,
      "end": 2204,
      "entities": [
        {
          "text": "Senior Civil Judge, Nuapada",
          "label": "COURT",
          "start": 2109,
          "end": 2136
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4705767333507538
    },
    {
      "sentence_id": 20,
      "text": "Indra Tamba vs Opposite Party on 16 April, 2024 Indian Kanoon - http://indiankanoon.org/doc/5273626/\n1 5.",
      "rhetorical_role": "PREAMBLE",
      "start": 2205,
      "end": 2311,
      "entities": [
        {
          "text": "Indra Tamba vs Opposite Party on 16 April, 2024 Indian Kanoon",
          "label": "PRECEDENT",
