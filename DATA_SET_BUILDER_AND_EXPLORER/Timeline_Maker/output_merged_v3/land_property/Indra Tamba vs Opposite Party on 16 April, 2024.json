    {
      "sentence_id": 9,
      "text": "2. Heard Mr. S.K. Joshi, learned counsel appearing for the petitioner and Mr. S. Nayak, learned Additional Standing Counsel appearing for the opposite party.\n3.",
      "rhetorical_role": "NONE",
      "start": 435,
      "end": 595,
