      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.49089619517326355
    },
    {
      "sentence_id": 14,
      "text": "The said reference case was registered as L.A.R. Case No.42 of 2008.",
      "rhetorical_role": "FAC",
      "start": 1271,
      "end": 1339,
      "entities": [
        {
          "text": "L.A.R. Case No.42 of 2008",
          "label": "CASE_NUMBER",
