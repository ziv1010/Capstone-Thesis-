        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3305134177207947
    },
    {
      "sentence_id": 11,
      "text": "4. As it appears, opposite party has acquired land of one Basa Tamba for Lower Indra Irrigation Project and he has been paid compensation.",
      "rhetorical_role": "FAC",
      "start": 897,
      "end": 1035,
      "entities": [
        {
