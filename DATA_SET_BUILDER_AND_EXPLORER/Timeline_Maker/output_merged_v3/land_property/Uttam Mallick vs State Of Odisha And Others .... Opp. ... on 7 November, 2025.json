        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 11,
      "text": "3. Mr. Biswal, learned Additional Standing Counsel, however, prays for adjournment to take further instruction in the matter.",
      "rhetorical_role": "NONE",
      "start": 1124,
      "end": 1250,
      "entities": [
        {
          "text": "Biswal",
          "label": "OTHER_PERSON",
