          "start": 591,
          "end": 601
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 8,
      "text": "Admittedly, notification under section 11(1)\nof the Right to Fair Compensation and Transparency in Land Acquisition, Rehabilitation and Resettlement Act, 2013 (for brevity, 'the Act') was published on 09.06.2023.",
      "rhetorical_role": "PREAMBLE",
      "start": 661,
      "end": 873,
      "entities": [
        {
          "text": "section 11(1)\nof",
          "label": "PROVISION",
          "start": 692,
          "end": 708
        },
        {
          "text": "Right to Fair Compensation and Transparency in Land Acquisition, Rehabilitation and Resettlement Act, 2013",
          "label": "STATUTE",
          "start": 713,
          "end": 819
        },
        {
          "text": "09.06.2023",
          "label": "DATE",
          "start": 862,
          "end": 872
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 9,
      "text": "As such notification under section 19(1) of the said Act should have been published within a period of twelve months.",
      "rhetorical_role": "PREAMBLE",
      "start": 874,
      "end": 991,
      "entities": [
        {
          "text": "section 19(1)",
          "label": "PROVISION",
          "start": 901,
          "end": 914
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 10,
      "text": "But from the submission of Mr. Biswal, learned Additional Standing Counsel, it appears that no such notification has yet been made.",
      "rhetorical_role": "NONE",
      "start": 992,
      "end": 1123,
      "entities": [
        {
          "text": "Biswal",
