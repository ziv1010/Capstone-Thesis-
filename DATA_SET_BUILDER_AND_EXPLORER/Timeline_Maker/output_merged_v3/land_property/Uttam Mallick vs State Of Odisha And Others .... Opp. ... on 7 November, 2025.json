      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 7,
      "text": "2. Mr. Biswal, learned Additional Standing Counsel, on instruction from the Tahasildar, Malkangiri,\nsubmits that steps are being taken for 19(1) publication.",
      "rhetorical_role": "NONE",
      "start": 502,
      "end": 660,
      "entities": [
        {
          "text": "Biswal",
