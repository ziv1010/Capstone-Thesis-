      "entities": [
        {
          "text": "24.12.2022",
          "label": "DATE",
          "start": 503,
          "end": 513
        },
        {
          "text": "Food Safety Appellate Tribunal, Dehradun",
          "label": "COURT",
          "start": 524,
          "end": 564
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14810751378536224
    },
    {
      "sentence_id": 6,
      "text": "He would submit that there is a delay of 68 days in filing the present appeal; that, as per Section 71(6) of the Food Safety and Standards Act, 2006, the period of limitation is 60 days and; that, the delay has occurred on account of the fact that the judgment passed by the Tribunal on 24.12.2022 was communicated to the appellant on 03.04.2023.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 675,
      "end": 1021,
      "entities": [
        {
          "text": "Section 71(6)",
          "label": "PROVISION",
