    },
    {
      "sentence_id": 4,
      "text": "1. Heard the learned Counsel for the applicant and the learned APP for the State.",
      "rhetorical_role": "NONE",
      "start": 617,
      "end": 698,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 5,
      "text": "2. This is an application for pre-arrest bail in connection with CR No.682 of 2023, registered with Manpada Police Station, Thane, for an offence punishable under Section 376 of the Indian Penal Code, 1860 (\"the Penal Code\").\n3.",
      "rhetorical_role": "FAC",
      "start": 699,
      "end": 928,
      "entities": [
        {
          "text": "CR No.682 of 2023",
          "label": "CASE_NUMBER",
          "start": 765,
          "end": 782
        },
        {
          "text": "Manpada Police Station, Thane",
          "label": "ORG",
          "start": 800,
          "end": 829
        },
        {
          "text": "Section 376",
          "label": "PROVISION",
          "start": 863,
          "end": 874
        },
        {
          "text": "Indian Penal Code, 1860",
          "label": "STATUTE",
          "start": 882,
          "end": 905
        },
        {
          "text": "Penal Code",
          "label": "STATUTE",
          "start": 912,
          "end": 922
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1494460105895996
    },
    {
      "sentence_id": 6,
      "text": "The first informant had known the applicant as the latter is friend of her brother.",
      "rhetorical_role": "FAC",
      "start": 929,
      "end": 1012,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.29305365681648254
    },
    {
      "sentence_id": 7,
      "text": "The first informant and applicant started chatting on Instagram.",
      "rhetorical_role": "FAC",
      "start": 1013,
      "end": 1077,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21909189224243164
    },
    {
      "sentence_id": 8,
      "text": "On 7 th September, 2023, the applicant took the first informant to Hotel Bombay Velvet for dinner.",
      "rhetorical_role": "FAC",
      "start": 1078,
      "end": 1176,
      "entities": [
        {
          "text": "7 th September, 2023",
          "label": "DATE",
          "start": 1081,
          "end": 1101
        },
        {
          "text": "Bombay Velvet",
          "label": "GPE",
          "start": 1151,
          "end": 1164
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2715685963630676
    },
    {
      "sentence_id": 9,
      "text": "They had beer.",
      "rhetorical_role": "FAC",
      "start": 1177,
      "end": 1191,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2318897545337677
    },
    {
      "sentence_id": 10,
      "text": "The applicant allegedly made the first informant to have tequila shots.",
      "rhetorical_role": "FAC",
      "start": 1192,
      "end": 1263,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.29139015078544617
    },
    {
      "sentence_id": 11,
      "text": "912-ABA3526-2023.DOC",
      "rhetorical_role": "FAC",
      "start": 1265,
      "end": 1285,
      "entities": [
        {
          "text": "912-ABA3526-2023.DOC",
          "label": "DATE",
          "start": 1265,
          "end": 1285
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23650281131267548
    },
    {
      "sentence_id": 12,
      "text": "Sidhesh Rushikesh Bhalerao vs State Of Maharashtra And Anr on 15 December, 2023 Indian Kanoon - http://indiankanoon.org/doc/190216494/\n1 4.",
      "rhetorical_role": "FAC",
      "start": 1286,
      "end": 1425,
      "entities": [
        {
          "text": "Sidhesh Rushikesh Bhalerao vs State Of Maharashtra And Anr",
          "label": "PRECEDENT",
          "start": 1286,
          "end": 1344
        },
        {
          "text": "15 December, 2023",
          "label": "DATE",
          "start": 1348,
          "end": 1365
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.49450016021728516
    },
    {
      "sentence_id": 13,
      "text": "The first informant alleged at about 10.30 pm.",
      "rhetorical_role": "FAC",
      "start": 1426,
      "end": 1472,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20801277458667755
    },
    {
      "sentence_id": 14,
      "text": "she was not in her senses.",
      "rhetorical_role": "FAC",
      "start": 1473,
      "end": 1499,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23776888847351074
    },
    {
      "sentence_id": 15,
      "text": "On the next morning,\nshe found herself in a room at a lodge at Sangarli.",
      "rhetorical_role": "FAC",
      "start": 1500,
      "end": 1572,
      "entities": [
        {
          "text": "Sangarli",
          "label": "GPE",
          "start": 1563,
          "end": 1571
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24327707290649414
    },
    {
      "sentence_id": 16,
      "text": "She was completely disrobed.",
      "rhetorical_role": "FAC",
      "start": 1573,
      "end": 1601,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.26355239748954773
    },
    {
      "sentence_id": 17,
      "text": "The applicant was with her.",
      "rhetorical_role": "FAC",
      "start": 1602,
      "end": 1629,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.25267478823661804
    },
    {
      "sentence_id": 18,
      "text": "The first informant realized that she was violated.",
      "rhetorical_role": "FAC",
      "start": 1630,
      "end": 1681,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.26991143822669983
    },
    {
      "sentence_id": 19,
      "text": "Upon being confronted, the applicant did not give proper answers and stated that as she was drunk, he had brought her to the lodge.",
      "rhetorical_role": "FAC",
      "start": 1682,
      "end": 1813,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24072633683681488
    },
    {
      "sentence_id": 20,
      "text": "She narrated the incident to her parents.",
      "rhetorical_role": "FAC",
      "start": 1814,
      "end": 1855,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.245993509888649
    },
    {
      "sentence_id": 21,
      "text": "They went to the house of the applicant and apprised the parents of the applicant and, thereafter, first informant lodged the report.",
      "rhetorical_role": "FAC",
      "start": 1856,
      "end": 1989,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23801051080226898
    },
    {
      "sentence_id": 22,
      "text": "5. Mr. Gole, the learned Counsel for the applicant, submitted that there is no material to show that the applicant had committed sexual intercourse.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1991,
      "end": 2139,
      "entities": [
        {
          "text": "Gole",
          "label": "LAWYER",
          "start": 1998,
          "end": 2002
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1781800240278244
    },
    {
      "sentence_id": 23,
      "text": "The first informant simply alleged that she felt that she was sexually exploited.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2140,
      "end": 2221,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2195231020450592
    },
    {
      "sentence_id": 24,
      "text": "Mr. Gole would further submit that the FIR was lodged after consulting an Advocate.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2222,
      "end": 2305,
      "entities": [
        {
          "text": "Gole",
          "label": "LAWYER",
          "start": 2226,
          "end": 2230
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.13842608034610748
    },
    {
      "sentence_id": 25,
      "text": "The only material, which incriminates the applicant, according to Mr. Gole, is the fact that the applicant had suppressed his real identity and furnished the identity card of another person.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2306,
      "end": 2496,
      "entities": [
        {
          "text": "Gole",
          "label": "LAWYER",
          "start": 2376,
          "end": 2380
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.18570026755332947
    },
    {
      "sentence_id": 26,
      "text": "However, that cannot be a ground to deprive the personal liberty of the applicant, submitted Mr.\nGole.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2497,
      "end": 2600,
      "entities": [
        {
          "text": "Gole",
          "label": "LAWYER",
          "start": 2595,
          "end": 2599
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.139398455619812
    },
    {
      "sentence_id": 27,
      "text": "912-ABA3526-2023.DOC 6.",
      "rhetorical_role": "ANALYSIS",
      "start": 2601,
      "end": 2625,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.16561846435070038
    },
    {
      "sentence_id": 28,
      "text": "The learned APP, on the other hand, submitted that there is overwhelming material to show that the applicant had taken the first informant to the lodge.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2626,
      "end": 2778,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14402776956558228
    },
    {
      "sentence_id": 29,
      "text": "The Manager and the room boy of the lodge have stated that the first informant was not in complete control of herself.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2779,
      "end": 2897,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.17224782705307007
    },
    {
      "sentence_id": 30,
      "text": "Moreover, the first informant had immediately reported the matter to police and the medical evidence corroborates her version.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2898,
      "end": 3024,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.19773806631565094
    },
    {
      "sentence_id": 31,
      "text": "7. Mr. Gole submitted that in the history narrated by the victim before the Medical Officer, she had claimed that she had known the applicant since three to four years.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3026,
      "end": 3194,
      "entities": [
        {
          "text": "Gole",
          "label": "LAWYER",
          "start": 3033,
          "end": 3037
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.17251001298427582
    },
    {
      "sentence_id": 32,
      "text": "There were no injury marks suggestive of sexual intercourse, submitted Mr. Gole.",
      "rhetorical_role": "ANALYSIS",
      "start": 3195,
      "end": 3275,
      "entities": [
        {
          "text": "Gole",
          "label": "LAWYER",
          "start": 3270,
          "end": 3274
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.21778516471385956
    },
    {
      "sentence_id": 33,
      "text": "8. I am afraid to accede to the submissions of Mr. Gole.",
      "rhetorical_role": "NONE",
      "start": 3277,
      "end": 3333,
      "entities": [
        {
          "text": "Gole",
          "label": "LAWYER",
          "start": 3328,
          "end": 3332
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 34,
      "text": "Prima facie there is ample material to show that on the night of occurrence the applicant took the first informant to the lodge.",
      "rhetorical_role": "ANALYSIS",
      "start": 3334,
      "end": 3462,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2202380895614624
    },
    {
      "sentence_id": 35,
      "text": "The applicant had suppressed his real identity.",
      "rhetorical_role": "ANALYSIS",
      "start": 3463,
      "end": 3510,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.287686288356781
    },
    {
      "sentence_id": 36,
      "text": "He had used documents of another person.",
      "rhetorical_role": "ANALYSIS",
      "start": 3511,
      "end": 3551,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.25609326362609863
    },
    {
      "sentence_id": 37,
      "text": "The room boy at the lodge had stated both the boy and the girl were drunk.",
      "rhetorical_role": "ANALYSIS",
      "start": 3552,
      "end": 3626,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.20885919034481049
    },
    {
      "sentence_id": 38,
      "text": "The gait of the girl was unsteady.",
      "rhetorical_role": "ANALYSIS",
      "start": 3627,
      "end": 3661,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.23434185981750488
    },
    {
      "sentence_id": 39,
      "text": "As the girl felt like vomiting, he had given them a room.",
      "rhetorical_role": "ANALYSIS",
      "start": 3662,
      "end": 3719,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.19853545725345612
    },
    {
      "sentence_id": 40,
      "text": "Moreover, the presence of the applicant and the first informant at the lodge is captured in the CCTV footages.",
      "rhetorical_role": "ANALYSIS",
      "start": 3720,
      "end": 3830,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2758316993713379
    },
    {
      "sentence_id": 41,
      "text": "912-ABA3526-2023.DOC 9.",
      "rhetorical_role": "ANALYSIS",
      "start": 3831,
      "end": 3855,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.07188031077384949
    },
    {
      "sentence_id": 42,
      "text": "In the aforesaid view of the matter, I find substance in the submission of the learned APP that the version of the prosecutrix cannot be discarded at this stage.",
      "rhetorical_role": "ANALYSIS",
      "start": 3856,
      "end": 4017,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.19506892561912537
    },
    {
      "sentence_id": 43,
      "text": "The first informant lodged FIR almost instantaneously.",
      "rhetorical_role": "ANALYSIS",
      "start": 4018,
      "end": 4072,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.27466487884521484
    },
    {
      "sentence_id": 44,
      "text": "She was medically examined on the very day.",
      "rhetorical_role": "RATIO",
      "start": 4073,
      "end": 4116,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3639739751815796
    },
    {
      "sentence_id": 45,
      "text": "She narrated the history.",
      "rhetorical_role": "RATIO",
      "start": 4117,
      "end": 4142,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.23755325376987457
    },
    {
      "sentence_id": 46,
      "text": "The Medical Officer opined that the evidence of sexual intercourse/assault cannot be ruled out.",
      "rhetorical_role": "RATIO",
      "start": 4143,
      "end": 4238,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.30944302678108215
    },
    {
      "sentence_id": 47,
      "text": "10. In the aforesaid view of the matter, I am persuaded to hold that a strong prima facie case is made out against the applicant.",
      "rhetorical_role": "RATIO",
      "start": 4240,
      "end": 4369,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.24415379762649536
    },
    {
      "sentence_id": 48,
      "text": "Therefore, I am not inclined to exercise the discretion in favour of the applicant.",
      "rhetorical_role": "RPC",
      "start": 4370,
      "end": 4453,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.18433457612991333
    },
    {
      "sentence_id": 49,
      "text": "Sidhesh Rushikesh Bhalerao vs State Of Maharashtra And Anr on 15 December, 2023 Indian Kanoon - http://indiankanoon.org/doc/190216494/\n2 11.",
      "rhetorical_role": "NONE",
      "start": 4454,
      "end": 4595,
      "entities": [
        {
          "text": "Sidhesh Rushikesh Bhalerao vs State Of Maharashtra And Anr",
          "label": "PRECEDENT",
          "start": 4455,
          "end": 4513
        },
        {
          "text": "15 December, 2023",
          "label": "DATE",
          "start": 4517,
          "end": 4534
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 50,
      "text": "Hence the following order:\n:ORDER:",
      "rhetorical_role": "NONE",
      "start": 4596,
      "end": 4630,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 51,
      "text": "(i) Application stands rejected.",
      "rhetorical_role": "RPC",
      "start": 4631,
      "end": 4664,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.09176413714885712
    },
    {
      "sentence_id": 52,
      "text": "(ii) It is clarified that these prima facie observations are confined to determine entitlement to pre-arrest bail only.",
      "rhetorical_role": "NONE",
      "start": 4665,
      "end": 4785,
      "entities": [],
      "in_summary": false
    },
