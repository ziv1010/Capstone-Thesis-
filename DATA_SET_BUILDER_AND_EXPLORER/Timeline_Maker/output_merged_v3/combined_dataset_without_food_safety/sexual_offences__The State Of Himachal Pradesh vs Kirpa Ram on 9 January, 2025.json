      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 3,
      "text": "We have heard learned counsel for the appellant- State and learned counsel for the respondent-accused and perused the material on record.",
      "rhetorical_role": "NONE",
      "start": 238,
      "end": 375,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 4,
      "text": "The allegations against the respondent were for the offences under Sections 363, 366 and 376 of the Indian Penal Code, 1860.",
      "rhetorical_role": "FAC",
      "start": 377,
      "end": 501,
      "entities": [
        {
          "text": "Sections 363",
          "label": "PROVISION",
          "start": 444,
          "end": 456
        },
        {
          "text": "366",
          "label": "PROVISION",
          "start": 458,
          "end": 461
        },
        {
          "text": "376",
          "label": "PROVISION",
          "start": 466,
          "end": 469
        },
        {
          "text": "Indian Penal Code, 1860",
          "label": "STATUTE",
          "start": 477,
          "end": 500
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4709359109401703
    },
    {
      "sentence_id": 5,
      "text": "The allegations are related to the month of March, 1999.",
      "rhetorical_role": "FAC",
      "start": 502,
      "end": 558,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20175956189632416
    },
    {
      "sentence_id": 6,
      "text": "By Judgment dated 19.04.2005, the Court of S.C.Kainthla, Presiding Officer, Fast Track Court, Mandi, H.P. in Sessions Trial Nos.15/2001 and 68/2004, convicted the respondent for the aforesaid offences.",
      "rhetorical_role": "RLC",
      "start": 559,
      "end": 760,
      "entities": [
        {
          "text": "19.04.2005",
          "label": "DATE",
          "start": 577,
          "end": 587
        },
        {
          "text": "S.C.Kainthla",
          "label": "JUDGE",
          "start": 602,
          "end": 614
        },
