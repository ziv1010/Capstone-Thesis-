      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.12840934097766876
    },
    {
      "sentence_id": 7,
      "text": "Being aggrieved, the respondent herein preferred Criminal Appeal No.202/2005.",
      "rhetorical_role": "FAC",
      "start": 761,
      "end": 839,
      "entities": [
        {
          "text": "Criminal Appeal No.202/2005",
          "label": "CASE_NUMBER",
          "start": 811,
          "end": 838
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3375868499279022
    },
    {
      "sentence_id": 8,
      "text": "The learned Single Judge of the High Court of Himachal Pradesh by the impugned judgment dated 29.05.2012 has reversed the conviction and has passed the judgment of acquittal, thereby acquitting the respondent herein of all the offences alleged against him and set aside the sentence imposed by the trial court.",
      "rhetorical_role": "RLC",
      "start": 840,
      "end": 1150,
      "entities": [
        {
          "text": "High Court of Himachal Pradesh",
          "label": "COURT",
          "start": 872,
          "end": 902
        },
        {
          "text": "29.05.2012",
          "label": "DATE",
          "start": 934,
          "end": 944
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5697107315063477
    },
    {
      "sentence_id": 9,
      "text": "14:00:36 IST Reason:\nHence, this appeal filed on behalf of the State.",
      "rhetorical_role": "NONE",
      "start": 1152,
      "end": 1221,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "We have considered the parameters that are applicable for considering the judgment of acquittal and closely perused the material on record.",
      "rhetorical_role": "NONE",
      "start": 1222,
      "end": 1361,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 11,
      "text": "We find that the High Court was justified in acquitting the respondent herein by setting aside the judgment of conviction and sentence passed by the trial court.",
      "rhetorical_role": "RATIO",
      "start": 1362,
      "end": 1523,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5044310092926025
    },
    {
      "sentence_id": 12,
      "text": "We do not find any merit in this appeal.",
      "rhetorical_role": "RPC",
      "start": 1524,
      "end": 1565,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.07171564549207687
    },
    {
      "sentence_id": 13,
      "text": "Hence, the appeal is dismissed.",
      "rhetorical_role": "RPC",
      "start": 1566,
      "end": 1597,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.3430194556713104
