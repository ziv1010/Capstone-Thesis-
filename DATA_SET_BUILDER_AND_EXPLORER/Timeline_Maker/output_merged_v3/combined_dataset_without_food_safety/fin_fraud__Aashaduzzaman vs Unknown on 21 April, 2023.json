          "start": 692,
          "end": 702
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "Petitioner submits he is in custody for more than six years.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 722,
      "end": 783,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2606063783168793
    },
    {
      "sentence_id": 8,
      "text": "He submits there is no possibility of trial concluding in the near future.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 784,
      "end": 858,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.23377501964569092
    },
    {
      "sentence_id": 9,
      "text": "Co-accused are on bail.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 859,
      "end": 882,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.29782038927078247
    },
    {
      "sentence_id": 10,
      "text": "Accordingly, he prays for bail.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 883,
      "end": 914,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2810831665992737
    },
    {
      "sentence_id": 11,
      "text": "Learned Public Prosecutor opposes the bail prayer.",
      "rhetorical_role": "NONE",
      "start": 916,
      "end": 966,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 12,
      "text": "He submits prosecution proposes to examine two more witnesses.",
      "rhetorical_role": "NONE",
      "start": 967,
      "end": 1029,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 13,
      "text": "Case involves trafficking of new born babies.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 1030,
      "end": 1075,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.314348042011261
    },
    {
      "sentence_id": 14,
      "text": "Petitioner is the owner of the nursing home wherefrom the trafficked babies were recovered.",
      "rhetorical_role": "FAC",
      "start": 1076,
      "end": 1167,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3605661988258362
    },
    {
      "sentence_id": 15,
      "text": "Co-accused who are released on bail were doctors.",
      "rhetorical_role": "FAC",
      "start": 1168,
      "end": 1217,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3517215847969055
    },
    {
      "sentence_id": 16,
      "text": "Medical officers attached to the hospital/nursing home have been released on bail.",
      "rhetorical_role": "FAC",
      "start": 1218,
      "end": 1300,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3292134404182434
    },
    {
      "sentence_id": 17,
      "text": "Petitioner does not stand on the same footing with the said co-accused.",
      "rhetorical_role": "FAC",
      "start": 1301,
      "end": 1373,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.33594849705696106
    },
    {
      "sentence_id": 18,
      "text": "We have considered the materials on record.",
      "rhetorical_role": "ANALYSIS",
      "start": 1374,
      "end": 1418,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.14517155289649963
    },
    {
      "sentence_id": 19,
      "text": "Offence involves grave allegation of trafficking in new born babies.",
      "rhetorical_role": "ANALYSIS",
      "start": 1419,
      "end": 1487,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.40503352880477905
    },
    {
      "sentence_id": 20,
      "text": "Petitioner is the owner of the medical institution where new born babies were found.",
      "rhetorical_role": "ANALYSIS",
      "start": 1488,
      "end": 1572,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4001012146472931
    },
    {
      "sentence_id": 21,
      "text": "Medical officers have been enlarged on bail.",
      "rhetorical_role": "FAC",
      "start": 1573,
      "end": 1618,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3356400728225708
    },
    {
      "sentence_id": 22,
      "text": "Petitioner was in-charge of the day to day management of the medical institution which is prima facie involved in trafficking of new born babies.",
      "rhetorical_role": "FAC",
      "start": 1619,
      "end": 1764,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4110889136791229
    },
    {
      "sentence_id": 23,
      "text": "Though petitioner is in custody for a considerable period of time, learned Public Prosecutor assures the Court that only two more prosecution witnesses will be examined.",
      "rhetorical_role": "RATIO",
      "start": 1765,
      "end": 1934,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.25510451197624207
    },
    {
      "sentence_id": 24,
      "text": "Bail prayer of co-accused was rejected in April, 2023 and direction to record evidence by learned Judge- in-charge (in the event of vacancy) had also been directed.",
      "rhetorical_role": "RATIO",
      "start": 1935,
      "end": 2099,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.33016127347946167
    },
    {
      "sentence_id": 25,
      "text": "Accordingly, possibility of expeditious conclusion of trial in the case is bright.",
      "rhetorical_role": "RATIO",
      "start": 2100,
      "end": 2182,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3385639786720276
    },
    {
      "sentence_id": 26,
      "text": "Hence, we are not inclined to grant bail to the petitioner at this stage.",
      "rhetorical_role": "RPC",
      "start": 2183,
      "end": 2256,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.21110373735427856
    },
    {
      "sentence_id": 27,
      "text": "Accordingly, the prayer for bail of the petitioner is rejected.",
      "rhetorical_role": "RPC",
      "start": 2257,
      "end": 2321,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.34841465950012207
    },
    {
      "sentence_id": 28,
      "text": "We reiterate our earlier direction in CRM (DB) 1193 of 2023 and hope and trust that the trial shall be concluded at an early date.",
      "rhetorical_role": "NONE",
      "start": 2322,
      "end": 2453,
      "entities": [
        {
          "text": "CRM (DB) 1193 of 2023",
          "label": "CASE_NUMBER",
          "start": 2361,
          "end": 2382
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 29,
      "text": "None of the parties shall delay or dilate proceeding by seeking unnecessary adjournment.",
      "rhetorical_role": "RPC",
      "start": 2454,
      "end": 2542,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.3871783912181854
    },
