      "in_summary": false
    },
    {
      "sentence_id": 6,
      "text": "Mr. Saswata Gopal Mukherjee, ld. P.P., Mr. Rudradipta Nandy, ld. A.P.P., Mrs. Sonali Das. ...for the State.",
      "rhetorical_role": "NONE",
      "start": 614,
      "end": 721,
      "entities": [
        {
          "text": "Saswata Gopal Mukherjee",
