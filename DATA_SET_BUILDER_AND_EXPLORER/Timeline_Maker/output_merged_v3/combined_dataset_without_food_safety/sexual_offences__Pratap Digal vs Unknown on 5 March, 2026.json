      "end": 900,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 8,
      "text": "2. We have heard learned Counsel for the parties for some time.",
      "rhetorical_role": "NONE",
      "start": 902,
      "end": 965,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "There appears to be an arguable case on both sides.",
      "rhetorical_role": "NONE",
      "start": 966,
      "end": 1017,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "Hence, we propose to hear out the appeal by treating the application for suspension of sentence as an informal paper book.",
      "rhetorical_role": "RPC",
      "start": 1018,
      "end": 1140,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.061036042869091034
    },
