      "summary_sent_score": 0.2759917974472046
    },
    {
      "sentence_id": 5,
      "text": "Applicant has been arrested on 17-03-2024 by Police Station Kotwali District Gwalior in connection with Crime No.32/2020 registered for offence under Sections 420, 467, 468 of IPC.",
