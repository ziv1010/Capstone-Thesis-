          "label": "STATUTE",
          "start": 2253,
          "end": 2256
        },
        {
          "text": "Sections 3/4",
          "label": "PROVISION",
          "start": 2267,
          "end": 2279
        },
        {
          "text": "5L/6",
          "label": "PROVISION",
          "start": 2281,
          "end": 2285
        },
        {
          "text": "Protection of Children from Sexual Offences Act, 2012",
          "label": "STATUTE",
          "start": 2293,
          "end": 2346
        },
        {
          "text": "Manoj",
          "label": "PETITIONER",
          "start": 2367,
          "end": 2372
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5062139630317688
    },
    {
      "sentence_id": 18,
      "text": "Statements of victim were recorded under Sections 161 and 164 of Cr.P.C.",
      "rhetorical_role": "FAC",
      "start": 2374,
      "end": 2446,
      "entities": [
        {
          "text": "Sections 161",
          "label": "PROVISION",
          "start": 2415,
          "end": 2427
        },
        {
          "text": "164",
