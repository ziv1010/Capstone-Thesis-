          "start": 2439,
          "end": 2446
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.31306084990501404
    },
    {
      "sentence_id": 19,
      "text": "Victim was forwarded for medico-legal Manoj Kumar vs The State Of Madhya Pradesh on 12 July, 2024 Indian Kanoon - http://indiankanoon.org/doc/199251245/\n1 examination.",
      "rhetorical_role": "FAC",
      "start": 2447,
      "end": 2614,
      "entities": [
        {
          "text": "medico-legal Manoj Kumar vs The State Of Madhya Pradesh on 12 July, 2024 Indian Kanoon",
          "label": "PRECEDENT",
          "start": 2472,
          "end": 2558
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4042908549308777
    },
    {
      "sentence_id": 20,
      "text": "Relevant seizures have been made.",
      "rhetorical_role": "FAC",
      "start": 2615,
      "end": 2648,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.28144922852516174
    },
    {
      "sentence_id": 21,
      "text": "CCTV footage of Siddharth Guest House was recovered and seized.",
      "rhetorical_role": "FAC",
      "start": 2649,
      "end": 2712,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20405003428459167
    },
    {
      "sentence_id": 22,
      "text": "Manoj is absconding since the date of incident.",
      "rhetorical_role": "FAC",
      "start": 2713,
      "end": 2760,
      "entities": [
        {
          "text": "Manoj",
          "label": "PETITIONER",
          "start": 2713,
          "end": 2718
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2576005756855011
    },
    {
      "sentence_id": 23,
      "text": "Investigation is underway.",
      "rhetorical_role": "FAC",
      "start": 2761,
      "end": 2787,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21836070716381073
    },
    {
      "sentence_id": 24,
      "text": "Learned Counsel for the applicant, in addition to the grounds mentioned in the application, submits that applicant has been falsely implicated in this matter.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2789,
      "end": 2947,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.18399976193904877
    },
    {
      "sentence_id": 25,
      "text": "The FIR is delayed and lodged after pre-meditation.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2948,
      "end": 2999,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2558927536010742
    },
    {
      "sentence_id": 26,
      "text": "Victim has honey- trapped the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3000,
      "end": 3040,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.31069332361221313
    },
    {
      "sentence_id": 27,
      "text": "Learned counsel, referring to whats-app messages contends that in fact the victim had proposed relationship to the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3041,
      "end": 3166,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1959555745124817
    },
    {
      "sentence_id": 28,
      "text": "Learned counsel further submits that the applicant is aged around 30 years.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3167,
      "end": 3242,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.24562665820121765
    },
    {
      "sentence_id": 29,
      "text": "No criminal antecedent is reported against him.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3243,
      "end": 3290,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4064664840698242
    },
    {
      "sentence_id": 30,
      "text": "Applicant is ready to co-operate with the investigation.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3291,
      "end": 3347,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4183618724346161
    },
    {
      "sentence_id": 31,
      "text": "Therefore, applicant may be extended the benefit of anticipatory bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3348,
      "end": 3418,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.5139548182487488
    },
    {
      "sentence_id": 32,
      "text": "Per contra, learned counsel for State ably assisted by learned counsel for the objector opposes the anticipatory bail application on the ground of gravity 3 MCRC-28536-2024 of alleged offence and submits that as per the mark-sheet of the Board of Secondary Education, date of birth of the victim is 23.12.2005.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3419,
      "end": 3730,
      "entities": [
        {
          "text": "23.12.2005",
          "label": "DATE",
          "start": 3719,
          "end": 3729
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.24844422936439514
    },
    {
      "sentence_id": 33,
      "text": "She was minor at the time of incident, whereas applicant is aged around 30 years.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3731,
      "end": 3812,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4362030029296875
    },
    {
      "sentence_id": 34,
      "text": "Applicant has manipulated and sexually exploited minor victim.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3813,
      "end": 3876,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4586273431777954
    },
    {
      "sentence_id": 35,
      "text": "Applicant has never been available for the investigation.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3877,
      "end": 3934,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3840723931789398
    },
    {
      "sentence_id": 36,
      "text": "Custodial interrogation and recovery are to be made at the instance of the applicant.",
      "rhetorical_role": "RPC",
      "start": 3935,
      "end": 4020,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.4171975553035736
    },
    {
      "sentence_id": 37,
      "text": "Therefore, the applicant may not be extended the benefit of anticipatory bail.",
      "rhetorical_role": "RPC",
      "start": 4021,
      "end": 4099,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.5291273593902588
    },
    {
      "sentence_id": 38,
      "text": "Heard learned counsel for the parties and perused case diary.",
      "rhetorical_role": "NONE",
      "start": 4101,
      "end": 4162,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 39,
      "text": "Considering rival contentions, but without commenting on merits of the case, in the considered opinion of this Court, applicant does not deserve to be extended the benefit of anticipatory bail.",
      "rhetorical_role": "RATIO",
      "start": 4163,
      "end": 4356,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.13792286813259125
    },
    {
      "sentence_id": 40,
      "text": "Consequently, second repeat application under Section 438 of Cr.P.C. stands dismissed.",
      "rhetorical_role": "RPC",
      "start": 4357,
      "end": 4444,
      "entities": [
        {
          "text": "Section 438",
          "label": "PROVISION",
