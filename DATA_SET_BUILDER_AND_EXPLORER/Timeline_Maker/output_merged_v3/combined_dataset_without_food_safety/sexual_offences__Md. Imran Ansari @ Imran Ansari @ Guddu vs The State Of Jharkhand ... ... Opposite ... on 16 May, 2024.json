    {
      "sentence_id": 7,
      "text": "Prosecutrix was having affairs with the petitioner.",
      "rhetorical_role": "FAC",
      "start": 769,
      "end": 820,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.16033093631267548
    },
    {
      "sentence_id": 8,
      "text": "It is alleged that petitioner had sexually exploited her in November 2021.",
      "rhetorical_role": "FAC",
      "start": 821,
      "end": 895,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.15992823243141174
    },
    {
      "sentence_id": 9,
      "text": "He also video graphed their intimate relationship.",
      "rhetorical_role": "FAC",
      "start": 896,
      "end": 946,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.15938733518123627
    },
    {
      "sentence_id": 10,
      "text": "Later on, the victim got married somewhere else.",
      "rhetorical_role": "FAC",
      "start": 947,
      "end": 995,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1426638960838318
    },
    {
      "sentence_id": 11,
      "text": "It is further alleged that the petitioner went to the husband of the victim and told him about their previous affairs.",
      "rhetorical_role": "FAC",
      "start": 996,
      "end": 1115,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.121213398873806
    },
    {
      "sentence_id": 12,
      "text": "He showed the video graph of their relationship.",
      "rhetorical_role": "FAC",
      "start": 1116,
      "end": 1164,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.14646868407726288
    },
    {
      "sentence_id": 13,
      "text": "Subsequently, the victim was driven away from her matrimonial home and she is residing with her parents.",
      "rhetorical_role": "FAC",
      "start": 1165,
      "end": 1269,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.16105930507183075
    },
    {
      "sentence_id": 14,
      "text": "Case diary earlier called for has been received, perused the same.",
      "rhetorical_role": "FAC",
      "start": 1270,
      "end": 1337,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.055925048887729645
    },
    {
      "sentence_id": 15,
      "text": "It appears that several witnesses in the case diary have stated that due to the fact that the petitioner had revealed his relationship with the victim prior to her marriage her husband had deserted her.",
      "rhetorical_role": "FAC",
      "start": 1338,
      "end": 1540,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.04436231404542923
    },
    {
      "sentence_id": 16,
      "text": "Regard being had to the facts and circumstance of the case; I am not inclined to enlarge the petitioner on bail.",
      "rhetorical_role": "FAC",
      "start": 1541,
      "end": 1654,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.0429673045873642
    },
    {
      "sentence_id": 17,
      "text": "Accordingly, his prayer for bail is hereby rejected at this stage.",
      "rhetorical_role": "RPC",
      "start": 1655,
      "end": 1721,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
