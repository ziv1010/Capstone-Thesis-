      "text": "Investigation is over.",
      "rhetorical_role": "FAC",
      "start": 3877,
      "end": 3900,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2989336848258972
    },
    {
      "sentence_id": 32,
      "text": "Applicant is permanent resident of District Morena.",
      "rhetorical_role": "FAC",
      "start": 3901,
      "end": 3952,
      "entities": [
        {
          "text": "Morena",
          "label": "GPE",
          "start": 3945,
          "end": 3951
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4154006838798523
    },
    {
      "sentence_id": 33,
      "text": "Final conclusion of trial will take time, hence the applicant may be enlarged on bail.",
      "rhetorical_role": "FAC",
      "start": 3953,
      "end": 4039,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3136180639266968
    },
    {
      "sentence_id": 34,
      "text": "8 . Per contra, learned counsel for the respondent/State opposed the prayer and prayed for its rejection by submitting that deceased in her dying declaration categorically mentioned the name of present applicant.",
