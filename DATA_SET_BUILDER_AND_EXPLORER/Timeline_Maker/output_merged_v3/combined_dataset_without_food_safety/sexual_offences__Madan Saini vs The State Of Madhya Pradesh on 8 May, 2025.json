      "summary_section": "facts",
      "summary_sent_score": 0.24733518064022064
    },
    {
      "sentence_id": 18,
      "text": "7. Learned counsel for the applicant contended that the applicant is innocent and he has been falsely implicated in the matter.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2662,
      "end": 2789,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.18584918975830078
    },
    {
      "sentence_id": 19,
      "text": "He is in custody since 24.6.2024.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2790,
      "end": 2823,
      "entities": [
        {
          "text": "24.6.2024",
          "label": "DATE",
          "start": 2813,
          "end": 2822
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3435765206813812
    },
    {
      "sentence_id": 20,
      "text": "At the time of incident, he was not present on the spot and he was driving his e-rickshaw at village Dhore and nearby Ambah Nagar Palika Office.",
      "rhetorical_role": "FAC",
      "start": 2824,
      "end": 2968,
      "entities": [
        {
