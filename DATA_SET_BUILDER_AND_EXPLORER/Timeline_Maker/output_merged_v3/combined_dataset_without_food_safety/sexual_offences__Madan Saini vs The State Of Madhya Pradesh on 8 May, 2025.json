          "start": 2942,
          "end": 2960
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3022758960723877
    },
    {
      "sentence_id": 21,
      "text": "Crime under Section 376 of IPC has been registered against the husband of the deceased.",
      "rhetorical_role": "FAC",
      "start": 2969,
      "end": 3056,
      "entities": [
        {
          "text": "Section 376",
          "label": "PROVISION",
          "start": 2981,
          "end": 2992
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 2996,
          "end": 2999
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3432636260986328
    },
    {
      "sentence_id": 22,
      "text": "She herself poured petrol upon her and set her NEUTRAL CITATION NO.\n2025:MPHC-GWL:10189 3 MCRC-19474-2025 ablaze.",
      "rhetorical_role": "FAC",
      "start": 3057,
      "end": 3170,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3621074855327606
    },
    {
      "sentence_id": 23,
      "text": "No lighter and petrol was recovered from the place of incident.",
      "rhetorical_role": "FAC",
      "start": 3171,
      "end": 3234,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.37968921661376953
    },
    {
      "sentence_id": 24,
      "text": "Alleged dying declaration of the deceased is doubtful.",
      "rhetorical_role": "FAC",
      "start": 3235,
      "end": 3289,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3352983593940735
    },
    {
      "sentence_id": 25,
      "text": "No video recording was conducted during recording of dying declaration of the deceased.",
      "rhetorical_role": "FAC",
      "start": 3290,
      "end": 3377,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.40610700845718384
    },
    {
      "sentence_id": 26,
      "text": "Statement of Puttu was not recorded by the Investigating Officer.",
      "rhetorical_role": "FAC",
      "start": 3378,
      "end": 3443,
      "entities": [
        {
          "text": "Puttu",
          "label": "OTHER_PERSON",
