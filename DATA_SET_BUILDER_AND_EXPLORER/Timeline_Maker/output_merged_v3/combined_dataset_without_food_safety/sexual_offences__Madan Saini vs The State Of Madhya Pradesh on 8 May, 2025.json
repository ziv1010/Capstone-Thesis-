    {
      "sentence_id": 14,
      "text": "Thereupon, all the accused persons fled away from the spot.",
      "rhetorical_role": "FAC",
      "start": 2152,
      "end": 2211,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2721649706363678
    },
    {
      "sentence_id": 15,
      "text": "She started crying and someone called her brother-in-law (Jeth).",
      "rhetorical_role": "FAC",
      "start": 2212,
      "end": 2276,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.25786828994750977
    },
    {
      "sentence_id": 16,
      "text": "Her brother-in-law (Jgth) gave information about the, incident to her husband who came alongwith the police at the spot and took her to the hospital where during treatment she died.",
      "rhetorical_role": "FAC",
      "start": 2277,
      "end": 2458,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.27247825264930725
    },
    {
      "sentence_id": 17,
      "text": "Accordingly, the case was registered vide ELR. bearing Crime No.66 of 2024:at Police Station - Ambah, District Morena under the above-mentioned Sections against the applicant and other accused persons.",
      "rhetorical_role": "FAC",
      "start": 2459,
      "end": 2660,
      "entities": [
        {
          "text": "Police Station - Ambah, District Morena",
          "label": "ORG",
