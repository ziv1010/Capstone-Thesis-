          "end": 3396
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.32408013939857483
    },
    {
      "sentence_id": 27,
      "text": "Co-accused Smt. Rakhi and Smt. Suneeta have been enlarged on bail vide orders dated 30.8.2024 and 20.8.2024 passed in M.Cr.C.Nos.36561/2024 and 34081/2024 respectively.",
      "rhetorical_role": "FAC",
      "start": 3444,
      "end": 3612,
      "entities": [
        {
          "text": "Rakhi",
          "label": "OTHER_PERSON",
          "start": 3460,
          "end": 3465
        },
        {
          "text": "Suneeta",
          "label": "OTHER_PERSON",
          "start": 3475,
          "end": 3482
        },
        {
          "text": "30.8.2024",
          "label": "DATE",
          "start": 3528,
          "end": 3537
        },
        {
          "text": "20.8.2024",
          "label": "DATE",
          "start": 3542,
          "end": 3551
        },
        {
          "text": "M.Cr.C.Nos.36561/2024 and 34081/2024",
          "label": "CASE_NUMBER",
          "start": 3562,
          "end": 3598
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2202068269252777
    },
    {
      "sentence_id": 28,
      "text": "Although the presence of Smt. Rakhi and Smt. Suneeta was not established on the spot, therefore, prima facie no case is made out against the present applicant.",
      "rhetorical_role": "FAC",
      "start": 3613,
      "end": 3772,
      "entities": [
        {
          "text": "Rakhi",
          "label": "OTHER_PERSON",
