          "end": 3648
        },
        {
          "text": "Suneeta",
          "label": "OTHER_PERSON",
          "start": 3658,
          "end": 3665
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4271475076675415
    },
    {
      "sentence_id": 29,
      "text": "Applicant is not having any criminal past.",
      "rhetorical_role": "FAC",
      "start": 3773,
      "end": 3816,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.43458351492881775
    },
    {
      "sentence_id": 30,
      "text": "He has suffered jail incarceration since last eight months.",
      "rhetorical_role": "FAC",
      "start": 3817,
      "end": 3876,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4544855058193207
    },
    {
