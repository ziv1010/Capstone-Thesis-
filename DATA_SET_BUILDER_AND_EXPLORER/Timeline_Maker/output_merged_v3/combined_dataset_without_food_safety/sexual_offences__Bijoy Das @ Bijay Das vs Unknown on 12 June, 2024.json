      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 6,
      "text": "The charge against the petitioner is under Sections 376/354C IPC read with Sections 67/67A of the Information Technology (Amendment) Act, 2008.",
      "rhetorical_role": "FAC",
      "start": 613,
      "end": 756,
      "entities": [
        {
          "text": "Sections 376/354C",
          "label": "PROVISION",
