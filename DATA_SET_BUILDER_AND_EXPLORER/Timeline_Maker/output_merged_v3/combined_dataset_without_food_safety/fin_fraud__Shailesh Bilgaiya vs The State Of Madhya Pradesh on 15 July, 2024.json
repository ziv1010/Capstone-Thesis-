          "end": 3269
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.24547548592090607
    },
    {
      "sentence_id": 28,
      "text": "In these circumstances, applicant may be granted bail.",
