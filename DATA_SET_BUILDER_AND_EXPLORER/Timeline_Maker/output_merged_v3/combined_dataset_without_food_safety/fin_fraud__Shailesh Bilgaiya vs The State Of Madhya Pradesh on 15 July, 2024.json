      "end": 2258,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2651521563529968
    },
    {
      "sentence_id": 15,
      "text": "4. Learned counsel appearing for applicants submitted that applicants are innocent and have falsely been implicated in the case.",
