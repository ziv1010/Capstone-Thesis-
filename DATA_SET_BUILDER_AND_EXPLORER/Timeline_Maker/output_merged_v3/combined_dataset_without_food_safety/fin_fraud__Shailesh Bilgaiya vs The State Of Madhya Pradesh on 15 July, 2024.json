      "start": 3791,
      "end": 3822,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.30815568566322327
    },
    {
      "sentence_id": 35,
      "text": "Applicants have misrepresented before the Court.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3823,
      "end": 3871,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3716605305671692
    },
    {
      "sentence_id": 36,
      "text": "They were not the workers of the company, whereas they are Directors of the Company.",
