      "start": 3079,
      "end": 3157,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.30237868428230286
    },
    {
      "sentence_id": 26,
      "text": "He is suffering from kidney disease and is under treatment from jail.",
