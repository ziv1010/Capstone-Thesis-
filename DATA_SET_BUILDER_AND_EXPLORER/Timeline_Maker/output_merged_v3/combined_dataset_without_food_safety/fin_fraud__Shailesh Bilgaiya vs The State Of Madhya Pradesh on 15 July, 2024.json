      "end": 2388,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2672199010848999
    },
    {
      "sentence_id": 16,
      "text": "Investigation is complete and charge sheet has been filed.",
