      "start": 2389,
      "end": 2447,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.23576867580413818
    },
    {
      "sentence_id": 17,
      "text": "First application of applicant Keshav was dismissed for want of prosecution.",
