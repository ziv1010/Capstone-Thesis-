      "start": 3158,
      "end": 3227,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2883284091949463
    },
    {
      "sentence_id": 27,
      "text": "Applicant is permanent resident of Nagpur.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3228,
      "end": 3270,
      "entities": [
        {
          "text": "Nagpur",
