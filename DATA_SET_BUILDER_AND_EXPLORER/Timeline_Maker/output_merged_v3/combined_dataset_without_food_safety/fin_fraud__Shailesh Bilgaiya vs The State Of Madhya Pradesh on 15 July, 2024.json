      "end": 2038,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18117423355579376
    },
    {
      "sentence_id": 13,
      "text": "Complainant invested Rs.3,50,000/- in the Company on promise of better interest.",
      "rhetorical_role": "FAC",
      "start": 2039,
      "end": 2120,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24826204776763916
    },
    {
      "sentence_id": 14,
      "text": "After maturity,\nwhen she went to office, she found that Directors of the Company have closed the office and have cheated the complainant.",
