      "text": "Documents in respect of said investment was seized from the company.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 3722,
      "end": 3790,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2968718111515045
    },
    {
