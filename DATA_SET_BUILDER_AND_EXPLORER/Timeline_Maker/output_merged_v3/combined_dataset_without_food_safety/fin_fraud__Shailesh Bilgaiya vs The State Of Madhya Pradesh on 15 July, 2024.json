      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.372166246175766
    },
    {
      "sentence_id": 20,
      "text": "No case is made out against the applicant.",
      "rhetorical_role": "FAC",
      "start": 2635,
      "end": 2677,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3016617000102997
    },
    {
      "sentence_id": 21,
      "text": "He has not cheated the complainant and no specific role has been attributed to him.",
      "rhetorical_role": "FAC",
      "start": 2678,
      "end": 2761,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3686162829399109
    },
    {
      "sentence_id": 22,
      "text": "Co-accused persons have already been granted bail by this court and on the ground of parity, applicant Keshav deserves to be released on anticipatory bail.",
