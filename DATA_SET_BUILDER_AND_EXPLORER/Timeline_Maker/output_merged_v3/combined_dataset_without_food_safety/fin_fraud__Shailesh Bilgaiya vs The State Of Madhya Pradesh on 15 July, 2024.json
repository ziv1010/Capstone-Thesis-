      "summary_sent_score": 0.17175886034965515
    },
    {
      "sentence_id": 30,
      "text": "Learned Dy. Government Advocate appearing for the State opposed the bail applications and submitted that applicants are main accused in the case and they are Directors of the company.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3348,
      "end": 3531,
