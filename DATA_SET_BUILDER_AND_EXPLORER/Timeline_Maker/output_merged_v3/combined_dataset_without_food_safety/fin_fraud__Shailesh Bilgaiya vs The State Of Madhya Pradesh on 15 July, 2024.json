          "end": 2871
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3271285593509674
    },
    {
      "sentence_id": 23,
      "text": "5. Learned counsel appearing for applicant Shailesh Bilgaiya submitted that applicant is only a worker in the said company.",
