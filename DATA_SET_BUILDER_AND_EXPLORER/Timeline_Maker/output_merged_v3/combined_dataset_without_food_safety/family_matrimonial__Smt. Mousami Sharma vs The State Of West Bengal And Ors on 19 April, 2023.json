    {
      "sentence_id": 12,
      "text": "1.  The petitioner complains that her daughter-in- law and her associates have assaulted her repeatedly on many occasions.",
      "rhetorical_role": "FAC",
      "start": 465,
      "end": 587,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.23405656218528748
    },
    {
      "sentence_id": 13,
      "text": "They intended to dispossess the petitioner from her house.",
      "rhetorical_role": "FAC",
      "start": 588,
      "end": 646,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2858404517173767
    },
    {
      "sentence_id": 14,
      "text": "Title Suit No.262/2021 has been filed by the petitioner before the learned Civil Judge (Junior Division),\nBarrackpore, which is since pending.",
      "rhetorical_role": "FAC",
      "start": 647,
      "end": 789,
      "entities": [
        {
          "text": "Title Suit No.262/2021",
          "label": "CASE_NUMBER",
          "start": 647,
          "end": 669
        },
        {
          "text": "Civil Judge (Junior Division),\nBarrackpore",
          "label": "COURT",
          "start": 722,
          "end": 764
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1259259432554245
    },
    {
      "sentence_id": 15,
      "text": "Injunction has been ordered by the Civil Court against the private respondent and Belgharia Police has been strictly directed to enforce the order of injunction passed by the Civil Court.",
      "rhetorical_role": "FAC",
      "start": 790,
      "end": 977,
      "entities": [
        {
          "text": "Belgharia Police",
          "label": "ORG",
