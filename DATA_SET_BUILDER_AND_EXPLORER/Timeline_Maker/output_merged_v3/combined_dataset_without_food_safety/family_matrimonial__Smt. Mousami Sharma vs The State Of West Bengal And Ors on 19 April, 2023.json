      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.10493126511573792
    },
    {
      "sentence_id": 17,
      "text": "Two FIRs have resulted in charge sheets.",
      "rhetorical_role": "FAC",
      "start": 1194,
      "end": 1234,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.16409428417682648
    },
    {
      "sentence_id": 18,
      "text": "3. There is prima facie evidence of misconduct against the private respondent.",
      "rhetorical_role": "FAC",
      "start": 1235,
      "end": 1314,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1212536096572876
    },
    {
      "sentence_id": 19,
      "text": "In the event of any further complaint against the private respondent by the petitioner, coercive measures may be taken by the Belghoria Police.",
