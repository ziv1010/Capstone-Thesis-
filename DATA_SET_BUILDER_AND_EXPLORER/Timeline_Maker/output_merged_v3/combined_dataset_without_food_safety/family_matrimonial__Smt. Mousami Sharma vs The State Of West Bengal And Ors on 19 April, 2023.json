          "end": 888
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.26010945439338684
    },
    {
      "sentence_id": 16,
      "text": "2. On the complaints of the petitioner FIR No.872/21 dated 25th December, 2021, FIR No.513/21 dated 1st August, 2021, FIR No.472/21 dated 17th July, 2021, FIR No.25/22 dated 10th January,\n2022 have been registered.",
      "rhetorical_role": "FAC",
      "start": 978,
      "end": 1193,
      "entities": [
        {
          "text": "25th December, 2021",
          "label": "DATE",
