      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2691720724105835
    },
    {
      "sentence_id": 16,
      "text": "Today, her husband along with her Dever and Devrani brought her both the daughters at Chanderi and her Devrani informed that applicant Shakti Adiwasi has committed rape with your daughter.",
