      "summary_sent_score": 0.15234042704105377
    },
    {
      "sentence_id": 37,
      "text": "No specific overt act is alleged against the petitioner.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1692,
      "end": 1748,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.22988136112689972
    },
    {
      "sentence_id": 38,
      "text": "Learned counsel further submitted that this petitioner neither demanded any dowry nor assaulted the informant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1749,
      "end": 1859,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.13784433901309967
    },
    {
      "sentence_id": 39,
      "text": "Learned counsel next submitted that petitioner is ready to keep her wife with honour and dignity.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1860,
      "end": 1957,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.11103328317403793
    },
    {
      "sentence_id": 40,
      "text": "It has been submitted on behalf of the petitioner that the petitioner is in custody since 01.09.2023 and has no criminal antecedent.",
