      "start": 1174,
      "end": 1352,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.21956676244735718
    },
    {
      "sentence_id": 33,
      "text": "4. Learned counsel for the petitioner submitted that the petitioner has falsely been implicated in the present case.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1354,
      "end": 1470,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1395609825849533
    },
