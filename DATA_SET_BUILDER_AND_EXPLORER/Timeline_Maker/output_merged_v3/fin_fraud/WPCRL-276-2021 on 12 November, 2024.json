        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 4,
      "text": "There is no representation for the petitioners.",
      "rhetorical_role": "PREAMBLE",
      "start": 297,
      "end": 344,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 5,
      "text": "Mr. Deepak Bhardwaj, Brief Holder for the State of Uttarakhand.",
      "rhetorical_role": "NONE",
      "start": 345,
      "end": 409,
      "entities": [
        {
          "text": "Deepak Bhardwaj",
          "label": "OTHER_PERSON",
