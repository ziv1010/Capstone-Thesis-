          "start": 388,
          "end": 408
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 6,
      "text": "2. Petitioners have sought quashing of F.I.R. No.0025 of 2021, registered against them for offence punishable under Section 420 I.P.C. in Police Station Mukhani, District Nainital.",
      "rhetorical_role": "FAC",
      "start": 410,
      "end": 591,
      "entities": [
        {
          "text": "F.I.R. No.0025 of 2021",
          "label": "CASE_NUMBER",
          "start": 450,
          "end": 472
        },
        {
          "text": "Section 420",
          "label": "PROVISION",
          "start": 527,
          "end": 538
        },
        {
          "text": "I.P.C.",
          "label": "STATUTE",
          "start": 539,
          "end": 545
        },
        {
          "text": "Police Station Mukhani, District",
          "label": "ORG",
          "start": 549,
          "end": 581
        },
        {
          "text": "Nainital",
          "label": "GPE",
          "start": 582,
          "end": 590
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.20516283810138702
    },
    {
      "sentence_id": 7,
      "text": "They have also sought a direction to the Police Authorities not to arrest them, pursuant to the aforesaid F.I.R.\n3.",
      "rhetorical_role": "FAC",
      "start": 592,
      "end": 707,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2717265784740448
    },
    {
      "sentence_id": 8,
      "text": "Learned State Counsel submit that, upon investigation, charge sheet has been filed against the petitioners on 16.03.2021.",
      "rhetorical_role": "FAC",
      "start": 708,
      "end": 829,
      "entities": [
        {
          "text": "16.03.2021",
          "label": "DATE",
          "start": 818,
          "end": 828
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.16050593554973602
    },
    {
      "sentence_id": 9,
      "text": "Thus, it is contended that writ petition has become infructuous.",
      "rhetorical_role": "ANALYSIS",
      "start": 830,
      "end": 894,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.20697566866874695
    },
    {
      "sentence_id": 10,
      "text": "The said contention, however, cannot be accepted.",
      "rhetorical_role": "ANALYSIS",
      "start": 895,
      "end": 944,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.15807653963565826
    },
    {
      "sentence_id": 11,
      "text": "Mere filing of charge sheet will not render the writ petition infructuous.",
      "rhetorical_role": "ANALYSIS",
      "start": 945,
      "end": 1019,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3934005796909332
    },
    {
      "sentence_id": 12,
      "text": "4. Hon'ble Supreme Court in the case of M/s Neeharika Infrastructure Pvt. Ltd. Vs. State of Maharashtra & others, reported in AIR 2021 SC 1918, have laid down parameters for exercise of power under Article 226 of Constitution, in such matters.",
      "rhetorical_role": "PRE_RELIED",
      "start": 1021,
      "end": 1264,
      "entities": [
        {
          "text": "Supreme Court",
          "label": "COURT",
          "start": 1032,
          "end": 1045
        },
        {
          "text": "M/s Neeharika Infrastructure Pvt. Ltd. Vs. State of Maharashtra & others, reported in AIR 2021 SC 1918",
          "label": "PRECEDENT",
          "start": 1061,
          "end": 1163
        },
        {
          "text": "Article 226",
          "label": "PROVISION",
          "start": 1219,
          "end": 1230
        },
        {
          "text": "Constitution",
          "label": "STATUTE",
          "start": 1234,
          "end": 1246
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.28666335344314575
    },
    {
      "sentence_id": 13,
      "text": "5. The impugned F.I.R. is on record as Annexure No.1 to the writ petition.",
      "rhetorical_role": "ANALYSIS",
      "start": 1266,
      "end": 1340,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.24839025735855103
    },
    {
      "sentence_id": 14,
      "text": "Perusal of the F.I.R.\nreveals that ingredients of offences levelled against the petitioners are made out.",
      "rhetorical_role": "ANALYSIS",
      "start": 1341,
      "end": 1446,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3558644950389862
    },
    {
      "sentence_id": 15,
      "text": "2024:UHC:8395 6.",
      "rhetorical_role": "NONE",
      "start": 1447,
      "end": 1464,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 16,
      "text": "Whether the allegations are true or untrue, would have to be decided in the trial.",
      "rhetorical_role": "ANALYSIS",
      "start": 1465,
      "end": 1547,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5676721334457397
    },
    {
      "sentence_id": 17,
      "text": "While exercising power under Article 226 of the Constitution, this Court is not expected to embark upon an enquiry into, whether there is reliable evidence or not.",
      "rhetorical_role": "ANALYSIS",
      "start": 1548,
      "end": 1711,
      "entities": [
        {
          "text": "Article 226",
          "label": "PROVISION",
          "start": 1577,
          "end": 1588
        },
        {
          "text": "Constitution",
          "label": "STATUTE",
          "start": 1596,
          "end": 1608
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6498584151268005
    },
    {
      "sentence_id": 18,
      "text": "It is not a case where FIR does not, disclose any offence.",
      "rhetorical_role": "RATIO",
      "start": 1712,
      "end": 1770,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6250556707382202
    },
    {
      "sentence_id": 19,
      "text": "None of the parameters laid down by Hon'ble Supreme Court, for invoking power under Article 226 of the Constitution for quashing an FIR, are met in the present case.",
      "rhetorical_role": "RATIO",
      "start": 1771,
      "end": 1936,
      "entities": [
        {
          "text": "Supreme Court",
          "label": "COURT",
          "start": 1815,
          "end": 1828
        },
        {
          "text": "Article 226",
          "label": "PROVISION",
          "start": 1855,
          "end": 1866
        },
        {
          "text": "Constitution",
          "label": "STATUTE",
          "start": 1874,
          "end": 1886
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5870407223701477
    },
    {
      "sentence_id": 20,
      "text": "7. In such view of the matter, there is no scope for interference with the impugned FIR while exercising extraordinary power under Article 226 of the Constitution.",
      "rhetorical_role": "RATIO",
      "start": 1938,
      "end": 2101,
      "entities": [
        {
          "text": "Article 226",
          "label": "PROVISION",
          "start": 2069,
          "end": 2080
        },
        {
          "text": "Constitution",
          "label": "STATUTE",
          "start": 2088,
          "end": 2100
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5754095315933228
    },
    {
      "sentence_id": 21,
      "text": "8. Accordingly, the writ petition fails and is dismissed.",
      "rhetorical_role": "RPC",
      "start": 2103,
      "end": 2160,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.20129050314426422
