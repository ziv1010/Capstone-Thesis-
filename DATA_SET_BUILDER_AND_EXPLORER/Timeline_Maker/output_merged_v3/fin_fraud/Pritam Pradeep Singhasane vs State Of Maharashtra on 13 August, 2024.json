    {
      "sentence_id": 9,
      "text": "2. Heard Mr. Aditya Raktade, learned counsel for the applicant and Ms. Ranjana Humane, learned APP for the State.",
      "rhetorical_role": "NONE",
      "start": 743,
      "end": 856,
