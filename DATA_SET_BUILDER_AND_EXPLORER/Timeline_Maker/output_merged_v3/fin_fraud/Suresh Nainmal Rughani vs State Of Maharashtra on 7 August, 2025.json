      "summary_section": "arguments",
      "summary_sent_score": 0.25761139392852783
    },
    {
      "sentence_id": 33,
      "text": "This is to safeguard Vikram's dignity and reputation.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3958,
      "end": 4011,
      "entities": [
        {
          "text": "Vikram",
