          "label": "LAWYER",
          "start": 1099,
          "end": 1106
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "3. The FIR is lodged by one Suhas Ovhal.",
      "rhetorical_role": "FAC",
      "start": 1135,
      "end": 1176,
      "entities": [
        {
          "text": "Suhas Ovhal",
          "label": "OTHER_PERSON",
          "start": 1164,
          "end": 1175
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.08607586473226547
    },
    {
      "sentence_id": 11,
      "text": "He was working with M/s Shreeram City Union Finance Ltd.",
      "rhetorical_role": "FAC",
      "start": 1177,
      "end": 1233,
      "entities": [
        {
          "text": "Shreeram City Union Finance Ltd.",
          "label": "ORG",
          "start": 1201,
          "end": 1233
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.16819444298744202
    },
    {
      "sentence_id": 12,
      "text": "It was a non banking y.s.patil 1 of 7 8-ABA-460-2024.odt Finance Company.",
      "rhetorical_role": "FAC",
      "start": 1234,
      "end": 1307,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18936927616596222
    },
    {
      "sentence_id": 13,
      "text": "It was in business of giving loans, business loans etc.",
      "rhetorical_role": "FAC",
      "start": 1308,
      "end": 1363,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.22948242723941803
    },
    {
      "sentence_id": 14,
      "text": "The applicants were Directors of M/s Mountain Edge Tours and Holidays Private Limited.",
      "rhetorical_role": "FAC",
      "start": 1364,
      "end": 1450,
      "entities": [
        {
          "text": "Mountain Edge Tours and Holidays Private Limited",
          "label": "ORG",
          "start": 1401,
          "end": 1449
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.17090417444705963
    },
    {
      "sentence_id": 15,
      "text": "Their registered office is at Andaman-Nicobar.",
      "rhetorical_role": "FAC",
      "start": 1451,
      "end": 1497,
      "entities": [
        {
          "text": "Andaman-Nicobar",
          "label": "GPE",
          "start": 1481,
          "end": 1496
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.165956512093544
    },
    {
      "sentence_id": 16,
      "text": "Both of them had approached the informant's Company's office through Shivpujan Pande and Rishab Khanna.",
      "rhetorical_role": "FAC",
      "start": 1498,
      "end": 1601,
      "entities": [
        {
          "text": "Shivpujan Pande",
          "label": "OTHER_PERSON",
          "start": 1567,
          "end": 1582
        },
        {
          "text": "Rishab Khanna",
          "label": "OTHER_PERSON",
          "start": 1587,
          "end": 1600
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15997767448425293
    },
    {
      "sentence_id": 17,
      "text": "They made four applications for sanctioning of loan for purchasing office numbers 03, 05, 15, 17 on the 1 st floor, A wing, 119, Business Point, Sahar Road, Andheri (East), Mumbai by mortgaging the said property.",
      "rhetorical_role": "FAC",
      "start": 1602,
      "end": 1815,
      "entities": [
        {
          "text": "Andheri",
          "label": "GPE",
          "start": 1760,
          "end": 1767
        },
        {
          "text": "Mumbai",
          "label": "GPE",
          "start": 1776,
          "end": 1782
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20318350195884705
    },
    {
      "sentence_id": 18,
      "text": "They wanted loan of Rs. 1 crore each for purchasing the offices.",
      "rhetorical_role": "FAC",
      "start": 1816,
      "end": 1880,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2009965479373932
    },
    {
      "sentence_id": 19,
      "text": "They submitted the documents alongwith their application.",
      "rhetorical_role": "FAC",
      "start": 1881,
      "end": 1938,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2140296995639801
    },
    {
      "sentence_id": 20,
      "text": "The informant's Company verified those documents.",
      "rhetorical_role": "FAC",
      "start": 1939,
      "end": 1988,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20775771141052246
    },
    {
      "sentence_id": 21,
      "text": "They saw their CIBIL scores.",
      "rhetorical_role": "FAC",
      "start": 1989,
      "end": 2017,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1745961308479309
    },
    {
      "sentence_id": 22,
      "text": "The Company was satisfied about their scores.",
      "rhetorical_role": "FAC",
      "start": 2018,
      "end": 2063,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20692595839500427
    },
    {
      "sentence_id": 23,
      "text": "The informant's Company obtained valuation report from the government appointed valuers.",
      "rhetorical_role": "FAC",
      "start": 2064,
      "end": 2152,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2264758199453354
    },
    {
      "sentence_id": 24,
      "text": "They also obtained property title search report.",
      "rhetorical_role": "FAC",
      "start": 2153,
      "end": 2201,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20103387534618378
    },
    {
      "sentence_id": 25,
      "text": "All these reports were positive and therefore on 30/05/2018 and 30/06/2018,\ninformant's Company sanctioned loan of Rs. 4,90,00,000/- in favour of both the applicants.",
      "rhetorical_role": "FAC",
      "start": 2202,
      "end": 2368,
      "entities": [
        {
          "text": "30/05/2018",
          "label": "DATE",
          "start": 2251,
          "end": 2261
        },
        {
          "text": "30/06/2018",
          "label": "DATE",
          "start": 2266,
          "end": 2276
        },
        {
          "text": "informant's Company",
          "label": "ORG",
          "start": 2278,
          "end": 2297
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20164896547794342
    },
    {
      "sentence_id": 26,
      "text": "The applicants and informant's Company entered into four agreements for that loan.",
      "rhetorical_role": "FAC",
      "start": 2369,
      "end": 2451,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2666691839694977
    },
    {
      "sentence_id": 27,
      "text": "Both the y.s.patil 2 of 7 8-ABA-460-2024.odt applicants submitted four agreements which they had entered into with the builder namely Roy Ambrose Credo in respect of those four properties.",
      "rhetorical_role": "FAC",
      "start": 2452,
      "end": 2640,
      "entities": [
        {
          "text": "Roy Ambrose Credo",
          "label": "OTHER_PERSON",
          "start": 2586,
          "end": 2603
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2263760268688202
    },
    {
      "sentence_id": 28,
      "text": "According to the instructions given by the applicants, the loan amount was deposited in the bank account of Roy Ambrose Credo maintained with Axis Bank.",
      "rhetorical_role": "FAC",
      "start": 2641,
      "end": 2793,
      "entities": [
        {
          "text": "Roy Ambrose Credo",
          "label": "OTHER_PERSON",
          "start": 2749,
          "end": 2766
        },
        {
          "text": "Axis Bank",
          "label": "ORG",
          "start": 2783,
          "end": 2792
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1766705960035324
    },
    {
      "sentence_id": 29,
      "text": "Said builder had given NOC for mortgaging those properties.",
      "rhetorical_role": "FAC",
      "start": 2794,
      "end": 2853,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15069924294948578
    },
    {
      "sentence_id": 30,
      "text": "Informant's Company had registered notice of intimation in respect of mortgaging of those properties with the Sub Registrar, Andheri.",
      "rhetorical_role": "FAC",
      "start": 2854,
      "end": 2987,
      "entities": [
        {
          "text": "Andheri",
          "label": "GPE",
          "start": 2979,
          "end": 2986
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.21100062131881714
    },
    {
      "sentence_id": 31,
      "text": "Thus, the informant-Company deposited loan amount of Rs. 4,80,00,445/- in Roy Ambrose Credo's two bank accounts.",
      "rhetorical_role": "FAC",
      "start": 2988,
      "end": 3100,
      "entities": [
        {
          "text": "Roy Ambrose Credo",
          "label": "OTHER_PERSON",
          "start": 3062,
          "end": 3079
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.22286882996559143
    },
    {
      "sentence_id": 32,
      "text": "Initially applicants paid four installments, but thereafter the installments were not paid.",
      "rhetorical_role": "FAC",
      "start": 3101,
      "end": 3192,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1595408171415329
    },
    {
      "sentence_id": 33,
      "text": "They started giving evasive replies.",
      "rhetorical_role": "FAC",
      "start": 3193,
      "end": 3229,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.08189644664525986
    },
    {
      "sentence_id": 34,
      "text": "Informant's Company employees made inquiry.",
      "rhetorical_role": "FAC",
      "start": 3230,
      "end": 3274,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15765270590782166
    },
    {
      "sentence_id": 35,
      "text": "They went to the building where those properties were situated.",
      "rhetorical_role": "FAC",
      "start": 3275,
      "end": 3338,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.12281019240617752
    },
    {
      "sentence_id": 36,
      "text": "It was revealed that the office numbers 03,05,15 and 17 were not in existence at all.",
      "rhetorical_role": "FAC",
      "start": 3339,
      "end": 3424,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.10422337800264359
    },
    {
      "sentence_id": 37,
      "text": "In fact, there were office numbers 103,105, 115 and 117 on the first floor of that building.",
      "rhetorical_role": "FAC",
      "start": 3425,
      "end": 3517,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.11231209337711334
    },
    {
      "sentence_id": 38,
      "text": "Those offices were owned by different people.",
      "rhetorical_role": "FAC",
      "start": 3518,
      "end": 3563,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.16314463317394257
    },
    {
      "sentence_id": 39,
      "text": "Thus the informant's Company realised that they were cheated.",
      "rhetorical_role": "FAC",
      "start": 3564,
      "end": 3625,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15881848335266113
    },
    {
      "sentence_id": 40,
      "text": "They made further inquiry and they came to know that major amount y.s.patil 3 of 7 8-ABA-460-2024.odt deposited in Roy Ambraso Credo's account was transferred to the applicants'\naccount.",
      "rhetorical_role": "FAC",
      "start": 3626,
      "end": 3813,
      "entities": [
        {
          "text": "Roy Ambraso Credo",
          "label": "ORG",
          "start": 3742,
          "end": 3759
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1156364306807518
    },
    {
      "sentence_id": 41,
      "text": "In all Rs. 2,25,77,895/- were transferred from Credo's account to the applicants' Company's account.",
      "rhetorical_role": "FAC",
      "start": 3814,
      "end": 3914,
      "entities": [
        {
          "text": "Credo",
          "label": "OTHER_PERSON",
          "start": 3861,
          "end": 3866
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15590423345565796
    },
    {
      "sentence_id": 42,
      "text": "The FIR further mentions that one Chinmaykumar Nath and Rishab Khanna had misled the people who had done valuation and verification at the time of taking title search.",
      "rhetorical_role": "FAC",
      "start": 3915,
      "end": 4082,
      "entities": [
        {
          "text": "Chinmaykumar Nath",
          "label": "OTHER_PERSON",
          "start": 3949,
          "end": 3966
        },
        {
          "text": "Rishab Khanna",
          "label": "OTHER_PERSON",
          "start": 3971,
          "end": 3984
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.09775379300117493
    },
    {
      "sentence_id": 43,
      "text": "On these allegations the FIR is lodged.",
      "rhetorical_role": "FAC",
      "start": 4083,
      "end": 4122,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.16907140612602234
    },
    {
      "sentence_id": 44,
      "text": "4. Learned counsel for the applicants submitted that the applicants themselves are the victims.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4123,
      "end": 4219,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1230086013674736
    },
    {
      "sentence_id": 45,
      "text": "The finance Company and the builder have cheated the applicants.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4220,
      "end": 4284,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.21248911321163177
    },
    {
      "sentence_id": 46,
      "text": "They had made complaints to the police in January 2020, February 2020 and February 2021 but no action was taken by the police,",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4285,
      "end": 4411,
      "entities": [
        {
          "text": "January 2020, February 2020 and February 2021",
          "label": "DATE",
          "start": 4327,
          "end": 4372
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.17207573354244232
    },
    {
      "sentence_id": 47,
      "text": "and instead, this false complaint is lodged against the applicants.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4412,
      "end": 4480,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.191518634557724
    },
    {
      "sentence_id": 48,
      "text": "He submitted that the FIR itself mentioned that the finance Company had taken all the precautions in respect of valuation and search report and only thereafter the loan was sanctioned.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4481,
      "end": 4665,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2016827017068863
    },
    {
      "sentence_id": 49,
      "text": "Therefore, there was no scope to even Prakash Kumar Raj And Anr vs The State Of Maharashtra on 16 February, 2024 Indian Kanoon - http://indiankanoon.org/doc/63951588/\n2 suggest that the applicants had cheated the finance Company.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4666,
      "end": 4895,
      "entities": [
        {
          "text": "Prakash Kumar Raj And Anr vs The State Of Maharashtra on 16 February, 2024 Indian Kanoon",
          "label": "PRECEDENT",
          "start": 4704,
          "end": 4792
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3828583061695099
    },
    {
      "sentence_id": 50,
      "text": "The original documents are still with the complainant's y.s.patil 4 of 7 8-ABA-460-2024.odt Company.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4896,
      "end": 4996,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.042349617928266525
    },
    {
      "sentence_id": 51,
      "text": "He submitted that money which was transferred from Roy Ambraso Credo's account to the applicants Company was given for purchasing shares of the applicants Company.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4997,
      "end": 5160,
      "entities": [
        {
          "text": "Roy Ambraso Credo",
          "label": "OTHER_PERSON",
          "start": 5048,
          "end": 5065
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.18227505683898926
    },
    {
      "sentence_id": 52,
      "text": "He submitted that the finance Company has initiated the insolvency proceedings before the Company Law Tribunal at Kolkata.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5161,
      "end": 5283,
      "entities": [
        {
          "text": "Company Law Tribunal at Kolkata",
          "label": "COURT",
          "start": 5251,
          "end": 5282
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.16799993813037872
    },
    {
      "sentence_id": 53,
      "text": "This fact is suppressed from the FIR.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5284,
      "end": 5321,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.15315133333206177
    },
    {
      "sentence_id": 54,
      "text": "The Interim Resolution Professional is taking steps to take charge of the applicants'\nproperties which are worth more than 7 crores.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5322,
      "end": 5454,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.18635016679763794
    },
    {
      "sentence_id": 55,
      "text": "The applicants have cooperated with the investigation when they were on ad-interim relief during pendency of their anticipatory bail application before the Sessions Court.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5455,
      "end": 5626,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.24149759113788605
    },
    {
      "sentence_id": 56,
      "text": "5. Learned APP opposed these submissions.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5628,
      "end": 5669,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.07706917822360992
    },
    {
      "sentence_id": 57,
      "text": "He relied on the money trail which shows that the major amount of the loan sanctioned by the Company and deposited in the builder's account was transferred to the applicants accounts.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5670,
      "end": 5853,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.19739440083503723
    },
    {
      "sentence_id": 58,
      "text": "He submitted that the allegations in the FIR themselves show that the offence is committed by the applicants.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5854,
      "end": 5963,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.17251025140285492
    },
    {
      "sentence_id": 59,
      "text": "During the investigation it was revealed that office numbers 03,05,15,17 were not existing and y.s.patil 5 of 7 8-ABA-460-2024.odt the offices which were in existence belonged to the other persons.\n6.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5964,
      "end": 6164,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.09602000564336777
    },
    {
      "sentence_id": 60,
      "text": "I have considered these submissions.",
      "rhetorical_role": "ANALYSIS",
      "start": 6165,
      "end": 6201,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.027150919660925865
    },
    {
      "sentence_id": 61,
      "text": "First of all it is sufficiently revealed in the investigation that those particular offices were not in existence.",
      "rhetorical_role": "ANALYSIS",
      "start": 6202,
      "end": 6316,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.15075622498989105
    },
    {
      "sentence_id": 62,
      "text": "Therefore, the applicants have obtained loan on non existing property.",
      "rhetorical_role": "ANALYSIS",
      "start": 6317,
      "end": 6387,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.24679666757583618
    },
    {
      "sentence_id": 63,
      "text": "Properties which were mortgaged were not in existence at all.",
      "rhetorical_role": "ANALYSIS",
      "start": 6388,
      "end": 6449,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.22694101929664612
    },
    {
      "sentence_id": 64,
      "text": "The actual offices which were on the first floor of that building belonged to somebody else.",
      "rhetorical_role": "ANALYSIS",
      "start": 6450,
      "end": 6542,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1875750720500946
    },
    {
      "sentence_id": 65,
      "text": "Thus it is a clear case of cheating.",
      "rhetorical_role": "ANALYSIS",
      "start": 6543,
      "end": 6579,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.25360217690467834
    },
    {
      "sentence_id": 66,
      "text": "The applicants have not taken any steps to even suggest that though they were paying installments they had not been given possession of the offices.",
      "rhetorical_role": "ANALYSIS",
      "start": 6580,
      "end": 6728,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.19995830953121185
    },
    {
      "sentence_id": 67,
      "text": "This conduct is also not explained by the applicants.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 6729,
      "end": 6782,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1785994917154312
    },
    {
      "sentence_id": 68,
      "text": "7. Though the learned counsel for the applicants submitted that the applicants have filed suit for those properties, however, question still remains that there were no such offices existing.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 6784,
      "end": 6974,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.11361903697252274
    },
    {
      "sentence_id": 69,
      "text": "It is also important to note that the major amount which was deposited in the builder's account has travelled back to the account of the applicants' Company.",
      "rhetorical_role": "RATIO",
      "start": 6975,
      "end": 7132,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1642088145017624
    },
    {
      "sentence_id": 70,
      "text": "This is also strong incriminating circumstance against the applicants which indicates y.s.patil 6 of 7 8-ABA-460-2024.odt that the transactions were entered into by the applicants only to get that money and they were not interested in getting the offices.",
      "rhetorical_role": "RATIO",
      "start": 7133,
      "end": 7388,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.20871591567993164
    },
    {
      "sentence_id": 71,
      "text": "The Insolvency Proceedings are totally an independent issue.",
      "rhetorical_role": "RATIO",
      "start": 7389,
      "end": 7449,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3031119406223297
    },
    {
      "sentence_id": 72,
      "text": "8. The offence of cheating, misappropriation and forgery of documents is clearly made out in this particular FIR.",
      "rhetorical_role": "RATIO",
      "start": 7451,
      "end": 7564,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2142949253320694
    },
    {
      "sentence_id": 73,
      "text": "The offence is serious.",
      "rhetorical_role": "RPC",
      "start": 7565,
      "end": 7588,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.23138469457626343
    },
    {
      "sentence_id": 74,
      "text": "The Applicants' custodial interrogation is therefore necessary.",
      "rhetorical_role": "RPC",
      "start": 7589,
      "end": 7652,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.1808447688817978
    },
    {
      "sentence_id": 75,
      "text": "Therefore, no relief under Section 438 of Cr.P.C. can be granted to the applicants.",
      "rhetorical_role": "RPC",
      "start": 7653,
      "end": 7737,
      "entities": [
        {
          "text": "Section 438",
          "label": "PROVISION",
          "start": 7681,
          "end": 7692
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 7696,
          "end": 7703
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.5173070430755615
    },
    {
      "sentence_id": 76,
      "text": "The Application is rejected.",
      "rhetorical_role": "RPC",
      "start": 7738,
      "end": 7766,
      "entities": [],
