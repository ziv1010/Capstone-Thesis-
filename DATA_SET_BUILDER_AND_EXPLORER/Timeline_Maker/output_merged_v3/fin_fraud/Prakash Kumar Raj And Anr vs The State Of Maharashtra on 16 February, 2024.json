      "rhetorical_role": "NONE",
      "start": 977,
      "end": 1036,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "Heard Shri Varma,learned counsel for the Applicants and Shri Satpute, learned APP for the State.",
      "rhetorical_role": "NONE",
      "start": 1037,
      "end": 1134,
      "entities": [
        {
          "text": "Varma",
          "label": "LAWYER",
