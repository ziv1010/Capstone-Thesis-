      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "The Applicants are seeking anticipatory bail in connection with C.R.No.- 68 of\n2024 registered with Bandra Kurla Complex Police Station on 21/01/2024 under\nsections 406, 420,465, 467, 468, 471, 120-B of the Indian Penal Code.\nPrakash Kumar Raj And Anr vs The State Of Maharashtra on 16 February, 2024",
      "rhetorical_role": "NONE",
      "start": 675,
      "end": 975,
      "entities": [
        {
