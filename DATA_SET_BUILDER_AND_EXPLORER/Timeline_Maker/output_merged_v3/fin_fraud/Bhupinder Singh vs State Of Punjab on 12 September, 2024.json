    {
      "sentence_id": 34,
      "text": "which was dismissed on merits vide order dated 20.03.2023.",
      "rhetorical_role": "FAC",
      "start": 4477,
      "end": 4535,
      "entities": [
        {
          "text": "20.03.2023",
          "label": "DATE",
