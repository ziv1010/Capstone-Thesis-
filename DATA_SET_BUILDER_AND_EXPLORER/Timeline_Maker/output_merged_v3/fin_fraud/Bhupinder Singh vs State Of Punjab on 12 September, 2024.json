        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22642222046852112
    },
    {
      "sentence_id": 12,
      "text": "It was alleged in the complaint that the complainants met Sukhiwnder Singh and Sukhchain Singh about a year back and talked regarding sending them to Canada.",
      "rhetorical_role": "FAC",
      "start": 1666,
      "end": 1823,
      "entities": [
        {
          "text": "Sukhiwnder Singh",
          "label": "OTHER_PERSON",
          "start": 1724,
          "end": 1740
        },
        {
          "text": "Sukhchain Singh",
          "label": "OTHER_PERSON",
          "start": 1745,
          "end": 1760
        },
        {
          "text": "Canada",
          "label": "GPE",
          "start": 1816,
          "end": 1822
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.230187326669693
    },
    {
      "sentence_id": 13,
      "text": "They received phone call and made them to talk to Pali @ Sidhu.",
      "rhetorical_role": "FAC",
      "start": 1824,
      "end": 1887,
      "entities": [
        {
          "text": "Pali @ Sidhu",
          "label": "OTHER_PERSON",
          "start": 1874,
          "end": 1886
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2262904793024063
    },
    {
      "sentence_id": 14,
      "text": "Thereafter, they remained in conversation with Sandeep Gill and Romi.",
      "rhetorical_role": "FAC",
      "start": 1888,
      "end": 1958,
      "entities": [
        {
          "text": "Sandeep Gill",
          "label": "OTHER_PERSON",
          "start": 1936,
          "end": 1948
        },
        {
          "text": "Romi",
          "label": "OTHER_PERSON",
          "start": 1953,
          "end": 1957
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22025372087955475
    },
    {
      "sentence_id": 15,
      "text": "They were told that they would be sent as News Reporters by one news company.",
      "rhetorical_role": "FAC",
      "start": 1959,
      "end": 2036,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21528911590576172
    },
    {
      "sentence_id": 16,
      "text": "On 16.01.2022, they received a call that work for going Canada has been done.",
      "rhetorical_role": "FAC",
      "start": 2037,
      "end": 2114,
      "entities": [
        {
          "text": "16.01.2022",
          "label": "DATE",
          "start": 2040,
          "end": 2050
        },
        {
          "text": "Canada",
          "label": "GPE",
          "start": 2093,
          "end": 2099
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24756157398223877
    },
    {
      "sentence_id": 17,
      "text": "On 18.01.2022, Sukhwinder Singh and Sandeep Singh and one unidentified girl and Romi reached their home to take them.",
      "rhetorical_role": "FAC",
      "start": 2115,
      "end": 2232,
      "entities": [
        {
          "text": "18.01.2022",
          "label": "DATE",
          "start": 2118,
          "end": 2128
        },
        {
          "text": "Sukhwinder Singh",
          "label": "PETITIONER",
          "start": 2130,
          "end": 2146
        },
        {
          "text": "Sandeep Singh",
          "label": "PETITIONER",
          "start": 2151,
          "end": 2164
        },
        {
          "text": "Romi",
          "label": "OTHER_PERSON",
          "start": 2195,
          "end": 2199
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2792710065841675
    },
    {
      "sentence_id": 18,
      "text": "They were lodged in a Hotel at Paharganj, Delhi.",
      "rhetorical_role": "FAC",
      "start": 2233,
      "end": 2281,
      "entities": [
        {
          "text": "Paharganj",
          "label": "GPE",
          "start": 2264,
          "end": 2273
        },
        {
          "text": "Delhi",
          "label": "GPE",
          "start": 2275,
          "end": 2280
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.27337735891342163
    },
    {
      "sentence_id": 19,
      "text": "Both the complainants took Rs.3,00,000/- lacs each from their families as it was agreed that after reaching Delhi, Canadian dollar of equivalent to that amount would be handed over to them.",
      "rhetorical_role": "FAC",
      "start": 2282,
      "end": 2471,
      "entities": [
        {
          "text": "Delhi",
          "label": "GPE",
          "start": 2390,
          "end": 2395
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2707175016403198
    },
    {
      "sentence_id": 20,
      "text": "However, on reaching Delhi, they were clandestinely kidnapped by the accused and were tortured.",
      "rhetorical_role": "FAC",
      "start": 2472,
      "end": 2567,
      "entities": [
        {
          "text": "Delhi",
          "label": "GPE",
          "start": 2493,
          "end": 2498
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3477654755115509
    },
    {
      "sentence_id": 21,
      "text": "They were made to talk to their families by video call and Rs.27 lacs each were demanded from their families.",
      "rhetorical_role": "FAC",
      "start": 2568,
      "end": 2677,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2572717070579529
    },
    {
      "sentence_id": 22,
      "text": "Their families were made to believe that both of them have reached Canada, however, their families were informed that the complainants could not come on phone as they were quarantined.",
      "rhetorical_role": "FAC",
      "start": 2678,
      "end": 2862,
      "entities": [
        {
          "text": "Canada",
          "label": "GPE",
          "start": 2745,
          "end": 2751
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18493777513504028
    },
    {
      "sentence_id": 23,
      "text": "The accused went to the house of complainant Udhampreet Singh to take payment of Rs.27 lacs and his family was promised that by 30.01.2022, their son would be released.",
      "rhetorical_role": "FAC",
      "start": 2863,
      "end": 3031,
      "entities": [
        {
          "text": "Udhampreet Singh",
          "label": "OTHER_PERSON",
          "start": 2908,
          "end": 2924
        },
        {
          "text": "30.01.2022",
          "label": "DATE",
          "start": 2991,
          "end": 3001
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18756042420864105
    },
    {
      "sentence_id": 24,
      "text": "Being afraid, his family paid Rs.27 lacs in cash, however, despite this complainant Udhampreet Singh was not released.",
      "rhetorical_role": "FAC",
      "start": 3033,
      "end": 3151,
      "entities": [
        {
          "text": "Udhampreet Singh",
          "label": "OTHER_PERSON",
          "start": 3117,
          "end": 3133
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.16061539947986603
    },
    {
      "sentence_id": 25,
      "text": "Accused Sidhu, Sukhiwnder, Sandeep, Happy alongwith sister and Jija of Sidhu and his father went to the house of complainant Navjot Singh as well 2 of 5 Neutral Citation No:=2024:PHHC:120987 for collecting Rs.27 lacs.",
      "rhetorical_role": "FAC",
      "start": 3152,
      "end": 3369,
      "entities": [
        {
          "text": "Sidhu",
          "label": "OTHER_PERSON",
          "start": 3160,
          "end": 3165
        },
        {
          "text": "Sukhiwnder",
          "label": "OTHER_PERSON",
          "start": 3167,
          "end": 3177
        },
        {
          "text": "Sandeep",
          "label": "PETITIONER",
          "start": 3179,
          "end": 3186
        },
        {
          "text": "Jija",
          "label": "OTHER_PERSON",
          "start": 3215,
          "end": 3219
        },
        {
          "text": "Sidhu",
          "label": "OTHER_PERSON",
          "start": 3223,
          "end": 3228
        },
        {
          "text": "Navjot Singh",
          "label": "OTHER_PERSON",
          "start": 3277,
          "end": 3289
        },
        {
          "text": ":",
          "label": "CASE_NUMBER",
          "start": 3330,
          "end": 3331
        },
        {
          "text": "PHHC:120987",
          "label": "CASE_NUMBER",
          "start": 3331,
          "end": 3342
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.16201674938201904
    },
    {
      "sentence_id": 26,
      "text": "Thereafter, they lost their consciousness and found themselves at the house of one Sardar Family.",
      "rhetorical_role": "FAC",
      "start": 3370,
      "end": 3467,
      "entities": [
        {
          "text": "Sardar Family",
          "label": "OTHER_PERSON",
          "start": 3453,
          "end": 3466
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20991608500480652
    },
    {
      "sentence_id": 27,
      "text": "They were told that on 05.02.2022, they found the complainant at railway track and brought to their house.",
      "rhetorical_role": "FAC",
      "start": 3468,
      "end": 3574,
      "entities": [
        {
          "text": "05.02.2022",
          "label": "DATE",
          "start": 3491,
          "end": 3501
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1974353939294815
    },
    {
      "sentence_id": 28,
      "text": "With their help, the complainants reached Gurudwara Sahib, Sis Ganj, from where they contacted their families and returned back to their home.",
      "rhetorical_role": "FAC",
      "start": 3575,
      "end": 3717,
      "entities": [
        {
          "text": "Gurudwara Sahib",
          "label": "GPE",
          "start": 3617,
          "end": 3632
        },
        {
          "text": "Sis Ganj",
          "label": "OTHER_PERSON",
          "start": 3634,
          "end": 3642
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1657586395740509
    },
    {
      "sentence_id": 29,
      "text": "It was prayed that strict legal action be taken against all the accused.",
      "rhetorical_role": "FAC",
      "start": 3718,
      "end": 3790,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2261042296886444
    },
    {
      "sentence_id": 30,
      "text": "On the basis of the complaint, the FIR was lodged and the investigation commenced.",
      "rhetorical_role": "FAC",
      "start": 3791,
      "end": 3873,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2819000780582428
    },
    {
      "sentence_id": 31,
      "text": "Both the petitioners were arrested on 25.11.2022 and 15.04.2022, respectively.",
      "rhetorical_role": "FAC",
      "start": 3874,
      "end": 3952,
      "entities": [
        {
          "text": "25.11.2022",
          "label": "DATE",
          "start": 3912,
          "end": 3922
        },
        {
          "text": "15.04.2022",
          "label": "DATE",
          "start": 3927,
          "end": 3937
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2724911868572235
    },
    {
      "sentence_id": 32,
      "text": "Both the petitioner, namely, Bhupinder Singh and Sukhwinder Singh approached the Court of learned Additional Judge, Patiala praying for grant of regular bail, however, finding no merit in the petitions filed, learned Court declined the same vide orders dated 30.01.2023 and 13.07.2022, respectively.",
      "rhetorical_role": "FAC",
      "start": 3953,
      "end": 4252,
      "entities": [
        {
          "text": "Bhupinder Singh",
          "label": "PETITIONER",
          "start": 3982,
          "end": 3997
        },
        {
          "text": "Sukhwinder Singh",
          "label": "PETITIONER",
          "start": 4002,
          "end": 4018
        },
        {
          "text": "Court of learned Additional Judge, Patiala",
          "label": "COURT",
          "start": 4034,
          "end": 4076
        },
        {
          "text": "30.01.2023",
          "label": "DATE",
          "start": 4212,
          "end": 4222
        },
        {
          "text": "13.07.2022",
          "label": "DATE",
