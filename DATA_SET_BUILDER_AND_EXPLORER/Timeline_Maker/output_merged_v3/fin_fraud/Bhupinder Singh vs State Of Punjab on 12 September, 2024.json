          "end": 4291
        },
        {
          "text": "CRM-M-11620-2023",
          "label": "CASE_NUMBER",
          "start": 4331,
          "end": 4347
        },
        {
          "text": "25.05.2023",
          "label": "DATE",
          "start": 4401,
