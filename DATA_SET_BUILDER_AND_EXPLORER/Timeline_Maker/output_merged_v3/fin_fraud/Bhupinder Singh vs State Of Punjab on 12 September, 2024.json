          "end": 4237
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.26298433542251587
    },
    {
      "sentence_id": 33,
      "text": "Thereafter, petitioner-Bhupinder Singh approached this Court by way of filing CRM-M-11620-2023, which was dismissed as not pressed vide order dated 25.05.2023 and that of petitioner- Sukhwinder Singh filed CRM-M-50942-2022,",
      "rhetorical_role": "FAC",
      "start": 4253,
      "end": 4477,
      "entities": [
        {
          "text": "Bhupinder Singh",
          "label": "PETITIONER",
