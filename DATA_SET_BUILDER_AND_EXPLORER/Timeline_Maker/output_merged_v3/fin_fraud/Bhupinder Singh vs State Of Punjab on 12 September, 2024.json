          "end": 4534
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2964576780796051
    },
    {
      "sentence_id": 35,
      "text": "Hence, both the petitioners are before this Court by way of filing the present second petitions praying for grant of regular bail.",
      "rhetorical_role": "FAC",
      "start": 4536,
      "end": 4666,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23051322996616364
    },
    {
      "sentence_id": 36,
      "text": "3. It has been submitted by counsel for petitioner -Bhupinder Singh that the petitioner has been falsely implicated in the present case.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4667,
      "end": 4804,
      "entities": [
        {
          "text": "-Bhupinder Singh",
          "label": "PETITIONER",
          "start": 4719,
          "end": 4735
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.10696245729923248
    },
    {
      "sentence_id": 37,
      "text": "She submits that only allegations against the petitioner is that he visited the house of the complainant alongwith the co-accused.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4805,
      "end": 4935,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.15406516194343567
    },
    {
      "sentence_id": 38,
      "text": "Besides this, there is no other allegations qua the petitioner.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4936,
      "end": 4999,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14815722405910492
    },
    {
      "sentence_id": 39,
      "text": "She submits that the petitioner is behind bars from the last more than two years and thus, he deserves to be granted 3 of 5 Neutral Citation No:=2024:PHHC:120987 bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5000,
      "end": 5167,
      "entities": [
        {
          "text": "Neutral Citation No:=2024:PHHC:120987",
          "label": "CASE_NUMBER",
          "start": 5124,
          "end": 5161
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.16615119576454163
    },
    {
      "sentence_id": 40,
      "text": "Bhupinder Singh vs State Of Punjab on 12 September, 2024 Indian Kanoon - http://indiankanoon.org/doc/146220895/\n2 4.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5168,
      "end": 5285,
      "entities": [
        {
          "text": "Bhupinder Singh vs State Of Punjab on 12 September, 2024 Indian Kanoon",
          "label": "PRECEDENT",
          "start": 5169,
          "end": 5239
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4525841772556305
    },
    {
      "sentence_id": 41,
      "text": "Learned counsel for petitioner -Sukhinwer Singh has also submitted that the petitioner is behind bars from the last more than two years and there is no substantial progress in the trial.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5286,
      "end": 5472,
      "entities": [
        {
          "text": "-Sukhinwer Singh",
          "label": "PETITIONER",
          "start": 5317,
          "end": 5333
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.09556210786104202
    },
    {
      "sentence_id": 42,
      "text": "He further submits that main allegations are against co-accused Pali, who is already abroad.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5473,
      "end": 5565,
      "entities": [
        {
          "text": "Pali",
          "label": "OTHER_PERSON",
          "start": 5537,
          "end": 5541
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.10363458096981049
    },
    {
      "sentence_id": 43,
      "text": "He submits that the petitioner has no criminal antecedents and thus, in these circumstances, he deserves to be granted bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5566,
      "end": 5690,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.13282351195812225
    },
    {
      "sentence_id": 44,
      "text": "5. Per contra, learned State counsel has vehemently opposed the submissions made by counsel for the petitioners.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5691,
      "end": 5804,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.12693795561790466
    },
    {
      "sentence_id": 45,
      "text": "He has submitted that the petitioners have committed serious offence.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5805,
      "end": 5874,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.18678434193134308
    },
    {
      "sentence_id": 46,
      "text": "He has drawn the attention of this Court to the status report filed and has submitted that a thorough enquiry has been conducted and complicity of both the petitioners has been duly established.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 5875,
      "end": 6069,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14945340156555176
    },
    {
      "sentence_id": 47,
      "text": "It is submitted that the complainants were kidnapped by the accused and thereafter, were tortured and they were duped with heavy amount of Rs.60 lacs.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 6070,
      "end": 6220,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.15595774352550507
    },
    {
      "sentence_id": 48,
      "text": "It has been submitted that so far the challan has been presented only against three of the accused i.e. the both the petitioners and Sandeep Singh, whereas,\nremaining accused, namely, Pali @ Sidhu, Romi @ Harmandeep Singh and Manjinder Kaur, are yet to be arrested and PO proceedings have been initiated against these accused.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 6221,
      "end": 6547,
      "entities": [
        {
          "text": "Sandeep Singh",
          "label": "PETITIONER",
          "start": 6354,
          "end": 6367
        },
        {
          "text": "Pali @ Sidhu",
          "label": "OTHER_PERSON",
          "start": 6405,
          "end": 6417
        },
        {
          "text": "Romi @ Harmandeep Singh",
          "label": "OTHER_PERSON",
          "start": 6419,
          "end": 6442
        },
        {
          "text": "Manjinder Kaur",
          "label": "OTHER_PERSON",
          "start": 6447,
          "end": 6461
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.06909354031085968
    },
    {
      "sentence_id": 49,
      "text": "It is also submitted that out of 34 prosecution witnesses, 17 witnesses have been examined and 01 witness is given up.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 6548,
      "end": 6666,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.12685810029506683
    },
    {
      "sentence_id": 50,
      "text": "He has submitted that granting bail to the petitioners would scuttle the on going investigation qua the rest of the accused against whom PO proceedings have been initiated.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 6667,
      "end": 6840,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14165809750556946
    },
    {
      "sentence_id": 51,
      "text": "6. Heard.\n7.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 6841,
      "end": 6854,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14649665355682373
    },
    {
      "sentence_id": 52,
      "text": "After hearing counsel for the parties and perusing the record, it is apparent that these are the second petitions filed by the petitioners.",
      "rhetorical_role": "ANALYSIS",
      "start": 6855,
      "end": 6994,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.21839778125286102
    },
    {
      "sentence_id": 53,
      "text": "The 4 of 5 Neutral Citation No:=2024:PHHC:120987 allegations made by the complainants are specific.",
      "rhetorical_role": "ANALYSIS",
      "start": 6995,
      "end": 7094,
      "entities": [
        {
          "text": "Neutral Citation No:=2024:PHHC:120987",
          "label": "CASE_NUMBER",
          "start": 7006,
          "end": 7043
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.06309501826763153
    },
    {
      "sentence_id": 54,
      "text": "Involvement of both the petitioners alongwith co-accused has been established during the investigation as well.",
      "rhetorical_role": "ANALYSIS",
      "start": 7095,
      "end": 7206,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.39673539996147156
    },
    {
      "sentence_id": 55,
      "text": "So far three accused are yet to be arrested and PO proceedings have been initiated against them.",
      "rhetorical_role": "ANALYSIS",
      "start": 7207,
      "end": 7303,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.27755987644195557
    },
    {
      "sentence_id": 56,
      "text": "All the accused in conspiracy with each other have kidnapped the complainants.",
      "rhetorical_role": "RATIO",
      "start": 7304,
      "end": 7382,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.43341174721717834
    },
    {
      "sentence_id": 57,
      "text": "Families of both the complainants were compelled to part with a heavy amount for their release.",
      "rhetorical_role": "RATIO",
      "start": 7383,
      "end": 7478,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4339267611503601
    },
    {
      "sentence_id": 58,
      "text": "In view of the facts and circumstances of the case, this Court finds no ground to take a lenient view in favour of the petitioners.",
      "rhetorical_role": "RATIO",
      "start": 7479,
      "end": 7610,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4073105752468109
    },
    {
      "sentence_id": 59,
      "text": "Granting bail to the petitioners would definitely prejudiced the on going trial as well as the investigation pending against the other accused, who are yet to be arrested.",
      "rhetorical_role": "RATIO",
      "start": 7611,
      "end": 7782,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4916054606437683
    },
    {
      "sentence_id": 60,
      "text": "8. Thus, the present petitions being devoid of any merits are hereby dismissed.",
      "rhetorical_role": "RPC",
      "start": 7784,
      "end": 7863,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.1951434314250946
    },
    {
      "sentence_id": 61,
      "text": "Nothing said herein shall be treated as an expression of opinion on the merits of the case.",
      "rhetorical_role": "RPC",
      "start": 7864,
      "end": 7955,
      "entities": [],
      "in_summary": true,
