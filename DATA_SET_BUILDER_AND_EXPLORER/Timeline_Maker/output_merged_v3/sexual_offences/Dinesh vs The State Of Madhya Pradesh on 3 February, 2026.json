      "summary_sent_score": 0.4615333080291748
    },
    {
      "sentence_id": 6,
      "text": "His earlier three applications were dismissed as withdrawn vide orders dated 8.5.2025,\n10.7.2025 and 23.9.2025 passed in MCRC Nos. 18566/2025, 27964/2025 and 36744/2025.\n2.",
      "rhetorical_role": "NONE",
