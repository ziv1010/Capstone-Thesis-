          "end": 949
        },
        {
          "text": "12.05.2024",
          "label": "DATE",
          "start": 1065,
          "end": 1075
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23709321022033691
    },
    {
      "sentence_id": 8,
      "text": "She suspects that some unknown person has enticed and taken them.",
      "rhetorical_role": "FAC",
      "start": 1077,
      "end": 1142,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26432156562805176
    },
    {
      "sentence_id": 9,
      "text": "Accordingly, PS Khachrod, District Ujjain registered FIR at Crime No.291/2024 for offence punishable under Section 363 of IPC.",
      "rhetorical_role": "FAC",
      "start": 1143,
      "end": 1269,
      "entities": [
        {
          "text": "PS Khachrod",
          "label": "ORG",
