          "end": 2158
        },
        {
          "text": "POCSO Act, 2012",
          "label": "STATUTE",
          "start": 2162,
          "end": 2177
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3533703088760376
    },
    {
      "sentence_id": 22,
      "text": "Applicant - Gopal was arrested on 16.07.2024.",
      "rhetorical_role": "FAC",
      "start": 2189,
      "end": 2234,
      "entities": [
        {
          "text": "Gopal",
          "label": "PETITIONER",
          "start": 2201,
          "end": 2206
        },
        {
          "text": "16.07.2024",
          "label": "DATE",
          "start": 2223,
          "end": 2233
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.28005093336105347
    },
    {
      "sentence_id": 23,
      "text": "He is in custody ever since.",
      "rhetorical_role": "FAC",
      "start": 2235,
      "end": 2263,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23528645932674408
    },
    {
      "sentence_id": 24,
      "text": "Relevant seizures were made.",
      "rhetorical_role": "FAC",
      "start": 2264,
      "end": 2292,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23223194479942322
    },
    {
      "sentence_id": 25,
      "text": "The statements of witnesses were recorded.",
      "rhetorical_role": "FAC",
      "start": 2293,
      "end": 2335,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26434239745140076
    },
    {
      "sentence_id": 26,
      "text": "On completion of investigation, final report was submitted.",
      "rhetorical_role": "FAC",
      "start": 2336,
      "end": 2395,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.35760918259620667
    },
    {
      "sentence_id": 27,
      "text": "Gopal vs The State Of Madhya Pradesh on 10 January, 2025 Indian Kanoon - http://indiankanoon.org/doc/107305841/\n1",
      "rhetorical_role": "FAC",
      "start": 2396,
      "end": 2510,
      "entities": [
        {
          "text": "Gopal vs The State Of Madhya Pradesh",
          "label": "PRECEDENT",
          "start": 2397,
          "end": 2433
        },
        {
          "text": "10 January, 2025",
          "label": "DATE",
          "start": 2437,
          "end": 2453
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4859219789505005
    },
    {
      "sentence_id": 28,
      "text": "The trial is underway.",
      "rhetorical_role": "FAC",
      "start": 2511,
      "end": 2533,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.32010897994041443
    },
    {
      "sentence_id": 29,
      "text": "Learned counsel for the applicant in addition to the grounds mentioned in the application submits that the applicant has been falsely implicated in the matter.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2534,
      "end": 2694,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2115892469882965
    },
    {
      "sentence_id": 30,
      "text": "It is a case of consensual relation.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2695,
      "end": 2731,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.5279322266578674
    },
    {
      "sentence_id": 31,
      "text": "The victim eloped with the applicant at her own.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2732,
      "end": 2780,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.43769168853759766
    },
    {
      "sentence_id": 32,
      "text": "No offence, as alleged, is committed by the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2781,
      "end": 2835,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4846670627593994
    },
    {
      "sentence_id": 33,
      "text": "Learned counsel referring to the evidence of victim and her sister recorded before the trial Court submits that the cross-examination of victim reveals that she never complained to anybody during the transit and her stay at Rajkot.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2837,
      "end": 3068,
      "entities": [
        {
          "text": "Rajkot",
          "label": "GPE",
          "start": 3061,
          "end": 3067
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.18063366413116455
    },
    {
      "sentence_id": 34,
      "text": "It goes to show that the victim was a consensual party to alleged act.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3069,
      "end": 3139,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.35201016068458557
    },
    {
      "sentence_id": 35,
      "text": "Learned counsel submits that the material witnesses have been examined.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3140,
      "end": 3211,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14690667390823364
    },
    {
      "sentence_id": 36,
      "text": "Trial would take time to conclude.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3212,
      "end": 3246,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.28535211086273193
    },
    {
      "sentence_id": 37,
      "text": "Therefore, the applicant may be extended benefit of bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3247,
      "end": 3304,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.34982267022132874
    },
    {
      "sentence_id": 38,
      "text": "NEUTRAL CITATION NO. 2025:MPHC-IND:810 3 MCRC-53180-2024",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3305,
      "end": 3362,
      "entities": [
        {
          "text": "NEUTRAL CITATION NO. 2025",
          "label": "CASE_NUMBER",
          "start": 3306,
          "end": 3331
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.13031844794750214
    },
    {
      "sentence_id": 39,
      "text": "Per Contra, learned counsel for the respondent/State opposes the bail application and submits that the minor victim has made specific allegation of assault, criminal intimidation and penetrative sexual assault against the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3363,
      "end": 3595,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.19746257364749908
    },
    {
      "sentence_id": 40,
      "text": "The medical report supports the allegation that accuse has assaulted the victim with knife.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3596,
      "end": 3687,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.3026329576969147
    },
    {
      "sentence_id": 41,
      "text": "The victim has deposed against the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3688,
      "end": 3734,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.32144689559936523
    },
    {
      "sentence_id": 42,
      "text": "The consent of victim is immaterial in view of the fact that she was minor at the time of alleged incident.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3735,
      "end": 3842,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.40252482891082764
    },
    {
