          "end": 1400
        },
        {
          "text": "NEUTRAL CITATION NO.\n2025:MPHC-IND:810 2 MCRC-53180-2024",
          "label": "CASE_NUMBER",
          "start": 1426,
          "end": 1482
        },
        {
          "text": "Gopal",
          "label": "PETITIONER",
          "start": 1491,
          "end": 1496
        },
