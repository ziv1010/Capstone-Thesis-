      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.42073678970336914
    },
    {
      "sentence_id": 7,
      "text": "As per the case of prosecution, the mother of the victim reported to PS Khachrod that her daughter aged around 16 years and 11 months and her niece aged around 15 years are missing since night of 12.05.2024.",
      "rhetorical_role": "FAC",
      "start": 869,
      "end": 1076,
      "entities": [
        {
          "text": "Khachrod",
          "label": "OTHER_PERSON",
