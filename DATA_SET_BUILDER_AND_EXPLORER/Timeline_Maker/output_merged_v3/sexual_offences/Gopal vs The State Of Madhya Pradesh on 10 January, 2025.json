      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2455901801586151
    },
    {
      "sentence_id": 12,
      "text": "Gopal and his associate Kailash took them to Rajkot.",
      "rhetorical_role": "FAC",
      "start": 1605,
      "end": 1657,
      "entities": [
        {
          "text": "Gopal",
          "label": "PETITIONER",
