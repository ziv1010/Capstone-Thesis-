          "start": 1629,
          "end": 1636
        },
        {
          "text": "Rajkot",
          "label": "GPE",
          "start": 1650,
          "end": 1656
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.28262951970100403
    },
    {
      "sentence_id": 13,
      "text": "They were residing in a rented room at Rajkot.",
      "rhetorical_role": "FAC",
      "start": 1658,
      "end": 1704,
      "entities": [
        {
          "text": "Rajkot",
          "label": "GPE",
          "start": 1697,
          "end": 1703
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2888041138648987
    },
    {
      "sentence_id": 14,
      "text": "Gopal committed rape on her against her will.",
      "rhetorical_role": "FAC",
      "start": 1705,
      "end": 1750,
      "entities": [
        {
          "text": "Gopal",
          "label": "PETITIONER",
          "start": 1705,
          "end": 1710
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3426576256752014
    },
    {
      "sentence_id": 15,
      "text": "Gopal used to consume liquor and threatened her.",
      "rhetorical_role": "FAC",
      "start": 1751,
      "end": 1799,
      "entities": [
        {
          "text": "Gopal",
          "label": "PETITIONER",
          "start": 1751,
          "end": 1756
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3146454095840454
    },
    {
      "sentence_id": 16,
      "text": "Gopal has assaulted her with knife on both the hands.",
      "rhetorical_role": "FAC",
      "start": 1800,
      "end": 1853,
      "entities": [
        {
          "text": "Gopal",
          "label": "PETITIONER",
          "start": 1800,
          "end": 1805
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.329937219619751
    },
    {
      "sentence_id": 17,
      "text": "Gopal manhandled her and left her at station.",
      "rhetorical_role": "FAC",
      "start": 1854,
      "end": 1899,
      "entities": [
        {
          "text": "Gopal",
          "label": "PETITIONER",
          "start": 1854,
          "end": 1859
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.32649344205856323
    },
    {
      "sentence_id": 18,
      "text": "She boarded a wrong train and reached Gujarat.",
      "rhetorical_role": "FAC",
      "start": 1900,
      "end": 1946,
      "entities": [
        {
          "text": "Gujarat",
          "label": "GPE",
          "start": 1938,
          "end": 1945
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.32651007175445557
    },
    {
      "sentence_id": 19,
      "text": "She call her father from railway station.",
      "rhetorical_role": "FAC",
      "start": 1947,
      "end": 1988,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.29562893509864807
    },
    {
      "sentence_id": 20,
      "text": "Police alongwith her family members recovered her.",
      "rhetorical_role": "FAC",
      "start": 1989,
      "end": 2039,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3280394971370697
    },
    {
      "sentence_id": 21,
      "text": "On such allegations, prosecution for offence punishable under Sections 323, 366-A, 376(2)(n) of IPC and Section 5(L)/6 of POCSO Act, 2012 was added.",
      "rhetorical_role": "FAC",
      "start": 2040,
      "end": 2188,
      "entities": [
        {
          "text": "Sections 323",
          "label": "PROVISION",
          "start": 2102,
          "end": 2114
        },
        {
          "text": "366-A",
          "label": "PROVISION",
          "start": 2116,
          "end": 2121
        },
        {
          "text": "376(2)(n)",
          "label": "PROVISION",
          "start": 2123,
          "end": 2132
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 2136,
          "end": 2139
        },
        {
          "text": "Section 5(L)/6",
