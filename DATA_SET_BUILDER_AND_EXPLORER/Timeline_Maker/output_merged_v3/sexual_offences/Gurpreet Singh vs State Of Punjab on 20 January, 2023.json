      "summary_sent_score": 0.43728044629096985
    },
    {
      "sentence_id": 20,
      "text": "Learned counsel for the petitioner argued that earlier he was granted bail u/s 363, 366A and 120-B of IPC vide order dated 18.07.2020 by the Court of Additional Sessions Judge, Sangrur which is Annexure P-2.",
      "rhetorical_role": "FAC",
