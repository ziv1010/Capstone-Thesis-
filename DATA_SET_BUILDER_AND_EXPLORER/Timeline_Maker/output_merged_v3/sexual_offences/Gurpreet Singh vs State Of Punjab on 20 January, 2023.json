    {
      "sentence_id": 9,
      "text": "The facts of the case are that Manoj -- the complainant gave his statement to the police that his wife expired leaving behind three children.",
      "rhetorical_role": "FAC",
      "start": 845,
      "end": 987,
      "entities": [
        {
          "text": "Manoj",
          "label": "OTHER_PERSON",
          "start": 877,
          "end": 882
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21082065999507904
    },
    {
      "sentence_id": 10,
      "text": "The victim had appeared in 10\" class examination last year.",
      "rhetorical_role": "FAC",
      "start": 988,
      "end": 1047,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1823844164609909
    },
    {
      "sentence_id": 11,
      "text": "She was being harassed by Gurpreet Singh s/o Gagandeep Singh.",
      "rhetorical_role": "FAC",
      "start": 1048,
      "end": 1110,
      "entities": [
        {
          "text": "Gurpreet Singh",
          "label": "PETITIONER",
          "start": 1075,
          "end": 1089
        },
        {
          "text": "Gagandeep Singh",
          "label": "OTHER_PERSON",
          "start": 1094,
          "end": 1109
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26906484365463257
    },
    {
      "sentence_id": 12,
      "text": "A panchayat was convened on 14.05.2020 and father of Gurpreet Singh was requested to make his son understand but he did not listen.",
      "rhetorical_role": "FAC",
      "start": 1111,
      "end": 1242,
      "entities": [
        {
          "text": "14.05.2020",
          "label": "DATE",
          "start": 1139,
          "end": 1149
        },
        {
          "text": "Gurpreet Singh",
          "label": "PETITIONER",
          "start": 1164,
          "end": 1178
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21538300812244415
    },
    {
      "sentence_id": 13,
      "text": "On the intervening night of 30/31.05.2020 Gurpreet Singh kidnapped his daughter on the pretext of SANDEEP marriage.",
      "rhetorical_role": "FAC",
      "start": 1243,
      "end": 1358,
      "entities": [
        {
          "text": "30/31.05.2020",
          "label": "DATE",
          "start": 1271,
          "end": 1284
        },
        {
          "text": "Gurpreet Singh",
          "label": "PETITIONER",
          "start": 1285,
          "end": 1299
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2614372968673706
    },
    {
      "sentence_id": 14,
      "text": "He found that she had taken away 10 tola gold of his wife and cash of Rs.20,000/- along with her own cloths.",
      "rhetorical_role": "FAC",
      "start": 1359,
      "end": 1467,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2659309208393097
    },
    {
      "sentence_id": 15,
      "text": "With these allegations present FIR has been registered.",
      "rhetorical_role": "FAC",
      "start": 1468,
      "end": 1523,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.259016752243042
    },
    {
      "sentence_id": 16,
      "text": "During investigation the victim was recovered.",
      "rhetorical_role": "FAC",
      "start": 1524,
      "end": 1571,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2863363027572632
    },
