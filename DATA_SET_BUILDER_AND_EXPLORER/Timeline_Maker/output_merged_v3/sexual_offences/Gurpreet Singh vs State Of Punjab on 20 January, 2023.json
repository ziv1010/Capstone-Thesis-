      "rhetorical_role": "FAC",
      "start": 2818,
      "end": 2877,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2991226315498352
    },
    {
      "sentence_id": 29,
      "text": "Therefore, considering the gravity of the offence the anticipatory bail application filed by the I have considered the arguments and have gone through the record carefully.",
      "rhetorical_role": "ANALYSIS",
      "start": 2878,
      "end": 3050,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.23510205745697021
    },
