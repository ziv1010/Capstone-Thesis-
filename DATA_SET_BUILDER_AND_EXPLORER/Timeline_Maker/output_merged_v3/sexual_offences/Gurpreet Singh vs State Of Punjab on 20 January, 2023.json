      "sentence_id": 22,
      "text": "The petitioner was regularly appearing before the Court.",
      "rhetorical_role": "FAC",
      "start": 2278,
      "end": 2334,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3458780348300934
    },
    {
      "sentence_id": 23,
      "text": "He never misused the Gurpreet Singh vs State Of Punjab on 20 January, 2023 Indian Kanoon - http://indiankanoon.org/doc/159844525/\n1 concession of bail granted in his favour.",
      "rhetorical_role": "FAC",
      "start": 2335,
      "end": 2508,
      "entities": [
        {
          "text": "Gurpreet Singh vs State Of Punjab",
          "label": "PRECEDENT",
