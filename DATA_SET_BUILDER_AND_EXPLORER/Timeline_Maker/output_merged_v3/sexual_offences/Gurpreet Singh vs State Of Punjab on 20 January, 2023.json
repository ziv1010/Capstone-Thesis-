      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3369046151638031
    },
    {
      "sentence_id": 24,
      "text": "He is still ready to abide by the terms of bail order.",
      "rhetorical_role": "FAC",
      "start": 2509,
      "end": 2563,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22123128175735474
    },
    {
      "sentence_id": 25,
      "text": "It is prayed that his regular bail application may be allowed.",
      "rhetorical_role": "FAC",
      "start": 2564,
      "end": 2626,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22362805902957916
    },
    {
      "sentence_id": 26,
      "text": "The bail application is opposed by learned counsel representing the State.",
      "rhetorical_role": "FAC",
      "start": 2627,
      "end": 2702,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24367846548557281
    },
    {
      "sentence_id": 27,
      "text": "It is argued that there are specific serious allegations falling under Section 376 IPC and Section 4 of POCSO Act.",
      "rhetorical_role": "FAC",
      "start": 2703,
      "end": 2817,
      "entities": [
        {
