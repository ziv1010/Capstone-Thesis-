      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2646790146827698
    },
    {
      "sentence_id": 20,
      "text": "Therefore, considering young age of applicant",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2270,
      "end": 2315,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3854963779449463
    },
    {
      "sentence_id": 21,
      "text": ", learned counsel prays for suspension of substantive sentence and grant of bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2316,
      "end": 2397,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.30083417892456055
    },
    {
      "sentence_id": 22,
      "text": "CriAppln-4589-2023 4.",
      "rhetorical_role": "NONE",
      "start": 2398,
      "end": 2420,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 23,
      "text": "Learned APP strenuously opposed on the ground that offence is serious.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2421,
      "end": 2491,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.24965839087963104
    },
    {
      "sentence_id": 24,
      "text": "That, on due satisfaction,\noffence of kidnapping and rape as well as offence under Section 4 of the POCSO Act is recorded by learned trial Judge.",
      "rhetorical_role": "ANALYSIS",
      "start": 2492,
      "end": 2637,
