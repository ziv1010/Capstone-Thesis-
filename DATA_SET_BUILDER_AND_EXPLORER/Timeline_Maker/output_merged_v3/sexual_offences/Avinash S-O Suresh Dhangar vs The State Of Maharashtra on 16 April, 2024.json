    },
    {
      "sentence_id": 17,
      "text": "3. He further submitted that victim is shown to be 17 years of age, but there is no cogent proof.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1966,
      "end": 2063,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3144863545894623
    },
    {
      "sentence_id": 18,
      "text": "Moreover, accused is barely 20 years of age.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2064,
      "end": 2109,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3578062951564789
    },
    {
      "sentence_id": 19,
      "text": "That, appeal has been preferred in the year 2023 against the above conviction and the same is pending and would take long time to be finally heard and decided.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2110,
      "end": 2269,
