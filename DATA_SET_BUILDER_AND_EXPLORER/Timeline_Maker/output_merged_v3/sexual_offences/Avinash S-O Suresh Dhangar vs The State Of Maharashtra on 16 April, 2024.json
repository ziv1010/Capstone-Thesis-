      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.45525598526000977
    },
    {
      "sentence_id": 25,
      "text": "That, prosecution has adduced evidence of 18 witnesses.",
      "rhetorical_role": "ANALYSIS",
      "start": 2638,
      "end": 2693,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3572480380535126
    },
    {
      "sentence_id": 26,
      "text": "There is correct appreciation and therefore, considering the nature of offence, he prays to reject the application.",
      "rhetorical_role": "ANALYSIS",
      "start": 2694,
      "end": 2809,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3802538216114044
    },
