          "end": 3636
        },
        {
          "text": "Section 4",
          "label": "PROVISION",
          "start": 3641,
          "end": 3650
        },
        {
          "text": "POCSO Act",
          "label": "STATUTE",
          "start": 3654,
          "end": 3663
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2394886463880539
    },
    {
      "sentence_id": 34,
      "text": "Considering the nature of offence and nature of charge, this Court does not find it a fit case to grant benefit as prayed.",
