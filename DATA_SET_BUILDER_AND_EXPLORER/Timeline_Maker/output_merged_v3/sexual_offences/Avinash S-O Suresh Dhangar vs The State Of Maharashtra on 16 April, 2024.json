      "end": 3165,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.21480250358581543
    },
    {
      "sentence_id": 29,
      "text": "She is examined as PW2.",
      "rhetorical_role": "ANALYSIS",
      "start": 3166,
      "end": 3189,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.18504267930984497
    },
    {
      "sentence_id": 30,
      "text": "By examining PW16, age of victim seems to have been proved.",
      "rhetorical_role": "ANALYSIS",
      "start": 3190,
      "end": 3249,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.19762128591537476
    },
    {
      "sentence_id": 31,
      "text": "According to prosecution, date of birth of victim is 22.10.2004 and occurrence took place on 15.12.2021.",
      "rhetorical_role": "ANALYSIS",
      "start": 3250,
      "end": 3354,
      "entities": [
        {
