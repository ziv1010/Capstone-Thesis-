    {
      "sentence_id": 51,
      "text": "20.01.2023 (AMARJOT BHATTI) snd JUDGE Whether speaking/reasoned: Yes/No.",
      "rhetorical_role": "NONE",
      "start": 4419,
      "end": 4492,
