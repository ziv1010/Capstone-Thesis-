      "summary_sent_score": 0.1761913150548935
    },
    {
      "sentence_id": 43,
      "text": "He has been falsely implicated in the case.",
      "rhetorical_role": "FAC",
      "start": 3519,
      "end": 3562,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2023640275001526
    },
    {
      "sentence_id": 44,
      "text": "It is a false case.",
      "rhetorical_role": "FAC",
      "start": 3563,
      "end": 3582,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2053050845861435
    },
    {
      "sentence_id": 45,
      "text": "Prosecutrix registered this case against him only State Vs. Mohd. Moies FIR No. : 618/2016 PS Hauz Khas U/s 506/509 IPC Page no.3 of 6 to pressurize him for marriage when she failed she registered another FIR no. 623/16 u/s 376 IPC in which he got acquitted.\n8.",
      "rhetorical_role": "FAC",
      "start": 3583,
      "end": 3844,
      "entities": [
        {
          "text": "State Vs. Mohd. Moies",
          "label": "PRECEDENT",
          "start": 3633,
          "end": 3654
        },
        {
          "text": "PS Hauz Khas",
          "label": "ORG",
          "start": 3674,
          "end": 3686
        },
        {
          "text": "s 506/509",
          "label": "PROVISION",
