          "end": 3814
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.17714355885982513
    },
    {
      "sentence_id": 46,
      "text": "Final arguments addressed by the Ld. APP for State and Ld. Counsel for accused were heard and case file was perused.",
      "rhetorical_role": "NONE",
      "start": 3845,
      "end": 3961,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 47,
      "text": "9. \"Section 506 describes, \"Punishment for criminal intimidation.",
      "rhetorical_role": "STA",
      "start": 3962,
      "end": 4028,
      "entities": [
        {
          "text": "Section 506",
          "label": "PROVISION",
          "start": 3967,
          "end": 3978
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.08146075904369354
    },
    {
      "sentence_id": 48,
      "text": "-- Whoever commits, the offence of criminal intimidation shall be punished with imprisonment of either description for a term which may extend to two years, or with fine, or with both; If threat be to cause death or grievous hurt, etc\"",
      "rhetorical_role": "STA",
      "start": 4029,
      "end": 4265,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.08484892547130585
    },
    {
      "sentence_id": 49,
      "text": "Section 509 IPC describes, \"Punishment for crime under Section 509 IPC.",
      "rhetorical_role": "STA",
      "start": 4265,
      "end": 4336,
      "entities": [
        {
          "text": "Section 509",
          "label": "PROVISION",
          "start": 4265,
          "end": 4276
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 4277,
          "end": 4280
        },
        {
          "text": "Section 509",
          "label": "PROVISION",
          "start": 4320,
          "end": 4331
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 4332,
          "end": 4335
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.09214714169502258
    },
    {
      "sentence_id": 50,
      "text": "The offence of insulting the modesty of a woman is a cognizable, bailable, and compoundable offence.",
      "rhetorical_role": "ANALYSIS",
      "start": 4337,
      "end": 4437,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6240317821502686
    },
    {
      "sentence_id": 51,
      "text": "Before the Criminal Law (Amendment) Act, 2013, the offence was punishable with simple imprisonment, which may extend to one year, or with a fine, or both.",
      "rhetorical_role": "ANALYSIS",
      "start": 4438,
      "end": 4592,
      "entities": [
        {
          "text": "Criminal Law (Amendment) Act, 2013",
          "label": "STATUTE",
          "start": 4449,
          "end": 4483
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5176987648010254
    },
    {
      "sentence_id": 52,
      "text": "10. It is the case of the prosecution that on 11.08.2016 at about 11 pm during telephonic conversation of accused with complainant Ms. Apoorva Mehta, accused intending to insult the modesty of the complainant, uttered abuses to her and also threatened to kill her.",
      "rhetorical_role": "ANALYSIS",
      "start": 4594,
      "end": 4858,
      "entities": [
        {
          "text": "11.08.2016",
          "label": "DATE",
          "start": 4640,
          "end": 4650
        },
        {
          "text": "Apoorva Mehta",
          "label": "OTHER_PERSON",
          "start": 4729,
          "end": 4742
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1261397749185562
    },
    {
      "sentence_id": 53,
      "text": "Perusal of the record reveals that vide order dt. 26.07.2022, due to the conduct of complainant, she was dropped from the list of witnesses in the present case and it was categorically mentioned in the said order State vs Mohd. Moies on 11 December, 2024 Indian Kanoon - http://indiankanoon.org/doc/42029366/\n2 that the testimony of complainant shall not be read in evidence.",
      "rhetorical_role": "ANALYSIS",
      "start": 4859,
      "end": 5234,
      "entities": [
        {
          "text": "26.07.2022",
          "label": "DATE",
          "start": 4909,
          "end": 4919
        },
        {
          "text": "State vs Mohd. Moies",
          "label": "PRECEDENT",
          "start": 5072,
          "end": 5092
        },
        {
          "text": "11 December, 2024",
          "label": "DATE",
          "start": 5096,
          "end": 5113
        },
        {
          "text": "Indian Kanoon",
          "label": "GPE",
          "start": 5114,
          "end": 5127
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.12354190647602081
    },
    {
      "sentence_id": 54,
      "text": "Further there is no other independent witness available on record to State Vs. Mohd. Moies FIR No. : 618/2016 PS Hauz Khas U/s 506/509 IPC Page no.4 of 6 prove the fact that the accused uttered abuses to complainant and also threatened to kill her and insulted the modesty of complainant.",
      "rhetorical_role": "ANALYSIS",
      "start": 5235,
      "end": 5523,
      "entities": [
        {
          "text": "State Vs. Mohd. Moies FIR No. : 618/2016",
          "label": "PRECEDENT",
          "start": 5304,
          "end": 5344
        },
        {
          "text": "PS Hauz Khas",
          "label": "ORG",
          "start": 5345,
          "end": 5357
        },
        {
          "text": "s 506/509",
          "label": "PROVISION",
          "start": 5360,
          "end": 5369
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 5370,
          "end": 5373
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.09159576892852783
    },
    {
      "sentence_id": 55,
      "text": "Further during the cross-examination of PW4 SI Rambal (IO) he admitted that the complainant has not mentioned in her complaint or in the FIR or in the statement u/s 164 Cr.P.C. or in the statement u/s 161 Cr.P.C that what abusive words have been used by the accused.",
      "rhetorical_role": "ANALYSIS",
      "start": 5524,
      "end": 5790,
      "entities": [
        {
          "text": "Rambal",
          "label": "WITNESS",
          "start": 5571,
          "end": 5577
        },
        {
          "text": "s 164",
          "label": "PROVISION",
          "start": 5687,
          "end": 5692
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 5693,
          "end": 5700
        },
        {
          "text": "s 161",
          "label": "PROVISION",
          "start": 5723,
          "end": 5728
        },
        {
          "text": "Cr.P.C",
          "label": "STATUTE",
          "start": 5729,
          "end": 5735
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1381460726261139
    },
    {
      "sentence_id": 56,
      "text": "He further stated during his cross-examination, that during investigation he asked the complainant about the exact abusive words used by the accused but complainant refused to mention the same and complainant never mentioned the reason or motive behind the alleged act of the accused.",
      "rhetorical_role": "ANALYSIS",
      "start": 5791,
      "end": 6075,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.11316846311092377
    },
    {
      "sentence_id": 57,
      "text": "Further perusal of document which is Ex.PW3/C (colly) reveals that it is the complainant who has called the accused.",
      "rhetorical_role": "ANALYSIS",
      "start": 6076,
      "end": 6192,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.13666421175003052
    },
    {
      "sentence_id": 58,
      "text": "In the present case, it is defence of the accused that accused and the complainant used to work in the same company namely India Medtronic Pvt Ltd and both of them were in relationship with each other and complainant used to exchange love messages with the accused and when accused refused to marry then the complainant filed a false case of rape i.e. FIR NO. 623/2016 and the present case.",
      "rhetorical_role": "ANALYSIS",
      "start": 6193,
      "end": 6583,
      "entities": [
        {
          "text": "India Medtronic Pvt Ltd",
          "label": "ORG",
          "start": 6316,
          "end": 6339
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.52046138048172
    },
    {
      "sentence_id": 59,
      "text": "In the present case, in the absence of testimony of complainant who is the star witness, the allegations alleged against the accused are not proved in the present case and testimony of IO and perusal of document Ex.PW3/C also somehow points out towards the fact that the present case is false and fabricated and filed just to implicate the accused person due to the refusal of marriage.",
      "rhetorical_role": "ANALYSIS",
      "start": 6584,
      "end": 6970,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.49027377367019653
    },
    {
      "sentence_id": 60,
      "text": "State Vs. Mohd. Moies FIR No. : 618/2016 PS Hauz Khas U/s 506/509 IPC Page no.5 of 6 11.",
      "rhetorical_role": "ANALYSIS",
      "start": 6972,
      "end": 7060,
      "entities": [
        {
          "text": "State Vs. Mohd. Moies",
          "label": "PRECEDENT",
          "start": 6972,
          "end": 6993
        },
        {
          "text": "PS Hauz Khas",
          "label": "ORG",
          "start": 7013,
          "end": 7025
        },
        {
          "text": "s 506/509",
          "label": "PROVISION",
          "start": 7028,
          "end": 7037
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 7038,
          "end": 7041
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.19659535586833954
    },
    {
      "sentence_id": 61,
      "text": "It is well settled that in a criminal trial the burden of proof is on the prosecution to prove its case beyond reasonable doubt.",
      "rhetorical_role": "ANALYSIS",
      "start": 7061,
      "end": 7189,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5792145133018494
    },
    {
      "sentence_id": 62,
      "text": "Any contradiction or iota of proof in favour of accused can completely dismantle the case of prosecution.",
      "rhetorical_role": "ANALYSIS",
      "start": 7190,
      "end": 7295,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.48788461089134216
    },
    {
      "sentence_id": 63,
      "text": "In the present case there are no cogent material available on record to suggest that accused had insulted the modesty of complainant and threatened to kill her.",
      "rhetorical_role": "RATIO",
      "start": 7296,
      "end": 7456,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5308760404586792
    },
    {
      "sentence_id": 64,
      "text": "The allegations against accused are not proved in the case.",
      "rhetorical_role": "RATIO",
      "start": 7457,
      "end": 7517,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4999068081378937
    },
    {
      "sentence_id": 65,
      "text": "Conclusion & Decision 12.",
      "rhetorical_role": "NONE",
      "start": 7519,
      "end": 7544,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 66,
      "text": "In these circumstances and in view of the aforementioned discussion, I hold that the prosecution has failed to prove its case against the accused Mohd. Moies beyond reasonable doubts.",
      "rhetorical_role": "RPC",
      "start": 7545,
      "end": 7728,
      "entities": [
        {
          "text": "Mohd. Moies",
          "label": "RESPONDENT",
          "start": 7691,
          "end": 7702
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.2734396457672119
    },
    {
      "sentence_id": 67,
      "text": "Accused Mohd. Moies is accordingly acquitted for offence u/s 506/509 IPC.",
      "rhetorical_role": "RPC",
      "start": 7729,
      "end": 7802,
      "entities": [
        {
          "text": "Mohd. Moies",
          "label": "RESPONDENT",
          "start": 7737,
          "end": 7748
        },
        {
          "text": "s 506/509",
          "label": "PROVISION",
          "start": 7788,
          "end": 7797
        },
        {
