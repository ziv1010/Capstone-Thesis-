          "end": 1479
        },
        {
          "text": "27/09/2024",
          "label": "DATE",
          "start": 1483,
          "end": 1493
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.10536111891269684
    },
    {
      "sentence_id": 14,
      "text": "It is stated that the victim was a student of 9th Standard in a school in Delhi.",
      "rhetorical_role": "FAC",
      "start": 1566,
      "end": 1646,
      "entities": [
        {
          "text": "Delhi",
          "label": "GPE",
          "start": 1640,
          "end": 1645
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.20514674484729767
    },
    {
      "sentence_id": 15,
      "text": "It is stated that the father of the victim tried to find the victim but she could not be traced.",
      "rhetorical_role": "FAC",
      "start": 1647,
      "end": 1743,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.13747663795948029
    },
    {
      "sentence_id": 16,
      "text": "It is stated that later on the father of the victim came to know that his daughter/victim has been misled by one Shubham who took his daughter along with him.",
      "rhetorical_role": "FAC",
      "start": 1744,
      "end": 1902,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 1857,
          "end": 1864
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1694120615720749
    },
    {
      "sentence_id": 17,
      "text": "The Respondent No.2 herein is the Aunt of the co- accused/Shubham.",
      "rhetorical_role": "FAC",
      "start": 1903,
      "end": 1969,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 1961,
          "end": 1968
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15649892389774323
    },
    {
      "sentence_id": 18,
      "text": "On the statement of the father of Nxxxxx Rxxxxx vs State (Govt. Of Nct Of Delhi) & Anr on 12 September, 2024 Indian Kanoon - http://indiankanoon.org/doc/164892819/\n1 the victim, the present FIR was registered.\n3.",
      "rhetorical_role": "FAC",
      "start": 1970,
      "end": 2182,
      "entities": [
        {
          "text": "father of Nxxxxx Rxxxxx vs State (Govt. Of Nct Of Delhi) & Anr",
          "label": "PRECEDENT",
          "start": 1994,
          "end": 2056
        },
        {
          "text": "12 September, 2024",
          "label": "DATE",
          "start": 2060,
          "end": 2078
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.21650774776935577
    },
    {
      "sentence_id": 19,
      "text": "Material on record indicates that the co-accused/Shubham and the victim were tracked down on 03.03.2022 from Peeragarhi Chowk, Delhi.",
      "rhetorical_role": "FAC",
      "start": 2183,
      "end": 2316,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 2232,
          "end": 2239
        },
        {
          "text": "03.03.2022",
          "label": "DATE",
          "start": 2276,
          "end": 2286
        },
        {
          "text": "Peeragarhi Chowk",
          "label": "GPE",
          "start": 2292,
          "end": 2308
        },
        {
          "text": "Delhi",
          "label": "GPE",
          "start": 2310,
          "end": 2315
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.11322071403265
    },
    {
      "sentence_id": 20,
      "text": "On the very same day i.e., 03.03.2022, the statement of the victim was recorded under Section 164 Cr.P.C.",
      "rhetorical_role": "FAC",
      "start": 2317,
      "end": 2422,
      "entities": [
        {
          "text": "03.03.2022",
          "label": "DATE",
          "start": 2344,
          "end": 2354
        },
        {
          "text": "Section 164",
          "label": "PROVISION",
          "start": 2403,
          "end": 2414
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 2415,
          "end": 2422
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1694338470697403
    },
    {
      "sentence_id": 21,
      "text": "In the statement, the victim has stated that she went to the house of her friend after informing her mother where she had called the co-accused/Shubham for a meeting.",
      "rhetorical_role": "FAC",
      "start": 2423,
      "end": 2589,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 2567,
          "end": 2574
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.11957141011953354
    },
    {
      "sentence_id": 22,
      "text": "It is stated that they were planning for a New Year Party and decided to go to Metro Walk but it was cancelled later on.",
      "rhetorical_role": "FAC",
      "start": 2590,
      "end": 2710,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.0980212539434433
    },
    {
      "sentence_id": 23,
      "text": "It is stated that she wanted to meet the Bua of the co- accused/Shubham and then they went to the house of the bua at Laxmi Nagar by Metro but by the time they reached there, it was evening.",
      "rhetorical_role": "FAC",
      "start": 2711,
      "end": 2901,
      "entities": [
        {
          "text": "Bua",
          "label": "OTHER_PERSON",
          "start": 2752,
          "end": 2755
        },
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 2775,
          "end": 2782
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.09130455553531647
    },
    {
      "sentence_id": 24,
      "text": "It is stated that she was receiving phone calls from her parents but out of fear she switched off the mobile phone.",
      "rhetorical_role": "FAC",
      "start": 2902,
      "end": 3017,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15380240976810455
    },
    {
      "sentence_id": 25,
      "text": "It is stated that the co-accused/Shubham was from Madhya Pradesh and, therefore, they purchased tickets from Kashmiri Gate and they went to Madhya Pradesh and started residing there in a rented accommodation which was arranged by a Senior in the office of the co- accused/Shubham.",
      "rhetorical_role": "FAC",
      "start": 3018,
      "end": 3298,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 3051,
          "end": 3058
        },
        {
          "text": "Madhya Pradesh",
          "label": "GPE",
          "start": 3068,
          "end": 3082
        },
        {
          "text": "Madhya Pradesh",
          "label": "GPE",
          "start": 3158,
          "end": 3172
        },
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 3290,
          "end": 3297
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.12442883849143982
    },
    {
      "sentence_id": 26,
      "text": "It is stated that they resided in Madhya Pradesh for 15 days and, thereafter, went to Hajipur, Patna.",
      "rhetorical_role": "FAC",
      "start": 3299,
      "end": 3400,
      "entities": [
        {
          "text": "Madhya Pradesh",
          "label": "GPE",
          "start": 3333,
          "end": 3347
        },
        {
          "text": "Hajipur",
          "label": "GPE",
          "start": 3385,
          "end": 3392
        },
        {
          "text": "Patna",
          "label": "GPE",
          "start": 3394,
          "end": 3399
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.14266887307167053
    },
    {
      "sentence_id": 27,
      "text": "It is stated that on coming to know that the father of the victim has filed a case, they took a train from",
      "rhetorical_role": "FAC",
      "start": 3401,
      "end": 3507,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.09156610816717148
    },
    {
      "sentence_id": 28,
      "text": "This is a digitally signed order.",
      "rhetorical_role": "FAC",
      "start": 3508,
      "end": 3541,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.0870179757475853
    },
    {
      "sentence_id": 29,
      "text": "The authenticity of the order can be re-verified from Delhi High Court Order Portal by scanning the QR code shown above.",
      "rhetorical_role": "FAC",
      "start": 3542,
      "end": 3663,
      "entities": [
        {
          "text": "Delhi High Court",
          "label": "COURT",
          "start": 3597,
          "end": 3613
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.0883137583732605
    },
    {
      "sentence_id": 30,
      "text": "The Order is downloaded from the DHC Server on 27/09/2024 at 21:41:46 Hajipur, Patna to New Delhi and, thereafter, a call was made to the police.",
      "rhetorical_role": "FAC",
      "start": 3664,
      "end": 3809,
      "entities": [
        {
          "text": "27/09/2024",
          "label": "DATE",
          "start": 3711,
          "end": 3721
        },
        {
          "text": "Hajipur",
          "label": "GPE",
          "start": 3734,
          "end": 3741
        },
        {
          "text": "Patna",
          "label": "GPE",
          "start": 3743,
          "end": 3748
        },
        {
          "text": "New Delhi",
          "label": "GPE",
          "start": 3752,
          "end": 3761
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.08275453746318817
    },
    {
      "sentence_id": 31,
      "text": "The medical examination of the victim was conducted before a Doctor and the victim stated that she had eloped with the co-accused/Shubham, and no complaints were given by the victim against the co-accused/Shubham.\n4.",
      "rhetorical_role": "FAC",
      "start": 3810,
      "end": 4026,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 3940,
          "end": 3947
        },
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 4015,
          "end": 4022
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18358200788497925
    },
    {
      "sentence_id": 32,
      "text": "Material on record further indicates that after about 23 days i.e., on 26.03.2024, another statement of the victim was recorded under Section 164 Cr.P.C.",
      "rhetorical_role": "FAC",
      "start": 4027,
      "end": 4180,
      "entities": [
        {
          "text": "26.03.2024",
          "label": "DATE",
          "start": 4098,
          "end": 4108
        },
        {
          "text": "Section 164",
          "label": "PROVISION",
          "start": 4161,
          "end": 4172
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 4173,
          "end": 4180
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.14871084690093994
    },
    {
      "sentence_id": 33,
      "text": "In that statement, the victim stated that she lied to her mother that she had gone to the house of her friend.",
      "rhetorical_role": "FAC",
      "start": 4181,
      "end": 4291,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.07558614015579224
    },
    {
      "sentence_id": 34,
      "text": "It is stated that the co- accused/Shubham wanted to meet her and wanted to celebrate New Year with her but later on the co-accused/Shubham cancelled the program.",
      "rhetorical_role": "FAC",
      "start": 4292,
      "end": 4453,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 4326,
          "end": 4333
        },
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 4423,
          "end": 4430
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.08110473304986954
    },
    {
      "sentence_id": 35,
      "text": "It is stated that the co-accused/Shubham told her that he would take her to his Aunt/Bua's house at Laxmi Nagar and drop her at home by 05:00 PM.",
      "rhetorical_role": "FAC",
      "start": 4454,
      "end": 4599,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 4487,
          "end": 4494
        },
        {
          "text": "Bua",
          "label": "OTHER_PERSON",
          "start": 4539,
          "end": 4542
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.058144308626651764
    },
    {
      "sentence_id": 36,
      "text": "It is stated that by the time they reached the Aunt's house of the co- accused/Shubham and had tea &\nsnacks, it was already 06:00 PM there.",
      "rhetorical_role": "FAC",
      "start": 4600,
      "end": 4739,
      "entities": [
        {
          "text": "Shubham",
          "label": "OTHER_PERSON",
          "start": 4679,
          "end": 4686
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.08277910947799683
    },
    {
      "sentence_id": 37,
      "text": "It is stated that the victim was receiving phone calls from her parents and, therefore, out of fear, she switched off her mobile phone.",
      "rhetorical_role": "FAC",
      "start": 4740,
      "end": 4875,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.06176929175853729
    },
    {
      "sentence_id": 38,
      "text": "It is stated that when the co-accused/Shubham was accompanying the victim outside his bua's house, he started saying, that your parents are searching for you and if you go to your parents now then they would kill you.",
      "rhetorical_role": "FAC",
      "start": 4876,
      "end": 5093,
      "entities": [
        {
          "text": "Shubham",
