          "label": "COURT",
          "start": 1052,
          "end": 1102
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "Both the parties are present in person.",
      "rhetorical_role": "NONE",
      "start": 1104,
      "end": 1143,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 11,
      "text": "This Court interacted with each of them.",
      "rhetorical_role": "FAC",
      "start": 1144,
      "end": 1184,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2821204364299774
    },
    {
      "sentence_id": 12,
      "text": "They submit that both of them have now married with each other and the marriage took place on 11.12.2023 at Arya Samaj Mandir, the certificate of which is also enclosed at page 33 dated 11.12.2023.",
      "rhetorical_role": "FAC",
      "start": 1185,
      "end": 1382,
      "entities": [
        {
          "text": "11.12.2023",
          "label": "DATE",
          "start": 1279,
          "end": 1289
        },
        {
          "text": "11.12.2023",
          "label": "DATE",
          "start": 1371,
          "end": 1381
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.14260807633399963
    },
    {
      "sentence_id": 13,
      "text": "Apart from this, the photographs have also been annexed as annexure- 6.",
      "rhetorical_role": "FAC",
      "start": 1383,
      "end": 1454,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.12315350770950317
    },
    {
      "sentence_id": 14,
      "text": "It is also submitted that both of them are major and the respondent no.2 is 6 months pregnant from the applicant.",
      "rhetorical_role": "FAC",
      "start": 1455,
      "end": 1568,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2146676629781723
    },
    {
      "sentence_id": 15,
      "text": "It is submitted by learned counsel for the parties that since both of them have now married with each other and if such proceedings are permitted to continue the married life of the applicant and the respondent no.2 will spoil.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1569,
      "end": 1796,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1701914370059967
    },
    {
      "sentence_id": 16,
      "text": "It is also submitted that the family members of both the parties have accepted this marriage.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1797,
      "end": 1890,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2556225061416626
    },
    {
      "sentence_id": 17,
      "text": "7. Mr. Saurabh Pandey, learned Brief Holder for the State submits that since both the parties have married with each other and are living happily, therefore, it will be a futile exercise if the trial is permitted to continue, it will spoil the married life of the parties.",
      "rhetorical_role": "ARG_PETITIONER",
