    },
    {
      "sentence_id": 9,
      "text": "The trial is going on in Special Sessions Trial No. 54 of 2021, State vs. Sachin Gupta, in the court of 2nd Additional District & Sessions Judge, Nainital.",
      "rhetorical_role": "NONE",
      "start": 948,
      "end": 1103,
      "entities": [
        {
