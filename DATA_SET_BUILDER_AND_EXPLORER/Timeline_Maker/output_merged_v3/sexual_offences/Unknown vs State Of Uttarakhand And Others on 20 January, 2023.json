      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 7,
      "text": "The challenge in this petition is made to the FIR No. 1698 of 2022 dated 30.12.2022, under Section 376(2)(n), 420 and 506 of IPC, registered at Police Station Manglaur, District Haridwar.",
      "rhetorical_role": "FAC",
      "start": 428,
      "end": 615,
      "entities": [
        {
          "text": "30.12.2022",
          "label": "DATE",
