    },
    {
      "sentence_id": 4,
      "text": "The appellant is a married sister-in-law of the first informant (wife).",
      "rhetorical_role": "PREAMBLE",
      "start": 314,
      "end": 386,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 5,
      "text": "A charge-sheet has been filed against the appellant and other accused for the offences punishable under Section 498A of the Indian Penal Code, 1860 and Sections 3 and 4 of the Dowry Prohibition Act, 1961.",
      "rhetorical_role": "FAC",
      "start": 387,
      "end": 591,
      "entities": [
        {
          "text": "Section 498A",
          "label": "PROVISION",
          "start": 491,
          "end": 503
        },
        {
