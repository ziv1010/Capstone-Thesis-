      ],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "Petitioner prays for anticipatory bail.",
      "rhetorical_role": "NONE",
      "start": 738,
      "end": 778,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 8,
      "text": "Petitioner before us is the husband of the victim.",
      "rhetorical_role": "NONE",
      "start": 779,
      "end": 829,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "Brother-in-law of the victim was granted anticipatory bail by the jurisdictional Court on November 10, 2022.",
      "rhetorical_role": "FAC",
      "start": 830,
      "end": 939,
      "entities": [
        {
          "text": "November 10, 2022",
          "label": "DATE",
          "start": 921,
          "end": 938
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5086571574211121
    },
    {
      "sentence_id": 10,
      "text": "The parents-in-law of the victim was granted bail by the High Court on February 10, 2023.",
      "rhetorical_role": "FAC",
      "start": 940,
      "end": 1030,
      "entities": [
        {
          "text": "February 10, 2023",
          "label": "DATE",
          "start": 1012,
          "end": 1029
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.49835851788520813
    },
    {
      "sentence_id": 11,
      "text": "The Coordinate Bench while granting the bail to the parents- in-law took into consideration the nature of accusation with the period of detention suffered by the parents-in-law.",
      "rhetorical_role": "FAC",
      "start": 1031,
      "end": 1209,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5052439570426941
    },
    {
      "sentence_id": 12,
      "text": "While granting anticipatory bail to the brother-in-law, the role of the brother-in-law was taken into account by the jurisdictional Court.",
      "rhetorical_role": "FAC",
      "start": 1210,
      "end": 1349,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.6315605044364929
    },
    {
      "sentence_id": 13,
      "text": "Petitioner before us is the husband of the victim.",
      "rhetorical_role": "FAC",
      "start": 1350,
      "end": 1401,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24231477081775665
    },
    {
      "sentence_id": 14,
      "text": "The incident occurred within two years of marriage.",
      "rhetorical_role": "FAC",
      "start": 1402,
      "end": 1453,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.489835649728775
    },
    {
      "sentence_id": 15,
      "text": "There are statements recorded under Section 164 of the Code of Criminal Procedure implicating the petitioner as the husband in the incident of torture.",
      "rhetorical_role": "FAC",
      "start": 1454,
      "end": 1605,
      "entities": [
        {
          "text": "Section 164",
          "label": "PROVISION",
          "start": 1490,
          "end": 1501
        },
        {
          "text": "Code of Criminal Procedure",
          "label": "STATUTE",
          "start": 1509,
          "end": 1535
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.39831113815307617
    },
    {
      "sentence_id": 16,
      "text": "Local of the petitioner at Kerala at the time of the incident is sought to be canvassed as a defence.",
      "rhetorical_role": "FAC",
      "start": 1606,
      "end": 1708,
      "entities": [
        {
          "text": "Kerala",
          "label": "GPE",
          "start": 1634,
          "end": 1640
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26109668612480164
    },
    {
      "sentence_id": 17,
      "text": "The involvement of the petitioner in the incident requires consideration.",
      "rhetorical_role": "FAC",
      "start": 1709,
      "end": 1783,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.38863056898117065
    },
    {
      "sentence_id": 18,
      "text": "Prima facie case stands made out as against the petitioner.",
      "rhetorical_role": "RPC",
      "start": 1784,
      "end": 1844,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.17410731315612793
    },
    {
      "sentence_id": 19,
      "text": "In such circumstances, we are unable to grant anticipatory bail to the petitioner.",
      "rhetorical_role": "RPC",
      "start": 1845,
      "end": 1927,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.18928547203540802
    },
    {
      "sentence_id": 20,
      "text": "Accordingly, the prayer for anticipatory bail of the petitioner is rejected.",
      "rhetorical_role": "NONE",
      "start": 1928,
      "end": 2005,
      "entities": [],
      "in_summary": false
    },
