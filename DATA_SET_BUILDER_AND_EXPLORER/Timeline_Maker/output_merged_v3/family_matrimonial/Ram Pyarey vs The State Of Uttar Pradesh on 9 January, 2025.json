        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.6022168397903442
    },
    {
      "sentence_id": 32,
      "text": "7. We are informed that the father-in-law and mother-in-law passed away while the appeal before the High Court was pending.",
      "rhetorical_role": "FAC",
      "start": 3829,
      "end": 3952,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.20934641361236572
    },
    {
      "sentence_id": 33,
      "text": "So far as, the husband is concerned he has already undergone the sentence as imposed by the trial court.",
      "rhetorical_role": "FAC",
      "start": 3953,
      "end": 4057,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.27468010783195496
    },
