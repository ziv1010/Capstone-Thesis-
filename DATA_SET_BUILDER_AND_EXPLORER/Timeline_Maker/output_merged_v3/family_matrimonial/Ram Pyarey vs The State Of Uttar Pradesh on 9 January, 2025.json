      "summary_sent_score": 0.05982203781604767
    },
    {
      "sentence_id": 27,
      "text": "On conclusion of the investigation, charge-sheet was filed for the offences enumerated above,\nagainst four accused persons which included the appellant herein.",
      "rhetorical_role": "FAC",
      "start": 3003,
      "end": 3162,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5081841945648193
    },
    {
      "sentence_id": 28,
      "text": "The offence being exclusively triable by the Sessions Court was committed under the provisions of Section 209 of the Code of Criminal Procedure.",
      "rhetorical_role": "FAC",
      "start": 3163,
      "end": 3307,
      "entities": [
        {
          "text": "Section 209",
          "label": "PROVISION",
          "start": 3261,
          "end": 3272
        },
        {
          "text": "Code of Criminal Procedure",
          "label": "STATUTE",
