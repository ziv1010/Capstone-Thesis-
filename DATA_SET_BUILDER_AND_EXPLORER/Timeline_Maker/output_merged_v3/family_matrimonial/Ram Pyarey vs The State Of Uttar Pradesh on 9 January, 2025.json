    },
    {
      "sentence_id": 21,
      "text": "The complaint of the complainant is against all the four accused.",
      "rhetorical_role": "FAC",
      "start": 2656,
      "end": 2722,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19441351294517517
    },
