      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.36685964465141296
    },
    {
      "sentence_id": 12,
      "text": "The gist of the complaint lodged by the father of the deceased reads thus:-\nTo, SHO, Police Station Ajgain, District Unnao:\nSir, It is respectfully submitted that the complainant Shiv Prasad Sahu, S/o. Laxman Sahu is resident of Village Bhakat, P.S. Kotwali, District Unnao.",
      "rhetorical_role": "FAC",
      "start": 1304,
      "end": 1578,
