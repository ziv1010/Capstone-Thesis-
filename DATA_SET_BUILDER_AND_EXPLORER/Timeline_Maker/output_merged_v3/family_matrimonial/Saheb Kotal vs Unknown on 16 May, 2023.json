        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 13,
      "text": "In such circumstances, we are unable to grant anticipatory bail to the petitioner.",
      "rhetorical_role": "RPC",
      "start": 1201,
      "end": 1284,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.3791365325450897
    },
    {
      "sentence_id": 14,
      "text": "Accordingly, the prayer for anticipatory bail of the petitioner is rejected.",
