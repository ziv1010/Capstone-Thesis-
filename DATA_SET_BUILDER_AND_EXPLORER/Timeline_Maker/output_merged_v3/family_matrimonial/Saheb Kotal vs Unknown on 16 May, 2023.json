      "summary_sent_score": 0.6112732291221619
    },
    {
      "sentence_id": 12,
      "text": "There is a statement recorded under Section 164 of the Code of Criminal Procedure of a person claiming to be the first wife of the petitioner and also implicates the petitioner in the incident of assault, torture and demand for dowry.",
      "rhetorical_role": "PREAMBLE",
      "start": 965,
      "end": 1200,
      "entities": [
        {
