          "label": "GPE",
          "start": 1418,
          "end": 1428
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15320485830307007
    },
    {
      "sentence_id": 16,
      "text": "Some of the police officials, therefore, kept a  watch in that area.",
      "rhetorical_role": "FAC",
      "start": 1430,
      "end": 1498,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1432284265756607
    },
    {
      "sentence_id": 17,
      "text": "It was found that one Prabhu Makariye and Jitesh  Kurliye (applicant) came on two Activa scooter, carrying fully loaded  three gunny bags on each Activa scooter.",
      "rhetorical_role": "FAC",
      "start": 1499,
      "end": 1660,
      "entities": [
        {
          "text": "Prabhu Makariye",
          "label": "OTHER_PERSON",
          "start": 1521,
          "end": 1536
        },
        {
          "text": "Jitesh  Kurliye",
          "label": "OTHER_PERSON",
          "start": 1541,
          "end": 1556
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.17976996302604675
    },
    {
      "sentence_id": 18,
      "text": "They were, therefore,\n intercepted and search was made.",
      "rhetorical_role": "FAC",
      "start": 1661,
      "end": 1716,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.24200797080993652
    },
    {
      "sentence_id": 19,
      "text": "It was found that the gunny bags  contained the packets of Hira Pan Masala.",
      "rhetorical_role": "FAC",
      "start": 1717,
      "end": 1792,
      "entities": [
        {
          "text": "Hira Pan Masala",
          "label": "OTHER_PERSON",
          "start": 1776,
          "end": 1791
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.23349882662296295
    },
    {
      "sentence_id": 20,
      "text": "The same came to be seized,\n since, sale, store and transportation of Gutkha and Pan Masala is  prohibited in the State of Maharashtra. FIR, then came to be lodged for  the aforesaid offences.",
      "rhetorical_role": "FAC",
      "start": 1793,
      "end": 1985,
      "entities": [
        {
          "text": "Gutkha",
          "label": "OTHER_PERSON",
          "start": 1863,
          "end": 1869
        },
        {
          "text": "Pan Masala",
          "label": "OTHER_PERSON",
          "start": 1874,
          "end": 1884
        },
        {
          "text": "Maharashtra",
          "label": "GPE",
          "start": 1916,
          "end": 1927
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.23909085988998413
    },
    {
      "sentence_id": 21,
      "text": "3. I have already observed that Section 328 of Indian Penal Code is  not applicable in case of storing, sale or transporting contraband  articles, namely, Gutkha, Pan Masala, Tobacco etc.",
      "rhetorical_role": "FAC",
      "start": 1986,
      "end": 2175,
      "entities": [
        {
          "text": "Section 328",
          "label": "PROVISION",
          "start": 2020,
          "end": 2031
        },
        {
          "text": "Indian Penal Code",
          "label": "STATUTE",
          "start": 2035,
          "end": 2052
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18528588116168976
    },
    {
      "sentence_id": 22,
      "text": "Rest of the offences  are bailable one.",
      "rhetorical_role": "FAC",
      "start": 2176,
      "end": 2215,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.20937058329582214
    },
    {
      "sentence_id": 23,
      "text": "I am, therefore, inclined to grant anticipatory bail to  the applicant.",
      "rhetorical_role": "RPC",
      "start": 2216,
      "end": 2287,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.1976492702960968
    },
    {
      "sentence_id": 24,
      "text": "Hence, following order:\n ORDER I.",
      "rhetorical_role": "RPC",
      "start": 2288,
      "end": 2321,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
