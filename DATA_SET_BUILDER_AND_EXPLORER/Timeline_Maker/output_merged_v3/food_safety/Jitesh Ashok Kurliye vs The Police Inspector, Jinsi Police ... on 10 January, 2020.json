    {
      "sentence_id": 15,
      "text": "It is alleged in the FIR that an information was received that  some persons are selling Gutkha and Pan Masala at Baijipura,\n Sanjaynagar, Aurangabad.",
      "rhetorical_role": "FAC",
      "start": 1279,
      "end": 1429,
      "entities": [
        {
          "text": "Gutkha",
          "label": "OTHER_PERSON",
          "start": 1368,
          "end": 1374
        },
        {
          "text": "Pan Masala",
          "label": "OTHER_PERSON",
          "start": 1379,
          "end": 1389
        },
        {
          "text": "Baijipura",
          "label": "GPE",
          "start": 1393,
          "end": 1402
        },
        {
          "text": "Sanjaynagar",
