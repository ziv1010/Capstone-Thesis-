    },
    {
      "sentence_id": 7,
      "text": "Present: Mr. Rakesh Bhatia, Advocate,\n for the petitioner.\n Mr. S.P.S. Tinna, Additional Advocate General, Punjab.\n ***\nRajiv Sharma, J.\n1.",
      "rhetorical_role": "PREAMBLE",
