          "start": 461,
          "end": 473
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 8,
      "text": "This revision petition is directed against judgment and order dated 11.10.2013, rendered by\nlearned Chief Judicial Magistrate, Fatehgarh Sahib, in Case No. 05 dated 23.01.2017, as well as\nagainst judgment dated 20.03.2014, passed by learned Additional Sessions Judge, Fatehgarh Sahib,\nin Criminal Appeal No. 78 dated 23.10.2013.\n2.",
      "rhetorical_role": "RLC",
      "start": 481,
      "end": 812,
      "entities": [
        {
          "text": "Case No. 05",
          "label": "CASE_NUMBER",
          "start": 628,
          "end": 639
        },
        {
          "text": "23.01.2017",
          "label": "DATE",
          "start": 646,
          "end": 656
        },
        {
          "text": "20.03.2014",
          "label": "DATE",
          "start": 692,
          "end": 702
        },
        {
          "text": "Additional Sessions Judge, Fatehgarh Sahib",
          "label": "COURT",
          "start": 722,
          "end": 764
        },
        {
          "text": "Criminal Appeal No. 78",
          "label": "CASE_NUMBER",
          "start": 769,
          "end": 791
        },
        {
          "text": "23.10.2013",
          "label": "DATE",
          "start": 798,
          "end": 808
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.04213104397058487
    },
    {
      "sentence_id": 9,
      "text": "Petitioner Taranjit Singh was charged with and tried for the offences punishable under Section 16 of the Prevention of Food 1 of 5 Adulteration Act, 1954 (hereinafter referred to as `the Act').",
      "rhetorical_role": "RLC",
      "start": 814,
      "end": 1007,
      "entities": [
        {
          "text": "Taranjit Singh",
          "label": "PETITIONER",
          "start": 825,
          "end": 839
        },
        {
          "text": "Section 16",
          "label": "PROVISION",
          "start": 901,
          "end": 911
        },
        {
          "text": "Prevention of Food 1 of 5",
          "label": "STATUTE",
          "start": 919,
          "end": 944
        },
        {
          "text": "Adulteration Act, 1954",
          "label": "STATUTE",
          "start": 945,
          "end": 967
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.568619430065155
    },
    {
      "sentence_id": 10,
      "text": "He was convicted and sentenced by the learned trial court to undergo simple imprisonment for six months and to pay a fine of ` 1,000/- and in default of payment of fine, to undergo further imprisonment for 15 days, under Section 16 of the Act.",
      "rhetorical_role": "RLC",
      "start": 1008,
      "end": 1251,
      "entities": [
        {
          "text": "Section 16",
          "label": "PROVISION",
          "start": 1229,
          "end": 1239
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4097829759120941
    },
    {
      "sentence_id": 11,
      "text": "Against his conviction and sentence, the petitioner filed appeal,\nwhich has been dismissed by learned Additional Sessions Judge, Fatehgarh Sahib.\nTaranjit Singh vs State Of Punjab & Anr on 24 May, 2019 Indian Kanoon - http://indiankanoon.org/doc/160824635/\n1 3.",
      "rhetorical_role": "RLC",
      "start": 1252,
      "end": 1513,
      "entities": [
        {
          "text": "Additional Sessions Judge, Fatehgarh Sahib",
          "label": "COURT",
          "start": 1354,
          "end": 1396
        },
        {
          "text": "Taranjit Singh vs State Of Punjab & Anr",
          "label": "PRECEDENT",
          "start": 1398,
          "end": 1437
        },
        {
          "text": "24 May, 2019",
          "label": "DATE",
          "start": 1441,
          "end": 1453
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.350068598985672
    },
    {
      "sentence_id": 12,
      "text": "The brief facts necessary for adjudication of this revision petition are that respondent/State through Food Inspector Paramjit Singh, Office of Civil Surgeon, Fatehgarh Sahib, filed complaint under Section 7/16 of the Act, against the petitioner with the averments that complainant Paramjit Singh on 07.06.2006 at about 4.00 PM along with Dr. Vinod Gupta, Medical Officer, Civil Hospital,\nMandi Gobindgarh, inspected the premises of the petitioner.",
      "rhetorical_role": "FAC",
      "start": 1514,
      "end": 1962,
      "entities": [
        {
          "text": "Paramjit Singh",
          "label": "WITNESS",
          "start": 1632,
          "end": 1646
        },
        {
          "text": "Fatehgarh Sahib",
          "label": "GPE",
          "start": 1673,
          "end": 1688
        },
        {
          "text": "Section 7/16",
          "label": "PROVISION",
          "start": 1712,
          "end": 1724
        },
        {
          "text": "Paramjit Singh",
          "label": "WITNESS",
          "start": 1796,
          "end": 1810
        },
        {
          "text": "07.06.2006",
          "label": "DATE",
          "start": 1814,
          "end": 1824
        },
        {
          "text": "Vinod Gupta",
          "label": "WITNESS",
          "start": 1857,
          "end": 1868
        },
        {
          "text": "Civil Hospital,\nMandi Gobindgarh",
          "label": "ORG",
          "start": 1887,
          "end": 1919
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.12709616124629974
    },
    {
      "sentence_id": 13,
      "text": "He was found in possession of 7 plastic crates of Banta Soda kept in room for sale and consumption.",
      "rhetorical_role": "FAC",
      "start": 1963,
      "end": 2062,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3160289525985718
    },
    {
      "sentence_id": 14,
      "text": "The complainant made efforts to join witnesses from the public.",
      "rhetorical_role": "FAC",
      "start": 2063,
      "end": 2126,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23917539417743683
    },
    {
      "sentence_id": 15,
      "text": "However, no person joined the investigation.",
      "rhetorical_role": "FAC",
      "start": 2127,
      "end": 2171,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24618898332118988
    },
    {
      "sentence_id": 16,
      "text": "The complainant disclosed his identity as Food Inspector to the petitioner.",
      "rhetorical_role": "FAC",
      "start": 2172,
      "end": 2247,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.27170127630233765
    },
    {
      "sentence_id": 17,
      "text": "He showed his intention to take sample by serving notice in writing in Form VI.",
      "rhetorical_role": "FAC",
      "start": 2248,
      "end": 2327,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2653745114803314
    },
    {
      "sentence_id": 18,
      "text": "The complainant purchased nine bottles of Banta Soda on payment of ` 99/-.",
      "rhetorical_role": "FAC",
      "start": 2328,
      "end": 2402,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26660698652267456
    },
    {
      "sentence_id": 19,
      "text": "He obtained the receipt.",
      "rhetorical_role": "FAC",
      "start": 2403,
      "end": 2427,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26829633116722107
    },
    {
      "sentence_id": 20,
      "text": "The purchased nine bottles were divided into three equal parts of three bottles in one sample packet.",
      "rhetorical_role": "FAC",
      "start": 2428,
      "end": 2529,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23586423695087433
    },
    {
      "sentence_id": 21,
      "text": "The bottles were labeled and wrapped into thick brown paper.",
      "rhetorical_role": "FAC",
      "start": 2530,
      "end": 2590,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23529192805290222
    },
    {
      "sentence_id": 22,
      "text": "The paper slip was also duly signed by the Local Health Authority, Fatehgarh Sahib.",
      "rhetorical_role": "FAC",
      "start": 2591,
      "end": 2675,
      "entities": [
        {
          "text": "Fatehgarh Sahib",
          "label": "GPE",
          "start": 2659,
          "end": 2674
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.13373544812202454
    },
    {
      "sentence_id": 23,
      "text": "All the three samples were sealed with seal bearing impressions and signatures of the complainant.",
      "rhetorical_role": "FAC",
      "start": 2676,
      "end": 2774,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21727155148983002
    },
    {
      "sentence_id": 24,
      "text": "The signatures of the petitioner were obtained partly on the slip and partly on the wrapper.",
      "rhetorical_role": "FAC",
      "start": 2775,
      "end": 2867,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18104669451713562
    },
    {
      "sentence_id": 25,
      "text": "The spot memo was 2 of 5 prepared.",
      "rhetorical_role": "FAC",
      "start": 2868,
      "end": 2902,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18826355040073395
    },
    {
      "sentence_id": 26,
      "text": "The memorandum of Form VII was also prepared.",
      "rhetorical_role": "FAC",
      "start": 2903,
      "end": 2948,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18601825833320618
    },
    {
      "sentence_id": 27,
      "text": "One part of the sample and one copy of memorandum in Form VII duly sealed were given to Malkiat Singh, Class IV employee, for depositing with the Public Analyst, on 07.06.2006.",
      "rhetorical_role": "FAC",
      "start": 2949,
      "end": 3125,
      "entities": [
        {
          "text": "Malkiat Singh",
          "label": "WITNESS",
          "start": 3037,
          "end": 3050
        },
        {
          "text": "07.06.2006",
          "label": "DATE",
          "start": 3114,
          "end": 3124
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19587604701519012
    },
    {
      "sentence_id": 28,
      "text": "The other two sample parcels were deposited with the office of Local Health Authority, Fatehgarh Sahib, on the same day.",
      "rhetorical_role": "FAC",
      "start": 3126,
      "end": 3246,
      "entities": [
        {
          "text": "Fatehgarh Sahib",
          "label": "GPE",
          "start": 3213,
          "end": 3228
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1544320434331894
    },
    {
      "sentence_id": 29,
      "text": "The result of the Public Analyst was that the contents of the sample contained saccharin as artificial sweetener to the extent of 80 P.P.M whereas the containers did not bear a label declaration regarding the addition of saccharin as required under the provisions of Rule 42 (zzz) (i) of PFA Rules, 1955.",
      "rhetorical_role": "FAC",
      "start": 3247,
      "end": 3551,
      "entities": [
        {
          "text": "Rule 42 (zzz) (i)",
          "label": "PROVISION",
          "start": 3514,
          "end": 3531
        },
        {
          "text": "PFA Rules, 1955",
          "label": "STATUTE",
          "start": 3535,
          "end": 3550
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4443020820617676
    },
    {
      "sentence_id": 30,
      "text": "The product was also not labelled in accordance with the provisions of Rule 32 of PFA Rules, 1955.",
      "rhetorical_role": "FAC",
      "start": 3552,
      "end": 3650,
      "entities": [
        {
          "text": "Rule 32",
          "label": "PROVISION",
          "start": 3623,
          "end": 3630
        },
        {
          "text": "PFA Rules, 1955",
          "label": "STATUTE",
          "start": 3634,
          "end": 3649
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.35108432173728943
    },
    {
      "sentence_id": 31,
      "text": "Thus,\nthe sample was misbranded.",
      "rhetorical_role": "FAC",
      "start": 3651,
      "end": 3683,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3823713958263397
    },
    {
      "sentence_id": 32,
      "text": "Complaint was filed against the petitioner.",
      "rhetorical_role": "FAC",
      "start": 3684,
      "end": 3727,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.31212475895881653
    },
    {
      "sentence_id": 33,
      "text": "4. The prosecution examined a number of witnesses in support of its case.",
      "rhetorical_role": "FAC",
      "start": 3729,
      "end": 3802,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.30782443284988403
    },
    {
      "sentence_id": 34,
      "text": "The accused was also examined under Section 313 Cr.P.C.",
      "rhetorical_role": "FAC",
      "start": 3803,
      "end": 3858,
      "entities": [
        {
          "text": "Section 313",
          "label": "PROVISION",
          "start": 3839,
          "end": 3850
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 3851,
          "end": 3858
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.33412760496139526
    },
    {
      "sentence_id": 35,
      "text": "He denied the case of the prosecution.",
      "rhetorical_role": "FAC",
      "start": 3859,
      "end": 3897,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.32750019431114197
    },
    {
      "sentence_id": 36,
      "text": "He was convicted and sentenced by the trial court, as noticed here-in-above.",
      "rhetorical_role": "FAC",
      "start": 3898,
      "end": 3974,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3887767493724823
    },
    {
      "sentence_id": 37,
      "text": "The appeal filed by him was dismissed by the learned appellate court.",
      "rhetorical_role": "FAC",
      "start": 3975,
      "end": 4044,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3629980683326721
    },
    {
      "sentence_id": 38,
      "text": "Hence, this revision petition.",
      "rhetorical_role": "FAC",
      "start": 4045,
      "end": 4075,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.12834829092025757
    },
    {
      "sentence_id": 39,
      "text": "5. Learned counsel appearing on behalf of the petitioner has vehemently argued that the prosecution has failed to prove its case against his client and both the courts below have misread the oral as well as documentary evidence.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4077,
      "end": 4305,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.20042866468429565
    },
    {
      "sentence_id": 40,
      "text": "Learned counsel appearing on behalf of the State has supported the judgments of the courts below.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4306,
      "end": 4403,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.12031576782464981
    },
    {
      "sentence_id": 41,
      "text": "6. We have heard learned counsel for the parties and gone through the judgment and record very carefully.",
      "rhetorical_role": "NONE",
      "start": 4405,
      "end": 4510,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 42,
      "text": "7. PW.1 Dr. Vinod Gupta, Medical Officer, was accompanying the Food Inspector.",
      "rhetorical_role": "NONE",
      "start": 4511,
      "end": 4590,
      "entities": [
        {
          "text": "Vinod Gupta",
          "label": "WITNESS",
          "start": 4524,
          "end": 4535
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 43,
      "text": "He testified with regard to drawing of samples of Banta 3 of 5 Soda from possession of the petitioner.",
      "rhetorical_role": "ANALYSIS",
      "start": 4591,
      "end": 4693,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.19236154854297638
    },
    {
      "sentence_id": 44,
      "text": "The Food Inspector tried to join independent witnesses, but no body came forward.",
      "rhetorical_role": "ANALYSIS",
      "start": 4694,
      "end": 4775,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.15632206201553345
    },
    {
      "sentence_id": 45,
      "text": "The petitioner was served notice in Form VI vide Ex.PW.1/A.",
      "rhetorical_role": "FAC",
      "start": 4776,
      "end": 4835,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26730453968048096
    },
    {
      "sentence_id": 46,
      "text": "Receipt was obtained.",
      "rhetorical_role": "ANALYSIS",
      "start": 4836,
      "end": 4857,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.12762314081192017
    },
    {
      "sentence_id": 47,
      "text": "PW.2 Paramjit Singh complainant referred to documents Ex.PW.1/A to Ex.PW.1/C.",
      "rhetorical_role": "FAC",
      "start": 4858,
      "end": 4935,
      "entities": [
        {
          "text": "Paramjit Singh",
          "label": "WITNESS",
          "start": 4863,
          "end": 4877
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.06371656060218811
    },
    {
      "sentence_id": 48,
      "text": "He proved report of the Public Analyst, Ex.PD, and complaint Ex.PE.",
