        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 21,
      "text": "Mr. B.S. Thind, learned Brief Holder for the State requested three weeks' time to clarify the weight of the samples.",
      "rhetorical_role": "NONE",
      "start": 2429,
      "end": 2545,
      "entities": [
        {
          "text": "B.S. Thind",
          "label": "OTHER_PERSON",
          "start": 2433,
          "end": 2443
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 22,
      "text": "List this case on 20.03.2023 for final hearing.",
      "rhetorical_role": "NONE",
      "start": 2547,
      "end": 2594,
      "entities": [
        {
          "text": "20.03.2023",
          "label": "DATE",
          "start": 2565,
          "end": 2575
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 23,
      "text": "Till then, further proceedings of the said Complaint Case No.10362 of 2022 are stayed.",
      "rhetorical_role": "RPC",
      "start": 2595,
      "end": 2682,
      "entities": [
        {
