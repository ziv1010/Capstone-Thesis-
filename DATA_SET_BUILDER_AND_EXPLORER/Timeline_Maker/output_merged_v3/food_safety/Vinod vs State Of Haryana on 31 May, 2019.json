          "end": 3366
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1494268923997879
    },
    {
      "sentence_id": 43,
      "text": "According to him,\nthey found the petitioner selling cow milk.",
      "rhetorical_role": "ANALYSIS",
      "start": 3368,
      "end": 3429,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.220176562666893
    },
    {
      "sentence_id": 44,
