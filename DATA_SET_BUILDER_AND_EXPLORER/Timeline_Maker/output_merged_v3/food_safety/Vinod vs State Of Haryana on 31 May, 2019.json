      "rhetorical_role": "ANALYSIS",
      "start": 3430,
      "end": 3465,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.22065213322639465
    },
    {
      "sentence_id": 45,
      "text": "10. PW-3 Muni Ram deposed that after the receipt the report of Public Analyst, he sent the same to the petitioner vide registered letter dated 01.09.1999.\n11.",
      "rhetorical_role": "ANALYSIS",
      "start": 3467,
      "end": 3625,
      "entities": [
        {
