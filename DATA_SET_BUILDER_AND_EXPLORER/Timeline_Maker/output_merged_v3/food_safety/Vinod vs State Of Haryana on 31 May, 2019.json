      "end": 4395,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5056617259979248
    },
    {
      "sentence_id": 60,
      "text": "12. Accordingly there is no merit in the arguments raised by the counsel for the petitioner so far his conviction is concerned.",
