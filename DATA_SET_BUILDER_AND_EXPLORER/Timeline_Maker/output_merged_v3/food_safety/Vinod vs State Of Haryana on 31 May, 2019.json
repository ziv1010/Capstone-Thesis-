        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19386355578899384
    },
    {
      "sentence_id": 42,
      "text": "9. PW-2 Dr.V.K.Malhotra has corroborated the statement of PW-1 K.K.Sharma.",
      "rhetorical_role": "ANALYSIS",
      "start": 3292,
      "end": 3367,
      "entities": [
        {
          "text": "V.K.Malhotra",
          "label": "WITNESS",
          "start": 3304,
          "end": 3316
        },
        {
          "text": "K.K.Sharma",
          "label": "WITNESS",
