      "summary_sent_score": 0.20030555129051208
    },
    {
      "sentence_id": 55,
      "text": "All the codal formalities were completed on the spot.",
      "rhetorical_role": "ANALYSIS",
      "start": 4053,
      "end": 4106,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.26103171706199646
    },
    {
      "sentence_id": 56,
      "text": "The statements made by the official witnesses inspire confidence.",
      "rhetorical_role": "ANALYSIS",
      "start": 4107,
      "end": 4172,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.21533340215682983
    },
    {
      "sentence_id": 57,
      "text": "There is no occasion to falsely implicate the petitioner.",
      "rhetorical_role": "RATIO",
      "start": 4173,
      "end": 4230,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.22234293818473816
    },
    {
      "sentence_id": 58,
      "text": "No cogent evidence has been led that the petitioner was below 18 years of age.",
      "rhetorical_role": "RATIO",
      "start": 4231,
      "end": 4309,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2381889820098877
    },
    {
      "sentence_id": 59,
      "text": "The plea of the petitioner being juvenile was not even raised before the trial Court.",
      "rhetorical_role": "RATIO",
