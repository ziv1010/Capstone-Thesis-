      "end": 3877,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.11250827461481094
    },
    {
      "sentence_id": 53,
      "text": "This sample also did not conform the specification laid down for cow milk.",
      "rhetorical_role": "ANALYSIS",
      "start": 3878,
      "end": 3952,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.22461189329624176
    },
    {
      "sentence_id": 54,
      "text": "It has come in the statement of PW-1 K.K. Sharma that milk was stirred clockwise or anti clockwise.",
      "rhetorical_role": "ANALYSIS",
