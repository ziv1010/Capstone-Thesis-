      "start": 3689,
      "end": 3714,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2471764236688614
    },
    {
      "sentence_id": 49,
      "text": "The report is Ex.PE.",
      "rhetorical_role": "ANALYSIS",
      "start": 3715,
      "end": 3735,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.12907050549983978
    },
    {
      "sentence_id": 50,
      "text": "According to the report, sample did not conform to the prescribed standard.",
