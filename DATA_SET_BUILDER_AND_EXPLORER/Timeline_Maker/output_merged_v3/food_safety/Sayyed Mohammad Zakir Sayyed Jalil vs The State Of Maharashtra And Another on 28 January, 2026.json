      "summary_sent_score": 0.3028814494609833
    },
    {
      "sentence_id": 55,
      "text": "It appears from record that even after the raid and registration of the offence on 07.11.2025, efforts were made to pursue and apprehend the Applicant on the next day of the raid i.e. 08.11.2025.",
      "rhetorical_role": "ANALYSIS",
