    {
      "sentence_id": 3,
      "text": "1 930.Aba-2166-2025.\n In The High Court Of Judicature At Bombay\n Bench At Aurangabad\n Anticipatory Bail Application No. 2166 Of 2025\n Sayyed Mohammad Zakir Sayyed Jalil\n Versus\n The State Of Maharashtra And Another\n ...\n Advocate for Applicant : Mr. Rajendra G. Hange\n App for the Respondents/State : Mr. P. D. Patil\n ...\n Coram : Mehroz K. Pathan, J.\nDate : 28th January, 2026 Per Court :",
      "rhetorical_role": "PREAMBLE",
      "start": 114,
      "end": 506,
      "entities": [
        {
          "text": "High Court Of Judicature At Bombay\n Bench At Aurangabad",
          "label": "COURT",
          "start": 145,
          "end": 200
        },
        {
          "text": "Sayyed Mohammad Zakir Sayyed Jalil",
          "label": "PETITIONER",
          "start": 250,
          "end": 284
        },
        {
          "text": "State Of Maharashtra",
          "label": "RESPONDENT",
          "start": 298,
          "end": 318
        },
        {
