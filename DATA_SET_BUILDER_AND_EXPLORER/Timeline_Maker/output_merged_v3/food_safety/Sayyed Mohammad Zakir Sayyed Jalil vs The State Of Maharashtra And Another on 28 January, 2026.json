      "end": 6143,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.13132408261299133
    },
    {
      "sentence_id": 47,
      "text": "The perusal of the investigation papers shows that the Applicant had stored prohibited articles in his shop, namely Madina Traders at Mominpura, Beed.",
