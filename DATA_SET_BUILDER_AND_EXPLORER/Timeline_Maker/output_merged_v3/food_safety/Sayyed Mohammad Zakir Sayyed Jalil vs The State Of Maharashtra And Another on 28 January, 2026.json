      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.11923608928918839
    },
    {
      "sentence_id": 48,
      "text": "Upon receiving secret information, the police 5 930.ABA-2166-2025.doc conducted a raid and made a phone call to the Applicant on his mobile number 9561031002, directing him to remain present.",
      "rhetorical_role": "ANALYSIS",
