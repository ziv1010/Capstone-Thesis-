      "text": "Learned APP submitted that there is direct involvement of the applicants in this case.",
      "rhetorical_role": "ANALYSIS",
      "start": 1492,
      "end": 1578,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.27757102251052856
    },
    {
      "sentence_id": 13,
      "text": "They ran away from the place of incident.",
      "rhetorical_role": "ANALYSIS",
      "start": 1579,
      "end": 1620,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.45555076003074646
    },
    {
