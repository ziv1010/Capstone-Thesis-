    {
      "sentence_id": 4,
      "text": "2.  The case of the prosecution is that movement of the applicants was found suspicious.",
      "rhetorical_role": "ANALYSIS",
      "start": 832,
      "end": 920,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.29670700430870056
    },
    {
      "sentence_id": 5,
      "text": "They were found in possession of Gutkha valued at Rs.63,400/-.",
      "rhetorical_role": "FAC",
      "start": 921,
      "end": 983,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.44631460309028625
    },
    {
      "sentence_id": 6,
      "text": "3. The submission of learned counsel for applicant is that the applicants are falsely implicated in this case.",
      "rhetorical_role": "ANALYSIS",
      "start": 985,
      "end": 1095,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.21272031962871552
    },
    {
      "sentence_id": 7,
      "text": "They were the purchasers of Gutkha pouch.",
      "rhetorical_role": "ANALYSIS",
      "start": 1096,
      "end": 1137,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.367310494184494
    },
    {
      "sentence_id": 8,
      "text": "They were not arrested immediately.",
      "rhetorical_role": "ANALYSIS",
      "start": 1138,
      "end": 1173,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.32523056864738464
    },
    {
      "sentence_id": 9,
      "text": "They were let off and subsequently in the mid night the FIR was registered and their arrest was sought.",
      "rhetorical_role": "ANALYSIS",
      "start": 1174,
      "end": 1277,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.33177873492240906
    },
    {
      "sentence_id": 10,
      "text": "Section 328 is not applicable in this case.",
      "rhetorical_role": "ANALYSIS",
      "start": 1278,
      "end": 1321,
      "entities": [
        {
