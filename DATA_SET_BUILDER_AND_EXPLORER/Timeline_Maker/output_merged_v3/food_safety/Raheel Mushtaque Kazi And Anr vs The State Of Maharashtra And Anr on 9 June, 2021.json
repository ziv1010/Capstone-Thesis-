      "summary_section": "facts",
      "summary_sent_score": 0.30026373267173767
    },
    {
      "sentence_id": 16,
      "text": "On perusal of the FIR it is apparent that involvement of applicants is disclosed.",
      "rhetorical_role": "ANALYSIS",
      "start": 1703,
      "end": 1784,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.34444743394851685
    },
    {
      "sentence_id": 17,
      "text": "The submission that Section 328 IPC is not attracted, cannot be accepted.",
      "rhetorical_role": "RATIO",
      "start": 1785,
      "end": 1858,
      "entities": [
        {
          "text": "Section 328",
          "label": "PROVISION",
          "start": 1805,
          "end": 1816
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 1817,
          "end": 1820
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3179667592048645
    },
    {
      "sentence_id": 18,
      "text": "This issue has been dealt with by this Court in several decisions.",
      "rhetorical_role": "RATIO",
      "start": 1859,
      "end": 1925,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.16085612773895264
    },
    {
      "sentence_id": 19,
      "text": "Hence, no case for grant of this application is made out.",
