      "text": "Prohibited Gutkha was recovered from them.",
      "rhetorical_role": "ANALYSIS",
      "start": 1621,
      "end": 1663,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.35354721546173096
    },
    {
      "sentence_id": 15,
      "text": "The value of Gutkha is Rs.63,400/-.\n5.",
