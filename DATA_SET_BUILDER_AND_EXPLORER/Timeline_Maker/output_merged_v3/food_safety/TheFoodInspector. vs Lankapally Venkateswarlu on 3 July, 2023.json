    },
    {
      "sentence_id": 3,
      "text": "1. The present prosecution is for the offence under Section 16 (1) 9 (a) (i) of Prevention of Food Adulteration Act, 1954 (for short 'the Act').\n2.",
      "rhetorical_role": "FAC",
      "start": 145,
      "end": 292,
