      "summary_sent_score": 0.22263379395008087
    },
    {
      "sentence_id": 13,
      "text": "He submits,\nregistered office of petitioner is situate in Kolkata while its factory is in Assam.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1283,
      "end": 1379,
      "entities": [
        {
          "text": "Kolkata",
          "label": "GPE",
          "start": 1341,
          "end": 1348
        },
        {
