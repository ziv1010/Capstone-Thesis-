        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.13653217256069183
    },
    {
      "sentence_id": 19,
      "text": "He seeks adjournment to produce notification and its schedule to show that petitioner's office is an establishment covered by the extension.",
