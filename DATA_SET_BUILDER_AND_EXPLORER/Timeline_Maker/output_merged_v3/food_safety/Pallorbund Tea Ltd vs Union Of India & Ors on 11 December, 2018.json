          "label": "GPE",
          "start": 1373,
          "end": 1378
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.19632884860038757
    },
    {
      "sentence_id": 14,
      "text": "According to him,\nthe Act does not apply to seasonal factories.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1380,
      "end": 1443,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.280673623085022
    },
    {
      "sentence_id": 15,
      "text": "Sub-section (19A) in section 2 covers petitioner as a factory exclusively engaged in manufacture of tea, as a seasonal factory.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1444,
      "end": 1571,
      "entities": [
        {
          "text": "section 2",
          "label": "PROVISION",
          "start": 1465,
          "end": 1474
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2417641282081604
    },
    {
      "sentence_id": 16,
      "text": "Extension of prevision of this Act by State cannot make it become applicable to its factory.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1572,
      "end": 1664,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.37258434295654297
    },
    {
      "sentence_id": 17,
      "text": "He seeks interference.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1665,
      "end": 1687,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.21315817534923553
    },
    {
      "sentence_id": 18,
      "text": "Mr. Subal Maitra, learned advocate appears on behalf of the authority and submits, petitioner's establishment in Kolkata has been inspected and nine employees found covered.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1688,
      "end": 1862,
