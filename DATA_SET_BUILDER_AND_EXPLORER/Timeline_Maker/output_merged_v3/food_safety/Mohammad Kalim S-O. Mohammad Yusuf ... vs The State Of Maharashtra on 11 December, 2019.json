        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1358911395072937
    },
    {
      "sentence_id": 28,
      "text": "He, therefore,\nurged for grant of anticipatory bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3003,
      "end": 3055,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.21191397309303284
    },
    {
      "sentence_id": 29,
      "text": "5. Learned APP would, on the other hand, submit that there is a big haul of contraband articles.",
