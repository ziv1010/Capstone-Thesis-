      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 7,
      "text": "Effectively there is no Tribunal functioning in the State.",
      "rhetorical_role": "PREAMBLE",
      "start": 772,
      "end": 830,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 8,
      "text": "The petitioner, therefore, has no remedy except to file the present writ petition before this Court.",
