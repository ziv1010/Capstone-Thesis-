        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 13,
      "text": "For the purpose of effective hearing and disposal of the matter the Lower Court Record is necessary.",
      "rhetorical_role": "RPC",
      "start": 1475,
      "end": 1575,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.5216285586357117
    },
    {
