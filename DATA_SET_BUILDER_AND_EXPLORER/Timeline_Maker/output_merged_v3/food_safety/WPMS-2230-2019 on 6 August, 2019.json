      "summary_sent_score": 0.3596495985984802
    },
    {
      "sentence_id": 7,
      "text": "Now it is not being renewed by the respondents, for which no reasons have been assigned.",
      "rhetorical_role": "FAC",
      "start": 559,
      "end": 648,
