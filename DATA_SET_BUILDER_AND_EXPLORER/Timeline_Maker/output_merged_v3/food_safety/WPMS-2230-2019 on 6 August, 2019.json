      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.08373941481113434
    },
    {
      "sentence_id": 9,
      "text": "List this matter after three weeks in the daily cause list.",
      "rhetorical_role": "RPC",
