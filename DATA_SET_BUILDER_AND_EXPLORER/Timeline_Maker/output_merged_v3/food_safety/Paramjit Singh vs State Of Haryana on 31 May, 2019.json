      "end": 4837,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2132783830165863
    },
    {
      "sentence_id": 53,
      "text": "The sample was sent to Public Analyst, Karnal.",
      "rhetorical_role": "FAC",
      "start": 4838,
      "end": 4884,
      "entities": [
