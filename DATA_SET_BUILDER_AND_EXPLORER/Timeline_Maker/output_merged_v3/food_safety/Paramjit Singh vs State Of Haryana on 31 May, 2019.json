      "end": 4785,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.31332793831825256
    },
    {
      "sentence_id": 52,
      "text": "Formalin was added as preservative in each bottle.",
      "rhetorical_role": "FAC",
