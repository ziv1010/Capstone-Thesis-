      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3003196120262146
    },
    {
      "sentence_id": 73,
      "text": "The prosecution has proved the case against the petitioner beyond reasonable doubt.",
