      "summary_section": "facts",
      "summary_sent_score": 0.29300644993782043
    },
    {
      "sentence_id": 63,
      "text": "The accused was served with a notice.",
      "rhetorical_role": "FAC",
      "start": 5620,
      "end": 5657,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3067627251148224
    },
    {
      "sentence_id": 64,
      "text": "The sample did not conform to the standards prescribed.",
      "rhetorical_role": "FAC",
      "start": 5658,
      "end": 5713,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3413541615009308
    },
    {
      "sentence_id": 65,
      "text": "Though the fact of the matter is that second sample sent for analysis to the Central Food Laboratory, Mysore, was received back with the report dated 30.5.2003 that the sample had been rendered unfit for analysis.",
      "rhetorical_role": "FAC",
      "start": 5714,
      "end": 5927,
      "entities": [
        {
          "text": "Central Food Laboratory, Mysore",
          "label": "ORG",
