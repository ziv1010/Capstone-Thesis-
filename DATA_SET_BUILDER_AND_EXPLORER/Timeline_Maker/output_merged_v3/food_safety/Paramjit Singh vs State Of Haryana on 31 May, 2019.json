          "label": "DATE",
          "start": 6117,
          "end": 6126
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19991077482700348
    },
    {
      "sentence_id": 67,
      "text": "The postal receipt has been proved by PW3 Dr. R. S. Chauhan.",
      "rhetorical_role": "FAC",
