      "entities": [
        {
          "text": "Apoorv Garg",
          "label": "LAWYER",
          "start": 421,
          "end": 432
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "Rajiv Sharma, J.\n1.",
      "rhetorical_role": "NONE",
      "start": 468,
      "end": 488,
      "entities": [
        {
          "text": "Rajiv Sharma",
          "label": "JUDGE",
