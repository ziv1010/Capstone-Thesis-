      "text": "The same curdled.",
      "rhetorical_role": "FAC",
      "start": 6285,
      "end": 6302,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26834529638290405
    },
