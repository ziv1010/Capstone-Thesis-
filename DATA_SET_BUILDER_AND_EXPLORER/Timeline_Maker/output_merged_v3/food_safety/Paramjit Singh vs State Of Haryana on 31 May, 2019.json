        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21803271770477295
    },
    {
      "sentence_id": 66,
      "text": "However, result of the sample as given in the report, Ex.PD, by the Public Analyst, Haryana, Karnal, was sent to the accused by the Local Health Authority, C.H.C., Kalka, vide letter dated 2.11.1995.",
      "rhetorical_role": "FAC",
