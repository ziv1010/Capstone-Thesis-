          "end": 481
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "This criminal revision is instituted against the judgment dated 17.7.2008, rendered by learned Additional Sessions Judge, Panchkula, in Criminal Appeal No. 01 of 12.12.2005/ 4.6.2008, whereby he upheld the judgment dated 23.11.2005, rendered by the trial Court in Criminal Case No.\n120/Food dated 28.10.1995.",
      "rhetorical_role": "RLC",
      "start": 489,
      "end": 798,
      "entities": [
        {
          "text": "17.7.2008",
          "label": "DATE",
          "start": 554,
          "end": 563
        },
        {
          "text": "Additional Sessions Judge, Panchkula",
          "label": "COURT",
          "start": 585,
          "end": 621
        },
        {
          "text": "Criminal Appeal No. 01 of 12.12.2005/",
          "label": "CASE_NUMBER",
          "start": 626,
          "end": 663
        },
        {
          "text": "4.6.2008",
          "label": "DATE",
          "start": 664,
          "end": 672
        },
        {
          "text": "23.11.2005",
          "label": "DATE",
          "start": 711,
          "end": 721
        },
        {
          "text": "Criminal Case No.\n120",
          "label": "CASE_NUMBER",
          "start": 754,
          "end": 775
        },
        {
          "text": "28.10.1995",
          "label": "DATE",
          "start": 787,
          "end": 797
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.12373460084199905
    },
    {
      "sentence_id": 11,
      "text": "The petitioner was convicted and sentenced to undergo simple imprisonment for a period of six months under Section 16 (1)(a)(i) of the Prevention of Food Adulteration Act, 1954 (for short, 'the Act'), and to pay fine of ` 1,000/- and in default of payment of fine, to undergo further simple imprisonment for a period of two months.",
      "rhetorical_role": "RLC",
      "start": 799,
      "end": 1130,
      "entities": [
        {
          "text": "Section 16 (1)(a)(i)",
          "label": "PROVISION",
          "start": 906,
          "end": 926
        },
        {
          "text": "Prevention of Food Adulteration Act, 1954",
          "label": "STATUTE",
          "start": 934,
          "end": 975
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5629492402076721
    },
    {
      "sentence_id": 12,
      "text": "2. The case of the prosecution in a nutshell is that on 30.8.1995 at about 7.40 A.M., complainant C.\nL. Sikri, Government Food Inspector along with Dr. Vimal Shori, Medical Officer, C.H.C., Kalka,\nintercepted the accused at Nalagarh Road, Pinjore.",
      "rhetorical_role": "FAC",
      "start": 1131,
      "end": 1379,
      "entities": [
        {
          "text": "30.8.1995",
          "label": "DATE",
          "start": 1188,
          "end": 1197
        },
        {
          "text": "C.\nL. Sikri",
          "label": "PETITIONER",
          "start": 1230,
          "end": 1241
        },
        {
          "text": "Vimal Shori",
          "label": "WITNESS",
          "start": 1284,
          "end": 1295
        },
        {
          "text": "C.H.C., Kalka",
          "label": "ORG",
          "start": 1314,
          "end": 1327
        },
        {
          "text": "Pinjore",
          "label": "GPE",
          "start": 1371,
          "end": 1378
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.11657468229532242
    },
    {
      "sentence_id": 13,
      "text": "He was found in possession of about 20 1 of 5 Criminal Revision No. 1269 of 2008 (2) liters of cow milk for public sale contained in iron drum.",
      "rhetorical_role": "FAC",
      "start": 1380,
      "end": 1523,
      "entities": [
        {
          "text": "Criminal Revision No. 1269 of 2008",
          "label": "CASE_NUMBER",
          "start": 1426,
          "end": 1460
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2565612196922302
    },
    {
      "sentence_id": 14,
      "text": "The complainant expressed his intention to have the sample of cow milk.",
      "rhetorical_role": "FAC",
      "start": 1524,
      "end": 1596,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2380514144897461
    },
    {
      "sentence_id": 15,
      "text": "He purchased 750 milliliter.",
      "rhetorical_role": "FAC",
      "start": 1597,
      "end": 1625,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24467402696609497
    },
    {
      "sentence_id": 16,
      "text": "He paid the price of milk.",
      "rhetorical_role": "FAC",
      "start": 1626,
      "end": 1652,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.25819113850593567
    },
    {
      "sentence_id": 17,
      "text": "The sample was divided into three parts and bottled in three dry, clean and empty bottles.",
      "rhetorical_role": "FAC",
      "start": 1653,
      "end": 1743,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23768338561058044
    },
    {
      "sentence_id": 18,
      "text": "Two drops of 40% formalin per 25 milliliter of milk was added as preservative in each bottle.",
      "rhetorical_role": "FAC",
      "start": 1744,
      "end": 1837,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2350195199251175
    },
    {
      "sentence_id": 19,
      "text": "The bottles were stoppered tightly and sealed on the neck with thick paper.",
      "rhetorical_role": "FAC",
      "start": 1838,
      "end": 1913,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23780323565006256
    },
    {
      "sentence_id": 20,
      "text": "The ends of the paper were pasted with gum.",
      "rhetorical_role": "FAC",
      "start": 1914,
      "end": 1957,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23777948319911957
    },
    {
      "sentence_id": 21,
      "text": "A paper slip bearing the code and signature of the Local Health Authority, Kalka was pasted on each bottle from top to bottom.",
      "rhetorical_role": "FAC",
      "start": 1958,
      "end": 2084,
      "entities": [
        {
          "text": "Local Health Authority, Kalka",
          "label": "ORG",
          "start": 2009,
          "end": 2038
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2108585238456726
    },
    {
      "sentence_id": 22,
      "text": "Thumb impressions of the accused were obtained in such a manner that both the paper slip and the wrapper Paramjit Singh vs State Of Haryana on 31 May, 2019 Indian Kanoon - http://indiankanoon.org/doc/26899133/\n1 on each sealed bottle carry a part of his thumb impressions.",
      "rhetorical_role": "FAC",
      "start": 2085,
      "end": 2357,
      "entities": [
        {
          "text": "Paramjit Singh vs State Of Haryana",
          "label": "PRECEDENT",
          "start": 2190,
          "end": 2224
        },
        {
          "text": "31 May, 2019",
          "label": "DATE",
          "start": 2228,
          "end": 2240
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15475061535835266
    },
    {
      "sentence_id": 23,
      "text": "One bottle sample was sent to the Public Analyst, Haryana, Karnal along with memorandum in Form VII in a sealed cover through railway parcel.",
      "rhetorical_role": "FAC",
      "start": 2358,
      "end": 2499,
      "entities": [
        {
          "text": "Haryana",
          "label": "GPE",
          "start": 2408,
          "end": 2415
        },
        {
          "text": "Karnal",
          "label": "GPE",
          "start": 2417,
          "end": 2423
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18109306693077087
    },
    {
      "sentence_id": 24,
      "text": "Other two parts of the sample along with two copies of memo in Form VII bearing the seal impressions were handed over to Local Health Authority on 30.8.1995.",
      "rhetorical_role": "FAC",
      "start": 2500,
      "end": 2657,
      "entities": [
        {
          "text": "30.8.1995",
          "label": "DATE",
          "start": 2647,
          "end": 2656
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.22088751196861267
    },
    {
      "sentence_id": 25,
      "text": "Sample was analysed by the Public Analyst vide his report dated 9.10.1995.",
      "rhetorical_role": "FAC",
      "start": 2658,
      "end": 2732,
      "entities": [
        {
          "text": "9.10.1995",
          "label": "DATE",
          "start": 2722,
          "end": 2731
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23145365715026855
    },
    {
      "sentence_id": 26,
      "text": "The same did not conform to the standards laid down for the cow milk in the table.",
      "rhetorical_role": "FAC",
      "start": 2733,
      "end": 2815,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.30831214785575867
    },
    {
      "sentence_id": 27,
      "text": "The milk fat fell below minimum specified limit of 4% and the milk solids not fat fell below minimum specified limit of 8.5%.",
      "rhetorical_role": "FAC",
      "start": 2816,
      "end": 2941,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.38525390625
    },
    {
      "sentence_id": 28,
      "text": "The petitioner was ordered to be summoned for the commission of offence under Section 7 punishable under Section 16(1)(a)(i) of the Act.",
      "rhetorical_role": "FAC",
      "start": 2942,
      "end": 3078,
      "entities": [
        {
          "text": "Section 7",
          "label": "PROVISION",
          "start": 3020,
          "end": 3029
        },
        {
          "text": "Section 16(1)(a)(i)",
          "label": "PROVISION",
          "start": 3047,
          "end": 3066
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.47254034876823425
    },
    {
      "sentence_id": 29,
      "text": "The petitioner appeared in the Court and contested the case.",
      "rhetorical_role": "FAC",
      "start": 3079,
      "end": 3139,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3693057894706726
    },
    {
      "sentence_id": 30,
      "text": "3. The prosecution examined a number of witnesses in support of the case.",
      "rhetorical_role": "FAC",
      "start": 3140,
      "end": 3214,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.33905214071273804
    },
    {
      "sentence_id": 31,
      "text": "The statement of the accused was also recorded under Section 313 Cr.P.C.",
      "rhetorical_role": "FAC",
      "start": 3215,
      "end": 3287,
      "entities": [
        {
          "text": "Section 313",
          "label": "PROVISION",
          "start": 3268,
          "end": 3279
        },
        {
          "text": "Cr.P.C.",
          "label": "STATUTE",
          "start": 3280,
          "end": 3287
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3044529855251312
    },
    {
      "sentence_id": 32,
      "text": "According to him, he was falsely implicated.",
      "rhetorical_role": "FAC",
      "start": 3288,
      "end": 3332,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.32191959023475647
    },
    {
      "sentence_id": 33,
      "text": "He was convicted and 2 of 5 Criminal Revision No. 1269 of 2008 (3) sentenced by the learned trial Court vide judgment dated 23.11.2005, as noticed above.",
      "rhetorical_role": "FAC",
      "start": 3333,
      "end": 3486,
      "entities": [
        {
          "text": "Criminal Revision No. 1269 of 2008 (3)",
          "label": "CASE_NUMBER",
          "start": 3361,
          "end": 3399
        },
        {
          "text": "23.11.2005",
          "label": "DATE",
          "start": 3457,
          "end": 3467
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5221698880195618
    },
    {
      "sentence_id": 34,
      "text": "The learned Additional Sessions Judge vide judgment dated 17.7.2008 dismissed the appeal and upheld the conviction and sentence awarded by the learned trial Court.",
      "rhetorical_role": "RLC",
      "start": 3487,
      "end": 3650,
      "entities": [
        {
          "text": "17.7.2008",
          "label": "DATE",
          "start": 3545,
          "end": 3554
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3135238587856293
    },
    {
      "sentence_id": 35,
      "text": "Hence, the present criminal revision.",
      "rhetorical_role": "FAC",
      "start": 3651,
      "end": 3688,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.27309104800224304
    },
    {
      "sentence_id": 36,
      "text": "4. Learned counsel appearing on behalf of the petitioner vehemently argued that the prosecution has failed to prove its case.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3690,
      "end": 3815,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.22134684026241302
    },
    {
      "sentence_id": 37,
      "text": "Learned counsel appearing for the State vehemently argued that the prosecution has proved its case beyond reasonable doubt and supported the judgment and order of the learned Court below.\n5.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3816,
      "end": 4006,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.18819183111190796
    },
    {
      "sentence_id": 38,
      "text": "I have heard learned counsel for the parties and gone through the judgments and record very carefully.",
      "rhetorical_role": "NONE",
      "start": 4007,
      "end": 4109,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 39,
      "text": "6. Learned counsel for the State has placed reliance upon the testimony of PW1 C. L. Sikri.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4111,
      "end": 4202,
      "entities": [
        {
          "text": "C. L. Sikri",
          "label": "WITNESS",
          "start": 4190,
          "end": 4201
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.14729087054729462
    },
    {
      "sentence_id": 40,
      "text": "He was the complainant.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4203,
      "end": 4226,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.22188182175159454
    },
    {
      "sentence_id": 41,
      "text": "He took the sample of the cow milk.",
      "rhetorical_role": "ANALYSIS",
      "start": 4227,
      "end": 4262,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2797147333621979
    },
    {
      "sentence_id": 42,
      "text": "He has supported the averments made in the complaint.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4263,
      "end": 4316,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.16623921692371368
    },
    {
      "sentence_id": 43,
      "text": "According to him, he was posted as GFI in Tehsil Kalka.",
      "rhetorical_role": "ANALYSIS",
      "start": 4317,
      "end": 4372,
      "entities": [
        {
          "text": "Kalka",
          "label": "GPE",
          "start": 4366,
          "end": 4371
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1095622107386589
    },
    {
      "sentence_id": 44,
      "text": "He accompanied by PW2 Dr.\nVimal Shori, went to Nalagarh-Pinjore Road.",
      "rhetorical_role": "FAC",
      "start": 4373,
      "end": 4442,
      "entities": [
        {
          "text": "Vimal Shori",
          "label": "WITNESS",
          "start": 4399,
          "end": 4410
        },
        {
          "text": "Nalagarh-Pinjore",
          "label": "GPE",
          "start": 4420,
          "end": 4436
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.23266096413135529
    },
    {
      "sentence_id": 45,
      "text": "He intercepted the accused.",
      "rhetorical_role": "FAC",
      "start": 4443,
      "end": 4470,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.29892587661743164
    },
    {
      "sentence_id": 46,
      "text": "He was in possession of 20 liters of cow milk contained in two drums, for human consumption.",
      "rhetorical_role": "FAC",
      "start": 4471,
      "end": 4563,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.30894798040390015
    },
    {
      "sentence_id": 47,
      "text": "PW Gurnam Singh was also joined in the process.",
      "rhetorical_role": "FAC",
      "start": 4564,
      "end": 4611,
      "entities": [
        {
          "text": "Gurnam Singh",
          "label": "WITNESS",
          "start": 4567,
          "end": 4579
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2371637225151062
    },
    {
      "sentence_id": 48,
      "text": "A notice, Ex.PA, was served upon the petitioner.",
      "rhetorical_role": "FAC",
      "start": 4612,
      "end": 4660,
      "entities": [],
