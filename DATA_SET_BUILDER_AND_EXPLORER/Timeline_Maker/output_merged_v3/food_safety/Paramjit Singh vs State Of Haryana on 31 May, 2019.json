      "end": 4906,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.29949820041656494
    },
    {
      "sentence_id": 55,
      "text": "The same was not found to be conforming to the standards laid down for the cow milk in the table.",
