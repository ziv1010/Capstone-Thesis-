          "end": 660
        },
        {
          "text": "Patiala House Court, New Delhi",
          "label": "COURT",
          "start": 675,
          "end": 705
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 6,
      "text": "2 The brief facts of the case as per record and from trial Virender Kumar Vs. State  court record",
      "rhetorical_role": "NONE",
      "start": 707,
      "end": 805,
      "entities": [
        {
          "text": "Virender Kumar Vs. State  court record",
          "label": "PRECEDENT",
          "start": 767,
          "end": 805
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "are that accused is running an establishment namely M/s Aggarwal Super Store, at C-131A, Thana Road, Gali No. 5, Bhajan Pura, Delhi.",
      "rhetorical_role": "FAC",
      "start": 806,
      "end": 938,
      "entities": [
        {
          "text": "Aggarwal Super Store",
          "label": "ORG",
          "start": 862,
          "end": 882
        },
        {
          "text": "Bhajan Pura",
          "label": "GPE",
          "start": 919,
          "end": 930
        },
        {
          "text": "Delhi",
          "label": "GPE",
          "start": 932,
          "end": 937
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.0757162794470787
    },
    {
      "sentence_id": 8,
      "text": "On 17.12.2002 at about 5.30 p.m. Food Inspector Sh. Suniti Kumar Gupta visited the said place and purchased 750 grams of \"Dal Arhar\"\n(ready for sale) from accused.",
      "rhetorical_role": "FAC",
      "start": 939,
      "end": 1102,
      "entities": [
        {
          "text": "17.12.2002",
          "label": "DATE",
          "start": 942,
          "end": 952
        },
        {
          "text": "Suniti Kumar Gupta",
          "label": "WITNESS",
          "start": 991,
          "end": 1009
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21663746237754822
    },
    {
      "sentence_id": 9,
      "text": "FI was accompanied with SDM/LHA Sh. P. C. Jain.",
      "rhetorical_role": "FAC",
      "start": 1103,
      "end": 1150,
      "entities": [
        {
          "text": "P. C. Jain",
          "label": "OTHER_PERSON",
          "start": 1139,
          "end": 1149
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.11113906651735306
    },
    {
      "sentence_id": 10,
      "text": "The said Dal Arhar was purchased for the purposes of analysis under PFA Act.",
      "rhetorical_role": "FAC",
      "start": 1151,
      "end": 1227,
      "entities": [
        {
          "text": "PFA Act",
          "label": "STATUTE",
          "start": 1219,
          "end": 1226
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.37942805886268616
    },
    {
      "sentence_id": 11,
      "text": "The same sample was divided into three parts, packed as per Rules of PFA.",
      "rhetorical_role": "FAC",
      "start": 1228,
      "end": 1301,
      "entities": [
        {
          "text": "PFA",
          "label": "STATUTE",
          "start": 1297,
          "end": 1300
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3037005066871643
    },
    {
      "sentence_id": 12,
      "text": "Panchanama was prepared.",
      "rhetorical_role": "FAC",
      "start": 1302,
      "end": 1326,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19893154501914978
    },
    {
      "sentence_id": 13,
      "text": "One sample was sent for analysis to Public Analyst.",
      "rhetorical_role": "FAC",
      "start": 1327,
      "end": 1378,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.33493685722351074
    },
    {
      "sentence_id": 14,
      "text": "As per the report of Analyst, sample did not confirm to the standard because \"The sample is adulterated because it is coloured with synthetic colouring matter viz.\ntartrazine.\"",
      "rhetorical_role": "FAC",
      "start": 1379,
      "end": 1555,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3079538941383362
    },
    {
      "sentence_id": 15,
      "text": "3 As the sample was failed, prosecution was launched by Food Inspector by filing complaint dated 16.04.2003 with the court.",
      "rhetorical_role": "FAC",
      "start": 1557,
      "end": 1680,
      "entities": [
        {
          "text": "16.04.2003",
          "label": "DATE",
          "start": 1654,
          "end": 1664
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.4241228997707367
    },
    {
      "sentence_id": 16,
      "text": "Accused was summoned.",
      "rhetorical_role": "FAC",
      "start": 1681,
      "end": 1702,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3258008360862732
    },
    {
      "sentence_id": 17,
      "text": "He has not exercised his right u/sec.13(2) PFA Act and get the sample analyzed by CFL.",
      "rhetorical_role": "FAC",
      "start": 1703,
      "end": 1789,
      "entities": [
        {
          "text": "sec.13(2)",
          "label": "PROVISION",
          "start": 1736,
          "end": 1745
        },
        {
          "text": "PFA Act",
          "label": "STATUTE",
          "start": 1746,
          "end": 1753
        },
        {
          "text": "CFL",
          "label": "ORG",
          "start": 1785,
          "end": 1788
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.565540611743927
    },
    {
      "sentence_id": 18,
      "text": "Virender Kumar vs The State (Da) on 23 September, 2016 Indian Kanoon - http://indiankanoon.org/doc/168919922/\n1 4",
      "rhetorical_role": "FAC",
      "start": 1790,
      "end": 1904,
      "entities": [
        {
          "text": "Virender Kumar vs The State (Da)",
          "label": "PRECEDENT",
          "start": 1791,
          "end": 1823
        },
        {
          "text": "23 September, 2016",
          "label": "DATE",
          "start": 1827,
          "end": 1845
        },
        {
          "text": "Indian Kanoon",
          "label": "OTHER_PERSON",
          "start": 1846,
          "end": 1859
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.5833223462104797
    },
    {
      "sentence_id": 19,
      "text": "Charge was framed against accused u/sec.2(ia) (a) (j)\n(m) read with sec.7 of PFA Act, 1954 punishable u/sec.16(1A) of PFA Act.",
      "rhetorical_role": "FAC",
      "start": 1905,
      "end": 2031,
      "entities": [
        {
          "text": "sec.2(ia) (a) (j)\n(m) read with sec.7",
          "label": "PROVISION",
          "start": 1941,
          "end": 1978
        },
        {
          "text": "PFA Act, 1954",
          "label": "STATUTE",
          "start": 1982,
          "end": 1995
        },
        {
          "text": "sec.16(1A)",
          "label": "PROVISION",
          "start": 2009,
          "end": 2019
        },
        {
          "text": "PFA Act",
          "label": "STATUTE",
          "start": 2023,
          "end": 2030
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.41232722997665405
    },
    {
      "sentence_id": 20,
      "text": "5 After trial, vide judgment dated 21.03.2013 accused was convicted for offence u/sec.16(1A) of PFA Act and vide order Virender Kumar Vs. State on sentence dated 28.03.2013,\naccused was directed to undergo simple imprisonment for a period of 1 year and fine of Rs.2,000/-\nand in default of payment of fine SI of 1 month.",
      "rhetorical_role": "RLC",
      "start": 2033,
      "end": 2353,
      "entities": [
        {
          "text": "21.03.2013",
          "label": "DATE",
          "start": 2068,
          "end": 2078
        },
        {
          "text": "sec.16(1A)",
          "label": "PROVISION",
          "start": 2115,
          "end": 2125
        },
        {
          "text": "PFA Act",
          "label": "STATUTE",
          "start": 2129,
          "end": 2136
        },
        {
          "text": "Virender Kumar Vs. State",
          "label": "PRECEDENT",
          "start": 2152,
          "end": 2176
        },
        {
          "text": "28.03.2013",
          "label": "DATE",
          "start": 2195,
          "end": 2205
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3627963066101074
    },
    {
      "sentence_id": 21,
      "text": "6 In this appeal, the accused has assailed the judgment on the following grounds:-\n(i) Non-compliance of Sec.10(7) of PFA Act and Rule i.e. independent witnesses were not joined.",
      "rhetorical_role": "FAC",
      "start": 2355,
      "end": 2533,
      "entities": [
        {
          "text": "Sec.10(7)",
          "label": "PROVISION",
          "start": 2460,
          "end": 2469
        },
        {
          "text": "PFA Act",
          "label": "STATUTE",
          "start": 2473,
          "end": 2480
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.24055373668670654
    },
    {
      "sentence_id": 22,
      "text": "(ii) Non-compliance of Rule 14 of PFA Rules i.e. the bottles, jhawa, polythene were not made clean and dried at the spot by the food inspector or any other official.",
      "rhetorical_role": "FAC",
      "start": 2534,
      "end": 2700,
      "entities": [
        {
          "text": "Rule 14",
          "label": "PROVISION",
          "start": 2558,
          "end": 2565
        },
        {
          "text": "PFA Rules",
          "label": "STATUTE",
          "start": 2569,
          "end": 2578
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.274118572473526
    },
    {
      "sentence_id": 23,
      "text": "(iii) Percentage of colour is not mentioned by any of the reports and thus benefit goes in favour of accused.",
      "rhetorical_role": "FAC",
      "start": 2701,
      "end": 2811,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.27063652873039246
    },
    {
      "sentence_id": 24,
      "text": "(iv) The adulteration of Dal Arhar with used colour falls in the category of misbranding and not adulteration.",
      "rhetorical_role": "FAC",
      "start": 2812,
      "end": 2923,
      "entities": [
        {
          "text": "Dal Arhar",
          "label": "OTHER_PERSON",
          "start": 2838,
          "end": 2847
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3260136544704437
    },
    {
      "sentence_id": 25,
      "text": "7 No reply was filed by respondent/state and the matter was argued orally.",
      "rhetorical_role": "FAC",
      "start": 2925,
      "end": 2999,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1587618887424469
    },
    {
      "sentence_id": 26,
      "text": "8 I have gone through the record, Trial Court record and have heard the submissions of Ld. counsel for appellant and Ld. SPP for State.",
      "rhetorical_role": "NONE",
      "start": 3001,
      "end": 3136,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 27,
      "text": "9 It is argued by counsel for appellant that no public witness was present in the proceedings nor efforts were made to join any public witnesses.",
      "rhetorical_role": "ANALYSIS",
      "start": 3138,
      "end": 3283,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.10570816695690155
    },
    {
      "sentence_id": 28,
      "text": "As far as this argument is concerned, I have gone through the record.",
      "rhetorical_role": "ANALYSIS",
      "start": 3284,
      "end": 3353,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.048895951360464096
    },
    {
      "sentence_id": 29,
      "text": "In this case, it is deposed by all the PWs that they had made efforts to join independent witness Virender Kumar Vs. State before the start of the proceedings.",
      "rhetorical_role": "ANALYSIS",
      "start": 3354,
      "end": 3513,
      "entities": [
        {
          "text": "Virender Kumar Vs. State",
          "label": "PRECEDENT",
          "start": 3452,
          "end": 3476
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.07962696254253387
    },
    {
      "sentence_id": 30,
      "text": "As no one agreed, FA Manohar Lal was joined as witness.",
      "rhetorical_role": "ANALYSIS",
      "start": 3514,
      "end": 3569,
      "entities": [
        {
          "text": "Manohar Lal",
          "label": "WITNESS",
          "start": 3535,
          "end": 3546
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.0792158842086792
    },
    {
      "sentence_id": 31,
      "text": "No cross-examination is done on this aspect.",
      "rhetorical_role": "ANALYSIS",
      "start": 3570,
      "end": 3614,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.07806721329689026
    },
    {
      "sentence_id": 32,
      "text": "So, I do not find any force in this argument.",
      "rhetorical_role": "ANALYSIS",
      "start": 3615,
      "end": 3660,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.0369081012904644
    },
    {
      "sentence_id": 33,
      "text": "Hence that part of judgment is upheld and the submissions forwarded by Ld. counsel for appellant are rejected.",
      "rhetorical_role": "ANALYSIS",
      "start": 3661,
      "end": 3771,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.05583665147423744
    },
    {
      "sentence_id": 34,
      "text": "10 It is further stated that percentage of colour is not mentioned by any of the reports and thus benefit goes in favour of accused.",
      "rhetorical_role": "ANALYSIS",
      "start": 3773,
      "end": 3905,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.16205677390098572
    },
    {
      "sentence_id": 35,
      "text": "As far as the commodity is concerned i.e. Dal Arhar, as per Sec.29 PFA Rules, the use of colour is totally banned.",
      "rhetorical_role": "ANALYSIS",
      "start": 3906,
      "end": 4020,
      "entities": [
        {
          "text": "Dal Arhar",
          "label": "OTHER_PERSON",
          "start": 3948,
          "end": 3957
        },
        {
          "text": "Sec.29",
          "label": "PROVISION",
          "start": 3966,
          "end": 3972
        },
        {
          "text": "PFA Rules",
          "label": "STATUTE",
          "start": 3973,
          "end": 3982
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3439534306526184
    },
    {
      "sentence_id": 36,
      "text": "So, even if a traces of colour is found in the Dal, the same can be termed as adulterated.",
      "rhetorical_role": "ANALYSIS",
      "start": 4021,
      "end": 4111,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4666437804698944
    },
    {
      "sentence_id": 37,
      "text": "So, there is no need for giving percentage of colour by the scientist i.e. PA or CFL.",
      "rhetorical_role": "ANALYSIS",
      "start": 4112,
      "end": 4197,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4588850140571594
    },
    {
      "sentence_id": 38,
      "text": "Moreover, the non- compliance falls under the violation of adulteration and not misbranding.",
      "rhetorical_role": "ANALYSIS",
      "start": 4198,
      "end": 4290,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5397301316261292
    },
    {
      "sentence_id": 39,
      "text": "Virender Kumar vs The State (Da) on 23 September, 2016 Indian Kanoon - http://indiankanoon.org/doc/168919922/\n2 11",
      "rhetorical_role": "ANALYSIS",
      "start": 4291,
      "end": 4406,
      "entities": [
        {
          "text": "Virender Kumar vs The State (Da)",
          "label": "PRECEDENT",
          "start": 4292,
          "end": 4324
        },
        {
          "text": "23 September, 2016",
          "label": "DATE",
          "start": 4328,
          "end": 4346
        },
        {
          "text": "Indian Kanoon",
          "label": "OTHER_PERSON",
          "start": 4347,
          "end": 4360
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.508372962474823
    },
    {
      "sentence_id": 40,
      "text": "It is further argued that compliance u/sec.14 PFA Rules was not proved on record by the prosecution.",
      "rhetorical_role": "ANALYSIS",
      "start": 4407,
      "end": 4507,
      "entities": [
        {
          "text": "sec.14",
          "label": "PROVISION",
          "start": 4446,
          "end": 4452
        },
        {
          "text": "PFA Rules",
          "label": "STATUTE",
          "start": 4453,
          "end": 4462
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.17553402483463287
    },
    {
      "sentence_id": 41,
      "text": "It is stated that witnesses are deposing differently with respect to the cleanliness of jhaba etc.",
      "rhetorical_role": "ANALYSIS",
      "start": 4508,
      "end": 4606,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.150349423289299
    },
    {
      "sentence_id": 42,
      "text": "It is further stated that it was the duty of the prosecution to prove these facts.",
      "rhetorical_role": "ANALYSIS",
      "start": 4607,
      "end": 4689,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1302940994501114
    },
    {
      "sentence_id": 43,
      "text": "These arguments were also addressed before the trial court.",
      "rhetorical_role": "ANALYSIS",
      "start": 4690,
      "end": 4749,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.0814797431230545
    },
    {
      "sentence_id": 44,
      "text": "12 As far as the arguments in this regard is concerned, the law discussed by the trial court is correct and the same is self Virender Kumar Vs. State explanatory.",
      "rhetorical_role": "ANALYSIS",
      "start": 4751,
      "end": 4913,
      "entities": [
        {
          "text": "Virender Kumar Vs. State",
          "label": "PRECEDENT",
          "start": 4876,
          "end": 4900
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.06247157230973244
    },
    {
      "sentence_id": 45,
      "text": "However, as far as the analysis of facts are concerned, to my opinion, the same requires some more elaboration.",
      "rhetorical_role": "ANALYSIS",
      "start": 4914,
      "end": 5025,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.10012181103229523
    },
    {
      "sentence_id": 46,
      "text": "13 As far as Rule 14 of PFA Rules are concerned, it spells out that the FI shall use dry bottles or containers for the purposes of sampling.",
      "rhetorical_role": "ANALYSIS",
      "start": 5027,
      "end": 5167,
      "entities": [
        {
          "text": "Rule 14",
          "label": "PROVISION",
          "start": 5040,
          "end": 5047
        },
        {
          "text": "PFA Rules",
          "label": "STATUTE",
          "start": 5051,
          "end": 5060
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.28737151622772217
    },
    {
      "sentence_id": 47,
      "text": "However, this fact was elaborated further by Hon. Supreme Court in Varghese Vs. Food, 1989 (II) Prevention of Food Adulteration Cases, 236 stating that \"it must be the endeavour of the FI to use clean and dry implements in sampling the articles of food.",
      "rhetorical_role": "PRE_RELIED",
      "start": 5168,
      "end": 5421,
      "entities": [
        {
          "text": "Supreme Court",
          "label": "COURT",
          "start": 5218,
          "end": 5231
        },
        {
          "text": "Varghese Vs. Food, 1989 (II) Prevention of Food Adulteration Cases, 236",
          "label": "PRECEDENT",
          "start": 5235,
          "end": 5306
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1614631563425064
    },
    {
      "sentence_id": 48,
      "text": "If unhygienic methods are adopted, it will effect the result of analysis.",
      "rhetorical_role": "PRE_RELIED",
      "start": 5422,
      "end": 5495,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.07775213569402695
    },
    {
      "sentence_id": 49,
      "text": "So, the Hon. Supreme Court use the word \"implements\" instead of only \"dry and clean bottles/containers\".",
      "rhetorical_role": "PRE_RELIED",
      "start": 5496,
      "end": 5600,
      "entities": [
        {
          "text": "Supreme Court",
          "label": "COURT",
          "start": 5509,
          "end": 5522
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.07576072216033936
    },
    {
      "sentence_id": 50,
      "text": "Similarly, in other judgments, i.e. State of Haryana Vs. Kishan Kumar CLT 559, it was observed that the prosecution had not stated that the \"weighing scale\" was clean.",
      "rhetorical_role": "PRE_RELIED",
      "start": 5601,
      "end": 5768,
      "entities": [
        {
          "text": "State of Haryana Vs. Kishan Kumar CLT 559",
          "label": "PRECEDENT",
          "start": 5637,
          "end": 5678
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.16188456118106842
    },
    {
      "sentence_id": 51,
      "text": "Similarly, in other judgments, like Sardar Mal Jain, 1996 (2) Prevention of Food Adulteration Cases, 203, it was stated that the newspaper on which the Barfi was weighed was not clean.",
      "rhetorical_role": "PRE_RELIED",
      "start": 5769,
      "end": 5953,
      "entities": [
        {
          "text": "Sardar Mal Jain, 1996 (2) Prevention of Food Adulteration Cases, 203",
          "label": "PRECEDENT",
          "start": 5805,
          "end": 5873
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.12657904624938965
    },
    {
      "sentence_id": 52,
      "text": "Similarly, in Shashi Kant Vs. State of UP, 1983 (1)\nPrevention of Food Adulteration Cases 90, it was observed that the \"bhagona\" was not proved to be clean and dry.",
      "rhetorical_role": "PRE_RELIED",
      "start": 5954,
      "end": 6118,
      "entities": [
        {
          "text": "Shashi Kant Vs. State of UP, 1983 (1)\nPrevention of Food Adulteration Cases 90",
          "label": "PRECEDENT",
          "start": 5968,
          "end": 6046
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.23791687190532684
    },
    {
      "sentence_id": 53,
      "text": "Similarly, in 2008 (3) RCR (Criminal) 422 Rajinder Kumar Vs. State of Haryana (Punjab and Haryana), it was held by the court that when an envelop is used for  Virender Kumar Vs. State weighing the sample commodity, the same must be proved as clean and free from any impurity.",
      "rhetorical_role": "PRE_RELIED",
      "start": 6119,
      "end": 6394,
      "entities": [
        {
          "text": "2008 (3) RCR (Criminal) 422 Rajinder Kumar Vs. State of Haryana (Punjab and Haryana)",
          "label": "PRECEDENT",
          "start": 6133,
          "end": 6217
        },
        {
          "text": "Virender Kumar Vs. State",
          "label": "PRECEDENT",
          "start": 6278,
          "end": 6302
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2617802321910858
    },
    {
      "sentence_id": 54,
      "text": "14 So, accordingly, it can be said that the law which can be crystallized from various judgments of Hon. High Courts as well as Hon. Supreme Court is that if in evidence, the prosecution states that the sample commodity had touched a surface of an \"implement\", it is the duty of the prosecution to prove beyond reasonable doubt that the said implement was clean and dry and thus could not have added any impurity to the sample.",
      "rhetorical_role": "PRE_RELIED",
      "start": 6396,
      "end": 6823,
      "entities": [
        {
          "text": "Supreme Court",
          "label": "COURT",
          "start": 6529,
          "end": 6542
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3138270080089569
    },
    {
      "sentence_id": 55,
      "text": "However, it is not the law that the FI shall spell out on which surfaces the sample commodity had touched while sampling.",
      "rhetorical_role": "ANALYSIS",
      "start": 6824,
      "end": 6945,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6469462513923645
    },
    {
      "sentence_id": 56,
      "text": "However, if he chooses to spell out the implements/surfaces with which the sample commodity came into contact/touch, the same must be proved as clean and dry.",
      "rhetorical_role": "RATIO",
      "start": 6946,
      "end": 7104,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6610667705535889
    },
    {
      "sentence_id": 57,
      "text": "15 In the present case, the PW2/FI Suniti Kumar Gupta had stated in his cross-examination dated 24.02.2009 that the Dal was weighed after putting in a brown paper.",
      "rhetorical_role": "RATIO",
      "start": 7106,
      "end": 7269,
      "entities": [
        {
          "text": "Suniti Kumar Gupta",
          "label": "WITNESS",
          "start": 7141,
          "end": 7159
        },
        {
          "text": "24.02.2009",
          "label": "DATE",
          "start": 7202,
          "end": 7212
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.36474505066871643
    },
    {
      "sentence_id": 58,
      "text": "Nowhere this witness or any other witness by the prosecution had proved on record that this brown paper was clean and free from colour and could not have added any colour to the Dal.",
      "rhetorical_role": "RATIO",
      "start": 7270,
      "end": 7452,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.45932358503341675
    },
    {
      "sentence_id": 59,
      "text": "16 So, in these circumstances, there is violation of Rule 14 of PFA Rules and thus the benefit goes in favour of appellant.",
      "rhetorical_role": "RATIO",
      "start": 7454,
      "end": 7577,
      "entities": [
        {
          "text": "Rule 14",
          "label": "PROVISION",
          "start": 7507,
          "end": 7514
        },
        {
          "text": "PFA Rules",
          "label": "STATUTE",
          "start": 7518,
          "end": 7527
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5649210810661316
    },
    {
      "sentence_id": 60,
      "text": "Virender Kumar Vs. State 17",
      "rhetorical_role": "NONE",
      "start": 7578,
      "end": 7607,
      "entities": [
        {
          "text": "Virender Kumar Vs. State 17",
          "label": "PRECEDENT",
          "start": 7580,
          "end": 7607
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 61,
      "text": "So, in these circumstances, the judgment and order on sentence of the trial court is reversed.",
      "rhetorical_role": "RPC",
      "start": 7608,
      "end": 7702,
      "entities": [],
      "in_summary": true,
