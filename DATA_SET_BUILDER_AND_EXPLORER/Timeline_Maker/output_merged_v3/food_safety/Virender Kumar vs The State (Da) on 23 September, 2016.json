      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 5,
      "text": "1 By this judgment I will dispose of appeal u/sec.374 Cr.PC. filed on behalf of convict Virender Kumar against the judgment dated 21.03.2013 and order on sentence dated 28.03.2013 passed by Sh. Balwant Rai Bansal, Ld. ACMM-II, Patiala House Court, New Delhi.",
      "rhetorical_role": "PREAMBLE",
      "start": 448,
      "end": 706,
      "entities": [
        {
          "text": "sec.374",
          "label": "PROVISION",
          "start": 494,
          "end": 501
        },
        {
          "text": "Cr.PC",
          "label": "STATUTE",
          "start": 502,
          "end": 507
        },
        {
          "text": "Virender Kumar",
          "label": "PETITIONER",
          "start": 536,
          "end": 550
        },
        {
          "text": "21.03.2013",
