  "texts": {
    "preamble": "Crlp/7208/2021 on 22 April, 2022 Author: D. Ramesh Bench: D. Ramesh The Honourable Sri Justice D. Ramesh Criminal Petition No.7208 Of 2021 Order:",
    "facts": "",
    "arguments": "Learned counsel for the petitioner would submit that this is a covered matter in view of the earlier common order passed by this Court in Criminal Petition Nos.5421 of 2019 and batch, whereby this Court has [LEAKAGE_MASK] several F.I.Rs registered for the similar offences based on identical facts. Therefore, he would submit that the petitioner is similarly placed and she is also entitled for quash of the F.I.R registered against her. 4. Learned Additional Public Prosecutor fairly concedes that this is a covered matter in view of the aforesaid common order passed by this Court and thereby prayed to pass appropriate orders, accordingly in this Criminal Petition. 5.",
    "petitioner_arguments": "Learned counsel for the petitioner would submit that this is a covered matter in view of the earlier common order passed by this Court in Criminal Petition Nos.5421 of 2019 and batch, whereby this Court has [LEAKAGE_MASK] several F.I.Rs registered for the similar offences based on identical facts. Therefore, he would submit that the petitioner is similarly placed and she is also entitled for quash of the F.I.R registered against her. 4. Learned Additional Public Prosecutor fairly concedes that this is a covered matter in view of the aforesaid common order passed by this Court and thereby prayed to pass appropriate orders, accordingly in this Criminal Petition. 5.",
    "respondent_arguments": "",
    "other_lawyer_arguments": ""
  },
