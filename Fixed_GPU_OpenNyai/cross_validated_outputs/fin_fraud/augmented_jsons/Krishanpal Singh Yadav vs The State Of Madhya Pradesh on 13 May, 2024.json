          "end": 1050
        },
        {
          "text": "Sections 420",
          "label": "PROVISION",
          "start": 1088,
          "end": 1100
        },
        {
          "text": "467",
          "label": "PROVISION",
          "start": 1102,
          "end": 1105
        },
        {
          "text": "468",
          "label": "PROVISION",
          "start": 1107,
          "end": 1110
        },
        {
          "text": "471",
          "label": "PROVISION",
          "start": 1112,
          "end": 1115
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 1119,
          "end": 1122
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.3241163194179535
    },
    {
      "sentence_id": 12,
      "text": "As per the case of prosecution, Gaurishankar Rajput submitted a written complaint to SHO, PS Bhitarwar that certain persons including applicant Krishna Pal Singh Yadav have availed benefit of appointment on the post of Samvida Shala Shikshak Grade-III on the basis of forged mark-sheet.",
      "rhetorical_role": "FAC",
      "start": 1124,
      "end": 1411,
      "entities": [
        {
          "text": "Gaurishankar Rajput",
          "label": "OTHER_PERSON",
          "start": 1157,
          "end": 1176
        },
        {
          "text": "PS Bhitarwar",
          "label": "ORG",
          "start": 1215,
          "end": 1227
        },
        {
          "text": "Krishna Pal Singh Yadav",
          "label": "PETITIONER",
          "start": 1269,
          "end": 1292
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2929702401161194
    },
    {
      "sentence_id": 13,
      "text": "An enquiry was conducted on complaint.",
      "rhetorical_role": "FAC",
      "start": 1412,
      "end": 1450,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.29424768686294556
    },
    {
      "sentence_id": 14,
      "text": "It was found that forged mark-sheet of Diploma in Education (D.Ed.) Year 2006 Roll No.2198387 was submitted by applicant Krishna Pal Singh Yadav as he had never taken admission for academic year 2005-06 at concerned Institute.",
      "rhetorical_role": "FAC",
      "start": 1451,
      "end": 1677,
      "entities": [
        {
          "text": "Krishna Pal Singh Yadav",
          "label": "PETITIONER",
          "start": 1572,
          "end": 1595
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2909940183162689
    },
    {
      "sentence_id": 15,
      "text": "It was found that the Krishanpal Singh Yadav vs The State Of Madhya Pradesh on 13 May, 2024 Indian Kanoon - http://indiankanoon.org/doc/24901178/\n1 mark-sheet attached in the application form by applicant Krishna Pal Singh Yadav for getting the job was found to be fake and forged.",
      "rhetorical_role": "FAC",
      "start": 1678,
      "end": 1959,
      "entities": [
        {
          "text": "Krishanpal Singh Yadav vs The State Of Madhya Pradesh on 13 May, 2024 Indian Kanoon",
          "label": "PRECEDENT",
          "start": 1700,
          "end": 1783
        },
        {
          "text": "Krishna Pal Singh Yadav",
          "label": "PETITIONER",
          "start": 1883,
          "end": 1906
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.26663365960121155
    },
    {
      "sentence_id": 16,
      "text": "On such allegations, PS Bhitarwar registered FIR at Crime No.604 of 2023 for offence punishable U/s 420, 467, 468 and 471 of IPC against applicant Krishna Pal Singh Yadav and seven others.",
      "rhetorical_role": "FAC",
      "start": 1960,
      "end": 2148,
      "entities": [
        {
          "text": "PS Bhitarwar",
          "label": "ORG",
          "start": 1981,
          "end": 1993
        },
        {
          "text": "Crime No.604 of 2023",
          "label": "CASE_NUMBER",
          "start": 2012,
          "end": 2032
        },
        {
          "text": "s 420",
          "label": "PROVISION",
          "start": 2058,
          "end": 2063
        },
        {
          "text": "467",
          "label": "PROVISION",
          "start": 2065,
          "end": 2068
        },
        {
          "text": "468",
          "label": "PROVISION",
          "start": 2070,
          "end": 2073
        },
        {
          "text": "471",
          "label": "PROVISION",
          "start": 2078,
          "end": 2081
        },
        {
          "text": "IPC",
          "label": "STATUTE",
          "start": 2085,
          "end": 2088
        },
        {
          "text": "Krishna Pal Singh Yadav",
          "label": "PETITIONER",
          "start": 2107,
          "end": 2130
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2763439118862152
    },
    {
      "sentence_id": 17,
      "text": "Statement of witnesses have been recorded.",
      "rhetorical_role": "FAC",
      "start": 2149,
      "end": 2191,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.17174872756004333
    },
    {
      "sentence_id": 18,
      "text": "Relevant record has been seized.",
      "rhetorical_role": "FAC",
      "start": 2192,
      "end": 2224,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.14632675051689148
    },
    {
      "sentence_id": 19,
      "text": "Investigation is underway.",
      "rhetorical_role": "FAC",
      "start": 2225,
      "end": 2251,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1466509848833084
    },
    {
      "sentence_id": 20,
      "text": "Learned Counsel for the applicant, in addition to the grounds mentioned in the application, submits that as per the service record of applicant, he had never claimed that he had applied for Diploma in Education and he has not submitted any such mark-sheet.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2253,
      "end": 2509,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2513664960861206
    },
    {
      "sentence_id": 21,
      "text": "Learned counsel referring to Madhya Pradesh Panchayat Samvida Shala Shikshak (Employment and Conditions of Contract) Rules, 2005 submits that the applicant was working as Samvida Shala Shikshak Grade- III.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2510,
      "end": 2715,
      "entities": [
        {
          "text": "Madhya Pradesh Panchayat Samvida Shala Shikshak (Employment and Conditions of Contract) Rules, 2005",
          "label": "ORG",
          "start": 2539,
          "end": 2638
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.30709168314933777
    },
    {
      "sentence_id": 22,
      "text": "For appointment on such post, applicant had submitted the requisite qualifications which are genuine and he was selected on the basis of merit.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2716,
      "end": 2859,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.3081025779247284
    },
    {
      "sentence_id": 23,
      "text": "Referring to service book and e.service book of applicant, learned Counsel submits that there is no mention of Diploma in Education Year 2005-06 in it.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2860,
      "end": 3011,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.04823356494307518
    },
    {
      "sentence_id": 24,
      "text": "Applicant is falsely implicated in this matter by RTI activist Gauri Shankar due to previous enmity.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3012,
      "end": 3112,
      "entities": [
        {
          "text": "Gauri Shankar",
          "label": "OTHER_PERSON",
          "start": 3075,
          "end": 3088
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.21923330426216125
    },
    {
      "sentence_id": 25,
      "text": "The applicant was working as Teacher.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3113,
      "end": 3150,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3524424433708191
    },
    {
      "sentence_id": 26,
      "text": "No criminal antecedent is reported against him.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3151,
      "end": 3198,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.31309774518013
    },
    {
      "sentence_id": 27,
      "text": "The applicant will cooperate in the investigation, therefore, he may be extended benefit of anticipatory bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3199,
      "end": 3309,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3347829580307007
    },
    {
      "sentence_id": 28,
      "text": "P e r contra, learned counsel for the State opposes anticipatory bail application and submits that the complainant has submitted the application of the applicant under RTI Act duly verified by the Public Information Officer of Janpad Panchayat, Bhitarwar, alongwith one mark-sheet of D.Ed for academic year 2006.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3311,
      "end": 3623,
      "entities": [
        {
          "text": "RTI Act",
          "label": "STATUTE",
          "start": 3479,
          "end": 3486
        },
        {
          "text": "Janpad Panchayat, Bhitarwar",
          "label": "ORG",
          "start": 3538,
          "end": 3565
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.15393012762069702
    },
    {
      "sentence_id": 29,
      "text": "This mark-sheet submitted by the applicant with application form was later found to be forged as no such mark-sheet was issued by Madhyamik Shiksha Mandal.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3624,
      "end": 3779,
      "entities": [
        {
          "text": "Madhyamik Shiksha Mandal",
          "label": "OTHER_PERSON",
          "start": 3754,
          "end": 3778
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.21261005103588104
    },
    {
      "sentence_id": 30,
      "text": "During investigation, the concerned Department also provided copy of same mark-sheet from the service record of the applicant which shows that the applicant has submitted this forged mark-sheet at the time of initial appointment as Samvida Shala Shikshak Grade III.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3780,
      "end": 4045,
      "entities": [
        {
          "text": "Samvida Shala Shikshak",
          "label": "OTHER_PERSON",
          "start": 4012,
          "end": 4034
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2826293408870697
    },
    {
      "sentence_id": 31,
      "text": "Learned counsel further submitted that the investigation is underway.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4046,
      "end": 4115,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.22567543387413025
    },
    {
      "sentence_id": 32,
      "text": "The applicant has not been available to the investigation Officer since registration of FIR on 27.10.2023.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4116,
      "end": 4222,
      "entities": [
        {
          "text": "27.10.2023",
          "label": "DATE",
          "start": 4211,
          "end": 4221
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3864358961582184
    },
    {
      "sentence_id": 33,
      "text": "There are seven other accused who had forged similar D.Ed mark-sheets and secured benefit of appointment.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4223,
      "end": 4328,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.32046952843666077
    },
    {
      "sentence_id": 34,
      "text": "The requirement of D.Ed or B.Ed. mark-sheet for selection/promotion as per rules will be considered at the trial.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4329,
      "end": 4442,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.49525192379951477
    },
    {
      "sentence_id": 35,
      "text": "At present, the fact remains that applicant had submitted forged mark-sheet.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4443,
      "end": 4519,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3513508439064026
    },
    {
      "sentence_id": 36,
      "text": "Therefore, the applicant may not be extended the benefit of anticipatory bail.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4520,
      "end": 4598,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4658886194229126
    },
    {
      "sentence_id": 37,
      "text": "Heard.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 4600,
      "end": 4606,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.18379880487918854
    },
    {
      "sentence_id": 38,
      "text": "Considered.",
      "rhetorical_role": "ANALYSIS",
      "start": 4607,
      "end": 4618,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2260512411594391
    },
    {
      "sentence_id": 39,
      "text": "The investigation is in primary stage.",
      "rhetorical_role": "ANALYSIS",
      "start": 4619,
      "end": 4658,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4714485704898834
    },
    {
      "sentence_id": 40,
      "text": "Applicant has prima-facie, taken illegal benefit of govt. job and earned the salary on basis of forged mark-sheet",
      "rhetorical_role": "ANALYSIS",
      "start": 4659,
      "end": 4772,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4644692838191986
    },
    {
      "sentence_id": 41,
      "text": ". \nInvestigation is underway.",
      "rhetorical_role": "RATIO",
      "start": 4773,
      "end": 4802,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2381889522075653
    },
    {
      "sentence_id": 42,
      "text": "The need for custodial interrogation cannot be ruled out.",
      "rhetorical_role": "RATIO",
      "start": 4803,
      "end": 4860,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6024355888366699
    },
    {
      "sentence_id": 43,
      "text": "Applicant has not co-operated in investigation.",
      "rhetorical_role": "RATIO",
      "start": 4861,
      "end": 4908,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.6136617660522461
    },
    {
      "sentence_id": 44,
      "text": "Considering the rival contentions and overall circumstances reflected by material on case diary, this Court is not inclined to extend benefit of anticipatory bail to the applicant.",
      "rhetorical_role": "RATIO",
      "start": 4909,
      "end": 5089,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.38131844997406006
    },
    {
      "sentence_id": 45,
      "text": "The application u/S 438 of CrPC is therefore, rejected.",
      "rhetorical_role": "RPC",
      "start": 5090,
      "end": 5146,
      "entities": [
        {
          "text": "S 438",
          "label": "PROVISION",
          "start": 5109,
          "end": 5114
        },
        {
          "text": "CrPC",
          "label": "STATUTE",
          "start": 5118,
          "end": 5122
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.32800841331481934
    },
