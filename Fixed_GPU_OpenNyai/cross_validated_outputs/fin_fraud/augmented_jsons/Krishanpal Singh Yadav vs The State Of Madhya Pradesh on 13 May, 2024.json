    },
    {
      "sentence_id": 11,
      "text": "This first application has been filed by the applicant under Section 438 of Code of Criminal Procedure, 1973 for grant of anticipatory bail to the applicant, who is apprehending his arrest in connection with Crime No.604 of 2023 registered at Police Station Bhitarwar, District Gwalior (M.P.) for offences punishable under Sections 420, 467, 468, 471 of IPC.",
      "rhetorical_role": "FAC",
      "start": 765,
      "end": 1123,
      "entities": [
        {
          "text": "Section 438",
          "label": "PROVISION",
          "start": 826,
          "end": 837
        },
