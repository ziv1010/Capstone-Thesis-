        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 3,
      "text": "Mr. Amit Bhatt, Deputy\nAdvocate General for the\nState/respondent nos.1 and 2.\nMr. Viplav Sharma and Mr. Bhuwan Bhatt, Advocates for respondent no.3.",
      "rhetorical_role": "NONE",
