      "in_summary": false
    },
    {
      "sentence_id": 21,
      "text": "One week thereafter, rejoinder affidavit, if any, may be filed.",
      "rhetorical_role": "RPC",
      "start": 1764,
      "end": 1827,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.06258285790681839
    },
    {
      "sentence_id": 22,
      "text": "List for final hearing on 30.10.2023.",
      "rhetorical_role": "NONE",
      "start": 1829,
      "end": 1866,
      "entities": [
        {
          "text": "30.10.2023",
          "label": "DATE",
          "start": 1855,
          "end": 1865
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 23,
      "text": "Having considered, as an interim measure, till the next date of listing, no coercive steps shall be taken against the petitioners, provided they cooperate with the investigation.\nStay Application (IA) No.1 of 2023, stands disposed of accordingly.",
      "rhetorical_role": "RPC",
