      "start": 6937,
      "end": 7027,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.5106033682823181
    },
    {
      "sentence_id": 61,
      "text": "In the case in hand, it cannot be overlooked that applicants in conspiracy and in connivance with co-accused Devendra Jaiswal and other co-accused persons played serious fraud upon innocent investors and deprived them of their hard earned money.",
      "rhetorical_role": "RATIO",
