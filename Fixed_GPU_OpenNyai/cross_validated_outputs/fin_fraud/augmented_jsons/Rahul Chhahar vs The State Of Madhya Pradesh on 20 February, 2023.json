      "end": 7525,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4266621470451355
    },
    {
      "sentence_id": 65,
      "text": "Therefore, without expressing any opinion on the merit of the case but having taken into consideration all the facts and circumstances of the case, I am of the view that it is not a fit case for grant of bail.",
      "rhetorical_role": "RATIO",
      "start": 7526,
