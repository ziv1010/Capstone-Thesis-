      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.5601388216018677
    },
    {
      "sentence_id": 62,
      "text": "Sufficient evidence is available on record to connect all the applicants with the offence in question.",
      "rhetorical_role": "RATIO",
      "start": 7275,
      "end": 7377,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.365009069442749
    },
    {
      "sentence_id": 63,
      "text": "Applicants also induced the innocent people to deposit the money with the company.",
      "rhetorical_role": "RATIO",
      "start": 7378,
      "end": 7460,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.43916064500808716
    },
    {
      "sentence_id": 64,
      "text": "They have embezzled crores of rupees cheated from the investors.",
