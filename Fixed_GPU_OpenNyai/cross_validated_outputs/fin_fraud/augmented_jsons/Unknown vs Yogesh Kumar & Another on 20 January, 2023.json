      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.2220558226108551
    },
    {
      "sentence_id": 20,
      "text": "Steps to be taken within a week.",
      "rhetorical_role": "NONE",
      "start": 2099,
      "end": 2131,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 21,
      "text": "List this matter on 01.05.2023.",
      "rhetorical_role": "RPC",
      "start": 2132,
      "end": 2163,
      "entities": [
        {
