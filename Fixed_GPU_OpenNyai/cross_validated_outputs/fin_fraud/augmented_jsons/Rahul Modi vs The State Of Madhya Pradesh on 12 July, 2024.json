      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 7,
      "text": "1 .  The applicants have filed this first bail application u/S.439 Cr.P.C for grant of bail.",
      "rhetorical_role": "FAC",
      "start": 684,
      "end": 777,
      "entities": [
        {
          "text": "S.439",
          "label": "PROVISION",
