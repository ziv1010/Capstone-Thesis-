          "end": 751
        },
        {
          "text": "Cr.P.C",
          "label": "STATUTE",
          "start": 752,
          "end": 758
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2716621458530426
    },
    {
      "sentence_id": 8,
      "text": "Applicants have been arrested on 25-11-2019 by Police Station Thatipur District Gwalior in connection with Crime No.563/2019 registered for offence under Sections 420, 406, 409, 467, 468, 477A, 120B of IPC.\n2.",
      "rhetorical_role": "FAC",
