    },
    {
      "sentence_id": 8,
      "text": "...for the State.",
      "rhetorical_role": "NONE",
      "start": 647,
      "end": 665,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 9,
      "text": "Learned counsel appearing on behalf of the petitioner submits that the petitioner had taken loan from the de facto complainant but could not repay.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 666,
      "end": 814,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14820562303066254
    },
    {
      "sentence_id": 10,
      "text": "This made the de facto complainant files a false case against the petitioner.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 815,
      "end": 892,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.22352983057498932
    },
    {
      "sentence_id": 11,
      "text": "The petitioner is 65% disabled in his lower limb.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 893,
      "end": 942,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2194754034280777
    },
    {
      "sentence_id": 12,
      "text": "Learned counsel appearing on behalf of the State relies on the case diary and opposes the prayer for anticipatory bail.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 943,
      "end": 1063,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.08817671984434128
    },
    {
      "sentence_id": 13,
      "text": "She refers to the money receipts issued by the petitioner.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1064,
      "end": 1122,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.11767173558473587
    },
    {
      "sentence_id": 14,
      "text": "She submits that the petitioner had taken money from several victims on the promise of giving jobs.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 1123,
      "end": 1222,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.14291144907474518
    },
    {
      "sentence_id": 15,
      "text": "In fact, fake appointment letters were issued in favour of the victims.",
      "rhetorical_role": "ARG_RESPONDENT",
      "start": 1223,
      "end": 1294,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.2083500325679779
    },
    {
      "sentence_id": 16,
      "text": "Considering the incriminating materials available in the case diary, I do not consider this to be a fit case for granting anticipatory bail to the present petitioner.",
      "rhetorical_role": "RATIO",
      "start": 1295,
      "end": 1462,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.16406235098838806
    },
    {
      "sentence_id": 17,
      "text": "The application for anticipatory bail being CRM (A) 2698 of 2025 is, thus, rejected.",
      "rhetorical_role": "RPC",
      "start": 1463,
      "end": 1548,
      "entities": [
        {
          "text": "CRM (A) 2698 of 2025",
          "label": "CASE_NUMBER",
