          "start": 5752,
          "end": 5765
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.4439287483692169
    },
    {
      "sentence_id": 55,
      "text": "Learned APP as well as learned counsel for the first informant opposed these submissions.",
      "rhetorical_role": "ANALYSIS",
      "start": 5811,
      "end": 5900,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.06611151993274689
    },
    {
      "sentence_id": 56,
      "text": "Learned APP produced the investigation papers before me including copy of the forged sale certificate and the genuine sale certificate.",
      "rhetorical_role": "ANALYSIS",
      "start": 5902,
      "end": 6037,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.07781178504228592
    },
    {
      "sentence_id": 57,
      "text": "She submitted that in the inquiry conducted before registering the FIR, the Applicant's statement was recorded and at that time he has 5 of 7 :6:\n12.ABA-726-24.odt accepted that he had used a forged sale certificate for showing the same to the informant to get investment from him.",
      "rhetorical_role": "ANALYSIS",
      "start": 6038,
      "end": 6319,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.12434160709381104
    },
    {
      "sentence_id": 58,
      "text": "6. I have considered these submissions and in particular I have seen the copies of the sale certificates.",
      "rhetorical_role": "ANALYSIS",
      "start": 6320,
      "end": 6426,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.03175865113735199
    },
    {
      "sentence_id": 59,
      "text": "There is no dispute now that the sale certificates shown to the informant were the forged sale certificates.",
      "rhetorical_role": "ANALYSIS",
      "start": 6427,
      "end": 6535,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2774944603443146
    },
    {
      "sentence_id": 60,
      "text": "The State Bank of India has not issued such certificate dated 31.1.2022 or even 21.3.2022.",
      "rhetorical_role": "ANALYSIS",
      "start": 6536,
      "end": 6626,
      "entities": [
        {
          "text": "State Bank of India",
          "label": "ORG",
          "start": 6540,
          "end": 6559
        },
        {
          "text": "31.1.2022",
          "label": "DATE",
          "start": 6598,
          "end": 6607
        },
        {
          "text": "21.3.2022",
          "label": "DATE",
          "start": 6616,
          "end": 6625
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3351517915725708
    },
    {
      "sentence_id": 61,
      "text": "The State Bank of India had not sold the property in question to Jasvi Construction as was claimed in those certificates.",
      "rhetorical_role": "ANALYSIS",
      "start": 6627,
      "end": 6748,
      "entities": [
        {
          "text": "State Bank of India",
          "label": "ORG",
          "start": 6631,
          "end": 6650
        },
        {
          "text": "Jasvi Construction",
          "label": "ORG",
          "start": 6692,
          "end": 6710
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3680671751499176
    },
    {
      "sentence_id": 62,
      "text": "The accused, including the present Applicant, had used this particular sale certificate to extract the huge investment from the informant.",
      "rhetorical_role": "ANALYSIS",
      "start": 6749,
      "end": 6887,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4097021818161011
    },
    {
      "sentence_id": 63,
      "text": "The genuine certificate was issued by the State Bank of India on 29.9.2022 in favour of Rishabh Tuff, which was the company of the Applicant's brother in respect of the sale of property of M/s. Singhania Fab Expert Private Limited.",
      "rhetorical_role": "ANALYSIS",
      "start": 6888,
      "end": 7119,
      "entities": [
        {
          "text": "State Bank of India",
          "label": "ORG",
          "start": 6930,
          "end": 6949
        },
        {
          "text": "29.9.2022",
          "label": "DATE",
          "start": 6953,
          "end": 6962
        },
        {
          "text": "Rishabh Tuff",
          "label": "OTHER_PERSON",
          "start": 6976,
          "end": 6988
        },
        {
          "text": "Singhania Fab Expert Private Limited",
          "label": "ORG",
          "start": 7082,
          "end": 7118
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4352016746997833
    },
    {
      "sentence_id": 64,
      "text": "7. Thus, it is quite clear that the huge amount was extracted from the informant on false representation and on the basis of forged documents.",
      "rhetorical_role": "ANALYSIS",
      "start": 7121,
      "end": 7263,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.4357895851135254
    },
    {
      "sentence_id": 65,
      "text": "The amount was misappropriated.",
      "rhetorical_role": "ANALYSIS",
      "start": 7264,
      "end": 7295,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.47210994362831116
    },
    {
      "sentence_id": 66,
      "text": "The cheques issued purportedly for refunding that amount were dishonored.",
      "rhetorical_role": "RATIO",
      "start": 7296,
      "end": 7369,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.474907785654068
    },
    {
      "sentence_id": 67,
      "text": "Therefore, it is quite clear that it is a well planned 6 of 7 :7: 12.ABA-726-24.odt conspiracy which was executed by the Applicant and the co- accused.",
      "rhetorical_role": "RATIO",
      "start": 7370,
      "end": 7521,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2618545889854431
    },
    {
      "sentence_id": 68,
      "text": "8. In this view of the matter, the custodial interrogation of the Applicant is necessary to find details of the offence.",
      "rhetorical_role": "RATIO",
      "start": 7523,
      "end": 7643,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.25969433784484863
    },
    {
      "sentence_id": 69,
      "text": "The allegations are serious.",
      "rhetorical_role": "RATIO",
      "start": 7644,
      "end": 7672,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2731698453426361
    },
    {
      "sentence_id": 70,
      "text": "The amount involved is huge.",
      "rhetorical_role": "RPC",
      "start": 7673,
      "end": 7701,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.4059373736381531
    },
    {
      "sentence_id": 71,
      "text": "The informant, who is 72 years of age and a handicapped person, is deprived of his huge amount.",
      "rhetorical_role": "RPC",
      "start": 7702,
      "end": 7797,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.47002437710762024
    },
    {
      "sentence_id": 72,
      "text": "No case for grant of protection under Section 438 of Cr.P.C. is made out.",
      "rhetorical_role": "RPC",
      "start": 7798,
      "end": 7871,
      "entities": [
