    {
      "sentence_id": 7,
      "text": "Heard the learned counsels for the parties.",
      "rhetorical_role": "NONE",
      "start": 618,
      "end": 661,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 8,
      "text": "Perused the case diary.",
      "rhetorical_role": "NONE",
