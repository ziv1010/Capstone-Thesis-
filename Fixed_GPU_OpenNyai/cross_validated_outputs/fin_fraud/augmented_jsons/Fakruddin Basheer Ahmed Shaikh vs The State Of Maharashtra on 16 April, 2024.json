      "end": 2098,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.14815747737884521
    },
    {
      "sentence_id": 19,
      "text": "The said customer then called Akubuddin, who told him that he should withdraw the complaints regarding the policies and his money would be returned within 8 to 10 days in his account.",
