    {
      "sentence_id": 11,
      "text": "Sameer Jaysingh Kanchan vs The State Of Maharashtra on 16 April, 2024 Indian Kanoon - http://indiankanoon.org/doc/142641549/\n1",
      "rhetorical_role": "PREAMBLE",
      "start": 961,
      "end": 1088,
      "entities": [
        {
          "text": "Sameer Jaysingh Kanchan vs The State Of Maharashtra",
          "label": "PRECEDENT",
