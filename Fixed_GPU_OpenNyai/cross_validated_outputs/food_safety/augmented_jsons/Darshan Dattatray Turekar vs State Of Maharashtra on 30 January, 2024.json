    {
      "sentence_id": 5,
      "text": "_\n Coram : Sarang V. Kotwal, J.\nDate : 30 January 2024 P.C. :\n1.",
      "rhetorical_role": "PREAMBLE",
      "start": 678,
      "end": 742,
      "entities": [
        {
