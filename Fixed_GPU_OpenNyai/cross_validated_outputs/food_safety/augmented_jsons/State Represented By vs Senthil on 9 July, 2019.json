      "summary_sent_score": 0.601589560508728
    },
    {
      "sentence_id": 15,
      "text": "By Judgment dated 05.05.2009, the learned trial Magistrate acquitted the accused.",
      "rhetorical_role": "RLC",
      "start": 1417,
      "end": 1498,
      "entities": [
        {
          "text": "05.05.2009",
          "label": "DATE",
