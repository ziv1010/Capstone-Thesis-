    },
    {
      "sentence_id": 18,
      "text": "It is the case of the prosecution that without any license the petitioner was running a country liquor shop and by consuming poisonous country liquor purchased from his shop, two persons died and several persons became seriously ill.\nOur attention has been drawn by the learned Public Prosecutor, High Court, Calcutta to the statements of the local people, which are at pages 8, 9, 13 and 14 of the case diary.",
      "rhetorical_role": "FAC",
      "start": 1516,
      "end": 1927,
      "entities": [
        {
          "text": "High Court, Calcutta",
          "label": "COURT",
          "start": 1814,
          "end": 1834
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.26387760043144226
    },
    {
      "sentence_id": 19,
      "text": "Going through the same, we find the petitioner's, prima facie, complicity is very much there.",
