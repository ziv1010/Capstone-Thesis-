    {
      "sentence_id": 16,
      "text": "PRAYER in both Petitions:",
      "rhetorical_role": "PREAMBLE",
      "start": 877,
      "end": 902,
      "entities": [],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 17,
      "text": "These Criminal Original Petitions are filed under Section 482",
      "rhetorical_role": "PREAMBLE",
      "start": 903,
      "end": 966,
      "entities": [
        {
          "text": "Section 482",
          "label": "PROVISION",
