    {
      "sentence_id": 1,
      "text": "C482/1132/2014 on 16 November, 2019",
      "rhetorical_role": "PREAMBLE",
      "start": 0,
      "end": 35,
      "entities": [
        {
          "text": "C482/1132/2014",
