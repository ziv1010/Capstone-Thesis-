          "label": "PROVISION",
          "start": 856,
          "end": 882
        },
        {
          "text": "3 (1) (zz) (v)",
          "label": "PROVISION",
          "start": 887,
          "end": 901
        },
        {
          "text": "Sections 52",
          "label": "PROVISION",
          "start": 930,
          "end": 941
        },
        {
          "text": "59",
          "label": "PROVISION",
          "start": 946,
          "end": 948
        },
        {
          "text": "Food Safety Standards Act, 2006",
          "label": "STATUTE",
          "start": 956,
          "end": 987
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "But, owing to the fact, which is brought to the knowledge of this Court, that based upon the report,\nwhich was called upon by the Hon'ble Apex Court from the accredited laboratory, it will not be feasible at this stage to decide the C482 Applications, on its own merits.",
      "rhetorical_role": "RPC",
      "start": 989,
      "end": 1260,
      "entities": [
        {
          "text": "Apex Court",
          "label": "COURT",
          "start": 1128,
          "end": 1138
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.21359288692474365
    },
    {
      "sentence_id": 8,
      "text": "Hence, the C482 Applications are directed to be listed on 7th March, 2023.",
      "rhetorical_role": "RPC",
      "start": 1261,
      "end": 1336,
      "entities": [
        {
          "text": "7th March, 2023",
          "label": "DATE",
          "start": 1320,
          "end": 1335
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.2551632225513458
    },
    {
      "sentence_id": 9,
      "text": "The respective pending applications, which are shown today, i.e. counter affidavits filed in the respective C482 Applications, along with the Stay Vacation Applications, they all would stand disposed of in each of the C482 Applications.",
      "rhetorical_role": "NONE",
      "start": 1337,
      "end": 1574,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 10,
      "text": "The affidavits would be taken on record.",
      "rhetorical_role": "NONE",
      "start": 1576,
      "end": 1616,
      "entities": [],
      "in_summary": false
    },
    {
