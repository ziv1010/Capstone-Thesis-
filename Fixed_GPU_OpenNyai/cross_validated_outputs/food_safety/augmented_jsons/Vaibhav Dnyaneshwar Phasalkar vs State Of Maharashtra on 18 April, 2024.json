      "summary_sent_score": 0.3981475532054901
    },
    {
      "sentence_id": 32,
      "text": "Learned counsel for the Applicant submitted that the Applicant is acquitted from the offence under section 302 of the I.P.C.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3798,
      "end": 3922,
      "entities": [
        {
          "text": "section 302",
          "label": "PROVISION",
          "start": 3897,
          "end": 3908
        },
        {
          "text": "I.P.C.",
          "label": "STATUTE",
          "start": 3916,
          "end": 3922
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.15094108879566193
    },
    {
      "sentence_id": 33,
      "text": "He is falsely implicated.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 3923,
      "end": 3948,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.15578202903270721
    },
    {
      "sentence_id": 34,
      "text": "6. I have considered these submissions.",
      "rhetorical_role": "ANALYSIS",
      "start": 3949,
      "end": 3989,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.026244213804602623
    },
    {
      "sentence_id": 35,
      "text": "The investigation papers include statements of other members of the raiding party i.e. other police officers and panchnama.",
      "rhetorical_role": "ANALYSIS",
      "start": 3990,
      "end": 4113,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.10625503212213516
    },
    {
      "sentence_id": 36,
      "text": "There is a statement of one Prem, who was working in the general store of the accused Sanjay.",
      "rhetorical_role": "ANALYSIS",
