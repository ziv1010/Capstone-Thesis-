      "text": "On demand, he failed to produce licence for sale of food articles.",
      "rhetorical_role": "FAC",
      "start": 1358,
      "end": 1424,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3711966574192047
    },
    {
