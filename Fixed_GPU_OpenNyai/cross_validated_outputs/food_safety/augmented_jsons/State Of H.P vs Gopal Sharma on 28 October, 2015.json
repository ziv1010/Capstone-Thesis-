      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2055763155221939
    },
    {
      "sentence_id": 15,
      "text": "Eatables, biscuits, fruit drinks, milk etc. were kept for sale to the public.",
      "rhetorical_role": "FAC",
      "start": 1280,
      "end": 1357,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2889865040779114
    },
