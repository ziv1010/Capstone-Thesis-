      "summary_sent_score": 0.4326648414134979
    },
    {
      "sentence_id": 27,
      "text": "The accused preferred an appeal against the judgment dated 27.7.2005 before the learned Sessions Judge, Shimla.",
      "rhetorical_role": "FAC",
      "start": 2065,
      "end": 2176,
      "entities": [
