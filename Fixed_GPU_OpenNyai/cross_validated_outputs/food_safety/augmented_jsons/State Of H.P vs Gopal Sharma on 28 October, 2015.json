          "end": 2314
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.16466140747070312
    },
    {
      "sentence_id": 31,
      "text": "However, he was unable to say if Vineet Kumar Proprietor had applied for renewal of the licence which was granted in his favour.",
