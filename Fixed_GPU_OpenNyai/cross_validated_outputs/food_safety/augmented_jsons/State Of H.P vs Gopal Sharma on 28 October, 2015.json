      "start": 973,
      "end": 1279,
      "entities": [
        {
          "text": "30.9.2004",
          "label": "DATE",
          "start": 1029,
          "end": 1038
        },
        {
          "text": "Shimla",
          "label": "GPE",
          "start": 1056,
          "end": 1062
        },
        {
