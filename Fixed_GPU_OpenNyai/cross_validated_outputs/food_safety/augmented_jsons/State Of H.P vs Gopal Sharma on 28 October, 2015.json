          "end": 2632
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.18732693791389465
    },
    {
      "sentence_id": 34,
      "text": "He was unable to say whether the shop was that of Vineet Kumar and on that day Vineet Kumar had obtained licence or not.",
      "rhetorical_role": "FAC",
      "start": 2687,
      "end": 2808,
      "entities": [
