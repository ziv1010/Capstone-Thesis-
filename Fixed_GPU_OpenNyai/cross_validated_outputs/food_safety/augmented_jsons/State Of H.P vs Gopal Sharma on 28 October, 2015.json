        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.21192249655723572
    },
    {
      "sentence_id": 29,
      "text": "Hence, this appeal at the instance of the State.",
      "rhetorical_role": "FAC",
      "start": 2246,
      "end": 2294,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.279529869556427
    },
    {
      "sentence_id": 30,
      "text": "4. PW-1 Leela Dhar, Food Inspector deposed that he considered the accused to be proprietor of the Shop on his admission.",
      "rhetorical_role": "FAC",
      "start": 2295,
      "end": 2416,
      "entities": [
