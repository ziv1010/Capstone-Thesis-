      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2848426401615143
    },
    {
      "sentence_id": 32,
      "text": "He denied that accused had claimed himself to be servant in the shop.",
      "rhetorical_role": "FAC",
      "start": 2546,
      "end": 2615,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2423376739025116
    },
    {
      "sentence_id": 33,
      "text": "PW-2 Ashok Kumar, Peon also stated that accused was owner of the shop.",
