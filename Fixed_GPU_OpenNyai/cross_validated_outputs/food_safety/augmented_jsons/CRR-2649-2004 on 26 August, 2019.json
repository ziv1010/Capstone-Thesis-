          "end": 182
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 5,
      "text": "None appears for the petitioner.",
      "rhetorical_role": "NONE",
      "start": 183,
      "end": 215,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 6,
      "text": "No accommodation is sought for.",
      "rhetorical_role": "NONE",
      "start": 216,
      "end": 248,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 7,
      "text": "The revisional application has been preferred against the judgement and order dated 21.06.2004 passed by the learned 2nd F.T.C. Court Calcutta in Criminal Appeal No. 74/2003.",
      "rhetorical_role": "RLC",
      "start": 250,
      "end": 424,
      "entities": [
        {
          "text": "21.06.2004",
          "label": "DATE",
          "start": 334,
          "end": 344
        },
        {
          "text": "2nd F.T.C. Court Calcutta",
          "label": "COURT",
          "start": 367,
          "end": 392
        },
        {
          "text": "Criminal Appeal No. 74/2003",
          "label": "CASE_NUMBER",
          "start": 396,
          "end": 423
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.1315876841545105
    },
    {
      "sentence_id": 8,
      "text": "By the said judgement the learned appellate court was pleased to affirm the order of conviction and sentence passed by the learned Municipal Magistrate, 3rd Court Calcutta in Case No. 9(D)/1992 under section 16(1)(a)(I) of the Prevention of Food Adulteration Act and sentenced the petitioner to suffer R.I. for six months with a fine of Rs.1000/- i.d. R.I. for one month more.",
      "rhetorical_role": "RLC",
      "start": 425,
      "end": 801,
      "entities": [
        {
          "text": "Municipal Magistrate, 3rd Court Calcutta",
          "label": "COURT",
          "start": 556,
          "end": 596
        },
        {
          "text": "Case No. 9(D)/1992",
          "label": "CASE_NUMBER",
          "start": 600,
          "end": 618
        },
        {
          "text": "section 16(1)(a)(I)",
          "label": "PROVISION",
          "start": 625,
          "end": 644
        },
        {
          "text": "Prevention of Food Adulteration Act",
          "label": "STATUTE",
          "start": 652,
          "end": 687
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3746892213821411
    },
    {
      "sentence_id": 9,
      "text": "I find from the records of this case that the revisional application was admitted on 11.03.2005 and there was a stay for a period of twelve weeks with a liberty to pray for extension.",
      "rhetorical_role": "FAC",
      "start": 802,
      "end": 986,
      "entities": [
        {
          "text": "11.03.2005",
          "label": "DATE",
          "start": 888,
          "end": 898
        }
      ],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.09998971968889236
    },
    {
      "sentence_id": 10,
      "text": "Subsequently, an application for extension of interim order was taken out by the petitioner being C.R.A.N. 1915 of 2005.",
      "rhetorical_role": "RPC",
      "start": 987,
      "end": 1107,
      "entities": [
        {
          "text": "C.R.A.N. 1915 of 2005",
          "label": "CASE_NUMBER",
          "start": 1085,
          "end": 1106
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.1930927038192749
    },
    {
      "sentence_id": 11,
      "text": "But the interim order was never extended.",
      "rhetorical_role": "NONE",
      "start": 1108,
      "end": 1149,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 12,
      "text": "In view of the long pendency of the matter before this Court, and the fact that this application has been running in the list for a considerable period of time, I do not think that the petitioner is pursuing the revisional application with due diligence.",
      "rhetorical_role": "NONE",
      "start": 1150,
      "end": 1405,
      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 13,
      "text": "As such the revisional application being C.R.R. 2649 of 2004 along with C.R.A.N. 1915 of 2005 is dismissed for default.",
      "rhetorical_role": "NONE",
      "start": 1406,
      "end": 1526,
      "entities": [
        {
