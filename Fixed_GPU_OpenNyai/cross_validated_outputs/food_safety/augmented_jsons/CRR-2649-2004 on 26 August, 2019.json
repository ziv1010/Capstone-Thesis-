    {
      "sentence_id": 4,
      "text": "In Re : Manoharlal Shaw",
      "rhetorical_role": "PREAMBLE",
      "start": 159,
      "end": 182,
      "entities": [
        {
          "text": "Manoharlal Shaw",
          "label": "OTHER_PERSON",
