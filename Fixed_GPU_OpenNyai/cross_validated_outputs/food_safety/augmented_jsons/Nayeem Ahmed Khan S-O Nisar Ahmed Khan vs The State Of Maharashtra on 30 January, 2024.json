      "end": 1410,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.2230149209499359
    },
    {
      "sentence_id": 11,
      "text": "There were about 32400 packets.",
      "rhetorical_role": "FAC",
      "start": 1411,
      "end": 1442,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.15529896318912506
    },
    {
