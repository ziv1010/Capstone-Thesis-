      "text": "He was not transporting any articles.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1831,
      "end": 1868,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.3941255807876587
    },
    {
      "sentence_id": 16,
      "text": "He was not the owner of the banned articles.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1869,
      "end": 1913,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
