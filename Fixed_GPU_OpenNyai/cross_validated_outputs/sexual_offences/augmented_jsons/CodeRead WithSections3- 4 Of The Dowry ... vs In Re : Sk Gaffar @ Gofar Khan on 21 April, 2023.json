      "in_summary": false
    },
    {
      "sentence_id": 4,
      "text": "Learned advocate appearing for the petitioner submits that,\nthe petitioner was falsely implicated.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 775,
      "end": 873,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2326279878616333
    },
    {
      "sentence_id": 5,
      "text": "He refers to the contents of the First Information Report (FIR).",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 874,
      "end": 938,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.378447562456131
    },
    {
      "sentence_id": 6,
      "text": "He submits that, there was a house warming party where the incident is alleged to occur.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 939,
      "end": 1028,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.24487236142158508
    },
    {
      "sentence_id": 7,
      "text": "He refers to the date of the incident and submits that, there is atleast six moths delay in the lodgment of the FIR.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1029,
      "end": 1145,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.3050915598869324
    },
    {
      "sentence_id": 8,
      "text": "Learned advocate appearing for the State draws the attention of the Court to the statement of the victim recorded under Section 164 of the Code of Criminal Procedure (Cr.P.C.) as well as to the medical examination report.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1146,
      "end": 1368,
      "entities": [
        {
          "text": "Section 164",
          "label": "PROVISION",
