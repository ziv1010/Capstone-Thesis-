          "end": 1822
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 14,
      "text": "Learned counsel for the applicant has submitted that applicant has not committed any offence.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1882,
      "end": 1975,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2707127630710602
    },
    {
      "sentence_id": 15,
      "text": "He is innocent.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1976,
      "end": 1992,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.29072338342666626
    },
    {
      "sentence_id": 16,
      "text": "He has been falsely implicated.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1993,
      "end": 2024,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.31484055519104004
    },
    {
      "sentence_id": 17,
      "text": "Trial is pending for the last three years trial.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2025,
      "end": 2073,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.31039363145828247
    },
    {
      "sentence_id": 18,
      "text": "Therefore, it is prayed that applicant may be released on bail, pending the trial.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2074,
      "end": 2157,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.2546086013317108
    },
    {
      "sentence_id": 19,
      "text": "5 . On the other hand, learned counsel for the victim as well as counsel for State has opposed the prayer for grant of bail to the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 2158,
      "end": 2299,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1577615886926651
    },
    {
      "sentence_id": 20,
      "text": "6. At the time of commission of offence prosecutrix was only 15 years old.",
      "rhetorical_role": "RATIO",
      "start": 2300,
      "end": 2375,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2403011918067932
    },
    {
      "sentence_id": 21,
      "text": "DNA as well as FSL reports are positive.",
      "rhetorical_role": "RATIO",
      "start": 2376,
      "end": 2417,
      "entities": [
        {
          "text": "FSL",
          "label": "ORG",
          "start": 2392,
          "end": 2395
        }
      ],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.22737480700016022
    },
    {
      "sentence_id": 22,
      "text": "Therefore, having taken into consideration the gravity of offence and material available on record, I am of the view that no case for grant of bail is made out.",
      "rhetorical_role": "RATIO",
      "start": 2418,
      "end": 2578,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.29982420802116394
    },
    {
      "sentence_id": 23,
      "text": "Consequently, this fifth bail application filed on behalf of the applicant Neeraj Mehra is dismissed.",
