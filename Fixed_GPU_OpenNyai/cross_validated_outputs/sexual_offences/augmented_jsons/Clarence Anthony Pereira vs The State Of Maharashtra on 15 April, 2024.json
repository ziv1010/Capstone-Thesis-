          "end": 4584
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.2416696846485138
    },
    {
      "sentence_id": 46,
      "text": "He, therefore, submitted that it is purely a civil dispute and, therefore, the applicant's custodial interrogation is not necessary.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4603,
      "end": 4735,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.21199825406074524
    },
    {
      "sentence_id": 47,
      "text": "6. Learned APP strongly opposed these submissions and 5 of 8 3-aba-993-24 produced the investigation papers before the Court.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4736,
      "end": 4862,
      "entities": [
        {
          "text": "3-aba-993-24",
          "label": "DATE",
          "start": 4798,
          "end": 4810
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.03608205169439316
    },
    {
      "sentence_id": 48,
      "text": "She heavily relied on the statement of the Notary Sayyad Amanulla.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4863,
      "end": 4929,
      "entities": [
        {
          "text": "Sayyad Amanulla",
          "label": "OTHER_PERSON",
          "start": 4913,
          "end": 4928
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.06839397549629211
    },
    {
      "sentence_id": 49,
      "text": "He has categorically stated that the informant was not present for notarising that document and the informant had not signed in front of him.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 4930,
      "end": 5071,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.14941473305225372
    },
    {
      "sentence_id": 50,
      "text": "She further submitted that the statement of Abbas Ali Razaq and Satish Sharma also support the informant's case.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5072,
      "end": 5184,
      "entities": [
        {
          "text": "Abbas Ali Razaq",
          "label": "OTHER_PERSON",
          "start": 5116,
          "end": 5131
        },
        {
          "text": "Satish Sharma",
          "label": "OTHER_PERSON",
          "start": 5136,
          "end": 5149
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.06881105899810791
    },
    {
      "sentence_id": 51,
      "text": "She submitted Clarence Anthony Pereira vs The State Of Maharashtra on 15 April, 2024 Indian Kanoon - http://indiankanoon.org/doc/135909457/\n2 that the applicant has not only created the forged document, but he actually used it by relying on it before the Court where he had filed a civil suit.",
      "rhetorical_role": "ARG_PETITIONER",
