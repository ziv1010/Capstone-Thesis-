      "summary_section": "facts",
      "summary_sent_score": 0.23287628591060638
    },
    {
      "sentence_id": 44,
      "text": "The informant had filed the proceedings on 19.12.2023 before the competent authority.",
      "rhetorical_role": "FAC",
      "start": 4418,
      "end": 4503,
      "entities": [
        {
          "text": "19.12.2023",
