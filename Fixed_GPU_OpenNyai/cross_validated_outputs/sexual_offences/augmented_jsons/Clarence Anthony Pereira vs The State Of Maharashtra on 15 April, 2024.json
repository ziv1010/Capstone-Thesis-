          "end": 5269
        }
      ],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.27057844400405884
    },
    {
      "sentence_id": 52,
      "text": "7. Learned APP submitted that, there are four antecedents against the present applicant; as follows:\ni) C.R.No.353/2016 registered at Andheri police station, under sections 420 r/w. 34 of the I.P.C.\nii) C.R.No.360/2014 registered at Khar police station, under sections 376, 509, 504 and 506 of the I.P.C.\niii) C.R.No.403/2014 registered at Bandra police station, under section 354-A, 420,\n506 r/w. 34 of the I.P.C.\niv) C.R.No.465 of 2014 registered at Bandra police station, under section 376, 328 and 506 of the I.P.C.\n6 of 8 3-aba-993-24 8.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 5480,
      "end": 6022,
      "entities": [
        {
          "text": "C.R.No.353/2016",
          "label": "CASE_NUMBER",
          "start": 5584,
          "end": 5599
        },
        {
          "text": "Andheri police station",
          "label": "ORG",
          "start": 5614,
          "end": 5636
        },
        {
          "text": "C.R.No.403/2014",
          "label": "CASE_NUMBER",
          "start": 5790,
          "end": 5805
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.07613290101289749
    },
    {
      "sentence_id": 53,
      "text": "I have considered these submissions.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 6023,
      "end": 6059,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.027803219854831696
    },
    {
      "sentence_id": 54,
      "text": "As rightly submitted by the learned APP, the statement of Notary is incriminating against the present applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 6060,
      "end": 6172,
      "entities": [
        {
          "text": "Notary",
          "label": "OTHER_PERSON",
          "start": 6118,
          "end": 6124
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.12736079096794128
    },
    {
      "sentence_id": 55,
      "text": "It is a strong circumstance against the applicant.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 6173,
      "end": 6223,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1508810967206955
    },
    {
      "sentence_id": 56,
      "text": "The Notary Sayyad has stated that, on 22.03.2023 the applicant and his family members had approached this witness in Andheri Court.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 6224,
      "end": 6355,
      "entities": [
        {
          "text": "Sayyad",
          "label": "OTHER_PERSON",
          "start": 6235,
          "end": 6241
        },
        {
          "text": "22.03.2023",
          "label": "DATE",
          "start": 6262,
          "end": 6272
        },
        {
          "text": "Andheri Court",
          "label": "COURT",
          "start": 6341,
          "end": 6354
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.10285763442516327
    },
    {
      "sentence_id": 57,
      "text": "The applicant had already prepared two documents.",
      "rhetorical_role": "ANALYSIS",
      "start": 6356,
      "end": 6405,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1571330428123474
    },
    {
      "sentence_id": 58,
      "text": "He insisted that the Notary should enter those documents in his register and should notarise those documents.",
      "rhetorical_role": "ANALYSIS",
      "start": 6406,
      "end": 6516,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.07138466835021973
    },
    {
      "sentence_id": 59,
      "text": "Sayyad Amanulla then obtained the applicant's signature and thumb impression on the documents and kept those documents with himself; waiting for the informant to approach him.",
      "rhetorical_role": "ANALYSIS",
      "start": 6517,
      "end": 6692,
      "entities": [
        {
          "text": "Sayyad Amanulla",
          "label": "OTHER_PERSON",
          "start": 6517,
          "end": 6532
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.11651401221752167
    },
    {
      "sentence_id": 60,
      "text": "But till 6:00p.m.",
      "rhetorical_role": "ANALYSIS",
      "start": 6693,
      "end": 6710,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1328914612531662
    },
    {
      "sentence_id": 61,
      "text": "the informant never came to him and ultimately he handed over those documents to the applicant.",
      "rhetorical_role": "ANALYSIS",
      "start": 6711,
      "end": 6806,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1403311789035797
    },
    {
      "sentence_id": 62,
      "text": "He has categorically admitted that, he had notarized those documents in the absence of the first informant.",
      "rhetorical_role": "ANALYSIS",
      "start": 6807,
      "end": 6914,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.08600281924009323
    },
    {
      "sentence_id": 63,
      "text": "This statement clearly supports the case of the informant.",
      "rhetorical_role": "ANALYSIS",
      "start": 6915,
      "end": 6973,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.0743507668375969
    },
    {
      "sentence_id": 64,
      "text": "9. Another strong circumstance against the present applicant is the photograph of the cheque which was sent on WhatsApp to the informant.",
      "rhetorical_role": "ANALYSIS",
      "start": 6975,
      "end": 7112,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.05135726183652878
    },
    {
      "sentence_id": 65,
      "text": "This was quite unusual, because if the 7 of 8 3-aba-993-24 transaction was genuine; there was no difficulty in handing over the physical cheque to the informant.",
      "rhetorical_role": "ANALYSIS",
      "start": 7113,
      "end": 7274,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.08286037296056747
    },
    {
      "sentence_id": 66,
      "text": "But that was not done.",
      "rhetorical_role": "ANALYSIS",
      "start": 7275,
      "end": 7297,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.12083213031291962
    },
    {
      "sentence_id": 67,
      "text": "This again supports the informant's case.",
      "rhetorical_role": "ANALYSIS",
      "start": 7298,
      "end": 7339,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.0505201518535614
    },
    {
      "sentence_id": 68,
      "text": "10. The next circumstance is about the statements given by Abbas Razaq and Satish Sharma who had brought Rafel to the informant.",
      "rhetorical_role": "ANALYSIS",
      "start": 7341,
      "end": 7469,
      "entities": [
        {
          "text": "Abbas Razaq",
          "label": "OTHER_PERSON",
          "start": 7400,
          "end": 7411
        },
        {
          "text": "Satish Sharma",
          "label": "OTHER_PERSON",
          "start": 7416,
          "end": 7429
        },
        {
          "text": "Rafel",
          "label": "OTHER_PERSON",
          "start": 7446,
          "end": 7451
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.04917389154434204
    },
    {
      "sentence_id": 69,
      "text": "They have also supported the informant's case.",
      "rhetorical_role": "ANALYSIS",
      "start": 7470,
      "end": 7516,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.0909506157040596
    },
    {
      "sentence_id": 70,
      "text": "The dates are also important.",
      "rhetorical_role": "ANALYSIS",
      "start": 7517,
      "end": 7546,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.060797080397605896
    },
    {
      "sentence_id": 71,
      "text": "The leave and licence agreement was executed in February 2023 and immediately the purported MoU was executed in March 2023.",
      "rhetorical_role": "ANALYSIS",
      "start": 7547,
      "end": 7670,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.27328217029571533
    },
    {
      "sentence_id": 72,
      "text": "The informant's case is that the said MoU is forged.",
      "rhetorical_role": "ANALYSIS",
      "start": 7671,
      "end": 7723,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.2830812931060791
    },
    {
      "sentence_id": 73,
      "text": "Therefore, only because the applicant had approached the Civil Court by filing a civil suit,\nthat by itself will not mean that the offence of forgery is not made out.",
      "rhetorical_role": "ANALYSIS",
      "start": 7724,
      "end": 7890,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.3444420099258423
    },
    {
      "sentence_id": 74,
      "text": "The evidentiary value of the notarized document is another issue; as far as, the civil suit is concerned.",
      "rhetorical_role": "ANALYSIS",
      "start": 7891,
      "end": 7996,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1743701994419098
    },
    {
      "sentence_id": 75,
      "text": "At this stage, there is reasonable and definite material against the present applicant showing his involvement in creating the forged document and actually using it.",
      "rhetorical_role": "ANALYSIS",
      "start": 7997,
      "end": 8162,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.31401312351226807
    },
    {
      "sentence_id": 76,
      "text": "The informant is a hawker and he is in need of money.",
      "rhetorical_role": "ANALYSIS",
      "start": 8163,
      "end": 8216,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.35292816162109375
    },
    {
      "sentence_id": 77,
      "text": "Clarence Anthony Pereira vs The State Of Maharashtra on 15 April, 2024 Indian Kanoon - http://indiankanoon.org/doc/135909457/\n3",
      "rhetorical_role": "PREAMBLE",
      "start": 8217,
      "end": 8345,
      "entities": [
        {
          "text": "Clarence Anthony Pereira vs The State Of Maharashtra",
          "label": "PRECEDENT",
          "start": 8218,
          "end": 8270
        },
        {
          "text": "15 April, 2024",
          "label": "DATE",
          "start": 8274,
          "end": 8288
        }
      ],
      "in_summary": true,
      "summary_section": "PREAMBLE"
    },
    {
      "sentence_id": 78,
      "text": "From the allegations it appears that he has lost his flat and has suffered financial loss.",
      "rhetorical_role": "RATIO",
      "start": 8346,
      "end": 8436,
      "entities": [],
      "in_summary": true,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.23989732563495636
    },
    {
      "sentence_id": 79,
      "text": "The investigation requires custodial interrogation of 8 of 8 3-aba-993-24 the applicant.",
      "rhetorical_role": "RPC",
      "start": 8437,
      "end": 8525,
      "entities": [
        {
          "text": "3-aba-993-24",
          "label": "DATE",
          "start": 8498,
          "end": 8510
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.23043696582317352
    },
    {
      "sentence_id": 80,
      "text": "11. The antecedents against the applicant is also an important issue which the Court will have to take into consideration while deciding this application; as there are four serious offences registered against the present applicant.",
      "rhetorical_role": "RATIO",
      "start": 8527,
      "end": 8758,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.161718487739563
    },
    {
      "sentence_id": 81,
      "text": "Therefore, considering all these aspects, the applicant cannot be protected U/s.438 of the Cr.p.c.\n12.",
      "rhetorical_role": "RPC",
      "start": 8759,
      "end": 8861,
      "entities": [
        {
          "text": "s.438",
          "label": "PROVISION",
          "start": 8837,
          "end": 8842
        }
      ],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.23199236392974854
    },
