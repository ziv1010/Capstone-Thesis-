      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.297672837972641
    },
    {
      "sentence_id": 45,
      "text": "On the other hand, the applicant has filed a civil suit in the Court at Dindoshi;\nin January 2024.",
      "rhetorical_role": "FAC",
      "start": 4504,
      "end": 4602,
      "entities": [
        {
          "text": "Court at Dindoshi",
          "label": "COURT",
