          "start": 1705,
          "end": 1718
        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 14,
      "text": "In such view of the matter, delay condonation application as well as application seeking leave to appeal are rejected.",
      "rhetorical_role": "RPC",
      "start": 1764,
      "end": 1882,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.3611333966255188
    },
    {
      "sentence_id": 15,
      "text": "9. Consequently, the Appeal also stands dismissed.",
      "rhetorical_role": "RPC",
      "start": 1884,
      "end": 1934,
      "entities": [],
      "in_summary": true,
      "summary_section": "decision",
      "summary_sent_score": 0.13280829787254333
    },
    {
      "sentence_id": 16,
      "text": "However, it shall be open to victim to file appeal under relevant provision of CrPC.",
      "rhetorical_role": "RPC",
      "start": 1935,
      "end": 2019,
      "entities": [
        {
          "text": "CrPC",
          "label": "STATUTE",
