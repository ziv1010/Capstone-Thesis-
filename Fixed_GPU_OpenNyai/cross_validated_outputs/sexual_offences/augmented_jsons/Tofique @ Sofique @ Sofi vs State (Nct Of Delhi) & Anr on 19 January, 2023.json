          "label": "STATUTE",
          "start": 932,
          "end": 941
        }
      ],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.21272362768650055
    },
    {
      "sentence_id": 9,
      "text": "Nevertheless it is submitted out of 17 years of sentence awarded, he has already spent nearly half of the sentence.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 943,
      "end": 1058,
      "entities": [],
      "in_summary": false,
      "summary_section": "arguments",
      "summary_sent_score": 0.1883532553911209
    },
    {
      "sentence_id": 10,
      "text": "4. It is further submitted by learned counsel for the applicant the sentence in any case is erroneous since even if the applicant is to be punished for life, such punishment is to be taken as for 20 years and the imprisonment of attempt of such an offence shall not be more than 10 years.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 1059,
      "end": 1348,
      "entities": [],
      "in_summary": true,
      "summary_section": "arguments",
      "summary_sent_score": 0.21927447617053986
    },
