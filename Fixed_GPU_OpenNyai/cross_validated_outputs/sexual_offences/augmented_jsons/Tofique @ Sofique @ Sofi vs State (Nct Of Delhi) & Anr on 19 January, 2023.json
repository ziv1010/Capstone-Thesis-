    {
      "sentence_id": 8,
      "text": "3. It is submitted by learned counsel for the applicant a bare perusal would show no attempt of aggravated penetrative sexual assault was made and rather the facts would only show a case under Section 8 of the POCSO Act.",
      "rhetorical_role": "ARG_PETITIONER",
      "start": 721,
      "end": 942,
      "entities": [
        {
          "text": "Section 8",
