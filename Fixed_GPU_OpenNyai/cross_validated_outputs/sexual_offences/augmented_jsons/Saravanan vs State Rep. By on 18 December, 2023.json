    {
      "sentence_id": 10,
      "text": "By on 18 December, 2023 Indian Kanoon - http://indiankanoon.org/doc/79084624/\n1  (Criminal side)\nhttps://www.mhc.tn.gov.in/judis  1/5  Crl.O.P.(MD)N  O R D E R",
      "rhetorical_role": "PREAMBLE",
      "start": 922,
      "end": 1081,
      "entities": [
        {
          "text": "18 December, 2023",
          "label": "DATE",
