      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.19585560262203217
    },
    {
      "sentence_id": 22,
      "text": "3. Applicant apprehends his arrest in connection with Crime No.469/2024 registered at Police Station Bahodapur, District Gwalior for the offence punishable under Sections 376, 377, 323, 294,\n506, 34 of IPC.",
      "rhetorical_role": "FAC",
