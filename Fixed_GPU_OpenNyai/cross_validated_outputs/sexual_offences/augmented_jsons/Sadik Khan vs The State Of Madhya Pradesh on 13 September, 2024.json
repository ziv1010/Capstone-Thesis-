      "entities": [],
      "in_summary": false
    },
    {
      "sentence_id": 21,
      "text": "2. The applicant has filed this first application u/S 482 of the Bhartiya Nagrik Suraksha Sanhita (BNSS), 2024 for grant of anticipatory bail.",
      "rhetorical_role": "FAC",
      "start": 673,
      "end": 816,
      "entities": [
