      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.10156372934579849
    },
    {
      "sentence_id": 42,
      "text": "They were being represented by one and the same Advocate.",
      "rhetorical_role": "ANALYSIS",
      "start": 7129,
      "end": 7186,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1728220283985138
    },
    {
      "sentence_id": 43,
      "text": "No where defence has been taken that they were not disclosed age of the victim or they did not give shelter to accused Taliv Hussain, Khurshid Begum and Mohammad Azad, and allowed Taliv Hussain and victim to stay in their houses.",
