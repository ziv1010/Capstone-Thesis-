          "start": 6617,
          "end": 6624
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.18332576751708984
    },
    {
      "sentence_id": 40,
      "text": "It has been further asserted by applicants that they were innocent and had not committed any offence.",
      "rhetorical_role": "ANALYSIS",
      "start": 6894,
      "end": 6995,
      "entities": [],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1273881196975708
    },
    {
      "sentence_id": 41,
      "text": "Rest response to the statement under Section 313 Cr.P.C. is denial of the entire prosecution story by stating that it was incorrect.",
      "rhetorical_role": "ANALYSIS",
      "start": 6996,
      "end": 7128,
      "entities": [
        {
          "text": "Section 313",
          "label": "PROVISION",
          "start": 7033,
          "end": 7044
        },
        {
          "text": "Cr.P.C.",
