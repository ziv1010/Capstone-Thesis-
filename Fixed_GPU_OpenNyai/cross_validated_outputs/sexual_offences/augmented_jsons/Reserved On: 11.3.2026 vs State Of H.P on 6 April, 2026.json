        },
        {
          "text": "Taliv Hussain",
          "label": "OTHER_PERSON",
          "start": 7368,
          "end": 7381
        }
      ],
      "in_summary": false,
      "summary_section": "ANALYSIS",
      "summary_sent_score": 0.1284162998199463
    },
    {
      "sentence_id": 44,
      "text": "Rather in cross-examination victim had stated that they traveled to a place Kagrod in a bus alongwith Talib Hussain, Khurshid and Azad.",
