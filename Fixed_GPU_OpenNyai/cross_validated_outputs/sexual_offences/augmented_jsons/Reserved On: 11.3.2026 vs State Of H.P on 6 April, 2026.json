    },
    {
      "sentence_id": 37,
      "text": "Aforesaid statement of the victim has not been disputed.",
      "rhetorical_role": "FAC",
      "start": 6307,
      "end": 6364,
      "entities": [],
      "in_summary": false,
      "summary_section": "facts",
      "summary_sent_score": 0.14445960521697998
    },
    {
      "sentence_id": 38,
      "text": "There is not even a single suggestion to the victim that applicants were not aware about her age and they had allowed accused Taliv Hussain of and victim to stay in their houses innocently.",
      "rhetorical_role": "FAC",
      "start": 6365,
      "end": 6554,
      "entities": [
