        }
      ],
      "in_summary": false
    },
    {
      "sentence_id": 13,
      "text": "According to the FIR, the petitioner no.1 Ankit Kumar, and the respondent no3, the informant, were in relationship.",
      "rhetorical_role": "FAC",
      "start": 913,
      "end": 1029,
      "entities": [
        {
          "text": "Ankit Kumar",
