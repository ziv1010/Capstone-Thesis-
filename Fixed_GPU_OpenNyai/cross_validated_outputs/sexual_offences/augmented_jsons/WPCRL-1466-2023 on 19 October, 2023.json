      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3282535970211029
    },
    {
      "sentence_id": 14,
      "text": "The petitioner no.1, Ankit Kumar, under the pretext of marriage, established physical relations with the informant, and continued thereafter.",
      "rhetorical_role": "FAC",
      "start": 1030,
      "end": 1171,
      "entities": [
        {
          "text": "Ankit Kumar",
          "label": "PETITIONER",
