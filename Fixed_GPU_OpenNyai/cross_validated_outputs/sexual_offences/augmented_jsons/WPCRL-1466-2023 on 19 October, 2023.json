          "end": 1062
        }
      ],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.3710540235042572
    },
    {
      "sentence_id": 15,
      "text": "Subsequently, he as well as his father, the petitioner no.2, declined to marry.",
      "rhetorical_role": "FAC",
      "start": 1172,
      "end": 1251,
      "entities": [],
      "in_summary": true,
      "summary_section": "facts",
      "summary_sent_score": 0.31993401050567627
    },
    {
      "sentence_id": 16,
      "text": "Having considered, as an interim measure, till the next date of listing, no coercive step shall be taken against the petitioners, provided they cooperate with the investigation.",
