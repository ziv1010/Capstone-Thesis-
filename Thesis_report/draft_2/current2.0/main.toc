\contentsline {chapter}{\numberline {8}Discussion}{93}{chapter.264}%
\contentsline {section}{\numberline {8.1}Summary of Findings}{93}{section.265}%
\contentsline {paragraph}{The pipeline produces a legally coherent corpus.}{93}{section*.266}%
\contentsline {paragraph}{The graph is hub-dominated and cross-domain.}{94}{section*.267}%
\contentsline {paragraph}{The HGT model learns cross-case structural signal.}{94}{section*.268}%
\contentsline {paragraph}{The model does not rely on identity shortcuts.}{94}{section*.269}%
\contentsline {paragraph}{Predictions are auditable at the case level.}{95}{section*.270}%
\contentsline {paragraph}{The cross-bucket representation transfers, partially, to an unseen legal domain.}{96}{section*.271}%
\contentsline {section}{\numberline {8.2}Limitations}{96}{section.272}%
\contentsline {paragraph}{Transductive evaluation assumes entity overlap at test time.}{96}{section*.273}%
\contentsline {paragraph}{Outcome labels are LLM-generated.}{96}{section*.274}%
\contentsline {paragraph}{RPC/RLC filtering is a lower bound on leakage, not a guarantee.}{97}{section*.275}%
\contentsline {paragraph}{The ablation ordering is stable but the margins are small.}{97}{section*.276}%
\contentsline {paragraph}{The pooled optimum is not the universal optimum.}{97}{section*.277}%
